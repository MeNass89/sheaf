import { JavaScriptConsole, JavaScriptBridge } from "screens/javascript.slint";
import { LibraryScreen, LibraryDeletePrompt, LibraryBridge, LibraryRow, LibraryVersionRow } from "screens/library.slint";
import { ActionsScreen, ActionPrompt, CustomToolsPanel, ActionBridge, ActionRow, ActionStepRow, ActionCommandRow } from "screens/actions.slint";
import { Theme } from "theme.slint";
import { ToolCard } from "widgets/tool-card.slint";
import { MenuItem } from "widgets/menu-item.slint";
import { TabBar } from "widgets/tab-bar.slint";
import { RecentsScreen } from "screens/recents.slint";
import { HistoryScreen, ClearHistoryDialog } from "screens/history.slint";
import { PreferencesScreen } from "screens/preferences.slint";
import { RecentFile, HistoryRow } from "history-types.slint";
import { ToolsScreen, ToolSection } from "screens/tools.slint";
import { ToolTab, ToolOptions, FileItem, PageItem, ResultFile, ContinueTool, Parse, OcrInfo, OcrLanguage, Picked, ReaderBridge, ReaderState, ReaderOutlineRow, ReaderAnnotRow, ReaderReply, ReaderNote, ReaderMark, ReaderResultRow, ViewerBridge, ViewerPage, ViewerThumb, ViewerOverlay, RedactResult, RedactMarkItem, SignBridge, SignOverlay, EditBridge, EditOverlay } from "flow-types.slint";
import { ToolFlowScreen } from "screens/tool-flow.slint";
import { ReaderScreen } from "screens/reader.slint";
import { ResultScreen } from "screens/result.slint";
import { PasswordDialog, ConfirmCloseDialog, UnsavedDialog, LaunchFileDialog, Toast } from "screens/dialogs.slint";

export { JavaScriptBridge, LibraryBridge, LibraryRow, LibraryVersionRow, ActionBridge, ActionRow, ActionStepRow, ActionCommandRow, Theme, ToolCard, ToolSection, ToolTab, ToolOptions, FileItem, PageItem, ResultFile, ContinueTool, RecentFile, HistoryRow, Parse, OcrInfo, OcrLanguage, Picked, ReaderBridge, ReaderState, ReaderOutlineRow, ReaderAnnotRow, ReaderReply, ReaderNote, ReaderMark, ReaderResultRow, ViewerBridge, ViewerPage, ViewerThumb, ViewerOverlay, RedactResult, RedactMarkItem, SignBridge, SignOverlay, EditBridge, EditOverlay }

export enum Page { recents, tools, history, preferences, actions, library }

component Sidebar inherits Rectangle {
    in-out property <Page> page;
    in property <bool> collapsed;

    width: collapsed ? Theme.sidebar-collapsed-width : Theme.sidebar-width;
    background: Theme.sidebar-bg;

    VerticalLayout {
        padding: Theme.sidebar-margin;
        padding-top: 16px;
        spacing: 2px;
        alignment: start;
        MenuItem {
            icon: @image-url("icons/clock.svg");
            text: "Recents";
            collapsed: root.collapsed;
            selected: root.page == Page.recents;
            clicked => { root.page = Page.recents; }
        }
        MenuItem {
            icon: @image-url("icons/wrench.svg");
            text: "Tools";
            collapsed: root.collapsed;
            selected: root.page == Page.tools;
            clicked => { root.page = Page.tools; }
        }
        MenuItem {
            icon: @image-url("icons/clipboard-list.svg");
            text: "Tasks History";
            collapsed: root.collapsed;
            selected: root.page == Page.history;
            clicked => { root.page = Page.history; }
        }
        MenuItem {
            icon: @image-url("icons/folder.svg");
            text: "Library";
            collapsed: root.collapsed;
            selected: root.page == Page.library;
            clicked => { root.page = Page.library; }
        }
        MenuItem {
            icon: @image-url("icons/list-ordered.svg");
            text: "Actions";
            collapsed: root.collapsed;
            selected: root.page == Page.actions;
            clicked => { root.page = Page.actions; }
        }
        MenuItem {
            icon: @image-url("icons/settings.svg");
            text: "Preferences";
            collapsed: root.collapsed;
            selected: root.page == Page.preferences;
            clicked => { root.page = Page.preferences; }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.sidebar-border;
    }
}

export component AppWindow inherits Window {
    in-out property <Page> page: Page.recents;
    in-out property <[ToolSection]> sections;
    in property <[ToolCard]> all-tools;
    // Tools page search: the tools found for what is typed, best first.
    in property <[ToolCard]> tool-results;
    // Home: the tools of the latest runs, newest first.
    in property <[ToolCard]> recent-tools;
    // Starred tools, and starring one.
    in property <[ToolCard]> favourite-tools;
    callback star-tool(string);
    callback tool-query(string) -> string;
    // Tools page sort: 0 = Categories, 1 = All. Kept here so it survives page switches.
    in-out property <int> tools-sort: 0;

    // Tool tabs; active-tab is an index into `tabs`, -1 = Home.
    in property <[ToolTab]> tabs;
    // The bar's order: rows of `tabs` as the bar shows them (a dragged tab moves only here).
    in property <[int]> tab-order;
    in-out property <int> active-tab: -1;

    // Password dialog
    in property <bool> pw-visible;
    in property <string> pw-file;
    in property <bool> pw-wrong;
    in property <int> pw-attempt;
    // Closing a tab with a running job
    in property <bool> confirm-visible;
    in property <string> launch-name;
    callback launch-answer(bool);
    in property <string> unsaved-file;
    in property <int> unsaved-redact-marks;
    callback unsaved-answer(int);
    // Bottom-centre toast
    in property <string> toast-text;
    // Files dragged over the window: what a drop would do ("" when nothing is dragged); a drop
    // the tab refuses is told in the warning colour.
    in property <string> drop-hint;
    in property <bool> drop-refused;
    in property <bool> toast-visible;

    // Recents, history, preferences
    in property <[RecentFile]> recents;
    in property <[HistoryRow]> history;
    in property <int> theme-pref;
    in property <int> backdrop-pref;
    in property <int> output-mode;
    in property <string> fixed-folder;
    in property <bool> open-after;
    in property <string> author-name;
    in property <int> default-zoom;
    in property <int> stamp-date;
    callback set-stamp-date(int);
    in property <bool> metric;
    callback set-metric(bool);
    in property <int> guide-colour;
    callback set-guide-colour(int);
    in property <bool> gpu: true;
    callback set-gpu(bool);
    in property <bool> show-boxes;
    in property <bool> physical-numbers;
    callback set-page-display(int, bool);
    in property <[string]> digital-ids;
    in property <[string]> trusted-certs;
    callback signature-prefs(int, int);
    callback make-default();
    callback set-default-zoom(int);
    in property <int> default-spread;
    callback set-default-spread(int);
    in property <bool> open-first-page;
    callback set-open-first-page(bool);
    // Preferences ▸ Rendering: text, line art and images smoothed.
    in property <[bool]> smooth: [true, true, true];
    callback set-smoothing(int, bool);
    in property <string> author-default;
    property <bool> confirm-clear;

    callback open-file();
    callback new-blank();
    callback new-from-clipboard();
    callback new-from-screenshot();
    callback new-from-scanner();
    callback pin-recent(int);
    callback filter-recents(string, int);
    callback open-tool(string);
    callback close-tab(int);
    // A tab dragged to another place (from, to), and the tab menu's close others / left / right.
    callback move-tab(int, int);
    // ⇧⌘[ / ⇧⌘]: the next tab along the bar.
    callback step-tab(int);
    // ⌘W anywhere: the tab shown closed.
    callback close-active-tab();
    callback close-tabs-around(int, int);
    callback add-files(int);
    callback open-slot(int, int);
    callback swap-slots(int);
    callback remove-file(int, int);
    callback move-file(int, int, int);
    callback place-file(int, int, int);
    callback sort-files(int);
    callback set-pages(int, int, string);
    pure callback open-doc-count(int) -> int;
    callback add-open-docs(int);
    pure callback open-doc-names(int) -> [string];
    callback add-open-doc-to-slot(int, int, int);
    callback remove-page(int, int);
    callback move-page(int, int, int);
    callback insert-blank(int);
    callback show-merge-pages(int, bool);
    callback crop-preview-step(int, int);
    callback run-tool(int, ToolOptions);
    callback cancel-job(int);
    callback open-output(int, int);
    callback reveal-output(int, int);
    callback open-folder(int);
    callback start-over(int);
    callback continue-to(int, string);
    callback get-libreoffice();
    callback pw-unlock(string);
    callback pw-skip();
    callback confirm-cancel-job();
    callback confirm-keep();
    callback open-recent(int);
    callback reveal-recent(int);
    callback remove-recent(int);
    callback clear-recents();
    callback reveal-history(int);
    callback rerun-history(int);
    callback clear-history();
    callback set-theme(int);
    callback set-accent(int);
    callback set-backdrop(int);
    callback set-output(int);
    callback choose-folder();
    callback set-open-after(bool);
    callback set-author(string);
    // ⌘, from anywhere: Home ▸ Preferences, out of full screen (a presentation ends with it).
    // A tool tab or Home shown: the app scope takes the keyboard (a reader tab takes it itself), so
    // ⌘, reaches it wherever the user is.
    changed active-tab => { root.take-keys(); }
    changed pw-visible => { if !self.pw-visible { root.take-keys(); } }
    init => { root.take-keys(); }
    // The keyboard goes where it belongs: the Tools search on Home ▸ Tools, else the app scope (so
    // ⌘, works everywhere); a reader tab and the password dialog take it themselves.
    function take-keys() {
        if root.pw-visible { return; }
        // A reader tab takes the keyboard itself (also after the password dialog it opened with).
        if root.active-tab >= 0 && root.tabs[root.active-tab].is-reader { root.reader-keys += 1; return; }
        if root.active-tab == -1 && root.page == Page.tools { root.search-seq += 1; } else { app-keys.focus(); }
    }
    // Bumped to give the shown reader tab the keyboard.
    property <int> reader-keys;
    // Bumped to give the Tools search the keyboard (+ tab, ⌘F).
    property <int> search-seq;
    // Bumped to end any presentation (⌘, leaves it as Escape would).
    property <int> end-presenting;
    function show-preferences() {
        root.end-presenting += 1;
        root.full-screen = false;
        root.active-tab = -1;
        root.page = Page.preferences;
    }
    // Home page switched: refresh relative times and missing files.
    callback page-shown();
    changed page => { root.page-shown(); root.take-keys(); }

    title: "Sheaf";
    // Windows and Linux taskbars (macOS takes the bundle's icon).
    icon: @image-url("../macos/icon.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;
    default-font-size: Theme.fs-body;

    // App-wide keys (macOS conventions), reached from anywhere a focused control does not take them:
    // ⌘, Preferences, ⌘O Open, ⌘W close the tab shown, ⌃Tab and ⌃⇧Tab the next and previous tab, as
    // browsers and PDF Expert do (⌘8 and ⌘9 stay the reader's zooms).
    app-keys := FocusScope {
        key-pressed(e) => {
            if e.modifiers.control && e.text == "," { root.show-preferences(); return accept; }
            if e.modifiers.control && (e.text == "o" || e.text == "O") { root.open-file(); return accept; }
            if e.modifiers.control && (e.text == "w" || e.text == "W") && root.active-tab >= 0 { root.close-active-tab(); return accept; }
            if e.text == Key.Tab && e.modifiers.control { root.step-tab(e.modifiers.shift ? -1 : 1); return accept; }
            // ⌘F on the Tools page: its search.
            if e.modifiers.control && e.text == "f" && root.active-tab == -1 && root.page == Page.tools { root.search-seq += 1; return accept; }
            reject
        }
        VerticalLayout {
            TabBar {
                tabs: root.tabs;
                order: root.tab-order;
                active <=> root.active-tab;
                close-tab(id) => { root.close-tab(id); }
                move-tab(from, to) => { root.move-tab(from, to); }
                close-tabs-around(id, which) => { root.close-tabs-around(id, which); }
                new-tab => {
                    root.active-tab = -1;
                    root.page = Page.tools;
                    // Already on Tools: neither change fires, the search still takes the keyboard.
                    root.take-keys();
                }
            }
            Rectangle {
                vertical-stretch: 1;
                // Home
                Rectangle {
                    visible: root.active-tab == -1;
                    sidebar := Sidebar {
                        x: 0;
                        height: parent.height;
                        page <=> root.page;
                        collapsed: root.width < Theme.sidebar-collapse-below;
                    }
                    Rectangle {
                        x: sidebar.width;
                        width: parent.width - sidebar.width;
                        height: parent.height;
                        if root.page == Page.recents: RecentsScreen {
                            recents: root.recents;
                            recent-tools: root.recent-tools;
                            open-tool(id) => { root.open-tool(id); }
                            star(id) => { root.star-tool(id); }
                            open-file => { root.open-file(); }
                            new-blank => { root.new-blank(); }
                            new-from-clipboard => { root.new-from-clipboard(); }
                            new-from-screenshot => { root.new-from-screenshot(); }
                            new-from-scanner => { root.new-from-scanner(); }
                            open-recent(i) => { root.open-recent(i); }
                            reveal-recent(i) => { root.reveal-recent(i); }
                            remove-recent(i) => { root.remove-recent(i); }
                            clear-recents => { root.clear-recents(); }
                            pin-recent(i) => { root.pin-recent(i); }
                            filter-recents(q, o) => { root.filter-recents(q, o); }
                        }
                        if root.page == Page.tools: ToolsScreen {
                        focus-seq: root.search-seq;
                            sections <=> root.sections;
                            all-tools: root.all-tools;
                            sort <=> root.tools-sort;
                            chevron: @image-url("icons/chevron-down.svg");
                            open-tool(id) => { root.open-tool(id); }
                            results: root.tool-results;
                            query(q) => { return root.tool-query(q); }
                        star(id) => { root.star-tool(id); }
                        favourites: root.favourite-tools;
                        }
                        if root.page == Page.actions: ActionsScreen { }
                        if root.page == Page.library: LibraryScreen { }
                        if root.page == Page.history: HistoryScreen {
                            rows: root.history;
                            reveal(i) => { root.reveal-history(i); }
                            rerun(i) => { root.rerun-history(i); }
                            ask-clear => { root.confirm-clear = true; }
                        }
                        if root.page == Page.preferences: PreferencesScreen {
                            theme-pref: root.theme-pref;
                            output-mode: root.output-mode;
                            fixed-folder: root.fixed-folder;
                            open-after: root.open-after;
                            author-name: root.author-name;
                            author-default: root.author-default;
                            default-zoom: root.default-zoom;
                            stamp-date: root.stamp-date;
                            set-stamp-date(f) => { root.set-stamp-date(f); }
                            metric: root.metric;
                            set-metric(m) => { root.set-metric(m); }
                            guide-colour: root.guide-colour;
                            set-guide-colour(k) => { root.set-guide-colour(k); }
                            gpu: root.gpu;
                            set-gpu(on) => { root.set-gpu(on); }
                            show-boxes: root.show-boxes;
                            physical-numbers: root.physical-numbers;
                            set-page-display(w, on) => { root.set-page-display(w, on); }
                            digital-ids: root.digital-ids;
                            trusted-certs: root.trusted-certs;
                            signature-prefs(w, k) => { root.signature-prefs(w, k); }
                            make-default => { root.make-default(); }
                            set-default-zoom(z) => { root.set-default-zoom(z); }
                            default-spread: root.default-spread;
                            set-default-spread(s) => { root.set-default-spread(s); }
                            open-first-page: root.open-first-page;
                            set-open-first-page(f) => { root.set-open-first-page(f); }
                            smooth: root.smooth;
                            set-smoothing(k, on) => { root.set-smoothing(k, on); }
                            backdrop-pref: root.backdrop-pref;
                            set-accent(i) => { root.set-accent(i); }
                            set-backdrop(i) => { root.set-backdrop(i); }
                            set-theme(m) => { root.set-theme(m); }
                            set-output(m) => { root.set-output(m); }
                            choose-folder => { root.choose-folder(); }
                            set-open-after(v) => { root.set-open-after(v); }
                            set-author(n) => { root.set-author(n); }
                        }
                    }
                }
                // Tool tabs: one instance each, so their options survive tab switches.
                for t[i] in root.tabs: Rectangle {
                    visible: root.active-tab == i;
                    if t.is-reader: ReaderScreen {
                        tab: t;
                        active: root.active-tab == i;
                        is-full-screen: root.full-screen;
                    end-presenting: root.end-presenting;
                    take-keys: root.reader-keys;
                        full-screen(on) => { root.full-screen = on; }
                        open-preferences => { root.show-preferences(); }
                        switch-tab(d) => { root.step-tab(d); }
                    }
                    if !t.is-reader: ToolFlowScreen {
                        visible: t.phase < 2;
                        tab: t;
                        open-files => { root.add-files(t.id); }
                        remove-file(uid) => { root.remove-file(t.id, uid); }
                        move-file(uid, d) => { root.move-file(t.id, uid, d); }
                        place-file(uid, k) => { root.place-file(t.id, uid, k); }
                        sort-files => { root.sort-files(t.id); }
                        set-pages(uid, text) => { root.set-pages(t.id, uid, text); }
                        open-doc-count => { root.open-doc-count(t.id) }
                        add-open-docs => { root.add-open-docs(t.id); }
                        open-doc-names => { root.open-doc-names(t.id) }
                        add-open-doc-to-slot(slot, i) => { root.add-open-doc-to-slot(t.id, slot, i); }
                        remove-page(k) => { root.remove-page(t.id, k); }
                        move-page(k, d) => { root.move-page(t.id, k, d); }
                        insert-blank => { root.insert-blank(t.id); }
                        show-merge-pages(on) => { root.show-merge-pages(t.id, on); }
                        crop-preview-step(d) => { root.crop-preview-step(t.id, d); }
                        run(o) => { root.run-tool(t.id, o); }
                        cancel => { root.cancel-job(t.id); }
                        get-libreoffice => { root.get-libreoffice(); }
                        open-slot(k) => { root.open-slot(t.id, k); }
                        swap-slots => { root.swap-slots(t.id); }
                    }
                    if t.phase == 2: ResultScreen {
                        tab: t;
                        open-output(k) => { root.open-output(t.id, k); }
                        reveal-output(k) => { root.reveal-output(t.id, k); }
                        open-folder => { root.open-folder(t.id); }
                        start-over => { root.start-over(t.id); }
                        continue-to(tool) => { root.continue-to(t.id, tool); }
                    }
                }
            }
        }
    }

    // The window as a drop zone while files are dragged over it (iLovePDF's and PDF Expert's).
    if root.drop-hint != "": Rectangle {
        background: (root.drop-refused ? Theme.warning : Theme.accent).transparentize(90%);
        border-width: 2px;
        border-color: root.drop-refused ? Theme.warning : Theme.accent;
        border-radius: Theme.radius-card;
        Rectangle {
            width: hint.preferred-width + 32px;
            height: 40px;
            border-radius: 20px;
            background: root.drop-refused ? Theme.warning : Theme.accent;
            hint := Text {
                text: root.drop-hint;
                font-size: Theme.fs-label;
                font-weight: Theme.weight-demibold;
                color: Theme.on-accent;
            }
        }
    }
    if root.toast-visible: Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 28px;
        text: root.toast-text;
    }
    if root.pw-visible: PasswordDialog {
        file-name: root.pw-file;
        wrong: root.pw-wrong;
        attempt: root.pw-attempt;
        unlock(pw) => { root.pw-unlock(pw); }
        skip => { root.pw-skip(); }
    }
    if root.confirm-clear: ClearHistoryDialog {
        clear => {
            root.confirm-clear = false;
            root.clear-history();
        }
        cancel => { root.confirm-clear = false; }
    }
    if root.unsaved-file != "": UnsavedDialog {
        file-name: root.unsaved-file;
        redact-marks: root.unsaved-redact-marks;
        save => { root.unsaved-answer(1); }
        discard => { root.unsaved-answer(2); }
        cancel => { root.unsaved-answer(0); }
    }
    if root.launch-name != "": LaunchFileDialog {
        name: root.launch-name;
        answer(yes) => { root.launch-answer(yes); }
    }
    if root.confirm-visible: ConfirmCloseDialog {
        cancel-job => { root.confirm-cancel-job(); }
        keep => { root.confirm-keep(); }
    }
    if ActionBridge.tools-visible: CustomToolsPanel { }
    if ActionBridge.prompt != "": ActionPrompt { }
    if JavaScriptBridge.visible: JavaScriptConsole { }
    if LibraryBridge.delete-id != "": LibraryDeletePrompt { }

}
