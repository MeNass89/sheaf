import { Theme } from "theme.slint";
import { ToolCard } from "widgets/tool-card.slint";
import { MenuItem } from "widgets/menu-item.slint";
import { TabBar } from "widgets/tab-bar.slint";
import { RecentsScreen } from "screens/recents.slint";
import { HistoryScreen, ClearHistoryDialog } from "screens/history.slint";
import { PreferencesScreen } from "screens/preferences.slint";
import { RecentFile, HistoryRow } from "history-types.slint";
import { ToolsScreen, ToolSection } from "screens/tools.slint";
import { ToolTab, ToolOptions, FileItem, PageItem, ResultFile, ContinueTool, Parse, OcrInfo, OcrLanguage, Picked, ReaderBridge, ReaderState, ReaderOutlineRow, ReaderAnnotRow, ReaderNote, ReaderMark, ReaderResultRow, ViewerBridge, ViewerPage, ViewerThumb, ViewerOverlay, RedactResult, RedactMarkItem, SignBridge, SignOverlay, EditBridge, EditOverlay } from "flow-types.slint";
import { ToolFlowScreen } from "screens/tool-flow.slint";
import { ReaderScreen } from "screens/reader.slint";
import { ResultScreen } from "screens/result.slint";
import { PasswordDialog, ConfirmCloseDialog, UnsavedDialog, Toast } from "screens/dialogs.slint";

export { Theme, ToolCard, ToolSection, ToolTab, ToolOptions, FileItem, PageItem, ResultFile, ContinueTool, RecentFile, HistoryRow, Parse, OcrInfo, OcrLanguage, Picked, ReaderBridge, ReaderState, ReaderOutlineRow, ReaderAnnotRow, ReaderNote, ReaderMark, ReaderResultRow, ViewerBridge, ViewerPage, ViewerThumb, ViewerOverlay, RedactResult, RedactMarkItem, SignBridge, SignOverlay, EditBridge, EditOverlay }

export enum Page { recents, tools, history, preferences }

component Sidebar inherits Rectangle {
    in-out property <Page> page;
    in property <bool> collapsed;

    width: collapsed ? Theme.sidebar-collapsed-width : Theme.sidebar-width;
    background: Theme.sidebar-bg;

    VerticalLayout {
        padding: Theme.sidebar-margin;
        padding-top: 16px;
        spacing: 2px;
        alignment: start;
        MenuItem {
            icon: @image-url("icons/clock.svg");
            text: "Recents";
            collapsed: root.collapsed;
            selected: root.page == Page.recents;
            clicked => { root.page = Page.recents; }
        }
        MenuItem {
            icon: @image-url("icons/wrench.svg");
            text: "Tools";
            collapsed: root.collapsed;
            selected: root.page == Page.tools;
            clicked => { root.page = Page.tools; }
        }
        MenuItem {
            icon: @image-url("icons/clipboard-list.svg");
            text: "Tasks History";
            collapsed: root.collapsed;
            selected: root.page == Page.history;
            clicked => { root.page = Page.history; }
        }
        MenuItem {
            icon: @image-url("icons/settings.svg");
            text: "Preferences";
            collapsed: root.collapsed;
            selected: root.page == Page.preferences;
            clicked => { root.page = Page.preferences; }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.sidebar-border;
    }
}

export component AppWindow inherits Window {
    in-out property <Page> page: Page.recents;
    in-out property <[ToolSection]> sections;
    in property <[ToolCard]> all-tools;
    // Tools page search: the tools found for what is typed, best first.
    in property <[ToolCard]> tool-results;
    // Home: the tools of the latest runs, newest first.
    in property <[ToolCard]> recent-tools;
    // Starred tools, and starring one.
    in property <[ToolCard]> favourite-tools;
    callback star-tool(string);
    callback tool-query(string) -> string;
    // Tools page sort: 0 = Categories, 1 = All. Kept here so it survives page switches.
    in-out property <int> tools-sort: 0;

    // Tool tabs; active-tab is an index into `tabs`, -1 = Home.
    in property <[ToolTab]> tabs;
    in-out property <int> active-tab: -1;

    // Password dialog
    in property <bool> pw-visible;
    in property <string> pw-file;
    in property <bool> pw-wrong;
    in property <int> pw-attempt;
    // Closing a tab with a running job
    in property <bool> confirm-visible;
    in property <string> unsaved-file;
    callback unsaved-answer(int);
    // Bottom-centre toast
    in property <string> toast-text;
    in property <bool> toast-visible;

    // Recents, history, preferences
    in property <[RecentFile]> recents;
    in property <[HistoryRow]> history;
    in property <int> theme-pref;
    in property <int> output-mode;
    in property <string> fixed-folder;
    in property <bool> open-after;
    in property <string> author-name;
    in property <string> author-default;
    property <bool> confirm-clear;

    callback open-file();
    callback open-tool(string);
    callback close-tab(int);
    callback add-files(int);
    callback open-slot(int, int);
    callback swap-slots(int);
    callback remove-file(int, int);
    callback move-file(int, int, int);
    callback remove-page(int, int);
    callback move-page(int, int, int);
    callback insert-blank(int);
    callback run-tool(int, ToolOptions);
    callback cancel-job(int);
    callback open-output(int, int);
    callback reveal-output(int, int);
    callback open-folder(int);
    callback start-over(int);
    callback continue-to(int, string);
    callback get-libreoffice();
    callback pw-unlock(string);
    callback pw-skip();
    callback confirm-cancel-job();
    callback confirm-keep();
    callback open-recent(int);
    callback reveal-recent(int);
    callback remove-recent(int);
    callback clear-recents();
    callback reveal-history(int);
    callback clear-history();
    callback set-theme(int);
    callback set-output(int);
    callback choose-folder();
    callback set-open-after(bool);
    callback set-author(string);
    // ⌘, from anywhere: Home ▸ Preferences, out of full screen (a presentation ends with it).
    // A tool tab or Home shown: the app scope takes the keyboard (a reader tab takes it itself), so
    // ⌘, reaches it wherever the user is.
    changed active-tab => { root.take-keys(); }
    changed pw-visible => { if !self.pw-visible { root.take-keys(); } }
    init => { root.take-keys(); }
    // The keyboard goes where it belongs: the Tools search on Home ▸ Tools, else the app scope (so
    // ⌘, works everywhere); a reader tab and the password dialog take it themselves.
    function take-keys() {
        if root.pw-visible || (root.active-tab >= 0 && root.tabs[root.active-tab].is-reader) { return; }
        if root.active-tab == -1 && root.page == Page.tools { root.search-seq += 1; } else { app-keys.focus(); }
    }
    // Bumped to give the Tools search the keyboard (+ tab, ⌘F).
    property <int> search-seq;
    // Bumped to end any presentation (⌘, leaves it as Escape would).
    property <int> end-presenting;
    function show-preferences() {
        root.end-presenting += 1;
        root.full-screen = false;
        root.active-tab = -1;
        root.page = Page.preferences;
    }
    // Home page switched: refresh relative times and missing files.
    callback page-shown();
    changed page => { root.page-shown(); root.take-keys(); }

    title: "Sheaf";
    // Windows and Linux taskbars (macOS takes the bundle's icon).
    icon: @image-url("../macos/icon.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;
    default-font-size: Theme.fs-body;

    // App-wide keys (macOS conventions), reached from anywhere a focused control does not take them:
    // ⌘, Preferences.
    app-keys := FocusScope {
        key-pressed(e) => {
            if e.modifiers.control && e.text == "," { root.show-preferences(); return accept; }
            // ⌘F on the Tools page: its search.
            if e.modifiers.control && e.text == "f" && root.active-tab == -1 && root.page == Page.tools { root.search-seq += 1; return accept; }
            reject
        }
        VerticalLayout {
            TabBar {
                tabs: root.tabs;
                active <=> root.active-tab;
                close-tab(id) => { root.close-tab(id); }
                new-tab => {
                    root.active-tab = -1;
                    root.page = Page.tools;
                    // Already on Tools: neither change fires, the search still takes the keyboard.
                    root.take-keys();
                }
            }
            Rectangle {
                vertical-stretch: 1;
                // Home
                Rectangle {
                    visible: root.active-tab == -1;
                    sidebar := Sidebar {
                        x: 0;
                        height: parent.height;
                        page <=> root.page;
                        collapsed: root.width < Theme.sidebar-collapse-below;
                    }
                    Rectangle {
                        x: sidebar.width;
                        width: parent.width - sidebar.width;
                        height: parent.height;
                        if root.page == Page.recents: RecentsScreen {
                            recents: root.recents;
                            recent-tools: root.recent-tools;
                            open-tool(id) => { root.open-tool(id); }
                            open-file => { root.open-file(); }
                            open-recent(i) => { root.open-recent(i); }
                            reveal-recent(i) => { root.reveal-recent(i); }
                            remove-recent(i) => { root.remove-recent(i); }
                            clear-recents => { root.clear-recents(); }
                        }
                        if root.page == Page.tools: ToolsScreen {
                        focus-seq: root.search-seq;
                            sections <=> root.sections;
                            all-tools: root.all-tools;
                            sort <=> root.tools-sort;
                            chevron: @image-url("icons/chevron-down.svg");
                            open-tool(id) => { root.open-tool(id); }
                            results: root.tool-results;
                            query(q) => { return root.tool-query(q); }
                        star(id) => { root.star-tool(id); }
                        favourites: root.favourite-tools;
                        }
                        if root.page == Page.history: HistoryScreen {
                            rows: root.history;
                            reveal(i) => { root.reveal-history(i); }
                            ask-clear => { root.confirm-clear = true; }
                        }
                        if root.page == Page.preferences: PreferencesScreen {
                            theme-pref: root.theme-pref;
                            output-mode: root.output-mode;
                            fixed-folder: root.fixed-folder;
                            open-after: root.open-after;
                            author-name: root.author-name;
                            author-default: root.author-default;
                            set-theme(m) => { root.set-theme(m); }
                            set-output(m) => { root.set-output(m); }
                            choose-folder => { root.choose-folder(); }
                            set-open-after(v) => { root.set-open-after(v); }
                            set-author(n) => { root.set-author(n); }
                        }
                    }
                }
                // Tool tabs: one instance each, so their options survive tab switches.
                for t[i] in root.tabs: Rectangle {
                    visible: root.active-tab == i;
                    if t.is-reader: ReaderScreen {
                        tab: t;
                        active: root.active-tab == i;
                        is-full-screen: root.full-screen;
                    end-presenting: root.end-presenting;
                        full-screen(on) => { root.full-screen = on; }
                        open-preferences => { root.show-preferences(); }
                        switch-tab(d) => {
                            // Tabs wrap around, Home not included.
                            root.active-tab = Math.mod(root.active-tab + d + root.tabs.length, root.tabs.length);
                        }
                    }
                    if !t.is-reader: ToolFlowScreen {
                        visible: t.phase < 2;
                        tab: t;
                        open-files => { root.add-files(t.id); }
                        remove-file(uid) => { root.remove-file(t.id, uid); }
                        move-file(uid, d) => { root.move-file(t.id, uid, d); }
                        remove-page(k) => { root.remove-page(t.id, k); }
                        move-page(k, d) => { root.move-page(t.id, k, d); }
                        insert-blank => { root.insert-blank(t.id); }
                        run(o) => { root.run-tool(t.id, o); }
                        cancel => { root.cancel-job(t.id); }
                        get-libreoffice => { root.get-libreoffice(); }
                        open-slot(k) => { root.open-slot(t.id, k); }
                        swap-slots => { root.swap-slots(t.id); }
                    }
                    if t.phase == 2: ResultScreen {
                        tab: t;
                        open-output(k) => { root.open-output(t.id, k); }
                        reveal-output(k) => { root.reveal-output(t.id, k); }
                        open-folder => { root.open-folder(t.id); }
                        start-over => { root.start-over(t.id); }
                        continue-to(tool) => { root.continue-to(t.id, tool); }
                    }
                }
            }
        }
    }

    if root.toast-visible: Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 28px;
        text: root.toast-text;
    }
    if root.pw-visible: PasswordDialog {
        file-name: root.pw-file;
        wrong: root.pw-wrong;
        attempt: root.pw-attempt;
        unlock(pw) => { root.pw-unlock(pw); }
        skip => { root.pw-skip(); }
    }
    if root.confirm-clear: ClearHistoryDialog {
        clear => {
            root.confirm-clear = false;
            root.clear-history();
        }
        cancel => { root.confirm-clear = false; }
    }
    if root.unsaved-file != "": UnsavedDialog {
        file-name: root.unsaved-file;
        save => { root.unsaved-answer(1); }
        discard => { root.unsaved-answer(2); }
        cancel => { root.unsaved-answer(0); }
    }
    if root.confirm-visible: ConfirmCloseDialog {
        cancel-job => { root.confirm-cancel-job(); }
        keep => { root.confirm-keep(); }
    }
}
