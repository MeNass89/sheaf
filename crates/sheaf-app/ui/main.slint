import { JavaScriptConsole, JavaScriptBridge, DocumentScriptRow } from "screens/javascript.slint";
import { LibraryScreen, LibraryDeletePrompt, LibraryBridge, LibraryRow, LibraryVersionRow } from "screens/library.slint";
import { ActionsScreen, ActionPrompt, ActionDiscardPrompt, CustomToolsPanel, ActionBridge, ActionRow, ActionStepRow, ActionCommandRow } from "screens/actions.slint";
import { Theme, Space } from "theme.slint";
import { ToolCard } from "widgets/tool-card.slint";
import { TabBar } from "widgets/tab-bar.slint";
import { RecentsScreen, FavouritesScreen, CustomizeHomeSheet, HomeBridge } from "screens/recents.slint";
import { HomeMetrics, SourceRow } from "screens/home-kit.slint";
import { HistoryScreen, ClearHistoryDialog } from "screens/history.slint";
import { RecentFile, HistoryRow } from "history-types.slint";
import { ToolsScreen, ToolSection } from "screens/tools.slint";
import { ToolTab, ToolOptions, FileItem, PageItem, ResultFile, ContinueTool, Parse, OcrInfo, OcrLanguage, Picked, ReaderBridge, ReaderState, ReaderOutlineRow, ReaderBookmarkRow, ReaderGridCell, ReaderAnnotRow, ReaderReply, ReaderNote, ReaderMark, ReaderResultRow, ViewerBridge, ViewerPage, ViewerThumb, ViewerOverlay, RedactResult, RedactMarkItem, SignBridge, SignOverlay, EditBridge, EditOverlay } from "flow-types.slint";
import { ToolFlowScreen } from "screens/tool-flow.slint";
import { ReaderScreen } from "screens/reader.slint";
import { ResultScreen } from "screens/result.slint";
import { PasswordDialog, ConfirmCloseDialog, UnsavedDialog, LaunchFileDialog } from "screens/dialogs.slint";
import { ToastView } from "widgets/surfaces.slint";
import { PlatformBridge, SpellIssue, ShortcutRow, Launcher, DictionaryRow } from "platform.slint";
import { SpellingDialog } from "screens/spelling-dialog.slint";
import { AiBridge, AiMessage } from "ai.slint";
import { SettingsBridge } from "settings.slint";
import { LinkWarningDialog } from "screens/preferences-more.slint";
import { FeedbackBridge, ReportIssueDialog } from "screens/feedback.slint";
import { UpdateBridge, UpdateDialog, UpdateNotice } from "screens/updates.slint";
import { PluginBridge, PluginRow, PluginWarningDialog } from "screens/preferences-plugins.slint";
import { TooltipBridge, TooltipLayer } from "widgets/tooltip.slint";
export { WidgetGallery } from "widgets/gallery.slint";
// The Settings window and the preferences it mirrors (src/settings_window.rs).
export { SettingsWindow } from "screens/settings-window.slint";
export { Prefs } from "screens/settings-form.slint";

export { PrintPreviewBridge, InkPlate }

export { PortfolioBridge, PortfolioRow, JavaScriptBridge, DocumentScriptRow, LibraryBridge, LibraryRow, LibraryVersionRow, ActionBridge, ActionRow, ActionStepRow, ActionCommandRow, Theme, ToolCard, ToolSection, ToolTab, ToolOptions, FileItem, PageItem, ResultFile, ContinueTool, RecentFile, HistoryRow, Parse, OcrInfo, OcrLanguage, Picked, ReaderBridge, ReaderState, ReaderOutlineRow, ReaderBookmarkRow, ReaderGridCell, ReaderAnnotRow, ReaderReply, ReaderNote, ReaderMark, ReaderResultRow, ViewerBridge, ViewerPage, ViewerThumb, ViewerOverlay, RedactResult, RedactMarkItem, SignBridge, SignOverlay, EditBridge, EditOverlay }

export { PlatformBridge, SpellIssue, ShortcutRow, Launcher, DictionaryRow }
export { AiBridge, AiMessage }
export { SettingsBridge, FeedbackBridge, UpdateBridge }
export { PluginBridge, PluginRow }
export { HomeBridge }

// Home's pages. Settings is its own window (⌘,, DESIGN §5.8), not a page.
export enum Page { recents, favourites, library, history, actions, all-tools }

// Home's source list (DESIGN §5.1): 220 wide in the chrome material, a hairline on its edge; rows
// 28 tall from 16 under the tab strip, Help at the bottom. No Settings row (⌘, and the menu bar).
// Icons only in a narrow window, each name in a tooltip.
component Sidebar inherits Rectangle {
    in-out property <Page> page;
    in property <bool> collapsed;
    callback help();

    width: collapsed ? HomeMetrics.source-collapsed : HomeMetrics.source-width;
    background: Theme.chrome;
    accessible-role: list;
    accessible-label: @tr("Home");

    VerticalLayout {
        padding: Space.sm;
        padding-top: Space.lg;
        spacing: HomeMetrics.source-row-pitch - Theme.row-height;
        alignment: start;
        SourceRow {
            icon: @image-url("icons/clock.svg");
            text: @tr("Recents");
            collapsed: root.collapsed;
            selected: root.page == Page.recents;
            clicked => { root.page = Page.recents; }
        }
        SourceRow {
            icon: @image-url("icons/star.svg");
            text: @tr("Favourites");
            collapsed: root.collapsed;
            selected: root.page == Page.favourites;
            clicked => { root.page = Page.favourites; }
        }
        SourceRow {
            icon: @image-url("icons/folder.svg");
            text: @tr("Library");
            collapsed: root.collapsed;
            selected: root.page == Page.library;
            clicked => { root.page = Page.library; }
        }
        SourceRow {
            icon: @image-url("icons/list.svg");
            text: @tr("Tasks");
            collapsed: root.collapsed;
            selected: root.page == Page.history;
            clicked => { root.page = Page.history; }
        }
        SourceRow {
            icon: @image-url("icons/zap.svg");
            text: @tr("Actions");
            collapsed: root.collapsed;
            selected: root.page == Page.actions;
            clicked => { root.page = Page.actions; }
        }
        SourceRow {
            icon: @image-url("icons/layout-grid.svg");
            text: @tr("All Tools");
            collapsed: root.collapsed;
            selected: root.page == Page.all-tools;
            clicked => { root.page = Page.all-tools; }
        }
    }
    VerticalLayout {
        padding: Space.sm;
        padding-bottom: Space.lg;
        alignment: end;
        SourceRow {
            icon: @image-url("icons/circle-help.svg");
            text: @tr("Help");
            collapsed: root.collapsed;
            clicked => { root.help(); }
        }
    }

    Rectangle {
        // Right to left the list is on the right: its hairline on its left.
        x: PlatformBridge.rtl ? 0 : parent.width - 1px;
        width: 1px;
        background: Theme.hairline;
    }
}

export component AppWindow inherits Window {
    in-out property <Page> page: Page.recents;
    in-out property <[ToolSection]> sections;
    in property <[ToolCard]> all-tools;
    // Tools page search: the tools found for what is typed, best first.
    in property <[ToolCard]> tool-results;
    // Starred tools, and starring one.
    in property <[ToolCard]> favourite-tools;
    callback star-tool(string);
    callback tool-query(string) -> string;
    // All Tools' category chip: -1 = every category, else its index. Kept across page switches.
    in-out property <int> tools-sort: -1;

    // Tool tabs; active-tab is an index into `tabs`, -1 = Home.
    in property <[ToolTab]> tabs;
    // The bar's order: rows of `tabs` as the bar shows them (a dragged tab moves only here).
    in property <[int]> tab-order;
    in-out property <int> active-tab: -1;

    // Password dialog
    in property <bool> pw-visible;
    in property <string> pw-file;
    // A certificate-encrypted file: the digital ID that opens it, and why the last try failed.
    in property <bool> pw-certificate;
    in property <string> pw-id;
    in property <string> pw-error;
    callback pw-choose-id();
    in property <bool> pw-wrong;
    in property <int> pw-attempt;
    // Closing a tab with a running job
    in property <bool> confirm-visible;
    in property <string> launch-name;
    callback launch-answer(bool);
    in property <string> unsaved-file;
    in property <int> unsaved-redact-marks;
    callback unsaved-answer(int);
    // Bottom-centre toast
    in property <string> toast-text;
    // The toast's action word ("Undo"), "" for none; clicked.
    in-out property <string> toast-action;
    callback toast-undo();
    // Files dragged over the window: what a drop would do ("" when nothing is dragged); a drop
    // the tab refuses is told in the warning colour.
    in property <string> drop-hint;
    in property <bool> drop-refused;
    in-out property <bool> toast-visible;

    // Recents, history, preferences
    in property <[RecentFile]> recents;
    in property <[HistoryRow]> history;
    in property <int> theme-pref;
    in property <int> backdrop-pref;
    in property <int> page-theme;
    in property <int> output-mode;
    in property <string> fixed-folder;
    in property <bool> open-after;
    in property <string> author-name;
    in property <int> default-zoom;
    in property <int> stamp-date;
    callback set-stamp-date(int);
    in property <bool> metric;
    callback set-metric(bool);
    in property <int> guide-colour;
    callback set-guide-colour(int);
    in property <bool> gpu: true;
    callback set-gpu(bool);
    in property <bool> show-boxes;
    in property <bool> physical-numbers;
    in property <bool> transparency-grid;
    callback set-page-display(int, bool);
    in property <[string]> digital-ids;
    in property <[string]> trusted-certs;
    callback signature-prefs(int, int);
    callback create-digital-id(string, string, string, string, string, string, string, bool);
    callback make-default();
    callback set-default-zoom(int);
    in property <int> default-spread;
    callback set-default-spread(int);
    in property <bool> open-first-page;
    callback set-open-first-page(bool);
    // Preferences ▸ Rendering: text, line art and images smoothed.
    in property <[bool]> smooth: [true, true, true];
    callback set-smoothing(int, bool);
    in property <string> display-profile;
    callback choose-display-profile();
    callback reset-display-profile();
    in property <string> author-default;
    property <bool> confirm-clear;
    // The Settings window shown on tab k (-1 the last one used; src/settings_window.rs).
    callback open-settings(int);

    callback open-file();
    callback new-blank();
    callback new-from-clipboard();
    callback new-from-screenshot();
    callback new-from-scanner();
    callback new-from-iphone();
    callback pin-recent(int);
    callback filter-recents(string, int);
    callback open-tool(string);
    callback close-tab(int);
    // A tab dragged to another place (from, to), and the tab menu's close others / left / right.
    callback move-tab(int, int);
    // ⇧⌘[ / ⇧⌘]: the next tab along the bar.
    callback step-tab(int);
    // ⌘W anywhere: the tab shown closed.
    callback close-active-tab();
    callback close-tabs-around(int, int);
    callback add-files(int);
    callback open-slot(int, int);
    callback swap-slots(int);
    callback remove-file(int, int);
    callback move-file(int, int, int);
    callback place-file(int, int, int);
    callback sort-files(int);
    callback set-pages(int, int, string);
    pure callback open-doc-count(int) -> int;
    callback add-open-docs(int);
    pure callback open-doc-names(int) -> [string];
    callback add-open-doc-to-slot(int, int, int);
    callback remove-page(int, int);
    callback move-page(int, int, int);
    callback insert-blank(int);
    callback show-merge-pages(int, bool);
    callback crop-preview-step(int, int);
    callback run-tool(int, ToolOptions);
    callback cancel-job(int);
    callback open-output(int, int);
    callback reveal-output(int, int);
    callback open-folder(int);
    callback start-over(int);
    callback continue-to(int, string);
    callback get-libreoffice();
    callback pw-unlock(string);
    callback pw-skip();
    callback confirm-cancel-job();
    callback confirm-keep();
    callback open-recent(int);
    callback open-guide();
    callback reveal-recent(int);
    callback remove-recent(int);
    callback clear-recents();
    callback reveal-history(int);
    callback rerun-history(int);
    callback clear-history();
    callback set-theme(int);
    callback set-accent(int);
    callback set-backdrop(int);
    callback set-page-theme(int);
    callback set-output(int);
    callback choose-folder();
    callback set-open-after(bool);
    callback set-author(string);
    // ⌘, from anywhere: Home ▸ Preferences, out of full screen (a presentation ends with it).
    // A tool tab or Home shown: the app scope takes the keyboard (a reader tab takes it itself), so
    // ⌘, reaches it wherever the user is.
    changed active-tab => { root.take-keys(); }
    changed pw-visible => { if !self.pw-visible { root.take-keys(); } }
    // Acrobat returns keyboard edits to the reader after a custom command palette closes.
    property <bool> custom-tools-visible: ActionBridge.tools-visible;
    changed custom-tools-visible => { if !self.custom-tools-visible { root.take-keys(); } }
    // A shortcut recorded in Preferences: the keyboard back to the window, outside the scrolled page.
    property <bool> recording-keys: PlatformBridge.recording-keys;
    changed recording-keys => { if !self.recording-keys { root.take-keys(); } }
    init => { root.take-keys(); }
    // The keyboard goes where it belongs: the Tools search on Home ▸ Tools, else the app scope (so
    // ⌘, works everywhere); a reader tab and the password dialog take it themselves.
    function take-keys() {
        if root.pw-visible { return; }
        // A reader tab takes the keyboard itself (also after the password dialog it opened with).
        if root.active-tab >= 0 && root.tabs[root.active-tab].is-reader { root.reader-keys += 1; return; }
        if root.active-tab == -1 && root.page == Page.all-tools { root.search-seq += 1; } else { app-keys.focus(); }
    }
    // Bumped to give the shown reader tab the keyboard.
    property <int> reader-keys;
    // Bumped to give the Tools search the keyboard (+ tab, ⌘F).
    property <int> search-seq;
    // Bumped to end any presentation (⌘, leaves it as Escape would).
    property <int> end-presenting;
    property <int> preferences-asked: PlatformBridge.preferences-asked;
    changed preferences-asked => { root.show-preferences(); }
    function show-preferences() {
        root.end-presenting += 1;
        root.full-screen = false;
        root.open-settings(-1);
    }
    // Home page switched: refresh relative times and missing files.
    callback page-shown();
    changed page => { root.page-shown(); root.take-keys(); }

    title: "Sheaf";
    // Windows and Linux taskbars (macOS takes the bundle's icon).
    icon: @image-url("../macos/icon.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;
    default-font-size: Theme.fs-body;

    // The menu bar (Linux and Windows draw it in the window; macOS puts it at the top of the
    // screen), as Acrobat's and Preview's menus: every command with its shortcut. The shortcuts
    // are the user's (Preferences ▸ Keyboard): `PlatformBridge.keys[i]` is src/platform.rs
    // COMMANDS[i]. A command that does not apply where the user is stays disabled, so its keys
    // go on to the field or page that has the keyboard.
    property <bool> reader-on: root.active-tab >= 0 && root.active-tab < root.tabs.length && root.tabs[root.active-tab].is-reader;
    property <int> reader-id: root.reader-on ? root.tabs[root.active-tab].id : -1;
    // The shown document's inspector is open (View ▸ Show / Hide Inspector).
    property <bool> inspector-shown: root.reader-on && root.tabs[root.active-tab].reader.inspector-open;
    // A command run by the reader tab shown itself (Find, Go to Page, Present).
    property <int> menu-seq;
    property <string> menu-command;
    function reader-command(c: string) {
        root.menu-command = c;
        root.menu-seq += 1;
    }
    MenuBar {
        visible: PlatformBridge.menu-bar && !root.full-screen;
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New Blank PDF…"); shortcut: PlatformBridge.keys[0]; activated => { root.new-blank(); } }
            MenuItem { title: @tr("Open…"); shortcut: PlatformBridge.keys[1]; activated => { root.open-file(); } }
            Menu {
                title: @tr("Open Recent");
                enabled: root.recents.length > 0;
                for r[i] in root.recents: MenuItem {
                    title: r.name;
                    activated => { root.open-recent(i); }
                }
            }
            MenuSeparator {}
            // Preview's File ▸ Import from iPhone or iPad (Continuity Camera) and Import from Scanner.
            if PlatformBridge.mac: MenuItem { title: @tr("Import from iPhone or iPad…"); activated => { root.new-from-iphone(); } }
            if PlatformBridge.mac: MenuItem { title: @tr("Import from Scanner…"); activated => { root.new-from-scanner(); } }
            if PlatformBridge.mac: MenuSeparator {}
            MenuItem { title: @tr("Save"); shortcut: PlatformBridge.keys[2]; enabled: root.reader-on; activated => { ReaderBridge.save(root.reader-id); } }
            MenuItem { title: @tr("Save As…"); shortcut: PlatformBridge.keys[3]; enabled: root.reader-on; activated => { ReaderBridge.save-as(root.reader-id); } }
            Menu {
                title: @tr("Export To");
                enabled: root.reader-on;
                for t in [{ n: @tr("Word…"), k: "pdf_to_word" }, { n: @tr("Excel…"), k: "pdf_to_excel" }, { n: @tr("PowerPoint…"), k: "pdf_to_powerpoint" }, { n: @tr("Images…"), k: "pdf_to_jpg" }, { n: @tr("Text or HTML…"), k: "pdf_to_text" }, { n: @tr("PDF/A…"), k: "pdf_to_pdfa" }]: MenuItem {
                    title: t.n;
                    enabled: root.reader-on;
                    activated => { ReaderBridge.tool-pick(root.reader-id, t.k); }
                }
            }
            MenuItem { title: @tr("Print…"); shortcut: PlatformBridge.keys[4]; enabled: root.reader-on; activated => { ReaderBridge.print-open(root.reader-id); } }
            MenuItem { title: @tr("Document Properties…"); shortcut: PlatformBridge.keys[5]; enabled: root.reader-on; activated => { ReaderBridge.props-open(root.reader-id); } }
            MenuSeparator {}
            MenuItem { title: @tr("Close Tab"); shortcut: PlatformBridge.keys[6]; enabled: root.active-tab >= 0; activated => { if root.reader-on { ReaderBridge.close(root.reader-id); } else { root.close-active-tab(); } } }
            // A Mac's Quit is the app menu's.
            if !PlatformBridge.mac: MenuItem { title: @tr("Quit Sheaf"); shortcut: PlatformBridge.keys[7]; activated => { PlatformBridge.quit(); } }
        }
        Menu {
            title: @tr("Edit");
            // Undo and Redo, Cut, Copy, Paste, Select All: sent as their keys to what has the keyboard,
            // a text field (its own text) or the reader's pages (the PDF; src/platform.rs EDIT_KEYS).
            MenuItem { title: @tr("Undo"); shortcut: PlatformBridge.keys[8]; activated => { PlatformBridge.edit-key("z", false); } }
            MenuItem { title: @tr("Redo"); shortcut: PlatformBridge.keys[9]; activated => { PlatformBridge.edit-key("z", true); } }
            MenuSeparator {}
            // Sent as their keys to what has the keyboard: a text field, or the reader's pages (src/platform.rs EDIT_KEYS).
            MenuItem { title: @tr("Cut"); shortcut: PlatformBridge.keys[40]; activated => { PlatformBridge.edit-key("x", false); } }
            MenuItem { title: @tr("Copy"); shortcut: PlatformBridge.keys[41]; activated => { PlatformBridge.edit-key("c", false); } }
            MenuItem { title: @tr("Paste"); shortcut: PlatformBridge.keys[42]; activated => { PlatformBridge.edit-key("v", false); } }
            MenuItem { title: @tr("Select All"); shortcut: PlatformBridge.keys[10]; activated => { PlatformBridge.edit-key("a", false); } }
            MenuSeparator {}
            MenuItem { title: @tr("Find…"); shortcut: PlatformBridge.keys[11]; enabled: root.reader-on || (root.active-tab == -1 && root.page == Page.all-tools); activated => { if root.reader-on { root.reader-command("find"); } else { root.search-seq += 1; } } }
            MenuItem { title: @tr("Find Next"); shortcut: PlatformBridge.keys[12]; enabled: root.reader-on; activated => { ReaderBridge.search-step(root.reader-id, 1); } }
            MenuItem { title: @tr("Find Previous"); shortcut: PlatformBridge.keys[13]; enabled: root.reader-on; activated => { ReaderBridge.search-step(root.reader-id, -1); } }
            MenuSeparator {}
            MenuItem { title: @tr("Check Spelling…"); shortcut: PlatformBridge.keys[43]; enabled: root.reader-on; activated => { PlatformBridge.check-start(root.reader-id); } }
            MenuItem { title: PlatformBridge.grammar-on ? @tr("Stop Checking Grammar With Spelling") : @tr("Check Grammar With Spelling"); shortcut: PlatformBridge.keys[44]; activated => { PlatformBridge.set-grammar-on(!PlatformBridge.grammar-on); } }
            MenuItem { title: PlatformBridge.spell-on ? @tr("Stop Checking Spelling While Typing") : @tr("Check Spelling While Typing"); shortcut: PlatformBridge.keys[14]; activated => { PlatformBridge.set-spell-on(!PlatformBridge.spell-on); } }
            // A Mac's is Settings… in the app menu (src/mac_menu.rs).
            if !PlatformBridge.mac: MenuSeparator {}
            if !PlatformBridge.mac: MenuItem { title: @tr("Settings…"); shortcut: PlatformBridge.keys[15]; activated => { root.show-preferences(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Zoom In"); shortcut: PlatformBridge.keys[16]; enabled: root.reader-on; activated => { if PlatformBridge.shift-held() && !PlatformBridge.rebound[16] /* zoom-in */ && !PlatformBridge.rebound[23] /* rotate-right */ { ReaderBridge.rotate-view(root.reader-id, 1); } else { ViewerBridge.zoom-step(root.reader-id, 1); } } }
            MenuItem { title: @tr("Zoom Out"); shortcut: PlatformBridge.keys[17]; enabled: root.reader-on; activated => { ViewerBridge.zoom-step(root.reader-id, -1); } }
            MenuItem { title: @tr("Actual Size"); shortcut: PlatformBridge.keys[18]; enabled: root.reader-on; activated => { ReaderBridge.zoom-fit(root.reader-id, 2); } }
            MenuItem { title: @tr("Zoom to Fit Page"); shortcut: PlatformBridge.keys[19]; enabled: root.reader-on; activated => { ReaderBridge.zoom-fit(root.reader-id, 1); } }
            MenuItem { title: @tr("Zoom to Fit Width"); shortcut: PlatformBridge.keys[20]; enabled: root.reader-on; activated => { ReaderBridge.zoom-fit(root.reader-id, 0); } }
            MenuSeparator {}
            // Show / Hide labels follow the state (BAMA menus.md); the sidebar's tabs ⌥⌘1…6.
            MenuItem { title: root.reader-on && root.tabs[root.active-tab].reader.panel-open ? @tr("Hide Sidebar") : @tr("Show Sidebar"); shortcut: PlatformBridge.keys[21]; enabled: root.reader-on; activated => { ReaderBridge.toggle-panel(root.reader-id); } }
            MenuItem { title: root.reader-on && root.inspector-shown ? @tr("Hide Inspector") : @tr("Show Inspector"); shortcut: PlatformBridge.keys[45]; enabled: root.reader-on; activated => { root.reader-command("inspector"); } }
            Menu {
                title: @tr("Sidebar");
                enabled: root.reader-on;
                MenuItem { title: @tr("Thumbnails"); shortcut: PlatformBridge.keys[46]; enabled: root.reader-on; activated => { ReaderBridge.set-panel(root.reader-id, 0); } }
                MenuItem { title: @tr("Outline"); shortcut: PlatformBridge.keys[47]; enabled: root.reader-on; activated => { ReaderBridge.set-panel(root.reader-id, 1); } }
                MenuItem { title: @tr("Bookmarks"); shortcut: PlatformBridge.keys[48]; enabled: root.reader-on; activated => { ReaderBridge.set-panel(root.reader-id, 6); } }
                MenuItem { title: @tr("Annotations"); shortcut: PlatformBridge.keys[49]; enabled: root.reader-on; activated => { ReaderBridge.set-panel(root.reader-id, 2); } }
                MenuItem { title: @tr("Attachments"); shortcut: PlatformBridge.keys[50]; enabled: root.reader-on; activated => { ReaderBridge.set-panel(root.reader-id, 4); } }
                MenuItem { title: @tr("Layers"); shortcut: PlatformBridge.keys[51]; enabled: root.reader-on; activated => { ReaderBridge.set-panel(root.reader-id, 5); } }
            }
            MenuSeparator {}
            Menu {
                title: @tr("Page Display");
                enabled: root.reader-on;
                MenuItem { title: @tr("Next Page Layout"); shortcut: PlatformBridge.keys[22]; enabled: root.reader-on; activated => { ReaderBridge.cycle-spread(root.reader-id); } }
                MenuItem { title: @tr("Rotate View Clockwise"); shortcut: PlatformBridge.keys[23]; enabled: root.reader-on; activated => { ReaderBridge.rotate-view(root.reader-id, 1); } }
                MenuItem { title: @tr("Rotate View Counterclockwise"); shortcut: PlatformBridge.keys[24]; enabled: root.reader-on; activated => { ReaderBridge.rotate-view(root.reader-id, -1); } }
            }
            Menu {
                title: @tr("Page Theme");
                enabled: root.reader-on;
                MenuItem { title: @tr("Day"); shortcut: PlatformBridge.keys[53]; enabled: root.reader-on; activated => { ReaderBridge.set-theme(root.reader-id, 0); } }
                MenuItem { title: @tr("Sepia"); shortcut: PlatformBridge.keys[54]; enabled: root.reader-on; activated => { ReaderBridge.set-theme(root.reader-id, 2); } }
                MenuItem { title: @tr("Night"); shortcut: PlatformBridge.keys[55]; enabled: root.reader-on; activated => { ReaderBridge.set-theme(root.reader-id, 1); } }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Full Screen"); shortcut: PlatformBridge.keys[25]; activated => { root.full-screen = !root.full-screen; } }
            MenuItem { title: @tr("Present"); shortcut: PlatformBridge.keys[26]; enabled: root.reader-on; activated => { root.reader-command("present"); } }
        }
        Menu {
            title: @tr("Go");
            MenuItem { title: @tr("Previous Page"); shortcut: PlatformBridge.keys[27]; enabled: root.reader-on; activated => { ReaderBridge.page-step(root.reader-id, -1); } }
            MenuItem { title: @tr("Next Page"); shortcut: PlatformBridge.keys[28]; enabled: root.reader-on; activated => { ReaderBridge.page-step(root.reader-id, 1); } }
            MenuItem { title: @tr("First Page"); shortcut: PlatformBridge.keys[29]; enabled: root.reader-on; activated => { ReaderBridge.page-step(root.reader-id, -10); } }
            MenuItem { title: @tr("Last Page"); shortcut: PlatformBridge.keys[30]; enabled: root.reader-on; activated => { ReaderBridge.page-step(root.reader-id, 10); } }
            MenuItem { title: @tr("Go to Page…"); shortcut: PlatformBridge.keys[31]; enabled: root.reader-on; activated => { root.reader-command("go-to-page"); } }
            MenuSeparator {}
            MenuItem { title: @tr("Back"); shortcut: PlatformBridge.keys[32]; enabled: root.reader-on; activated => { ReaderBridge.history(root.reader-id, -1); } }
            MenuItem { title: @tr("Forward"); shortcut: PlatformBridge.keys[33]; enabled: root.reader-on; activated => { ReaderBridge.history(root.reader-id, 1); } }
            MenuSeparator {}
            // PDF Expert's page bookmark (the sidebar's Bookmarks tab): the page in view, on or off.
            MenuItem { title: @tr("Add Bookmark"); shortcut: PlatformBridge.keys[52]; enabled: root.reader-on; activated => { ReaderBridge.bookmark-op(root.reader-id, 0, -1); } }
        }
        // The modes' menus (DESIGN §1: Annotate, Edit PDF, Forms, Pages, Protect, then Tools), most
        // general first. Items that need a document stay visible and disabled without one. The
        // reader's tool letters are not menu shortcuts (typing keeps them).
        Menu {
            title: @tr("Annotate");
            for t in [{ n: @tr("Select"), k: 0 }, { n: @tr("Highlight"), k: 1 }, { n: @tr("Underline"), k: 2 }, { n: @tr("Strikethrough"), k: 3 }, { n: @tr("Note"), k: 4 }, { n: @tr("Text Box"), k: 6 }, { n: @tr("Pen"), k: 5 }, { n: @tr("Eraser"), k: 11 }, { n: @tr("Shapes"), k: 10 }, { n: @tr("Stamp"), k: 12 }, { n: @tr("Link"), k: 13 }]: MenuItem {
                title: t.n;
                enabled: root.reader-on;
                activated => { ReaderBridge.set-tool(root.reader-id, t.k); }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Export Annotation Summary…"); enabled: root.reader-on; activated => { ReaderBridge.notes-action(root.reader-id, 1); } }
        }
        Menu {
            title: @tr("Edit PDF");
            MenuItem { title: @tr("Edit Text and Images"); enabled: root.reader-on; activated => { ReaderBridge.set-tool(root.reader-id, 7); } }
            MenuItem { title: @tr("Add Image"); enabled: root.reader-on; activated => { ReaderBridge.set-tool(root.reader-id, 8); } }
            MenuItem { title: @tr("Add Link"); enabled: root.reader-on; activated => { ReaderBridge.set-tool(root.reader-id, 13); } }
            MenuSeparator {}
            // One-run tools of the Tools popover: their options open in the inspector.
            MenuItem { title: @tr("Page Numbers, Header and Footer…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "page_numbers"); } }
            MenuItem { title: @tr("Add Watermark…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "watermark"); } }
            MenuItem { title: @tr("Adjust Colours…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "adjust_colours"); } }
            MenuItem { title: @tr("Crop Pages…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "crop"); } }
            MenuItem { title: @tr("Background…"); enabled: root.reader-on; activated => { ReaderBridge.background-open(root.reader-id); } }
        }
        Menu {
            title: @tr("Forms");
            MenuItem { title: @tr("Sign"); enabled: root.reader-on; activated => { ReaderBridge.set-tool(root.reader-id, 9); } }
            MenuItem { title: @tr("Prepare Form"); enabled: root.reader-on; activated => { ReaderBridge.set-tool(root.reader-id, 14); } }
            MenuItem { title: @tr("Detect Form Fields"); enabled: root.reader-on; activated => { ReaderBridge.detect-fields(root.reader-id); } }
            MenuSeparator {}
            MenuItem { title: @tr("Clear Form"); enabled: root.reader-on; activated => { ReaderBridge.form-op(root.reader-id, 0); } }
            MenuItem { title: @tr("Flatten Fields"); enabled: root.reader-on; activated => { ReaderBridge.form-op(root.reader-id, 1); } }
            MenuItem { title: @tr("Flatten Fields and Comments"); enabled: root.reader-on; activated => { ReaderBridge.form-op(root.reader-id, 2); } }
            MenuSeparator {}
            MenuItem { title: @tr("Sign with Certificate…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "sign"); } }
            MenuItem { title: @tr("Manage Signatures…"); enabled: root.reader-on; activated => { ReaderBridge.signature-manager(root.reader-id); } }
        }
        Menu {
            title: @tr("Pages");
            MenuItem { title: @tr("Show All Pages"); enabled: root.reader-on; activated => { ReaderBridge.toggle-grid(root.reader-id); } }
            MenuSeparator {}
            MenuItem { title: @tr("Rotate Left"); enabled: root.reader-on; activated => { ReaderBridge.page-op(root.reader-id, 0); } }
            MenuItem { title: @tr("Rotate Right"); enabled: root.reader-on; activated => { ReaderBridge.page-op(root.reader-id, 1); } }
            MenuItem { title: @tr("Duplicate Page"); enabled: root.reader-on; activated => { ReaderBridge.page-op(root.reader-id, 3); } }
            MenuItem { title: @tr("Insert Blank Page"); enabled: root.reader-on; activated => { ReaderBridge.page-op(root.reader-id, 5); } }
            MenuItem { title: @tr("Delete Page"); enabled: root.reader-on; activated => { ReaderBridge.page-op(root.reader-id, 2); } }
            MenuSeparator {}
            MenuItem { title: @tr("Extract Pages…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "extract_pages"); } }
            MenuItem { title: @tr("Remove Pages…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "remove_pages"); } }
            MenuItem { title: @tr("Split…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "split"); } }
            MenuItem { title: @tr("Rotate All Pages…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "rotate"); } }
        }
        Menu {
            title: @tr("Protect");
            MenuItem { title: @tr("Set Password…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "protect"); } }
            MenuItem { title: @tr("Remove Password…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "unlock"); } }
            MenuSeparator {}
            MenuItem { title: @tr("Redact…"); enabled: root.reader-on; activated => { ReaderBridge.redact(root.reader-id); } }
            MenuItem { title: @tr("Sanitize Document"); enabled: root.reader-on; activated => { ReaderBridge.sanitize(root.reader-id); } }
            MenuSeparator {}
            MenuItem { title: @tr("Encrypt with Certificates…"); enabled: root.reader-on; activated => { ReaderBridge.cert-open(root.reader-id); } }
            MenuItem { title: @tr("Security Policies…"); enabled: root.reader-on; activated => { ReaderBridge.policy-open(root.reader-id); } }
        }
        Menu {
            title: @tr("Tools");
            // In a document: the Tools popover (⌘K); on Home: the All Tools page (batch runs).
            MenuItem { title: @tr("All Tools…"); shortcut: PlatformBridge.keys[34]; activated => { if root.reader-on { root.reader-command("tools"); } else { root.active-tab = -1; root.page = Page.all-tools; } } }
            // Every tool of the Tools page, with the keys the user gave it (Settings ▸ Shortcuts,
            // Stirling's tool hotkeys).
            Menu {
                title: @tr("Open Tool");
                // Their keys are not menu shortcuts (those are taken even in a text field): main's
                // key scope answers them, only where no field has the keyboard.
                for t in PlatformBridge.launchers: MenuItem {
                    title: t.label == "" ? t.name : t.name + "    " + t.label;
                    activated => { root.open-tool(t.id); }
                }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Compress…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "compress"); } }
            MenuItem { title: @tr("Recognize Text (OCR)…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "ocr"); } }
            MenuItem { title: @tr("Repair…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "repair"); } }
            MenuItem { title: @tr("Compare…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "compare"); } }
            MenuItem { title: @tr("Export To…"); enabled: root.reader-on; activated => { ReaderBridge.tool-pick(root.reader-id, "pdf_to_word"); } }
            MenuSeparator {}
            MenuItem { title: @tr("Actions"); activated => { ActionBridge.open-page("actions"); } }
            MenuItem { title: @tr("Custom Tools…"); activated => { ActionBridge.command("custom-tools", 0); } }
            Menu {
                title: @tr("Developer");
                MenuItem { title: @tr("JavaScript Console…"); enabled: root.reader-on; activated => { JavaScriptBridge.open(root.reader-id); } }
                MenuItem { title: @tr("Plugins…"); activated => { root.open-settings(3); } }
            }
            MenuItem { title: @tr("Ask AI…"); enabled: root.reader-on; activated => { AiBridge.toggle(root.reader-id); } }
            MenuSeparator {}
            // Starred tools (Home ▸ All Tools' favourites).
            for t in root.favourite-tools: MenuItem {
                title: t.name;
                activated => { root.open-tool(t.id); }
            }
        }
        Menu {
            title: @tr("Window");
            if PlatformBridge.mac: MenuItem { title: @tr("Minimize"); shortcut: @keys(Control + "m"); activated => { PlatformBridge.minimize(); } }
            if PlatformBridge.mac: MenuItem { title: @tr("Zoom"); activated => { PlatformBridge.zoom(); } }
            if PlatformBridge.mac: MenuSeparator {}
            MenuItem { title: @tr("Next Tab"); shortcut: PlatformBridge.keys[35]; enabled: root.tabs.length > 0; activated => { root.step-tab(1); } }
            MenuItem { title: @tr("Previous Tab"); shortcut: PlatformBridge.keys[36]; enabled: root.tabs.length > 0; activated => { root.step-tab(-1); } }
            MenuItem { title: @tr("Home"); shortcut: PlatformBridge.keys[37]; activated => { root.active-tab = -1; } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("Keyboard Shortcuts"); shortcut: PlatformBridge.keys[38]; enabled: root.reader-on; activated => { ReaderBridge.show-help(root.reader-id, true); } }
            MenuItem { title: @tr("Customize Shortcuts…"); shortcut: PlatformBridge.keys[39]; activated => { root.open-settings(5); } }
            // PDF Expert's Welcome document and Acrobat's Help: how to use Sheaf, in a tab.
            MenuItem { title: @tr("Sheaf Guide"); activated => { root.open-guide(); } }
            // iLovePDF's Contact us: a problem or an idea, saved or opened as an issue.
            MenuItem { title: @tr("Report an Issue…"); activated => { FeedbackBridge.subject = 0; FeedbackBridge.open = true; } }
            // iLovePDF's and Acrobat's Check for Updates (a Mac's is in the app menu: src/mac_menu.rs).
            if !PlatformBridge.mac: MenuSeparator {}
            if !PlatformBridge.mac: MenuItem { title: @tr("Check for Updates…"); activated => { UpdateBridge.check(); } }
        }
    }

    // App-wide keys (macOS conventions), reached from anywhere a focused control does not take them:
    // ⌘, Preferences, ⌘O Open, ⌘W close the tab shown, ⌃Tab and ⌃⇧Tab the next and previous tab, as
    // browsers and PDF Expert do (⌘8 and ⌘9 stay the reader's zooms).
    app-keys := FocusScope {
        // Its own keyboard: no field has it (a field closed while focused said nothing).
        changed has-focus => { if self.has-focus { PlatformBridge.typing = false; } }
        key-pressed(e) => {
            // A Tools page tool's keys, unless a text field has the keyboard (it lets Ctrl and Alt
            // keys go by, but no tool opens while typing, as in Stirling).
            if !PlatformBridge.typing && PlatformBridge.launcher-for(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta) != "" {
                root.open-tool(PlatformBridge.launcher-for(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta));
                return accept;
            }
            // Menu commands too: only while they keep their own keys (see reader.slint).
            if e.modifiers.control && e.text == "," && !PlatformBridge.rebound[15] /* preferences */ { root.show-preferences(); return accept; }
            if e.modifiers.control && (e.text == "o" || e.text == "O") && !PlatformBridge.rebound[1] /* open */ { root.open-file(); return accept; }
            if e.modifiers.control && (e.text == "w" || e.text == "W") && root.active-tab >= 0 && !PlatformBridge.rebound[6] /* close */ { root.close-active-tab(); return accept; }
            if e.text == Key.Tab && e.modifiers.control && (e.modifiers.shift ? !PlatformBridge.rebound[36] /* previous-tab */ : !PlatformBridge.rebound[35] /* next-tab */) { root.step-tab(e.modifiers.shift ? -1 : 1); return accept; }
            // ⌘F on the Tools page: its search.
            if e.modifiers.control && e.text == "f" && root.active-tab == -1 && root.page == Page.all-tools && !PlatformBridge.rebound[11] /* find */ { root.search-seq += 1; return accept; }
            reject
        }
        VerticalLayout {
            TabBar {
                tabs: root.tabs;
                order: root.tab-order;
                active <=> root.active-tab;
                close-tab(id) => { root.close-tab(id); }
                move-tab(from, to) => { root.move-tab(from, to); }
                close-tabs-around(id, which) => { root.close-tabs-around(id, which); }
                new-tab => {
                    root.active-tab = -1;
                    root.page = Page.all-tools;
                    // Already on Tools: neither change fires, the search still takes the keyboard.
                    root.take-keys();
                }
            }
            Rectangle {
                vertical-stretch: 1;
                // Home
                Rectangle {
                    visible: root.active-tab == -1;
                    sidebar := Sidebar {
                        // Right to left (Preferences ▸ Direction, iLovePDF's): on the right.
                        x: PlatformBridge.rtl ? parent.width - self.width : 0;
                        height: parent.height;
                        page <=> root.page;
                        collapsed: root.width < HomeMetrics.collapse-below;
                        help => { root.open-guide(); }
                    }
                    Rectangle {
                        x: PlatformBridge.rtl ? 0 : sidebar.width;
                        width: parent.width - sidebar.width;
                        height: parent.height;
                        if root.page == Page.recents: RecentsScreen {
                            recents: root.recents;
                            favourite-tools: root.favourite-tools;
                            drag-over: root.drop-hint != "" && !root.drop-refused;
                            open-tool(id) => { root.open-tool(id); }
                            star(id) => { root.star-tool(id); }
                            view-all => { root.page = Page.all-tools; }
                            open-file => { root.open-file(); }
                            new-blank => { root.new-blank(); }
                            new-from-clipboard => { root.new-from-clipboard(); }
                            new-from-screenshot => { root.new-from-screenshot(); }
                            new-from-scanner => { root.new-from-scanner(); }
                            new-from-iphone => { root.new-from-iphone(); }
                            open-recent(i) => { root.open-recent(i); }
                            reveal-recent(i) => { root.reveal-recent(i); }
                            remove-recent(i) => { root.remove-recent(i); }
                            clear-recents => { root.clear-recents(); }
                            pin-recent(i) => { root.pin-recent(i); }
                            filter-recents(q, o) => { root.filter-recents(q, o); }
                        }
                        if root.page == Page.favourites: FavouritesScreen {
                            recents: root.recents;
                            favourite-tools: root.favourite-tools;
                            open-tool(id) => { root.open-tool(id); }
                            star(id) => { root.star-tool(id); }
                            open-recent(i) => { root.open-recent(i); }
                            reveal-recent(i) => { root.reveal-recent(i); }
                            remove-recent(i) => { root.remove-recent(i); }
                            pin-recent(i) => { root.pin-recent(i); }
                            filter-recents(q, o) => { root.filter-recents(q, o); }
                        }
                        if root.page == Page.all-tools: ToolsScreen {
                            focus-seq: root.search-seq;
                            sections <=> root.sections;
                            all-tools: root.all-tools;
                            sort <=> root.tools-sort;
                            open-tool(id) => { root.open-tool(id); }
                            results: root.tool-results;
                            query(q) => { return root.tool-query(q); }
                            star(id) => { root.star-tool(id); }
                            favourites: root.favourite-tools;
                        }
                        if root.page == Page.actions: ActionsScreen { }
                        if root.page == Page.library: LibraryScreen { }
                        if root.page == Page.history: HistoryScreen {
                            rows: root.history;
                            reveal(i) => { root.reveal-history(i); }
                            rerun(i) => { root.rerun-history(i); }
                            ask-clear => { root.confirm-clear = true; }
                        }
                    }
                }
                // Tool tabs: one instance each, so their options survive tab switches.
                for t[i] in root.tabs: Rectangle {
                    visible: root.active-tab == i;
                    if t.is-reader: ReaderScreen {
                        tab: t;
                        active: root.active-tab == i;
                        is-full-screen: root.full-screen;
                    end-presenting: root.end-presenting;
                    take-keys: root.reader-keys;
                        menu-seq: root.menu-seq;
                        menu-command: root.menu-command;
                        full-screen(on) => { root.full-screen = on; }
                        open-preferences => { root.show-preferences(); }
                        switch-tab(d) => { root.step-tab(d); }
                    }
                    if !t.is-reader: ToolFlowScreen {
                        visible: t.phase < 2;
                        tab: t;
                        open-files => { root.add-files(t.id); }
                        remove-file(uid) => { root.remove-file(t.id, uid); }
                        move-file(uid, d) => { root.move-file(t.id, uid, d); }
                        place-file(uid, k) => { root.place-file(t.id, uid, k); }
                        sort-files => { root.sort-files(t.id); }
                        set-pages(uid, text) => { root.set-pages(t.id, uid, text); }
                        open-doc-count => { root.open-doc-count(t.id) }
                        add-open-docs => { root.add-open-docs(t.id); }
                        open-doc-names => { root.open-doc-names(t.id) }
                        add-open-doc-to-slot(slot, i) => { root.add-open-doc-to-slot(t.id, slot, i); }
                        remove-page(k) => { root.remove-page(t.id, k); }
                        move-page(k, d) => { root.move-page(t.id, k, d); }
                        insert-blank => { root.insert-blank(t.id); }
                        show-merge-pages(on) => { root.show-merge-pages(t.id, on); }
                        crop-preview-step(d) => { root.crop-preview-step(t.id, d); }
                        run(o) => { root.run-tool(t.id, o); }
                        cancel => { root.cancel-job(t.id); }
                        get-libreoffice => { root.get-libreoffice(); }
                        open-slot(k) => { root.open-slot(t.id, k); }
                        swap-slots => { root.swap-slots(t.id); }
                    }
                    if t.phase == 2: ResultScreen {
                        tab: t;
                        open-output(k) => { root.open-output(t.id, k); }
                        reveal-output(k) => { root.reveal-output(t.id, k); }
                        open-folder => { root.open-folder(t.id); }
                        start-over => { root.start-over(t.id); }
                        continue-to(tool) => { root.continue-to(t.id, tool); }
                    }
                }
            }
        }
    }

    // The window as a drop zone while files are dragged over it (iLovePDF's and PDF Expert's).
    if root.drop-hint != "": Rectangle {
        background: (root.drop-refused ? Theme.warning : Theme.accent).transparentize(90%);
        border-width: 2px;
        border-color: root.drop-refused ? Theme.warning : Theme.accent;
        border-radius: Theme.radius-card;
        Rectangle {
            width: hint.preferred-width + 32px;
            height: 40px;
            border-radius: 20px;
            background: root.drop-refused ? Theme.warning : Theme.accent;
            hint := Text {
                text: root.drop-hint;
                font-size: Theme.fs-label;
                font-weight: Theme.weight-demibold;
                color: Theme.on-accent;
            }
        }
    }
    if HomeBridge.customizing && root.active-tab == -1: CustomizeHomeSheet { }
    // Bottom centre, 20 above the edge (DESIGN §5.10); "Undo" when the action can be undone.
    if root.toast-visible: ToastView {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 20px;
        width: min(self.preferred-width, parent.width - 40px);
        text: root.toast-text;
        action: root.toast-action;
        action-clicked => { root.toast-visible = false; root.toast-undo(); }
    }
    if root.pw-visible: PasswordDialog {
        file-name: root.pw-file;
        wrong: root.pw-wrong;
        attempt: root.pw-attempt;
        certificate: root.pw-certificate;
        id-name: root.pw-id;
        error-text: root.pw-error;
        choose-id => { root.pw-choose-id(); }
        unlock(pw) => { root.pw-unlock(pw); }
        skip => { root.pw-skip(); }
    }
    if root.confirm-clear: ClearHistoryDialog {
        clear => {
            root.confirm-clear = false;
            root.clear-history();
        }
        cancel => { root.confirm-clear = false; }
    }
    if root.unsaved-file != "": UnsavedDialog {
        file-name: root.unsaved-file;
        redact-marks: root.unsaved-redact-marks;
        save => { root.unsaved-answer(1); }
        discard => { root.unsaved-answer(2); }
        cancel => { root.unsaved-answer(0); }
    }
    if root.launch-name != "": LaunchFileDialog {
        name: root.launch-name;
        answer(yes) => { root.launch-answer(yes); }
    }
    // Edit ▸ Check Spelling… over the document's comments and fields.
    if PlatformBridge.check-open: SpellingDialog {}
    // A document's web link under Preferences ▸ Security, and Help ▸ Report an Issue.
    if SettingsBridge.ask-url != "": LinkWarningDialog {}
    if FeedbackBridge.open: ReportIssueDialog {}
    // Help ▸ Check for Updates…, and the daily check's notice (bottom right, above the toast's row).
    if UpdateBridge.notice && !UpdateBridge.open: UpdateNotice {
        x: PlatformBridge.rtl ? 20px : parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;
    }
    if UpdateBridge.open: UpdateDialog {}
    // The warning before a plugin runs for the first time.
    if PluginBridge.ask-name != "": PluginWarningDialog {}
    if root.confirm-visible: ConfirmCloseDialog {
        cancel-job => { root.confirm-cancel-job(); }
        keep => { root.confirm-keep(); }
    }
    if ActionBridge.tools-visible: CustomToolsPanel { }
    if ActionBridge.prompt != "": ActionPrompt { }
    if ActionBridge.discard-visible: ActionDiscardPrompt { }
    if JavaScriptBridge.visible: JavaScriptConsole { }
    if PortfolioBridge.visible && !PortfolioBridge.browsing: PortfolioPanel { }
    if PortfolioBridge.visible && PortfolioBridge.browsing: PortfolioBrowser { }
    if LibraryBridge.delete-id != "": LibraryDeletePrompt { }
    // Tooltips above everything (widgets/tooltip.slint): keep it the last child.
    TooltipLayer {}
}
