// Data the Rust side pushes into the tool flow screens.

export struct FileItem {
    uid: int,
    name: string,
    // "3.17 MB - 7 pages"
    info: string,
    thumb: image,
    has-thumb: bool,
    // 0 = PDF, 1 = image, 2 = office / HTML document
    kind: int,
    locked: bool,
    // The preview could not be rendered; the file is still processed.
    preview-failed: bool,
    // Compare: 0 Original, 1 Changed.
    slot: int,
}

// One page of the Organize grid. page 0 = inserted blank page.
export struct PageItem {
    page: int,
    thumb: image,
    has-thumb: bool,
}

// Page viewer: one page in the scrolling content (logical pixels), its render when ready.
export struct ViewerPage {
    x: length,
    y: length,
    w: length,
    h: length,
    image: image,
    ready: bool,
}

// A thumbnail in the viewer's strip.
export struct ViewerThumb {
    page: int,
    y: length,
    h: length,
    image: image,
    ready: bool,
}

// A box drawn over the pages, in content coordinates. kind: 0 marked for redaction,
// 1 search match, 2 the search match being looked at.
export struct ViewerOverlay {
    x: length,
    y: length,
    w: length,
    h: length,
    kind: int,
}

// Reader: an annotation drawn before the page renders with it (a highlight, an underline).
export struct ReaderMark {
    x: length,
    y: length,
    w: length,
    h: length,
    colour: color,
}

// Reader: one search result in the side panel.
export struct ReaderResultRow {
    before: string,
    hit: string,
    after: string,
    page-label: string,
    current: bool,
}

// Reader: one row of the outline panel.
export struct ReaderOutlineRow {
    title: string,
    depth: int,
    page-label: string,
    has-children: bool,
    expanded: bool,
    current: bool,
}

// Reader: one row of the annotations panel.
export struct ReaderAnnotRow {
    kind: string,
    text: string,
    page-label: string,
    colour: color,
    selected: bool,
}

// Reader: the note or text box being typed, in content coordinates.
export struct ReaderNote {
    show: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    // 0 note, 1 text box, 2 a paragraph of the page, 3 new text on the page
    kind: int,
    seq: int,
}

// Reader: everything a document tab shows besides the pages (ToolTab.viewer-*).
export struct ReaderState {
    title: string,
    dirty: bool,
    read-only: string,
    page-count: int,
    // 1-based page under the middle of the view, as typed in the page field.
    page-text: string,
    page-label: string,
    panel-open: bool,
    // 0 thumbnails, 1 outline, 2 annotations, 3 search results
    panel: int,
    outline: [ReaderOutlineRow],
    outline-empty: bool,
    annots: [ReaderAnnotRow],
    // 0 select, 1 highlight, 2 underline, 3 strikethrough, 4 note, 5 pen, 6 text box,
    // 7 edit text, 8 add image
    tool: int,
    colour: int,
    // 0 day, 1 night, 2 sepia
    theme: int,
    backdrop: color,
    // Text selection, search hits and the selected annotation, in content coordinates;
    // kind 3 selection, 4 search hit, 5 current hit, 6 selected annotation.
    marks: [ViewerOverlay],
    provisional: [ReaderMark],
    has-selection: bool,
    selected-text: string,
    selected-annot: bool,
    // The stroke being drawn with the pen, as SVG path commands in content coordinates.
    ink: string,
    ink-colour: color,
    note: ReaderNote,
    search-count: string,
    search-busy: bool,
    can-undo: bool,
    can-redo: bool,
    zoom-mode: int,
    // Pen: 0 fine, 1 medium, 2 thick.
    pen-width: int,
    results: [ReaderResultRow],
    case-sensitive: bool,
    whole-words: bool,
}

// Sign: the signature as placed on a page, in content coordinates, drawn upright in its box.
export struct SignOverlay {
    show: bool,
    x: length,
    y: length,
    w: length,
    h: length,
}

// Edit: one placed item in content coordinates; text is drawn at `font-size` in `color`, an
// image fills its box.
export struct EditOverlay {
    x: length,
    y: length,
    w: length,
    h: length,
    selected: bool,
    is-text: bool,
    text: string,
    font-size: length,
    color: color,
    image: image,
}

// Redact: one search match ("alice@example.com", "Page 2").
export struct RedactResult {
    text: string,
    page: string,
    checked: bool,
}

// Redact: one area marked for redaction.
export struct RedactMarkItem {
    label: string,
    page: string,
}

export struct ResultFile {
    name: string,
    info: string,
    // Compress: "PDF compressed (-29%)"; empty otherwise.
    note: string,
    is-pdf: bool,
    // Not a PDF: "image", "docx", "pptx" or "xlsx" (the card's icon).
    kind: string,
}

export struct ContinueTool {
    id: string,
    name: string,
    icon: image,
    tile: color,
}

export struct ToolTab {
    id: int,
    tool: string,
    name: string,
    icon: image,
    tile: color,
    multi: bool,
    // 0 = choosing files and options, 1 = running, 2 = result
    phase: int,
    progress: float,
    progress-text: string,
    // Cancel pressed, waiting for the job to stop.
    cancelling: bool,
    // Organize: page previews could not be rendered.
    preview-failed: bool,
    files: [FileItem],
    pages: [PageItem],
    office-missing: bool,
    // Every file is probed (page count known, no password pending).
    files-ready: bool,
    default-out: string,
    // Result page
    result-title: string,
    result-sub: string,
    result-pct: string,
    size-before: string,
    size-after: string,
    warning: string,
    // Batch with some failed inputs: "1 file failed:" and one "name — error" line each.
    failure-title: string,
    failures: [string],
    // Things to know about the outputs (PDF/A rules still broken): a heading and one line each.
    notes-title: string,
    notes: [string],
    outputs: [ResultFile],
    // Crop: page 1 of the file, and its displayed size in points.
    preview: image,
    has-preview: bool,
    preview-w: float,
    preview-h: float,
    continue-tools: [ContinueTool],
    // Result page: a check that passed ("Verified: no hidden text remains under the redactions").
    result-verified: string,
    // Page viewer (Redact)
    viewer-pages: [ViewerPage],
    viewer-thumbs: [ViewerThumb],
    viewer-overlays: [ViewerOverlay],
    viewer-width: length,
    viewer-height: length,
    viewer-thumbs-height: length,
    viewer-current: int,
    viewer-zoom: int,
    // "" when the pages are shown; otherwise why not ("Opening…", an error).
    viewer-status: string,
    // Rust asks the viewer to scroll: the position, and a counter bumped on each request.
    viewer-scroll: length,
    viewer-scroll-seq: int,
    // Redact
    redact-searched: bool,
    redact-busy: bool,
    redact-count: string,
    redact-results: [RedactResult],
    redact-marks: [RedactMarkItem],
    // Sign: 0 Type, 1 Draw, 2 Upload; the signature as ink on transparent (black, tinted in the
    // panel); one is made; the uploaded image's name; 0 small, 1 medium, 2 large; where it is.
    sign-mode: int,
    sign-preview: image,
    sign-has-graphic: bool,
    sign-image-name: string,
    sign-size: int,
    sign-placed: bool,
    sign-page: int,
    sign-overlay: SignOverlay,
    // Edit: 0 Add text, 1 Add image; items placed; the selection (0 none, 1 text, 2 image), its
    // page (1-based) and a counter bumped when it changes; the selected text; text size in
    // points and colour (0 black, 1 grey, 2 red, 3 blue) for the selection and the next text;
    // image width (0 small, 1 medium, 2 large); the image chosen; every item is ready.
    edit-mode: int,
    edit-count: int,
    edit-selected: int,
    edit-selected-page: int,
    edit-selected-seq: int,
    edit-text: string,
    edit-size: int,
    edit-colour: int,
    edit-width: int,
    edit-image-name: string,
    edit-ready: bool,
    // Why the action can't run yet (an empty or undrawable text), "" when it can.
    edit-problem: string,
    edit-overlays: [EditOverlay],
    // Reader (a document tab): see screens/reader.slint.
    is-reader: bool,
    reader: ReaderState,
}

// Everything the options panels collect, sent with the action button.
export struct ToolOptions {
    level: int,          // compress: 0 extreme, 1 recommended, 2 low
    password: string,    // protect
    confirm: string,
    owner: string,
    pages: string,       // remove / extract / rotate (optional)
    split-mode: int,     // 0 ranges, 1 every N
    ranges: string,
    every: int,
    degrees: int,        // 90 / 180 / 270
    layout: int,         // jpg→pdf: 0 fit, 1 A4 portrait, 2 A4 landscape
    margin: int,         // 0 none, 1 small, 2 big
    quality: int,        // pdf→jpg: 0 normal, 1 high
    out-name: string,    // merge
    // Page numbers and watermark: page range ("" = first / last page).
    from-page: string,
    to-page: string,
    // Page numbers
    num-position: int,   // 3×3 grid cell, row by row from the top left (top and bottom rows only)
    num-double: bool,    // double-sided
    num-cover: bool,     // first page is a cover page
    num-margin: int,     // 0 small, 1 recommended, 2 big
    num-start: string,   // first number
    num-text: int,       // 0 number only, 1 "Page {n}", 2 "Page {n} of {p}", 3 custom
    num-custom: string,
    // Watermark
    wm-image-mode: bool,
    wm-text: string,
    wm-font-size: string,
    wm-color: int,       // 0 black, 1 grey, 2 red, 3 blue
    wm-image: string,    // picture file path
    wm-scale: int,       // percent of the page
    wm-position: int,    // 3×3 grid cell
    wm-mosaic: bool,
    wm-transparency: int, // 0 none, 1 25 %, 2 50 %, 3 75 %
    wm-rotation: int,    // 0 none, 1 45°, 2 90°, 3 180°, 4 270°, 5 −45°
    wm-below: bool,
    // Crop
    crop-mode: int,      // 0 all pages, 1 selected pages, 2 remove crop
    crop-top: string,    // millimetres
    crop-bottom: string,
    crop-left: string,
    crop-right: string,
    // PDF to PDF/A
    pdfa-level: int,     // 0 PDF/A-2b, 1 PDF/A-3b
    // OCR
    ocr-languages: string, // selected language codes, ",en,fr," (the first one is used)
    ocr-all-pages: bool,   // also read pages that already contain text
    // PDF to Word / PowerPoint / Excel
    export-ocr: bool,      // recognise scanned pages first
    excel-layout: int,     // 0 one sheet, 1 one sheet per table
    // Compare
    compare-mode: int,     // 0 semantic text (report), 1 content overlay
    // Sign: the optional certificate
    sign-cert: bool,
    sign-p12: string,      // .p12 / .pfx path
    sign-p12-password: string,
    sign-reason: string,
    sign-location: string,
}

export struct OcrLanguage {
    code: string,
    name: string,
}

// What the OCR engine offers, set once at startup.
export global OcrInfo {
    in property <[OcrLanguage]> languages;
    // The recognition models are installed.
    in property <bool> available;
}

// Page viewer and Redact panel events, answered by the Rust side. The first argument is the tab id.
// Reader events, answered by the Rust side (src/reader_ui.rs). The first argument is the tab id.
// Pages, thumbnails, viewport and zoom go through ViewerBridge like the tools' viewers.
export global ReaderBridge {
    // Pointer on the pages, content coordinates; `clicks` 2 on a double-click.
    callback pressed(int, length, length, int);
    callback moved(int, length, length);
    callback released(int, length, length);
    callback set-tool(int, int);
    callback set-colour(int, int);
    callback set-pen-width(int, int);
    callback set-theme(int, int);
    callback set-panel(int, int);
    callback toggle-panel(int);
    callback outline-clicked(int, int);
    callback outline-toggled(int, int);
    callback annot-clicked(int, int);
    callback annot-delete(int, int);
    callback go-to-page(int, string);
    // +1 / −1 a page, +2 / −2 a screen, 10 / −10 the last / first page.
    callback page-step(int, int);
    // Scroll by a number of logical pixels (arrow keys).
    callback scroll-by(int, length);
    callback zoom-fit(int, int);
    callback search(int, string);
    // +1 next match, −1 previous.
    callback search-step(int, int);
    callback search-clear(int);
    // Match case, whole words, and the query to search again with them.
    callback search-options(int, bool, bool, string);
    callback result-clicked(int, int);
    // Markup the selection: 1 highlight, 2 underline, 3 strikethrough.
    callback markup(int, int);
    callback note-commit(int, string);
    callback note-cancel(int);
    callback save(int);
    callback save-as(int);
    callback undo(int);
    callback redo(int);
    callback delete-selected(int);
    callback escape(int);
    callback select-all(int);
    // ⌘[ back (−1), ⌘] forward (+1) after a link or an outline jump.
    callback history(int, int);
    // Tools page with this document ready for the tool picked.
    callback to-tools(int);
}

export global ViewerBridge {
    // The page area is `width` wide and shows [top, top + height) of its content.
    callback viewport(int, length, length, length);
    callback strip-viewport(int, length, length);
    callback pressed(int, length, length);
    callback released(int, length, length);
    callback thumb-clicked(int, int);
    // +1 / −1 one zoom step, 0 fit width.
    callback zoom-step(int, int);
    // Redact: search the text and the patterns (",email,phone,").
    callback search(int, string, string);
    callback toggle-result(int, int);
    callback show-result(int, int);
    callback mark-page(int);
    callback remove-mark(int, int);
    callback clear-marks(int);
}

// Sign panel events, answered by the Rust side. The first argument is the tab id.
// Files chosen in the Options panel's dialogs. The dialogs answer after the click returns: the Rust
// side sets the path and bumps the counter; the panel of tab `tab` takes it.
export global Picked {
    callback pick-watermark(int);
    callback pick-p12(int);
    in property <int> tab: -1;
    in property <string> watermark;
    in property <int> watermark-seq;
    in property <string> p12;
    in property <int> p12-seq;
}

export global SignBridge {
    // 0 Type, 1 Draw, 2 Upload.
    callback mode(int, int);
    callback typed(int, string);
    // The pad's strokes as "M x y L x y … M …" in pad pixels, and the pad's width and height.
    callback drawn(int, string, length, length);
    callback pick-image(int);
    // 0 small, 1 medium, 2 large.
    callback size(int, int);
}

// Edit panel events, answered by the Rust side. The first argument is the tab id.
export global EditBridge {
    // 0 Add text, 1 Add image.
    callback mode(int, int);
    // The selected text box's text.
    callback text(int, string);
    // +1 / −1: the next or previous text size.
    callback size-step(int, int);
    callback colour(int, int);
    callback width(int, int);
    callback pick-image(int);
    // Remove the selected item.
    callback remove(int);
}

// Text parsing the options panels need and Slint lacks, answered by the Rust side.
export global Parse {
    // A millimetre field: "2,5" and "2.5" are both 2.5; empty or invalid is 0.
    pure callback mm(string) -> float;
    // Why a custom page-number text is refused ("" when it is fine).
    pure callback custom-text-error(string) -> string;
    // A set of codes written ",a,b,": whether `code` is in it, and the set with `code` toggled.
    pure callback has-code(string, string) -> bool;
    pure callback toggle-code(string, string) -> string;
}
