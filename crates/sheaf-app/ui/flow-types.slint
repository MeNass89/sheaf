// Data the Rust side pushes into the tool flow screens.

export struct FileItem {
    uid: int,
    name: string,
    // "3.17 MB - 7 pages"
    info: string,
    thumb: image,
    has-thumb: bool,
    // 0 = PDF, 1 = image, 2 = office / HTML document
    kind: int,
    locked: bool,
    // The preview could not be rendered; the file is still processed.
    preview-failed: bool,
    // Compare: 0 Original, 1 Changed.
    slot: int,
    // Merge: the pages taken ("1-3, 5", empty = all), as the card shows it, and not valid.
    pages-spec: string,
    pages-label: string,
    pages-bad: bool,
}

// One page of the Organize grid. page 0 = inserted blank page.
export struct PageItem {
    page: int,
    // Merge's pages: the file it comes from ("" in Organize).
    label: string,
    thumb: image,
    has-thumb: bool,
}

// Page viewer: one page in the scrolling content (logical pixels), its render when ready.
export struct ViewerPage {
    // The page's index (0-based).
    page: int,
    x: length,
    y: length,
    w: length,
    h: length,
    image: image,
    ready: bool,
}

// A thumbnail in the viewer's strip.
export struct ViewerThumb {
    page: int,
    y: length,
    h: length,
    image: image,
    ready: bool,
    // Reader: the page is selected in the Pages panel.
    selected: bool,
}

// A box drawn over the pages, in content coordinates. kind: 0 marked for redaction,
// 1 search match, 2 the search match being looked at.
export struct ViewerOverlay {
    x: length,
    y: length,
    w: length,
    h: length,
    kind: int,
}

// Reader: an annotation drawn before the page renders with it (a highlight, an underline).
export struct ReaderMark {
    x: length,
    y: length,
    w: length,
    h: length,
    colour: color,
}

// Reader: one search result in the side panel.
export struct ReaderResultRow {
    before: string,
    hit: string,
    after: string,
    page-label: string,
    current: bool,
    // The first result of its page: the page heads its group (PDF Expert groups results by page).
    first: bool,
}

// Reader: one row of the outline panel.
export struct ReaderOutlineRow {
    title: string,
    depth: int,
    page-label: string,
    has-children: bool,
    expanded: bool,
    current: bool,
    // Being renamed in place.
    editing: bool,
    // Its look (Acrobat's bookmark Appearance): bold, italic, a colour (has-colour: one is set).
    bold: bool,
    italic: bool,
    has-colour: bool,
    colour: color,
}

// Reader: one row of the annotations panel.
// Reader: a line of Document Properties shown as is.
export struct ReaderProp {
    name: string,
    value: string,
}

// One complete diagnostic or its continuation, with a 1-based page (0 for the document).
export struct ReaderPrintCheck {
    title: string,
    detail: string,
    page: int,
}

// Accessibility rule, status, finding and whether it has a fix.
export struct ReaderCheck {
    name: string,
    status: int,
    detail: string,
    fix: bool,
}

// A layer of the document (Layers panel): its name, shown on screen or not.
export struct ReaderLayer {
    name: string,
    shown: bool,
}

// A reply under a comment, with where it is in the file (each can be deleted).
export struct ReaderReply {
    text: string,
    page: int,
    index: int,
}

export struct ReaderAnnotRow {
    kind: string,
    text: string,
    // "Author · date", as the file records them.
    meta: string,
    // Its place in the document's comment list (rows can be filtered and sorted).
    index: int,
    // Replies ("author: text"), oldest first, and its review status.
    replies: [ReaderReply],
    status: string,
    page-label: string,
    colour: color,
    selected: bool,
}

// Reader: the note or text box being typed, in content coordinates.
export struct ReaderNote {
    show: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    // 0 note, 1 text box, 2 a paragraph of the page, 3 new text on the page, 4 a form text field,
    // 5 a form choice, 6 an existing note or text box, 7 a reply, 8 a new link, 9 an existing link
    kind: int,
    seq: int,
    // A new text box or added text is typed on the page itself (Acrobat, PDF Expert): no card, the
    // text in its own size, font and colour where it will be.
    inplace: bool,
    font-px: length,
    font-family: string,
    bold: bool,
    italic: bool,
    ink: color,
}

// Reader: everything a document tab shows besides the pages (ToolTab.viewer-*).
// Prepare form: a field drawn over its page, named; the selected one is outlined in the accent.
// Prepare form's grid over a page (content pixels): its minor and major lines as path commands.
// A label of a page's ruler: on the top ruler (`across`) or the left one, at `at` px from the corner.
export struct ReaderRulerLabel {
    across: bool,
    at: length,
    text: string,
}

// A page's rulers and guides (More tools ▸ Rulers): its box, its points' scale, the ticks and the
// guides as path commands in its pixels, the rulers' labels.
export struct ReaderRuler {
    page: int,
    x: length,
    y: length,
    w: length,
    h: length,
    scale: float,
    ticks: string,
    guides: string,
    labels: [ReaderRulerLabel],
}

export struct ReaderGrid {
    x: length,
    y: length,
    w: length,
    h: length,
    minor: string,
    major: string,
}

export struct ReaderFormField {
    x: length,
    y: length,
    w: length,
    h: length,
    name: string,
    selected: bool,
}

// Prepare form: the selected field's properties card, under the field.
export struct ReaderFieldProps {
    show: bool,
    x: length,
    // Under the field (y), or above it (its top) when the pages end before the card does.
    y: length,
    top: length,
    seq: int,
    name: string,
    tooltip: string,
    required: bool,
    read-only: bool,
    multiline: bool,
    // 0 text, 1 check box, 2 radio button, 3 dropdown, 4 list, 5 button, 6 signature.
    exact: int,
    // A dropdown's or list's items, one per line.
    options: string,
    // Its text's alignment (0 left, 1 centre, 2 right) and size ("Auto" or points).
    align: int,
    font-size: string,
    // 0 Helvetica, 1 Times, 2 Courier.
    font: int,
    // A button's click: 0 nothing, 1 clear the form, 2 print, 3 open `url`, 4 submit the form to `url`.
    action: int,
    url: string,
    // A text field's Format (0 none, 1 number, 2 percent, 3 date, 4 phone, 5 zip, 6 another),
    // Validate range ("" none) and Calculate (simplified field notation).
    format: int,
    min: string,
    max: string,
    calc: string,
    // Pages that do not hold the field yet (On every page is offered when some).
    other-pages: bool,
    // Fields selected together (⇧-click): past one, the card arranges them instead.
    group: int,
}

// A page found by In a folder…: its file, its page ("p. 3") and the line around the words.
// Encrypt with certificates: one recipient, and Print, Copy, Edit, Comment, Fill forms, Change security.
export struct CertRecipient {
    name: string,
    detail: string,
    flags: [bool],
}

export struct FolderHit {
    file: string,
    page: string,
    line: string,
}

export struct ReaderState {
    title: string,
    // The document's When opened ▸ full screen and no toolbar, followed once per opening (open-seq).
    open-full-screen: bool,
    open-bare: bool,
    open-seq: int,
    dirty: bool,
    read-only: string,
    page-count: int,
    // "/ 12", or "(4 / 12)" when the page field shows a label ("iv").
    page-counter: string,
    // 1-based page under the middle of the view, as typed in the page field.
    page-text: string,
    page-label: string,
    panel-open: bool,
    // 0 thumbnails, 1 outline, 2 annotations, 3 search results
    panel: int,
    outline: [ReaderOutlineRow],
    outline-empty: bool,
    annots: [ReaderAnnotRow],
    // 0 select, 1 highlight, 2 underline, 3 strikethrough, 4 note, 5 pen, 6 text box,
    // 7 edit text, 8 add image
    tool: int,
    colour: int,
    // The colour row's sixth colour (index 5), for strokes and for highlights.
    custom-ink: color,
    custom-light: color,
    // 0 day, 1 night, 2 sepia
    theme: int,
    backdrop: color,
    // Text selection, search hits and the selected annotation, in content coordinates;
    // kind 3 selection, 4 search hit, 5 current hit, 6 selected annotation, 12 a page selected in
    // the page grid.
    marks: [ViewerOverlay],
    provisional: [ReaderMark],
    has-selection: bool,
    selected-text: string,
    selected-annot: bool,
    // The selected annotation takes the light palette (highlights, notes), not the ink one.
    annot-light: bool,
    // The selected annotation's colour as an index of its palette (−1: none of the five).
    annot-colour: int,
    // The stroke being drawn with the pen, as SVG path commands in content coordinates.
    ink: string,
    ink-colour: color,
    note: ReaderNote,
    search-count: string,
    search-busy: bool,
    can-undo: bool,
    can-redo: bool,
    zoom-mode: int,
    // Pen: 0 fine, 1 medium, 2 thick.
    pen-width: int,
    // Added text and text boxes: size in points, 0 Helvetica / 1 Times / 2 Courier, bold, italic.
    text-size: int,
    text-family: int,
    text-bold: bool,
    text-italic: bool,
    text-underline: bool,
    text-bullets: bool,
    text-numbers: bool,
    // Edit text: the computer's font the open paragraph is to be set in ("": the family buttons').
    text-font: string,
    text-align: int,
    // The selected annotation is a text box: the text format row restyles it.
    selected-text-box: bool,
    // Edit tool: a page image is selected (the options bar turns, flips, replaces, deletes it).
    selected-image: bool,
    // Pages selected in the Pages panel.
    pages-selected: int,
    // A form choice field being filled: its options.
    choices: [string],
    has-form: bool,
    // Signature tool: the pad is open to make one; one is kept.
    sign-open: bool,
    has-signature: bool,
    // Kept signatures, newest first (the first is placed).
    signatures: [image],
    // Document Properties: open, the four entries one can edit, what is only shown.
    props-open: bool,
    props-title: string,
    props-author: string,
    props-subject: string,
    props-keywords: string,
    // "Open the version signed by …", one per signature (Acrobat's View Signed Version).
    props-signed: [string],
    // "Trust …'s certificate", one per signature ("" when trusted already).
    props-trust: [string],
    // Its own properties, "Name: value; …" (Acrobat's Custom tab).
    props-custom: string,
    // When opened (the document's Initial View): page (1-based), layout, zoom, panel (properties.rs).
    props-opening: [int],
    props-about: [ReaderProp],
    // Notes panel: filter (0 all, 1 markup, 2 notes, 3 drawings, 4 stamps) and order (0 page,
    // 1 newest, 2 author, 3 type).
    notes-filter: int,
    notes-sort: int,
    // Files attached to the document or its pages: name, size.
    attachments: [ReaderProp],
    // The document's layers (the Layers tab shows when there is one).
    layers: [ReaderLayer],
    // Some layer is shown or hidden otherwise than the file sets it (Reset).
    layers-changed: bool,
    // More tools ▸ Voice…: the list open, the system's voices.
    voices-open: bool,
    // The keyboard shortcuts sheet.
    help-open: bool,
    voices: [string],
    // More tools ▸ Print preflight: measured results, split without dropping conditions.
    press-profile: string,
    press-busy: bool,
    production-open: bool,
    preflight-open: bool,
    preflight-busy: bool,
    preflight-ready: bool,
    preflight-rows: [ReaderPrintCheck],
    // More tools ▸ Accessibility check.
    a11y-open: bool,
    a11y-busy: bool,
    a11y-summary: string,
    a11y-rows: [ReaderCheck],
    // View ▸ Highlight links is on.
    show-links: bool,
    // Fillable fields tinted (More ▸ Highlight form fields).
    show-fields: bool,
    // Prepare form: the kind of field to add, every field drawn over its page, the selected one's card.
    field-kind: int,
    // Prepare form ▸ Barcode: the error correction of new barcode fields, as said.
    barcode-ecc: string,
    form-fields: [ReaderFormField],
    // Prepare form: Grid on (fields snap to it) and its lines over the pages in view.
    form-grid: bool,
    form-grids: [ReaderGrid],
    rulers-on: bool,
    guide-colour: color,
    rulers: [ReaderRuler],
    field-props: ReaderFieldProps,
    // The Link editor's complaint about what was typed.
    link-error: string,
    // Edit tool: objects are picked together (the arrow keys nudge them).
    has-picked: bool,
    // How many (Align and Distribute show from two).
    picked-count: int,
    // Comments selected together (⇧-click): how many (Align shows from two).
    annots-group: int,
    // New links' look: a visible border, dashed.
    link-visible: bool,
    link-dashed: bool,
    // Hide all comments is on.
    comments-hidden: bool,
    // Stamp tool: the stamps offered (labels) and the chosen one.
    stamps: [string],
    // A picture chosen as the stamp (its file name; "" for the palette's).
    stamp-image: string,
    stamp: int,
    // Pages side by side: 0 one column, 1 two pages, 2 two pages with the cover alone.
    spread: int,
    // Pairs read right to left.
    rtl: bool,
    // Pages across in one strip (PDF Expert's Horizontal scrolling).
    horizontal: bool,
    // Shapes tool: 0 rectangle, 1 oval, 2 line, 3 arrow; filled; opacity of shapes and pen (%).
    shape-kind: int,
    // Shapes: 1 Preview's Loupe, 2 its Mask, 3 Acrobat's Article box, 0 none (shape-option 30–32;
    // 33 ends the article, 34 deletes it).
    shape-special: int,
    // Shapes ▸ Loupe: the magnification of new loupes ("2×"); a loupe is the selected comment.
    loupe-magnify: string,
    selected-loupe: bool,
    shape-fill: bool,
    // Shapes ▸ Arrow: its head's name and whether both ends carry it.
    arrow-head: string,
    arrow-both: bool,
    // The Text box tool makes callouts (a line from the click to the box).
    callout: bool,
    // The Measuring tools' scale ("1:100 · m").
    measure-scale: string,
    measure-decimals: int,
    // Calibrate is on: the next distance asks for its real length.
    calibrating: bool,
    // Scroll automatically is on.
    auto-scroll: bool,
    // A form text field typed in: the entries remembered that start as typed (Auto-Complete).
    suggestions: [string],
    // Reflow: on, the page in view's text, its size in points.
    reflow: bool,
    reflow-text: string,
    reflow-size: int,
    // More ▸ Loupe: on, and the area under the pointer magnified.
    loupe: bool,
    loupe-image: image,
    // One page at a time (not continuous).
    // Replace Pages from a longer file: what it asks (empty: nothing asked).
    replace-ask: string,
    // Pen and shapes: dashed lines.
    dashed: bool,
    page-at-a-time: bool,
    // The page shown's top and bottom in the view's content (px): One page at a time turns it at its edges.
    page-top: float,
    page-bottom: float,
    // The page shown's seconds in full screen before the next (its transition's /Dur; 0 none).
    page-advance: float,
    // The page shown's transition in full screen: 0 none, 1 a fade (Fade, Dissolve, Glitter), 2 a
    // curtain across (Wipe, Push, Cover, Uncover, Fly), 3 from the middle (Split, Box, Blinds); its length.
    page-effect: int,
    page-effect-seconds: float,
    // Rotate View: how far the pages shown are turned clockwise (0, 90, 180, 270).
    view-turn: int,
    // The Signature tool places the initials; on every page at once.
    initials: bool,
    sign-every-page: bool,
    opacity: int,
    // Shapes' fill: −1 a tint of the stroke, else a highlight colour (5 the sixth).
    fill-colour: int,
    // A drawing or shape selected: the bar sets its width and opacity.
    selected-stroke: bool,
    // A selected rectangle, oval or polygon: its fill can change.
    selected-fillable: bool,
    // A stamp or picture selected: Turn ↻ turns it a quarter.
    selected-turnable: bool,
    // Print sheet: open, the system's printers, the chosen one.
    print-open: bool,
    // The print sheet's first sheet as it will print.
    print-preview: image,
    has-print-preview: bool,
    // More ▸ Background… is open.
    background-open: bool,
    // More ▸ Versions… is open; the versions saved in the file; what Undo and Redo would do.
    versions-open: bool,
    // The search panel's In a folder…: the sheet open, still searching, what and where, the results.
    signature-manager-open: bool,
    signature-manager-name: string,
    signature-manager-commands: string,
    signature-manager-style: [int],
    signature-manager-status: string,
    signature-manager-seq: int,
    policy-open: bool,
    policy-busy: bool,
    policy-names: [string],
    policy-name: string,
    policy-flags: [bool],
    policy-choices: [int],
    policy-status: string,
    policy-seq: int,
    policy-remembered: bool,
    cert-open: bool,
    cert-busy: bool,
    cert-recipients: [CertRecipient],
    cert-status: string,
    cert-policies: [string],
    cert-scope: int,
    cert-seq: int,
    cert-name: string,
    catalog-open: bool,
    catalog-busy: bool,
    catalog-status: string,
    catalog-files: [string],
    catalog-hits: [FolderHit],
    ocr-review-open: bool,
    ocr-review-busy: bool,
    ocr-review-text: string,
    ocr-review-position: string,
    ocr-review-has-row: bool,
    ocr-review-suspect: bool,
    ocr-review-suspects-only: bool,
    ocr-review-seq: int,
    folder-open: bool,
    folder-busy: bool,
    folder-title: string,
    folder-status: string,
    folder-results: [FolderHit],
    // PDFs of the folder that could not be read: name, and why (a password, damaged).
    folder-skipped: [FolderHit],
    // A text file or picture shown as a preview PDF: its own name ("" a PDF of its own).
    preview-of: string,
    versions: int,
    undo-label: string,
    redo-label: string,
    printers: [string],
    printer: int,
    results: [ReaderResultRow],
    // Earlier searches, newest first (this session).
    search-history: [string],
    // How many pages the results are on.
    search-pages: int,
    case-sensitive: bool,
    whole-words: bool,
}

// Sign: the signature as placed on a page, in content coordinates, drawn upright in its box.
export struct SignOverlay {
    show: bool,
    x: length,
    y: length,
    w: length,
    h: length,
}

// Edit: one placed item in content coordinates; text is drawn at `font-size` in `color`, an
// image fills its box.
export struct EditOverlay {
    x: length,
    y: length,
    w: length,
    h: length,
    selected: bool,
    is-text: bool,
    text: string,
    font-size: length,
    color: color,
    image: image,
}

// Redact: one search match ("alice@example.com", "Page 2").
export struct RedactResult {
    text: string,
    page: string,
    checked: bool,
}

// Redact: one area marked for redaction.
export struct RedactMarkItem {
    label: string,
    page: string,
}

export struct ResultFile {
    name: string,
    info: string,
    // Compress: "PDF compressed (-29%)"; empty otherwise.
    note: string,
    is-pdf: bool,
    // Not a PDF: "image", "docx", "pptx" or "xlsx" (the card's icon).
    kind: string,
}

export struct ContinueTool {
    id: string,
    name: string,
    icon: image,
    tile: color,
}

// Everything the options panels collect, sent with the action button.
export struct ToolOptions {
    level: int,          // compress: 0 extreme, 1 recommended, 2 low, 3 a target size
    compress-target: string, // compress to a size: the largest file, in MB as typed
    compress-ppi: string,    // compress, advanced: images' largest resolution in ppi ("" the level's)
    compress-quality: string, // compress, advanced: JPEG quality 1–100 ("" the level's)
    discard-thumbs: bool,    // compress, advanced: page thumbnails taken out
    discard-tags: bool,      // compress, advanced: structure tags taken out
    discard-meta: bool,      // compress, advanced: document information and XMP taken out
    compress-gray: bool,     // compress: every colour made grey (Stirling's Convert to grayscale)
    flatten-transparency: bool, // compress: explicit PDF 1.3 copy via local Ghostscript
    linearize: bool,          // compress: Fast Web View via local qpdf
    unembed-fonts: bool,     // compress, advanced: standard faces' programs taken out
    adjust-brightness: int,  // adjust colours: −100 to 100 (0 as it is)
    adjust-contrast: int,
    adjust-saturation: int,
    adjust-invert: bool,     // adjust colours: inverted (light on dark)
    password: string,    // protect
    confirm: string,
    owner: string,
    allow-printing: bool,
    allow-copying: bool,
    allow-editing: bool,
    allow-commenting: bool,
    allow-filling-forms: bool,
    pages: string,       // remove / extract / rotate (optional)
    remove-blank: bool,  // remove pages: the blank ones, found by Sheaf
    blank-level: int,    // how blank: 0 strict, 1 normal, 2 scans on grey paper
    rotate-parity: int,  // rotate: 0 even and odd pages, 1 odd, 2 even
    protect-sanitize: bool, // protect: remove the hidden information first
    compare-old-pages: string, // compare: the original's pages ("" all)
    compare-new-pages: string, // compare: the changed document's pages ("" all)
    rotate-orientation: int, // rotate: 0 portrait and landscape pages, 1 portrait, 2 landscape
    split-mode: int,     // 0 ranges, 1 every N, 2 top-level bookmarks, 3 file size
    ranges: string,
    every: int,
    split-one-file: bool, // split: every range into one PDF (iLovePDF's "Merge all ranges")
    split-size: string,  // split by size: the largest file, in MB as typed
    organize-order: string, // Organize: an order typed ("3,1,2", "odd,even", "collate"); "" the grid's
    split-cols: int,     // cut each page: columns and rows of parts (2 × 1 left and right, 1 × 2 top and bottom)
    split-rows: int,
    degrees: int,        // 90 / 180 / 270
    layout: int,         // jpg→pdf: 0 fit, 1 A4, 2 US Letter
    landscape: bool,     // jpg→pdf: the paper turned
    one-per-image: bool, // jpg→pdf: a PDF for each image instead of one for all
    margin: int,         // 0 none, 1 small, 2 big
    quality: int,        // pdf→jpg: 0 normal (150 dpi), 1 high (300), 2 very high (600)
    png: bool,           // pdf→jpg: lossless PNG instead of JPEG
    extract-images: bool, // pdf→jpg: the pictures placed in the pages, not the pages (iLovePDF)
    out-name: string,    // merge
    // Page numbers and watermark: page range ("" = first / last page).
    from-page: string,
    to-page: string,
    // Page numbers
    num-position: int,   // 3×3 grid cell, row by row from the top left (top and bottom rows only)
    num-double: bool,    // double-sided
    num-cover: bool,     // first page is a cover page
    num-margin: int,     // 0 small, 1 recommended, 2 big
    num-start: string,   // first number
    num-text: int,       // 0 number only, 1 "Page {n}", 2 "Page {n} of {p}", 3 custom
    num-custom: string,
    num-font-size: string, // points, empty: 12
    num-color: int,        // as wm-color: 0 black, 1 grey, 2 red, 3 blue
    num-family: int,       // 0 Helvetica, 1 Times, 2 Courier
    num-bold: bool,
    num-italic: bool,
    num-underline: bool,
    num-hex: string,       // a custom colour RRGGBB: overrides num-color when set
    // Header and footer text (left, centre, right; top then bottom), Bates numbers for {bates}.
    hf-tl: string,
    hf-tc: string,
    hf-tr: string,
    hf-bl: string,
    hf-bc: string,
    hf-br: string,
    bates-prefix: string,
    bates-digits: int,
    bates-start: string,
    hf-replace: bool,      // the file's own headers and footers go first
    // Watermark
    wm-image-mode: bool,
    wm-text: string,
    wm-font-size: string,
    wm-color: int,       // 0 black, 1 grey, 2 red, 3 blue
    wm-family: int,      // as num-family
    wm-bold: bool,
    wm-italic: bool,
    wm-underline: bool,
    wm-hex: string,      // as num-hex
    wm-image: string,    // picture file path
    wm-scale: int,       // percent of the page
    wm-position: int,    // 3×3 grid cell
    wm-mosaic: bool,
    wm-transparency: int, // 0 none, 1 25 %, 2 50 %, 3 75 %
    wm-rotation: int,    // 0 none, 1 45°, 2 90°, 3 180°, 4 270°, 5 −45°
    wm-below: bool,
    // Watermarks already in the file go first; or are only taken out (Acrobat's Remove).
    wm-replace: bool,
    wm-remove: bool,
    // Crop
    crop-mode: int,      // 0 all pages, 1 selected pages, 2 remove crop, 3 white margins, 4 change page size
    crop-paper: int,     // change page size: A4, Letter, A3, A5, Legal (pages::PAPER)
    per-sheet: int,      // organize: pages to a sheet, 0 one, 1 two, 2 four, 3 six, 4 nine, 5 a booklet
    crop-top: string,    // millimetres
    crop-bottom: string,
    crop-left: string,
    crop-right: string,
    // PDF to PDF/A
    pdfa-level: int,     // 0 2b, 1 3b, 2 1b, 3 2u, 4 3u, 5 1a, 6 2a, 7 3a
    pdfa-allow-incomplete: bool,
    html-long-page: bool,
    html-screen-width: int,
    // OCR
    ocr-languages: string, // selected language codes, ",en,fr," (all selected codes are used)
    ocr-local-engine: bool,
    ocr-all-pages: bool,   // also read pages that already contain text
    ocr-enhance: bool,     // straighten and clean scanned pages first (Acrobat's Enhance)
    // PDF to Word / PowerPoint / Excel
    export-ocr: bool,      // recognise scanned pages first
    export-exact: bool,    // Word: keep each page's layout (positioned text boxes)
    excel-layout: int,     // 0 one sheet, 1 one sheet per table
    text-format: int,      // PDF to HTML or text: 0 web page, 1 Markdown, 2 rich text, 3 plain text, 4 XML
    // Compare
    compare-mode: int,     // 0 semantic text (report), 1 content overlay, 2 side by side
    // Sign: the optional certificate
    sign-cert: bool,
    sign-p12: string,      // .p12 / .pfx path
    sign-p12-password: string,
    sign-reason: string,
    sign-location: string,
    sign-certify: int,       // sign: 0 approve; certify allowing 1 no changes, 2 forms and signing, 3 also comments
    redact-fill: int,        // redact: the boxes' colour, 0 black, 1 white, 2 grey, 3 red
    redact-overlay: string,  // redact: text over each box ("" none)
    redact-margin: string,   // redact: points added round each mark ("" none)
    redact-repeat: bool,     // redact: that text repeated to fill the box
}

export struct ToolTab {
    // A file whose first pages carry next to no text (a scan): PDF to Office suggests OCR.
    any-scanned: bool,
    // A file was opened with its password (Protect then changes it).
    any-locked: bool,
    // Merge: its files opened out into their pages (the page cards show them).
    merge-pages: bool,
    // Crop: the page its preview shows (1-based) of how many.
    preview-page: int,
    preview-pages: int,
    // Run again: the options the task ran with (has-options: there are some to start from).
    options: ToolOptions,
    has-options: bool,
    id: int,
    tool: string,
    name: string,
    icon: image,
    tile: color,
    multi: bool,
    // 0 = choosing files and options, 1 = running, 2 = result
    phase: int,
    progress: float,
    progress-text: string,
    // Cancel pressed, waiting for the job to stop.
    cancelling: bool,
    // Organize: page previews could not be rendered.
    preview-failed: bool,
    files: [FileItem],
    pages: [PageItem],
    office-missing: bool,
    // Every file is probed (page count known, no password pending).
    files-ready: bool,
    default-out: string,
    // Result page
    result-title: string,
    result-sub: string,
    result-pct: string,
    size-before: string,
    size-after: string,
    warning: string,
    // Batch with some failed inputs: "1 file failed:" and one "name — error" line each.
    failure-title: string,
    failures: [string],
    // Things to know about the outputs (PDF/A rules still broken): a heading and one line each.
    notes-title: string,
    notes: [string],
    outputs: [ResultFile],
    // Crop: page 1 of the file, and its displayed size in points.
    preview: image,
    has-preview: bool,
    // Add watermark: why its preview shows no mark ("" when it does).
    preview-note: string,
    preview-w: float,
    preview-h: float,
    continue-tools: [ContinueTool],
    // Result page: a check that passed ("Verified: no hidden text remains under the redactions").
    result-verified: string,
    // Result page: a page of the output as written ("Page 3 as redacted"; "" for none).
    result-preview: image,
    result-preview-caption: string,
    // Page viewer (Redact)
    viewer-pages: [ViewerPage],
    viewer-thumbs: [ViewerThumb],
    viewer-overlays: [ViewerOverlay],
    // Redact: a drag is selecting text (no rubber band; the selection shows as overlays of kind 3).
    viewer-selecting: bool,
    viewer-width: length,
    viewer-height: length,
    viewer-thumbs-height: length,
    viewer-current: int,
    viewer-zoom: int,
    // "" when the pages are shown; otherwise why not ("Opening…", an error).
    viewer-status: string,
    // Rust asks the viewer to scroll: the position, and a counter bumped on each request.
    viewer-scroll: length,
    // The horizontal scroll set with viewer-scroll after a zoom around a point (negative: unchanged).
    viewer-scroll-x: length,
    viewer-scroll-seq: int,
    // Split view (the reader's): 0 off, 1 side by side, 2 one above the other; the half the active
    // pane takes (0 first, 1 second); Sync scroll; the other pane's scroll set (seq) and the panes
    // swapped (swap); its pages, content size and scroll.
    split-mode: int,
    split-half: int,
    split-sync: bool,
    split-seq: int,
    split-swap: int,
    split-pages: [ViewerPage],
    split-width: length,
    split-height: length,
    split-scroll: length,
    split-scroll-x: length,
    // The other document's name when the other pane shows another tab ("": this document), and that
    // tab's id (−1); the share of the area the first half takes (the divider dragged).
    split-title: string,
    split-other: int,
    split-frac: float,
    // Bumped when Sync scroll and zoom zoomed the other pane (both scrolls taken as they are).
    split-zoom-seq: int,
    // Redact
    redact-searched: bool,
    redact-busy: bool,
    redact-count: string,
    redact-results: [RedactResult],
    redact-marks: [RedactMarkItem],
    // Sign: 0 Type, 1 Draw, 2 Upload; the signature as ink on transparent (black, tinted in the
    // panel); one is made; the uploaded image's name; 0 small, 1 medium, 2 large; where it is.
    sign-mode: int,
    // The typed name's handwriting font (Dancing Script, Great Vibes, Satisfy, Caveat).
    sign-font: int,
    sign-preview: image,
    sign-has-graphic: bool,
    sign-image-name: string,
    sign-size: int,
    sign-placed: bool,
    sign-page: int,
    sign-overlay: SignOverlay,
    // Edit: 0 Add text, 1 Add image; items placed; the selection (0 none, 1 text, 2 image), its
    // page (1-based) and a counter bumped when it changes; the selected text; text size in
    // points and colour (0 black, 1 grey, 2 red, 3 blue) for the selection and the next text;
    // image width (0 small, 1 medium, 2 large); the image chosen; every item is ready.
    edit-mode: int,
    edit-count: int,
    edit-selected: int,
    edit-selected-page: int,
    edit-selected-seq: int,
    edit-text: string,
    edit-size: int,
    // The preset ringed (−1: a colour typed, shown in hex).
    edit-colour: int,
    edit-hex: string,
    edit-width: int,
    edit-image-name: string,
    edit-ready: bool,
    // Why the action can't run yet (an empty or undrawable text), "" when it can.
    edit-problem: string,
    edit-overlays: [EditOverlay],
    // Reader (a document tab): see screens/reader.slint.
    is-reader: bool,
    reader: ReaderState,
}


export struct OcrLanguage {
    code: string,
    name: string,
}

// What the OCR engine offers, set once at startup.
export global OcrInfo {
    in property <[OcrLanguage]> languages;
    // The recognition models are installed.
    in property <bool> available;
    // The language ticked at first: the system's, when the models read it.
    in property <string> default-language: "en";
}

// Page viewer and Redact panel events, answered by the Rust side. The first argument is the tab id.
// Reader events, answered by the Rust side (src/reader_ui/). The first argument is the tab id.
// Pages, thumbnails, viewport and zoom go through ViewerBridge like the tools' viewers.
export global ReaderBridge {
    // The side panel's width, shared by every document; its edge dragged and let go.
    in-out property <length> panel-width: 248px;
    // The thumbnails' width, set once the edge is let go (their heights come with it).
    in property <length> thumb-width: 150px;
    // The computer's fonts a paragraph can be set in (Acrobat's Edit PDF font list), read when the
    // list is first opened (text-format 9).
    in property <[string]> system-fonts;
    // For each of those, why it can't be embedded ("": it can): listed dimmed, said when picked.
    in property <[string]> system-fonts-why;
    callback panel-resized(length);
    // Print: open the sheet; print with printer, copies, pages (0 all, 1 current, 2 range),
    // the range typed, fit to paper, two-sided, paper (0 the printer's, 1 A4, 2 Letter, 3 Legal),
    // orientation (0 auto, 1 portrait, 2 landscape); cancel.
    callback print-open(int);
    // The print sheet's preview for a layout (0–6), grey or not, with comments or not.
    callback print-preview(int, int, bool, bool);
    // More ▸ Background…: open; then apply (action 0, colour and opacity as chosen), a picture (1),
    // remove the backgrounds (2) or cancel (3).
    callback background-open(int);
    callback background-apply(int, int, int, int);
    // More ▸ Versions…: open; then 0 reverts to the saved file, n opens version n, −1 closes.
    callback versions-open(int);
    // Zoom to area: the next box dragged on a page fills the view (Z).
    callback zoom-area(int);
    callback snap-area(int);
    callback auto-scroll(int);
    callback page-at-a-time(int);
    // The search panel's Replace all: the words searched, what replaces them.
    callback replace-all(int, string, string);
    callback replace-one(int, string, string);
    // Replace Pages: the file's first page to take ("" cancels).
    callback replace-from(int, string);
    callback email(int);
    // More tools ▸ Overlay a PDF… (false) or Underlay a PDF… (true, behind the pages' content).
    callback overlay-pdf(int, bool);
    // 0 read from the page shown, 1 reading speed, 2 this page only, 3 the selection, 4 pause or
    // resume, 5 the voices.
    callback read-aloud(int, int);
    // A voice picked from the list (−1 the system's default; −2 closes).
    callback voice-pick(int, int);
    callback flat-copy(int, bool);
    callback loupe(int);
    callback sign-pages(int, string);
    callback turn-upright(int);
    callback remove-images(int);
    callback reflow(int, int);
    callback folder-search(int, string);
    callback signature-manager(int);
    callback signature-manager-action(int, int, int);
    callback signature-manager-save(int, string, string, int, int, int);
    callback policy-open(int);
    callback policy-action(int, int, int);
    callback policy-save(int, string, bool, bool, bool, bool, bool, bool, int, int, int);
    callback policy-apply(int, string, string, string, string, bool);
    // Encrypt with certificates: 0 close, 1 add certificate, 2 add digital ID (password), 3 remove k, 4 save with scope k,
    // 5 save as policy (name, scope k), 6 use policy k, 7 delete policy k, 8 import policy, 9 export policy (name, scope k).
    callback cert-open(int);
    callback cert-action(int, int, int, string);
    callback cert-flag(int, int, int, bool);
    callback catalog-open(int);
    callback catalog-action(int, int, int, string);
    callback review-ocr(int);
    // -1 close, 0 previous, 1 accept/next, 2 correct, 3 not text, 4 filter.
    callback ocr-review-action(int, int, string);
    callback folder-result(int, int);
    callback field-scripts(int, int, string, string, string);
    callback outline-drop(int, int, int, bool);
    callback version-action(int, int);
    // One column → two pages → two pages with the cover alone.
    callback cycle-spread(int);
    callback toggle-rtl(int);
    // Pages across in one strip, or back down a column.
    callback toggle-horizontal(int);
    // Split view: 0 off, 1 side by side, 2 one above the other; a press in the other pane makes it the
    // active one; its Sync scroll.
    callback split-view(int, int);
    callback split-focus(int);
    // A press in another document's pane: that tab laid out as the pane is; returns its id (−1: none).
    callback split-press-other(int) -> int;
    callback split-sync(int);
    // The divider dragged: the first half's share of the area (0.2 to 0.8).
    callback split-frac(int, float);
    // Split with another open document (the k-th of split-names), and those names.
    callback split-with(int, int);
    pure callback split-names(int) -> [string];
    // Rotate View: the pages shown turned a quarter clockwise (1) or back (−1), not the file.
    callback rotate-view(int, int);
    callback toggle-grid(int);
    // Pages side by side as given (0 one column, 1 two pages, 2 cover alone).
    callback set-spread(int, int);
    // The Notes panel: 0 hide or show all comments, 1 summary of comments, 2 remove all.
    callback notes-action(int, int);
    // Notes panel: what (0 filter, 1 order), value.
    callback notes-view(int, int, int);
    // View ▸ Highlight links on or off.
    callback toggle-links(int);
    callback toggle-fields(int);
    // Reply to a comment of the Notes panel (its index).
    callback annot-reply(int, int);
    // Files panel: save attachment (its index); attach a file to the page in view.
    callback attachment-save(int, int);
    callback attachment-open(int, int);
    // Attachment deleted ("" ) or renamed to the text.
    callback attachment-change(int, int, string);
    callback attachment-add(int);
    // Layers panel: layer (index) shown or hidden; all shown (0), hidden (1), as the file sets them (2).
    callback layer-set(int, int, bool);
    callback layers-all(int, int);
    // Outline panel: row, op (0 bookmark this page, 1 rename, 2 renamed to text, 3 stop, 4 delete), text.
    callback outline-op(int, int, int, string);
    // A zoom typed in the zoom field or picked from its list ("150", "150 %").
    callback zoom-typed(int, string);
    // Review status of a comment (its index): 0 none, 1 accepted, 2 rejected, 3 cancelled, 4 completed.
    callback annot-status(int, int, int);
    // Document Properties: open; save title, author, subject, keywords; cancel.
    callback props-open(int);
    // Title, author, subject, keywords, custom properties; When opened: page, layout, zoom, panel.
    callback props-save(int, string, string, string, string, string, string, int, int, int, int);
    callback open-signed(int, int);
    callback trust-signature(int, int);
    // Document properties ▸ Clear signature k (Acrobat's): its field left unsigned.
    callback clear-signature(int, int);
    callback props-cancel(int);
    // Copy report: the properties and the fonts as text on the clipboard.
    callback props-copy(int);
    callback props-report(int);
    // Shapes and pen: what (0 shape kind, 1 fill toggle, 2 next opacity), value.
    callback shape-option(int, int, int);
    callback print(int, int, int, int, string, bool, bool, int, int, int, bool, bool);
    callback print-cancel(int);
    // Pointer on the pages, content coordinates; `clicks` 2 on a double-click.
    callback pressed(int, length, length, int);
    callback moved(int, length, length);
    callback released(int, length, length);
    // Edit group: Redact opens the document in the Redact tool (saved first).
    callback redact(int);
    // Link tool: link the web addresses in the text; link the selected text.
    // Edit tool: nudge the picked objects (points; y up the page).
    callback nudge(int, float, float);
    // Edit tool: the pointer is up at a content point (the drawing under it is outlined).
    callback hover(int, length, length);
    callback loupe-at(int, length, length);
    callback link-urls(int);
    // Prepare form: the kind of field to add; Detect fields; the selected field's properties
    // (name, tooltip, required, read-only, several lines, items one per line), delete, copy to
    // every page.
    callback field-kind(int, int);
    callback detect-fields(int);
    // Prepare form ▸ Tab order: 0 rows, 1 columns, 2 structure.
    callback tab-order(int, int);
    // ⌘C / ⌘X (true) on a picture picked with the Edit tool.
    callback copy-image(int, bool);
    // More ▸ Sanitize document.
    callback sanitize(int);
    callback field-props(int, string, string, bool, bool, bool, string, string, int, int, int, string);
    callback field-delete(int);
    callback field-everywhere(int);
    callback field-copies(int, int, int);
    // Fields selected together: align, match size or space them (reader::arrange); the arrow keys move them.
    callback fields-arrange(int, int);
    // Edit tool, several objects picked ▸ Align or Distribute (codes as fields-arrange's, no sizes);
    // one or more ▸ Arrange: 20 to front, 21 forward, 22 backward, 23 to back.
    callback objects-arrange(int, int);
    // Comments selected together ▸ Align or Distribute (codes as fields-arrange's).
    callback annots-arrange(int, int);
    // More tools ▸ Rulers; a click on a page's ruler (top: across) at page points: a guide added or taken away.
    callback rulers(int);
    // The keyboard shortcuts sheet shown (true) or closed.
    callback show-help(int, bool);
    // More tools ▸ Copy the file (false), Share with AirDrop (true).
    callback share-file(int, bool);
    callback ruler-clicked(int, int, bool, float);
    // A text selection ▸ Look up: the words in the system's dictionary.
    callback look-up(string);
    // Pages panel ▸ Transitions: the selected pages' (or the one shown's) effect (index of
    // transitions::STYLES, −1 none) and seconds before the next page in full screen ("" none).
    callback page-transition(int, int, string);
    // Accessibility check: run it; row k's fix (−1 closes); its report saved.
    callback accessibility-check(int);
    callback accessibility-fix(int, int);
    callback accessibility-report(int);
    // Print Production ▸ Preflight: a saved report of the current document's print checks.
    callback print-preflight(int);
    callback preflight-check(int, string, string, string, int);
    callback preflight-save(int);
    callback preflight-close(int);
    callback preflight-page(int, int);
    callback fix-page-hairlines(int);
    callback add-crop-marks(int);
    callback press-profile(int);
    callback press-export(int, string, int);
    callback press-preset(int, int);
    callback production-close(int);
    callback production-hairlines(int, string, bool);
    callback production-marks(int, bool, int, string);
    callback production-box(int, int, string, string, string, string, bool, bool);
    callback form-grid(int);
    callback fields-nudge(int, float, float);
    callback link-selection(int);
    // Replace Text from the selection bar: the words to propose instead are typed next.
    callback replace-selection(int);
    callback insert-after-selection(int);
    callback set-tool(int, int);
    callback set-colour(int, int);
    // A colour from the palette or typed, RRGGBB.
    callback set-custom-colour(int, string);
    callback set-pen-width(int, int);
    // Added text's format: 0 size step, 1 family, 2 bold toggle.
    callback text-format(int, int, int);
    // A text size typed in the format row ("16", "16 pt").
    callback text-size-typed(int, string);
    callback set-theme(int, int);
    callback set-panel(int, int);
    callback toggle-panel(int);
    callback outline-clicked(int, int);
    callback outline-toggled(int, int);
    callback annot-clicked(int, int);
    callback annot-delete(int, int);
    // A reply deleted alone (its page and index in the file), the comment kept.
    callback reply-delete(int, int, int);
    callback go-to-page(int, string);
    // +1 / −1 a page, +2 / −2 a screen, 10 / −10 the last / first page.
    callback page-step(int, int);
    // Scroll by a number of logical pixels (arrow keys).
    callback scroll-by(int, length);
    callback zoom-fit(int, int);
    callback search(int, string);
    // +1 next match, −1 previous.
    callback search-step(int, int);
    callback search-clear(int);
    // Match case, whole words, and the query to search again with them.
    callback search-options(int, bool, bool, string);
    callback result-clicked(int, int);
    // Markup the selection: 1 highlight, 2 underline, 3 strikethrough.
    callback markup(int, int);
    callback note-commit(int, string);
    // The editor's text changed (Edit text previews the paragraph on its page).
    callback note-edited(int, string);
    // ⌘V: an image on the clipboard placed on the page in view.
    callback paste(int);
    // ⌘C with pages selected in the Pages panel (and no text selected).
    callback copy-pages(int);
    // Stamp ▸ Image…: a picture chosen as the stamp.
    callback stamp-image(int);
    // ⌘C / ⌘X on a selected comment (cut: true).
    callback copy-comment(int, bool);
    // The selected page image: 0 turn left, 1 turn right, 2 flip, 3 replace, 4 delete.
    callback image-action(int, int);
    callback note-cancel(int);
    callback save(int);
    callback save-as(int);
    callback undo(int);
    callback redo(int);
    callback delete-selected(int);
    callback escape(int);
    callback select-all(int);
    // ⌘[ back (−1), ⌘] forward (+1) after a link or an outline jump.
    callback history(int, int);
    // Tools page with this document ready for the tool picked.
    callback to-tools(int);
    // ⌘W: close the document (asks first when there are unsaved edits).
    callback close(int);
    // ⌥⌘W: every tab, documents with unsaved edits asked about in turn.
    callback close-all(int);
    // Whether a content point is over a link (the hand cursor).
    // Where the link under the point goes ("" when none).
    callback over-link(int, length, length) -> string;
    // Pages panel: a thumbnail clicked (`extend` ⇧, `toggle` ⌘), an operation on the selected
    // pages (0 rotate left, 1 rotate right, 2 delete, 3 duplicate, 5 insert a blank page
    // after), a drag over the thumbnails (content y; returns the drop line's y, −1 for none) and
    // its drop.
    callback thumb-pressed(int, int, bool, bool);
    callback page-op(int, int);
    // Number the selected pages (or the one shown) and the next: style (0 1 2 3, 1 i ii, 2 I II,
    // 3 a b, 4 A B, 5 none), prefix, first number as typed.
    callback number-pages(int, int, string, string, string);
    // Extract the selected pages (or the one shown): one file per page, then delete them.
    callback extract(int, bool, bool);
    callback thumb-drag(int, int, length) -> length;
    callback thumb-drop(int, length);
    // The page whose thumbnail is at content y of the Pages panel (−1: none).
    callback thumb-at(int, length) -> int;
    callback thumb-released(int);
    // Form fields: Tab / ⇧Tab in a field editor (its text), a choice picked.
    callback field-tab(int, string, bool);
    callback choice-picked(int, int);
    // 0 clear the form, 1 flatten the form fields, 2 flatten fields and comments.
    callback form-op(int, int);
    // The signature pad: commands and pad size, or a typed name; reset forgets the kept one.
    // The pad's answer: strokes (commands, pad width, height), typed name, ink (0 black, 1 blue,
    // 2 dark blue), pen (0 fine, 1 medium, 2 bold), font, and whether it is kept for next time.
    callback signature-made(int, string, length, length, string, int, int, int, bool);
    // A kept signature chosen (its index) or, with true, forgotten.
    callback signature-pick(int, int, bool);
    // The typed name as it will sign, in the script font (the pad's live preview).
    pure callback signature-preview(string, int) -> image;
    callback signature-reset(int);
}

export global ViewerBridge {
    // The page area is `width` wide and shows [top, top + height) of its content.
    callback viewport(int, length, length, length);
    // How far the view is scrolled across (⌘[ comes back to it).
    callback view-left(int, length);
    // Split view's other pane scrolled (left, top) or resized (width, height).
    callback second-viewport(int, length, length, length, length);
    callback strip-viewport(int, length, length);
    callback pressed(int, length, length);
    // The pointer moved with the button held (Redact shows the text a drag selects as it goes).
    callback dragged(int, length, length);
    callback double-clicked(int, length, length);
    callback released(int, length, length);
    callback thumb-clicked(int, int);
    // +1 / −1 one zoom step, 0 fit width.
    callback zoom-step(int, int);
    // Pinch and ⌘ + wheel: a zoom in percent of actual size, keeping the view point (x, y) on the
    // same point of its page; the last value is the horizontal scroll, the new one is returned.
    callback zoom-at(int, float, float, float, float) -> float;
    // ⌘ + wheel: as zoom-at, the zoom asked for so far times a factor (small steps add up).
    callback zoom-by(int, float, float, float, float) -> float;
    // Redact: search the text and the patterns (",email,phone,").
    callback search(int, string, string);
    callback toggle-result(int, int);
    callback show-result(int, int);
    // Whole pages marked for redaction: the range typed ("2-4, 7"), empty for the page shown.
    callback mark-page(int, string);
    callback remove-mark(int, int);
    callback show-mark(int, int);
    callback clear-marks(int);
}

// Sign panel events, answered by the Rust side. The first argument is the tab id.
// Files chosen in the Options panel's dialogs. The dialogs answer after the click returns: the Rust
// side sets the path and bumps the counter; the panel of tab `tab` takes it.
export global Picked {
    callback pick-watermark(int);
    // Add watermark: its options or file changed; the preview is drawn again.
    callback preview-watermark(int, ToolOptions);
    callback pick-p12(int);
    in property <int> tab: -1;
    in property <string> watermark;
    in property <int> watermark-seq;
    in property <string> p12;
    in property <int> p12-seq;
}

export global SignBridge {
    // 0 Type, 1 Draw, 2 Upload.
    callback mode(int, int);
    callback typed(int, string);
    // The typed name's handwriting font (0 Dancing Script, 1 Great Vibes, 2 Satisfy, 3 Caveat).
    callback font(int, int);
    // The pad's strokes as "M x y L x y … M …" in pad pixels, and the pad's width and height.
    callback drawn(int, string, length, length);
    callback pick-image(int);
    // 0 small, 1 medium, 2 large.
    callback size(int, int);
}

// Edit panel events, answered by the Rust side. The first argument is the tab id.
export global EditBridge {
    // 0 Add text, 1 Add image.
    callback mode(int, int);
    // The selected text box's text.
    callback text(int, string);
    // +1 / −1: the next or previous text size.
    callback size-step(int, int);
    callback colour(int, int);
    // A colour typed as RRGGBB.
    callback colour-typed(int, string);
    callback width(int, int);
    callback pick-image(int);
    // Remove the selected item.
    callback remove(int);
}

// Text parsing the options panels need and Slint lacks, answered by the Rust side.
export global Parse {
    pure callback password-strength(string) -> int;
    // A millimetre field: "2,5" and "2.5" are both 2.5; empty or invalid is 0.
    pure callback mm(string) -> float;
    // Why a custom page-number text is refused ("" when it is fine).
    pure callback custom-text-error(string) -> string;
    // Why a typed output name is not a valid file name ("" when it is, or when it is empty).
    pure callback file-name-error(string) -> string;
    // Split's page grid: ranges with a cut between page `after` and the next toggled (pages total);
    // the range (0-based) a page falls in, -1 none; how many files the ranges make, -1 unreadable.
    pure callback split-cut(string, int, int) -> string;
    pure callback split-range-of(string, int, int) -> int;
    pure callback split-count(string, int) -> int;
    // A name holds the text typed (any case); an empty text matches every name.
    pure callback name-matches(string, string) -> bool;
    // Why a typed colour is not RRGGBB ("" when it is, or when it is empty).
    pure callback colour-error(string) -> string;
    // The text colour of a font panel: the RRGGBB typed, else preset `k` (0 black, 1 grey, 2 red,
    // 3 blue).
    pure callback colour(string, int) -> color;
    // A set of codes written ",a,b,": whether `code` is in it, and the set with `code` toggled.
    pure callback has-code(string, string) -> bool;
    pure callback toggle-code(string, string) -> string;
}
