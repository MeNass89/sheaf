// Data the Rust side pushes into the tool flow screens.

export struct FileItem {
    uid: int,
    name: string,
    // "3.17 MB - 7 pages"
    info: string,
    thumb: image,
    has-thumb: bool,
    // 0 = PDF, 1 = image, 2 = office / HTML document
    kind: int,
    locked: bool,
    // The preview could not be rendered; the file is still processed.
    preview-failed: bool,
}

// One page of the Organize grid. page 0 = inserted blank page.
export struct PageItem {
    page: int,
    thumb: image,
    has-thumb: bool,
}

export struct ResultFile {
    name: string,
    info: string,
    // Compress: "PDF compressed (-29%)"; empty otherwise.
    note: string,
    is-pdf: bool,
    // Not a PDF: "image", "docx", "pptx" or "xlsx" (the card's icon).
    kind: string,
}

export struct ContinueTool {
    id: string,
    name: string,
    icon: image,
    tile: color,
}

export struct ToolTab {
    id: int,
    tool: string,
    name: string,
    icon: image,
    tile: color,
    multi: bool,
    // 0 = choosing files and options, 1 = running, 2 = result
    phase: int,
    progress: float,
    progress-text: string,
    // Cancel pressed, waiting for the job to stop.
    cancelling: bool,
    // Organize: page previews could not be rendered.
    preview-failed: bool,
    files: [FileItem],
    pages: [PageItem],
    office-missing: bool,
    // Every file is probed (page count known, no password pending).
    files-ready: bool,
    default-out: string,
    // Result page
    result-title: string,
    result-sub: string,
    result-pct: string,
    size-before: string,
    size-after: string,
    warning: string,
    // Batch with some failed inputs: "1 file failed:" and one "name — error" line each.
    failure-title: string,
    failures: [string],
    // Things to know about the outputs (PDF/A rules still broken): a heading and one line each.
    notes-title: string,
    notes: [string],
    outputs: [ResultFile],
    // Crop: page 1 of the file, and its displayed size in points.
    preview: image,
    has-preview: bool,
    preview-w: float,
    preview-h: float,
    continue-tools: [ContinueTool],
}

// Everything the options panels collect, sent with the action button.
export struct ToolOptions {
    level: int,          // compress: 0 extreme, 1 recommended, 2 low
    password: string,    // protect
    confirm: string,
    owner: string,
    pages: string,       // remove / extract / rotate (optional)
    split-mode: int,     // 0 ranges, 1 every N
    ranges: string,
    every: int,
    degrees: int,        // 90 / 180 / 270
    layout: int,         // jpg→pdf: 0 fit, 1 A4 portrait, 2 A4 landscape
    margin: int,         // 0 none, 1 small, 2 big
    quality: int,        // pdf→jpg: 0 normal, 1 high
    out-name: string,    // merge
    // Page numbers and watermark: page range ("" = first / last page).
    from-page: string,
    to-page: string,
    // Page numbers
    num-position: int,   // 3×3 grid cell, row by row from the top left (top and bottom rows only)
    num-double: bool,    // double-sided
    num-cover: bool,     // first page is a cover page
    num-margin: int,     // 0 small, 1 recommended, 2 big
    num-start: string,   // first number
    num-text: int,       // 0 number only, 1 "Page {n}", 2 "Page {n} of {p}", 3 custom
    num-custom: string,
    // Watermark
    wm-image-mode: bool,
    wm-text: string,
    wm-font-size: string,
    wm-color: int,       // 0 black, 1 grey, 2 red, 3 blue
    wm-image: string,    // picture file path
    wm-scale: int,       // percent of the page
    wm-position: int,    // 3×3 grid cell
    wm-mosaic: bool,
    wm-transparency: int, // 0 none, 1 25 %, 2 50 %, 3 75 %
    wm-rotation: int,    // 0 none, 1 45°, 2 90°, 3 180°, 4 270°, 5 −45°
    wm-below: bool,
    // Crop
    crop-mode: int,      // 0 all pages, 1 selected pages, 2 remove crop
    crop-top: string,    // millimetres
    crop-bottom: string,
    crop-left: string,
    crop-right: string,
    // PDF to PDF/A
    pdfa-level: int,     // 0 PDF/A-2b, 1 PDF/A-3b
    // OCR
    ocr-languages: string, // selected language codes, ",en,fr," (the first one is used)
    ocr-all-pages: bool,   // also read pages that already contain text
    // PDF to Word / PowerPoint / Excel
    export-ocr: bool,      // recognise scanned pages first
    excel-layout: int,     // 0 one sheet, 1 one sheet per table
}

export struct OcrLanguage {
    code: string,
    name: string,
}

// What the OCR engine offers, set once at startup.
export global OcrInfo {
    in property <[OcrLanguage]> languages;
    // The recognition models are installed.
    in property <bool> available;
}

// Text parsing the options panels need and Slint lacks, answered by the Rust side.
export global Parse {
    // A millimetre field: "2,5" and "2.5" are both 2.5; empty or invalid is 0.
    pure callback mm(string) -> float;
    // Why a custom page-number text is refused ("" when it is fine).
    pure callback custom-text-error(string) -> string;
    // A set of codes written ",a,b,": whether `code` is in it, and the set with `code` toggled.
    pure callback has-code(string, string) -> bool;
    pure callback toggle-code(string, string) -> string;
}
