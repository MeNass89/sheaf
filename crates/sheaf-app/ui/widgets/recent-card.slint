import { Theme } from "../theme.slint";
import { Thumb } from "file-card.slint";
import { IconButton } from "button.slint";
import { RecentFile } from "../history-types.slint";

// A recent output file: page-1 thumbnail, name, size and pages, age. Click opens it.
export component RecentCard inherits Rectangle {
    in property <RecentFile> file;
    callback open();
    callback reveal();
    callback remove();
    callback pin();
    accessible-role: button;
    accessible-label: root.file.name;
    accessible-action-default => { root.open(); }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return { root.open(); return accept; }
            if e.text == Key.Delete || e.text == Key.Backspace { root.remove(); return accept; }
            reject
        }
    }

    width: Theme.file-card-width + 20px;
    height: Theme.file-card-height + 18px;
    border-radius: Theme.radius-item;
    background: Theme.card;
    border-width: 1px;
    border-color: touch.has-hover || focus.has-focus ? Theme.dashed : Theme.card;

    Rectangle {
        y: 14px;
        height: Theme.file-thumb-height;
        if root.file.kind == 2: Image {
            width: 48px;
            height: 48px;
            source: @image-url("../icons/file-text.svg");
            colorize: Theme.text-muted;
        }
        if root.file.kind != 2: Thumb {
            thumb: root.file.thumb;
            has-thumb: root.file.has-thumb;
            max-w: Theme.file-thumb-width + (root.file.kind == 1 ? 30px : 0);
            max-h: Theme.file-thumb-height;
        }
    }
    VerticalLayout {
        x: 6px;
        y: 14px + Theme.file-thumb-height + 8px;
        width: parent.width - 12px;
        height: self.preferred-height;
        spacing: 2px;
        Text {
            text: root.file.name;
            font-size: Theme.fs-label;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.file.info;
            font-size: Theme.fs-caption;
            color: Theme.text-muted;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.file.when;
            font-size: Theme.fs-caption;
            color: Theme.text-muted;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
        // Inside the TouchArea so hovering it keeps the card hovered.
        if touch.has-hover || focus.has-focus: Rectangle {
            x: 4px;
            y: 4px;
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-small;
            background: Theme.card;
            IconButton {
                icon: @image-url("../icons/folder-open.svg");
                accessible-role: button;
                accessible-label: "Show in folder";
                accessible-action-default => { root.reveal(); }
                clicked => { root.reveal(); }
            }
        }
        // The star (PDF Expert's Favorites): shown on hover, and always once starred.
        Rectangle {
            opacity: touch.has-hover || focus.has-focus || root.file.pinned ? 1 : 0;
            x: (parent.width - self.width) / 2;
            y: 4px;
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-small;
            background: pt.has-hover ? Theme.popup-hover : Theme.card;
            accessible-role: button;
            accessible-label: root.file.pinned ? "Unstar" : "Star";
            accessible-action-default => { root.pin(); }
            Image {
                width: 15px;
                height: 15px;
                source: @image-url("../icons/star.svg");
                colorize: root.file.pinned ? #F5B301 : Theme.text-muted;
            }
            pt := TouchArea { mouse-cursor: pointer; clicked => { root.pin(); } }
        }
        if touch.has-hover || focus.has-focus: Rectangle {
            x: parent.width - self.width - 4px;
            y: 4px;
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-small;
            background: Theme.card;
            IconButton {
                icon: @image-url("../icons/x.svg");
                accessible-role: button;
                accessible-label: "Remove from recents";
                accessible-action-default => { root.remove(); }
                clicked => { root.remove(); }
            }
        }
    }
}
