import { Theme } from "../theme.slint";
import { FileItem, PageItem } from "../flow-types.slint";

// Round hover button used on cards (×, ←, →).
export component MiniButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: touch.has-hover && root.enabled ? Theme.text : Theme.badge-bg;
    opacity: root.enabled ? 1 : 0.3;
    Image {
        width: 12px;
        height: 12px;
        source: root.icon;
        colorize: Theme.on-badge;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Page-1 thumbnail, or a grey placeholder until it is rendered.
export component Thumb inherits Rectangle {
    in property <image> thumb;
    in property <bool> has-thumb;
    in property <length> max-w;
    in property <length> max-h;
    // Degrees clockwise the page is shown turned (Rotate's preview, as iLovePDF's cards).
    in property <int> turn;
    property <bool> sideways: Math.mod(root.turn, 180) == 90;
    property <float> upright: root.has-thumb && root.thumb.height > 0
        ? root.thumb.width / root.thumb.height : 0.707;
    property <float> ratio: root.sideways ? 1 / root.upright : root.upright;
    width: min(root.max-w, root.max-h * root.ratio);
    height: min(root.max-h, root.max-w / root.ratio);
    background: Theme.thumb-placeholder;
    drop-shadow-blur: 6px;
    drop-shadow-color: Theme.thumb-shadow;
    drop-shadow-offset-y: 1px;
    if root.has-thumb: Image {
        width: root.sideways ? parent.height : parent.width;
        height: root.sideways ? parent.width : parent.height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.thumb;
        image-fit: fill;
        transform-rotation: root.turn * 1deg;
        animate transform-rotation { duration: 150ms; }
    }
}

// A file waiting to be processed.
export component FileCardView inherits Rectangle {
    in property <FileItem> file;
    in property <color> tile;
    in property <bool> reorder;
    in property <bool> first;
    in property <bool> last;
    in property <bool> interactive: true;
    callback remove();
    callback move(int);
    // Dragged to reorder: where the pointer is (window coordinates), and let go.
    callback drag-to(length, length);
    callback drag-end();
    // Being dragged: shown faded where it was (not while a cancelled drag is still held).
    in property <bool> dimmed;
    // Merge: the caption is the file's page choice, clicked to type it ("1-3, 5"; Enter keeps it).
    in property <bool> ranges;
    // Rotate: page 1 shown turned as chosen.
    in property <int> turn;
    callback set-pages(string);
    property <bool> editing;
    property <bool> dragging;

    width: Theme.file-card-width;
    height: Theme.file-card-height;
    border-radius: Theme.radius-item;
    background: Theme.card;
    opacity: root.dimmed ? 0.35 : 1.0;
    border-width: 1px;
    border-color: touch.has-hover && root.interactive ? Theme.dashed : Theme.card;

    Rectangle {
        y: 14px;
        height: Theme.file-thumb-height;
        // A document shows its icon until LibreOffice has drawn its page 1.
        if root.file.kind == 2 && !root.file.has-thumb: Image {
            width: 48px;
            height: 48px;
            source: @image-url("../icons/file-text.svg");
            colorize: root.tile;
        }
        if root.file.kind != 2 || root.file.has-thumb: Thumb {
            thumb: root.file.thumb;
            has-thumb: root.file.has-thumb;
            turn: root.turn;
            max-w: Theme.file-thumb-width + (root.file.kind == 1 ? 30px : 0);
            max-h: Theme.file-thumb-height;
        }
    }
    if root.file.locked: Rectangle {
        x: parent.width / 2 + 18px;
        y: 10px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.badge-bg;
        Image {
            width: 11px;
            height: 11px;
            source: @image-url("../icons/lock.svg");
            colorize: Theme.on-badge;
        }
    }
    Text {
        x: 6px;
        y: 14px + Theme.file-thumb-height + 10px;
        width: parent.width - 12px;
        text: root.file.name;
        font-size: Theme.fs-label;
        color: Theme.text;
        horizontal-alignment: center;
        overflow: elide;
    }
    if !root.ranges || root.file.kind != 0: Text {
        x: 4px;
        y: 14px + Theme.file-thumb-height + 28px;
        width: parent.width - 8px;
        text: root.file.preview-failed ? "⚠ preview unavailable" : root.file.info;
        font-size: Theme.fs-caption;
        color: root.file.preview-failed ? Theme.warning : Theme.text-muted;
        horizontal-alignment: center;
        overflow: elide;
    }

    // Hover controls live inside the card's TouchArea so hovering them keeps the card hovered.
    touch := TouchArea {
        // A drag of over 6 px reorders (iLovePDF and Stirling drag file cards).
        moved => {
            if root.reorder && root.interactive && self.pressed
                && (root.dragging || abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                root.dragging = true;
                root.drag-to(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.drag-end();
            }
        }
        if root.ranges && root.file.kind == 0 && !root.editing: Rectangle {
            x: 4px;
            y: 14px + Theme.file-thumb-height + 25px;
            width: parent.width - 8px;
            height: 18px;
            border-radius: 3px;
            background: pages-touch.has-hover ? Theme.menu-hover-bg : transparent;
            Text {
                width: parent.width - 4px;
                text: root.file.pages-label;
                font-size: Theme.fs-caption;
                color: root.file.pages-bad ? Theme.warning : root.file.pages-spec != "" || pages-touch.has-hover ? Theme.accent : Theme.text-muted;
                horizontal-alignment: center;
                overflow: elide;
            }
            pages-touch := TouchArea {
                enabled: root.interactive;
                mouse-cursor: pointer;
                clicked => {
                    root.editing = true;
                }
            }
        }
        if root.ranges && root.file.kind == 0 && root.editing: Rectangle {
            x: 6px;
            y: 14px + Theme.file-thumb-height + 24px;
            width: parent.width - 12px;
            height: 20px;
            border-radius: 3px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.accent;
            pages-input := TextInput {
                x: 5px;
                width: parent.width - 10px;
                font-size: Theme.fs-caption;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                init => {
                    self.text = root.file.pages-spec;
                    self.focus();
                    self.select-all();
                }
                accepted => {
                    root.set-pages(self.text);
                    root.editing = false;
                }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.editing = false;
                        return accept;
                    }
                    reject
                }
                changed has-focus => {
                    if !self.has-focus && root.editing {
                        root.set-pages(self.text);
                        root.editing = false;
                    }
                }
            }
            if pages-input.text == "": Text {
                x: 5px;
                text: "e.g. 1-3, 5";
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
            }
        }
        if touch.has-hover && root.interactive && !root.dragging: MiniButton {
            x: parent.width - self.width - 6px;
            y: 6px;
            icon: @image-url("../icons/x.svg");
            clicked => { root.remove(); }
        }
        if touch.has-hover && root.interactive && root.reorder && !root.dragging: HorizontalLayout {
            x: 6px;
            y: 50px;
            width: parent.width - 12px;
            height: 22px;
            MiniButton {
                icon: @image-url("../icons/arrow-left.svg");
                enabled: !root.first;
                clicked => { root.move(-1); }
            }
            Rectangle { }
            MiniButton {
                icon: @image-url("../icons/arrow-right.svg");
                enabled: !root.last;
                clicked => { root.move(1); }
            }
        }
    }
}

// One page of the Organize grid.
export component PageCardView inherits Rectangle {
    in property <PageItem> item;
    in property <bool> first;
    in property <bool> last;
    in property <bool> interactive: true;
    callback remove();
    callback move(int);

    width: Theme.page-thumb-width + 24px;
    height: Theme.page-thumb-height + 44px;
    border-radius: Theme.radius-item;
    background: Theme.card;
    border-width: 1px;
    border-color: touch.has-hover && root.interactive ? Theme.dashed : Theme.card;

    Rectangle {
        y: 10px;
        height: Theme.page-thumb-height;
        Thumb {
            thumb: root.item.thumb;
            has-thumb: root.item.has-thumb;
            max-w: Theme.page-thumb-width;
            max-h: Theme.page-thumb-height;
            background: root.item.page == 0 ? Theme.art-page : Theme.thumb-placeholder;
        }
    }
    Text {
        y: Theme.page-thumb-height + 18px;
        text: root.item.page == 0 ? "Blank" : "Page " + root.item.page;
        font-size: Theme.fs-caption;
        color: Theme.text-muted;
    }
    // Hover controls live inside the card's TouchArea so hovering them keeps the card hovered.
    touch := TouchArea {
        if touch.has-hover && root.interactive: MiniButton {
            x: parent.width - self.width - 4px;
            y: 4px;
            icon: @image-url("../icons/x.svg");
            clicked => { root.remove(); }
        }
        if touch.has-hover && root.interactive: HorizontalLayout {
            x: 4px;
            y: parent.height - 30px;
            width: parent.width - 8px;
            height: 22px;
            MiniButton {
                icon: @image-url("../icons/arrow-left.svg");
                enabled: !root.first;
                clicked => { root.move(-1); }
            }
            Rectangle { }
            MiniButton {
                icon: @image-url("../icons/arrow-right.svg");
                enabled: !root.last;
                clicked => { root.move(1); }
            }
        }
    }
}

// One page of Split's grid (PDF Expert's split points): the file it goes into, tinted and numbered,
// and the gap after it, clicked to cut there or join again.
export component SplitPageView inherits Rectangle {
    in property <PageItem> item;
    // The output file (0-based) the page goes into; -1 when no range takes it.
    in property <int> range;
    // A cut after this page: the next page starts another file.
    in property <bool> cut;
    in property <bool> last;
    in property <bool> interactive: true;
    callback toggle-cut();
    property <[color]> tints: [#2f6fd6, #1f9d62, #c77d0a, #8150c8, #c43d5a, #13899b];
    property <color> tint: root.range >= 0 ? root.tints[mod(root.range, 6)] : Theme.card;
    width: Theme.page-thumb-width + 24px + 18px;
    // 14 px below each card: the rows' spacing (the grid's own is the gaps' 2 px).
    height: Theme.page-thumb-height + 44px + 14px;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width - 18px;
        height: parent.height - 14px;
        border-radius: Theme.radius-item;
        background: Theme.card;
        border-width: 2px;
        border-color: root.tint;
        opacity: root.range < 0 ? 0.45 : 1.0;
        Rectangle {
            y: 10px;
            height: Theme.page-thumb-height;
            Thumb {
                thumb: root.item.thumb;
                has-thumb: root.item.has-thumb;
                max-w: Theme.page-thumb-width;
                max-h: Theme.page-thumb-height;
            }
        }
        Text {
            y: Theme.page-thumb-height + 18px;
            text: "Page " + root.item.page;
            font-size: Theme.fs-caption;
            color: Theme.text-muted;
        }
        if root.range >= 0: Rectangle {
            x: 6px;
            y: 6px;
            width: file-no.preferred-width + 10px;
            height: 16px;
            border-radius: 8px;
            background: root.tint;
            file-no := Text {
                text: root.range + 1;
                font-size: 10px;
                font-weight: Theme.weight-demibold;
                color: white;
            }
        }
    }
    if !root.last: Rectangle {
        x: parent.width - 18px;
        y: 0;
        width: 18px;
        height: parent.height - 14px;
        Rectangle {
            x: 8px;
            width: 2px;
            background: root.cut ? Theme.accent : gap.has-hover && root.interactive ? Theme.dashed : transparent;
        }
        if root.cut || (gap.has-hover && root.interactive): Rectangle {
            width: 22px;
            height: 22px;
            x: -2px;
            border-radius: 11px;
            background: root.cut ? Theme.accent : Theme.card;
            border-width: root.cut ? 0 : 1px;
            border-color: Theme.dashed;
            Image {
                width: 12px;
                height: 12px;
                source: @image-url("../icons/scissors.svg");
                colorize: root.cut ? Theme.on-accent : Theme.text-secondary;
            }
        }
        gap := TouchArea {
            enabled: root.interactive;
            mouse-cursor: pointer;
            clicked => { root.toggle-cut(); }
        }
    }
}
