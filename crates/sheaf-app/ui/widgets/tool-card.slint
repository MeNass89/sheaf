import { Theme } from "../theme.slint";

export struct ToolCard {
    id: string,
    name: string,
    category: int,
    icon: image,
    tile: color,
    enabled: bool,
    // Starred by the user (shown first on Home and Tools).
    favourite: bool,
}

// 132 x 136 card: coloured icon tile on top, name below.
export component ToolCardView inherits Rectangle {
    in property <ToolCard> tool;
    // The search's chosen result (↑↓ move it, ↩ opens it).
    in property <bool> highlighted;
    callback clicked(string);
    callback star(string);

    width: Theme.card-width;
    height: Theme.card-height;
    border-radius: Theme.radius-card;
    background: Theme.card;
    border-width: root.highlighted ? 2px : 1px;
    border-color: root.highlighted ? Theme.accent : tool.enabled && touch.has-hover ? Theme.card-border-hover : Theme.card;
    opacity: tool.enabled ? 1.0 : 0.5;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: Theme.card-tile-top;
        width: Theme.card-tile;
        height: Theme.card-tile;
        border-radius: 8px;
        background: root.tool.tile;
        Image {
            source: root.tool.icon;
            width: Theme.card-icon;
            height: Theme.card-icon;
            colorize: white;
        }
    }

    Text {
        x: 6px;
        y: Theme.card-tile-top + Theme.card-tile + Theme.card-label-gap;
        width: parent.width - 12px;
        height: 40px;
        text: root.tool.name;
        font-size: Theme.fs-card;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: top;
        wrap: word-wrap;
        overflow: elide;
        line-height-factor: Theme.line-height;
    }

    if !root.tool.enabled: Rectangle {
        x: parent.width - self.width - 6px;
        y: 6px;
        width: soon.preferred-width + 10px;
        height: 16px;
        border-radius: 8px;
        background: Theme.pill-bg;
        soon := Text {
            text: @tr("Soon");
            font-size: Theme.fs-caption;
            font-weight: Theme.weight-demibold;
            color: Theme.text-secondary;
        }
    }

    touch := TouchArea {
        enabled: root.tool.enabled;
        mouse-cursor: root.tool.enabled ? pointer : default;
        clicked => { root.clicked(root.tool.id); }
    }

    // Star a tool (Stirling's favourites): on hover, always shown once starred.
    // Always there (not created on hover): a star that came and went with the card's hover lost
    // the click to the card.
    Rectangle {
        opacity: touch.has-hover || st.has-hover || root.tool.favourite ? 1 : 0;
        x: 6px;
        y: 6px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: st.has-hover ? Theme.popup-hover : transparent;
        Image {
            width: 14px;
            height: 14px;
            source: @image-url("../icons/star.svg");
            colorize: root.tool.favourite ? #F5B301 : Theme.text-muted;
        }
        st := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.star(root.tool.id); }
        }
    }
}
