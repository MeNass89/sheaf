import { ScrollView } from "std-widgets.slint";
import { Theme, Motion } from "../theme.slint";

// A popup button (DESIGN §4 Combo): 28 tall, `fill-2`, the label then a 12 px chevron. The label
// elides before the chevron, which is never clipped (the narrow side panel's "By page ⌄"); 88
// wide at least where it shares a row (its callers clamp it). New code may use PopupButton
// (controls.slint); this keeps the older API.
export component SortCombo inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index: 0;
    in property <image> chevron;
    callback selected(int);

    width: Theme.combo-width;
    height: Theme.combo-height;
    border-radius: Theme.r-sm;
    background: touch.pressed || touch.has-hover ? Theme.fill-3 : Theme.fill-2;
    animate background { duration: Motion.hover; }
    accessible-role: combobox;
    accessible-value: root.options[root.current-index];
    accessible-action-default => { popup.show(); }

    Text {
        x: 8px;
        width: parent.width - 8px - 4px - 12px - 8px;
        text: root.options[root.current-index];
        font-size: Theme.fs-body;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - self.width - 8px;
        width: 12px;
        height: 12px;
        source: root.chevron;
        colorize: Theme.text-2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    // At most ten entries tall; a longer list (the reader's stamps) scrolls instead of being pushed
    // up past the window's edge.
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 160px);
        height: min(root.options.length * Theme.row-height + 8px, 288px);
        Rectangle {
            background: Theme.window;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: Theme.popover-blur;
            drop-shadow-offset-y: Theme.popover-y;
            drop-shadow-color: Theme.popover-shadow;
            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    for opt[i] in root.options: Rectangle {
                        height: Theme.row-height;
                        border-radius: Theme.r-row;
                        background: ta.has-hover ? Theme.accent : transparent;
                        Image {
                            x: 6px;
                            width: 12px;
                            height: 12px;
                            visible: i == root.current-index;
                            source: @image-url("../icons/check.svg");
                            colorize: ta.has-hover ? Theme.on-accent : Theme.text;
                        }
                        Text {
                            x: 24px;
                            width: parent.width - 32px;
                            text: opt;
                            font-size: Theme.fs-body;
                            color: ta.has-hover ? Theme.on-accent : Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ta := TouchArea {
                            clicked => {
                                root.current-index = i;
                                root.selected(i);
                            }
                        }
                    }
                }
            }
        }
    }
}
