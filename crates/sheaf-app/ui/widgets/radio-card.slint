import { Theme } from "../theme.slint";

// Full-width choice card: radio circle, title, optional description; both wrap when the panel
// is too narrow for them, and the card grows.
export component RadioCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> selected;
    callback clicked();

    height: max(root.description == "" ? 36px : Theme.radio-card-height, lines.preferred-height + 12px);
    border-radius: Theme.radius-button;
    border-width: root.selected ? 0 : 1px;
    border-color: touch.has-hover ? Theme.text-secondary : Theme.option-border;
    background: root.selected ? Theme.option-selected-bg : Theme.panel-bg;

    // Radio circle
    Rectangle {
        x: 12px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: root.selected ? 0 : 1.5px;
        border-color: Theme.option-border;
        background: root.selected ? Theme.success-strong : transparent;
        if root.selected: Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.on-success;
        }
    }
    lines := VerticalLayout {
        x: 40px;
        width: parent.width - 52px;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.title;
            font-size: Theme.fs-label;
            font-weight: Theme.weight-demibold;
            color: root.selected ? Theme.accent : Theme.text;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: Theme.fs-caption;
            color: root.selected ? Theme.accent : Theme.text-muted;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Small segmented choice ("90°", "180°", …).
export component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    // The label drawn in a style of its own (a font row shows each choice in its look).
    in property <string> label-family;
    in property <bool> label-bold;
    in property <bool> label-italic;
    in property <bool> label-underline;
    callback clicked();

    height: 32px;
    border-radius: Theme.radius-button;
    border-width: root.selected ? 0 : 1px;
    border-color: touch.has-hover ? Theme.text-secondary : Theme.option-border;
    background: root.selected ? Theme.option-selected-bg : Theme.panel-bg;
    seg-label := Text {
        text: root.text;
        font-size: Theme.fs-label;
        font-weight: root.label-bold ? 700 : root.selected ? Theme.weight-demibold : 400;
        font-italic: root.label-italic;
        font-family: root.label-family;
        color: root.selected ? Theme.accent : Theme.text;
    }
    if root.label-underline: Rectangle {
        x: seg-label.x;
        y: seg-label.y + seg-label.height - 3px;
        width: seg-label.width;
        height: 1px;
        background: seg-label.color;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Blue information box under the options.
export component InfoBox inherits Rectangle {
    in property <string> text;
    in property <image> icon: @image-url("../icons/info.svg");
    background: Theme.info-bg;
    border-radius: Theme.radius-small;
    height: lay.preferred-height;
    lay := HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Image {
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: Theme.info;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12px;
            color: Theme.text;
            wrap: word-wrap;
            line-height-factor: Theme.line-height;
        }
    }
}
