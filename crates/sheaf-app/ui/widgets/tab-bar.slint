import { Theme } from "../theme.slint";
import { IconButton } from "button.slint";
import { ToolTab } from "../flow-types.slint";
import { PlatformBridge } from "../platform.slint";

// One tab (DESIGN §4 TabItem): 120–240 wide, the full 38 of the strip, a monochrome icon 14 at 12,
// the name, × on hover (and on the selected tab). The selected tab is the `window` colour with a
// hairline each side, joined to the toolbar under it; the others are the strip's `chrome`. A middle
// click closes it.
export component TabItem inherits Rectangle {
    in property <ToolTab> tab;
    in property <bool> active;
    // Draw the divider on its right (an inactive neighbour follows).
    in property <bool> divider;
    callback select();
    callback close();
    // Dragged sideways by `dx` (still pressed), then let go.
    callback drag(length);
    callback dropped(length);
    callback close-around(int);
    property <bool> dragging;
    property <bool> narrow: root.width < 150px;
    // Right to left (Preferences ▸ Interface ▸ Direction): icon on the right, × on the left.
    property <bool> rtl: PlatformBridge.rtl;
    property <length> name-start: 12px + Theme.tab-icon + 10px;
    // The unsaved dot sits where the × goes: the name stops before either.
    property <length> name-end: (close.visible || root.unsaved) ? 30px : 8px;
    width: Theme.tab-max-width;
    height: Theme.tabbar-height;
    background: root.active ? Theme.window : touch.has-hover ? Theme.fill-1 : transparent;
    accessible-role: AccessibleRole.tab;
    accessible-label: root.tab.name;
    accessible-item-selected: root.active;
    accessible-action-default => { root.select(); }
    // The selected tab's sides.
    if root.active: Rectangle { x: 0; width: 1px; background: Theme.hairline; }
    if root.active: Rectangle { x: parent.width - 1px; width: 1px; background: Theme.hairline; }
    // A task running in this tab: its progress along the tab's foot, followed from any other tab
    // (the task goes on while another document is read).
    if root.tab.phase == 1: Rectangle {
        x: 8px;
        y: parent.height - 4px;
        width: parent.width - 16px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.progress-track;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.tab.progress, 0, 1);
            border-radius: 1.5px;
            background: Theme.accent;
            animate width { duration: 150ms; }
        }
    }
    touch := TouchArea {
        clicked => { if !root.dragging { root.select(); } }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle { root.close(); }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.dragging = false; }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.dragging {
                root.dropped(self.mouse-x - self.pressed-x);
                root.dragging = false;
            }
        }
        moved => {
            if self.pressed && abs(self.mouse-x - self.pressed-x) > 6px {
                root.dragging = true;
                root.drag(self.mouse-x - self.pressed-x);
            }
        }
    }
    // Right click: close the others, those to the left or to the right, or all (iLovePDF's tab menu).
    ContextMenuArea {
        Menu {
            MenuItem { title: @tr("Close Other Tabs"); activated => { root.close-around(0); } }
            MenuItem { title: @tr("Close Tabs to the Left"); activated => { root.close-around(1); } }
            MenuItem { title: @tr("Close Tabs to the Right"); activated => { root.close-around(2); } }
            MenuItem { title: @tr("Close All Tabs"); activated => { root.close-around(3); } }
            // A document's file (PDF Expert's File menu): renamed where it is, shown, or trashed.
            MenuSeparator { }
            MenuItem { title: @tr("Rename…"); enabled: root.tab.is-reader; activated => { root.close-around(4); } }
            MenuItem { title: @tr("Show in Folder"); enabled: root.tab.is-reader; activated => { root.close-around(5); } }
            MenuItem { title: @tr("Move to Trash"); enabled: root.tab.is-reader; activated => { root.close-around(6); } }
            MenuItem { title: @tr("Move to New Window"); enabled: root.tab.is-reader; activated => { root.close-around(7); } }
            MenuItem { title: @tr("Merge All Windows"); activated => { root.close-around(8); } }
        }
    }
    if root.divider: Rectangle {
        x: root.rtl ? 0 : parent.width - 1px;
        y: 11px;
        width: 1px;
        height: parent.height - 22px;
        background: Theme.hairline;
    }
    // Monochrome: no coloured tiles in the chrome (DESIGN §1 Feeling).
    Image {
        x: root.rtl ? parent.width - 12px - self.width : 12px;
        width: Theme.tab-icon;
        height: Theme.tab-icon;
        source: root.tab.icon;
        colorize: root.active ? Theme.text : Theme.text-2;
    }
    Text {
        x: root.rtl ? root.name-end : root.name-start;
        // Up to the close button (24 px from the right edge), elided before it.
        width: parent.width - root.name-start - root.name-end;
        horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.tab.name;
        font-size: Theme.fs-body;
        color: root.active ? Theme.text : Theme.text-2;
        vertical-alignment: center;
        overflow: elide;
    }
    // A document with unsaved changes shows a dot where its × goes (macOS's and PDF Expert's), the ×
    // back on hover.
    property <bool> unsaved: root.tab.is-reader && root.tab.reader.dirty;
    if root.unsaved && !touch.has-hover: Rectangle {
        x: root.rtl ? 10px : parent.width - 18px;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.text-2;
    }
    close := IconButton {
        visible: (root.active || touch.has-hover || self.has-hover) && (!root.unsaved || touch.has-hover || self.has-hover);
        x: root.rtl ? 8px : parent.width - self.width - 8px;
        width: 20px;
        height: 20px;
        icon-size: 14px;
        icon: @image-url("../icons/x.svg");
        clicked => { root.close(); }
    }
}

export component TabBar inherits Rectangle {
    in property <[ToolTab]> tabs;
    // Rows of `tabs` in the order shown; `active` is a row.
    in property <[int]> order;
    // The active tab's place in the bar.
    property <int> active-at: -1;
    in-out property <int> active: -1;
    callback close-tab(int);
    callback new-tab();
    callback move-tab(int, int);
    callback close-tabs-around(int, int);
    height: Theme.tabbar-height;
    // A tab being dragged: its index and how far, for the drop line.
    property <int> drag-from: -1;
    property <length> drag-dx;
    // Where it would land: whole tab widths away from where it was.
    // Right to left, a drag to the left goes further along the bar.
    property <int> drop-at: root.drag-from < 0 ? -1
        : clamp(root.drag-from + round((PlatformBridge.rtl ? -root.drag-dx : root.drag-dx) / root.other-w), 0, root.tabs.length - 1);
    background: Theme.chrome;
    // The Home tab, pinned first (its icon and name).
    property <length> home-w: Theme.tab-min-width;
    // Tabs share the bar: 240 wide while they fit, narrower down to 120 as more open (a
    // browser's), then the row scrolls (wheel or trackpad) and the active tab is kept in view.
    property <length> room: root.width - root.home-w - 38px - 8px;
    property <length> each: root.tabs.length == 0 ? Theme.tab-max-width
        : clamp(root.room / root.tabs.length, Theme.tab-min-width, Theme.tab-max-width);
    property <length> active-w: root.each;
    property <length> other-w: root.each;
    property <length> row-width: root.home-w + root.tabs.length * root.each + 38px;
    changed active => { if root.active < 0 { root.active-at = -1; } }
    // The active tab is kept in view (its place is set by the tab itself).
    changed active-at => {
        if root.active-at >= 0 {
            let from-start = root.home-w + root.active-at * root.other-w;
            // Right to left the bar starts at the right edge of the row.
            let left = PlatformBridge.rtl ? strip.content-width - from-start - root.active-w : from-start;
            if left + root.active-w > -strip.content-x + strip.width { strip.content-x = -(left + root.active-w - strip.width + 4px); }
            if left < -strip.content-x { strip.content-x = min(0px, -(left - 8px)); }
        }
    }

    strip := Flickable {
        // Scrolled by wheel or trackpad only: a mouse drag moves a tab.
        interactive: false;
        y: 0;
        height: Theme.tabbar-height;
        content-width: max(root.row-width, self.width);
        content-height: self.height;
    // A flexbox, not a HorizontalLayout, so that right to left reverses it (Slint's rows have no
    // direction of their own).
    FlexboxLayout {
        x: 0;
        width: parent.width;
        height: Theme.tabbar-height;
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: start;
        spacing: 0px;
        // "Home" tab, pinned first.
        // Full tab height, as the other tabs: unset, the flexbox gave it its content's height.
        Rectangle {
            width: root.home-w;
            height: Theme.tabbar-height;
            background: root.active == -1 ? Theme.window : home-touch.has-hover ? Theme.fill-1 : transparent;
            accessible-role: AccessibleRole.tab;
            accessible-label: @tr("Home");
            accessible-item-selected: root.active == -1;
            accessible-action-default => { root.active = -1; }
            if root.active == -1: Rectangle { x: parent.width - 1px; width: 1px; background: Theme.hairline; }
            home-touch := TouchArea {
                clicked => { root.active = -1; }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 8px;
                alignment: start;
                Image {
                    source: @image-url("../icons/house.svg");
                    width: Theme.tab-icon;
                    height: Theme.tab-icon;
                    y: (parent.height - self.height) / 2;
                    colorize: root.active == -1 ? Theme.text : Theme.text-2;
                }
                Text {
                    text: @tr("Home");
                    font-size: Theme.fs-body;
                    color: root.active == -1 ? Theme.text : Theme.text-2;
                    vertical-alignment: center;
                }
            }
        }
        for k[i] in root.order: TabItem {
            width: root.active == k ? root.active-w : root.other-w;
            divider: root.active != k && i + 1 < root.order.length && root.active != root.order[i + 1];
            init => { if root.active == k { root.active-at = i; } }
            changed active => { if self.active { root.active-at = i; } }
            drag(dx) => { root.drag-from = i; root.drag-dx = dx; }
            dropped(dx) => {
                root.drag-dx = dx;
                let to = root.drop-at;
                root.drag-from = -1;
                root.move-tab(i, to);
            }
            close-around(which) => { root.close-tabs-around(root.tabs[k].id, which); }
            tab: root.tabs[k];
            active: root.active == k;
            select => { root.active = k; }
            close => { root.close-tab(root.tabs[k].id); }
        }
        Rectangle {
            width: 38px;
            height: Theme.tabbar-height;
            IconButton {
                icon: @image-url("../icons/plus.svg");
                clicked => { root.new-tab(); }
            }
        }
    }
    // Where a dragged tab will go.
    if root.drag-from >= 0 && root.drop-at != root.drag-from: Rectangle {
        property <length> left: root.home-w + root.drop-at * root.other-w;
        property <length> ltr-x: root.drop-at > root.drag-from ? self.left + root.other-w - 1px : self.left - 1px;
        x: PlatformBridge.rtl ? strip.content-width - self.ltr-x - self.width : self.ltr-x;
        width: 2px;
        height: Theme.tabbar-height;
        background: Theme.accent;
    }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }
}
