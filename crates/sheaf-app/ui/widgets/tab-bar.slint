import { Theme } from "../theme.slint";
import { IconButton } from "button.slint";
import { ToolTab } from "../flow-types.slint";

// One tool tab: tile-colour icon, name (elided), ×. Narrow (many tabs open), the × shows on the
// active and the hovered tab only, as in a browser; a middle click closes it.
component TabItem inherits Rectangle {
    in property <ToolTab> tab;
    in property <bool> active;
    // Draw the divider on its right (an inactive neighbour follows).
    in property <bool> divider;
    callback select();
    callback close();
    // Dragged sideways by `dx` (still pressed), then let go.
    callback drag(length);
    callback dropped(length);
    callback close-around(int);
    property <bool> dragging;
    property <bool> narrow: root.width < 110px;
    width: Theme.tool-tab-width;
    height: Theme.tab-height;
    background: root.active ? Theme.tab-bg : touch.has-hover ? Theme.menu-hover-bg : transparent;
    border-top-left-radius: Theme.radius-small;
    border-top-right-radius: Theme.radius-small;
    // A task running in this tab: its progress along the tab's foot, followed from any other tab
    // (the task goes on while another document is read).
    if root.tab.phase == 1: Rectangle {
        x: 8px;
        y: parent.height - 4px;
        width: parent.width - 16px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.progress-track;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.tab.progress, 0, 1);
            border-radius: 1.5px;
            background: Theme.accent;
            animate width { duration: 150ms; }
        }
    }
    touch := TouchArea {
        clicked => { if !root.dragging { root.select(); } }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle { root.close(); }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.dragging = false; }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.dragging {
                root.dropped(self.mouse-x - self.pressed-x);
                root.dragging = false;
            }
        }
        moved => {
            if self.pressed && abs(self.mouse-x - self.pressed-x) > 6px {
                root.dragging = true;
                root.drag(self.mouse-x - self.pressed-x);
            }
        }
    }
    // Right click: close the others, those to the left or to the right, or all (iLovePDF's tab menu).
    ContextMenuArea {
        Menu {
            MenuItem { title: "Close Other Tabs"; activated => { root.close-around(0); } }
            MenuItem { title: "Close Tabs to the Left"; activated => { root.close-around(1); } }
            MenuItem { title: "Close Tabs to the Right"; activated => { root.close-around(2); } }
            MenuItem { title: "Close All Tabs"; activated => { root.close-around(3); } }
        }
    }
    if root.divider: Rectangle {
        x: parent.width - 1px;
        y: 9px;
        width: 1px;
        height: parent.height - 18px;
        background: Theme.option-border;
    }
    Rectangle {
        x: 12px;
        width: Theme.tab-icon + 2px;
        height: Theme.tab-icon + 2px;
        border-radius: 3px;
        background: root.tab.tile;
        Image {
            width: Theme.tab-icon - 4px;
            height: Theme.tab-icon - 4px;
            source: root.tab.icon;
            colorize: white;
        }
    }
    Text {
        x: 12px + Theme.tab-icon + 10px;
        // Up to the close button (24 px from the right edge), elided before it.
        width: parent.width - self.x - (close.visible ? 30px : 8px);
        text: root.tab.name;
        font-size: Theme.fs-tab;
        font-weight: root.active ? Theme.weight-demibold : 400;
        color: root.active ? Theme.text : Theme.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
    // A document with unsaved changes shows a dot where its × goes (macOS's and PDF Expert's), the ×
    // back on hover.
    property <bool> unsaved: root.tab.is-reader && root.tab.reader.dirty;
    if root.unsaved && !touch.has-hover: Rectangle {
        x: parent.width - 18px;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.text-secondary;
    }
    close := IconButton {
        visible: (!root.narrow || root.active || touch.has-hover) && (!root.unsaved || touch.has-hover);
        x: parent.width - self.width - 4px;
        width: 20px;
        height: 20px;
        icon-size: 12px;
        icon: @image-url("../icons/x.svg");
        clicked => { root.close(); }
    }
}

export component TabBar inherits Rectangle {
    in property <[ToolTab]> tabs;
    // Rows of `tabs` in the order shown; `active` is a row.
    in property <[int]> order;
    // The active tab's place in the bar.
    property <int> active-at: -1;
    in-out property <int> active: -1;
    callback close-tab(int);
    callback new-tab();
    callback move-tab(int, int);
    callback close-tabs-around(int, int);
    height: Theme.tabbar-height;
    // A tab being dragged: its index and how far, for the drop line.
    property <int> drag-from: -1;
    property <length> drag-dx;
    // Where it would land: whole tab widths away from where it was.
    property <int> drop-at: root.drag-from < 0 ? -1
        : clamp(root.drag-from + round(root.drag-dx / (root.other-w + 2px)), 0, root.tabs.length - 1);
    background: Theme.tabbar-bg;
    // Tabs share the bar: full width while they fit, narrower down to 72 px as more open (a
    // browser's), then the row scrolls (wheel or trackpad) and the active tab is kept in view.
    property <length> room: root.width - 8px - Theme.tab-width - 34px - 12px;
    property <length> each: root.tabs.length == 0 ? Theme.tool-tab-width
        : clamp((root.room - 2px * root.tabs.length) / root.tabs.length, 72px, Theme.tool-tab-width);
    // The active tab keeps room for its name (140 px); the others share what is left.
    property <length> active-w: min(Theme.tool-tab-width, max(root.each, 140px));
    property <length> other-w: root.active < 0 || root.tabs.length < 2 ? root.each
        : clamp((root.room - root.active-w - 2px * root.tabs.length) / (root.tabs.length - 1), 72px, Theme.tool-tab-width);
    property <length> row-width: 8px + Theme.tab-width + (root.tabs.length - 1) * (root.other-w + 2px) + root.active-w + 38px;
    changed active => { if root.active < 0 { root.active-at = -1; } }
    // The active tab is kept in view (its place is set by the tab itself).
    changed active-at => {
        if root.active-at >= 0 {
            let left = 8px + Theme.tab-width + 2px + root.active-at * (root.other-w + 2px);
            if left + root.active-w > -strip.content-x + strip.width { strip.content-x = -(left + root.active-w - strip.width + 4px); }
            if left < -strip.content-x { strip.content-x = min(0px, -(left - 8px)); }
        }
    }

    strip := Flickable {
        // Scrolled by wheel or trackpad only: a mouse drag moves a tab.
        interactive: false;
        y: parent.height - Theme.tab-height;
        height: Theme.tab-height;
        content-width: max(root.row-width, self.width);
        content-height: self.height;
    HorizontalLayout {
        x: 8px;
        height: Theme.tab-height;
        alignment: start;
        spacing: 2px;
        // "Home" tab
        Rectangle {
            width: Theme.tab-width;
            background: root.active == -1 ? Theme.tab-bg : home-touch.has-hover ? Theme.menu-hover-bg : transparent;
            border-top-left-radius: Theme.radius-small;
            border-top-right-radius: Theme.radius-small;
            home-touch := TouchArea {
                clicked => { root.active = -1; }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 8px;
                alignment: start;
                Image {
                    source: @image-url("../icons/house.svg");
                    width: Theme.tab-icon;
                    height: Theme.tab-icon;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.text;
                }
                Text {
                    text: "Home";
                    font-size: Theme.fs-tab;
                    font-weight: root.active == -1 ? Theme.weight-demibold : 400;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
        }
        for k[i] in root.order: TabItem {
            width: root.active == k ? root.active-w : root.other-w;
            divider: root.active != k && i + 1 < root.order.length && root.active != root.order[i + 1];
            init => { if root.active == k { root.active-at = i; } }
            changed active => { if self.active { root.active-at = i; } }
            drag(dx) => { root.drag-from = i; root.drag-dx = dx; }
            dropped(dx) => {
                root.drag-dx = dx;
                let to = root.drop-at;
                root.drag-from = -1;
                root.move-tab(i, to);
            }
            close-around(which) => { root.close-tabs-around(root.tabs[k].id, which); }
            tab: root.tabs[k];
            active: root.active == k;
            select => { root.active = k; }
            close => { root.close-tab(root.tabs[k].id); }
        }
        Rectangle {
            width: 34px;
            IconButton {
                icon: @image-url("../icons/plus.svg");
                clicked => { root.new-tab(); }
            }
        }
    }
    // Where a dragged tab will go.
    if root.drag-from >= 0 && root.drop-at != root.drag-from: Rectangle {
        property <length> left: 8px + Theme.tab-width + 2px + root.drop-at * (root.other-w + 2px);
        x: root.drop-at > root.drag-from ? self.left + root.other-w : self.left - 2px;
        width: 2px;
        height: Theme.tab-height;
        background: Theme.accent;
    }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.sidebar-border;
    }
}
