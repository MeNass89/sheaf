import { Theme } from "../theme.slint";
import { PlatformBridge } from "../platform.slint";

// One entry of the left task menu. Collapsed = icon only.
export component MenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    in property <bool> collapsed;
    callback clicked();

    height: Theme.menu-item-height;
    border-radius: Theme.radius-item;
    background: selected ? Theme.menu-selected-bg : touch.has-hover ? Theme.menu-hover-bg : transparent;
    animate background { duration: 100ms; }

    // Right to left (Preferences ▸ Direction): the icon on the right, the text against it.
    property <bool> rtl: PlatformBridge.rtl;
    Image {
        x: root.collapsed ? (root.width - self.width) / 2 : root.rtl ? root.width - self.width - 12px : 12px;
        source: root.icon;
        width: Theme.menu-icon;
        height: Theme.menu-icon;
        colorize: root.selected ? Theme.accent : Theme.menu-text;
    }
    Text {
        x: root.rtl ? 12px : 12px + Theme.menu-icon + Theme.menu-gap;
        width: root.width - 24px - Theme.menu-icon - Theme.menu-gap;
        horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        visible: !root.collapsed;
        text: root.text;
        font-size: Theme.fs-menu;
        // Selected: the tint and the accent icon mark it (macOS sidebar); the text stays plain.
        font-weight: 400;
        color: root.selected ? Theme.text : Theme.menu-text;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
