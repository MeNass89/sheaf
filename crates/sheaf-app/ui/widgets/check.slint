import { Theme } from "../theme.slint";
import { PlatformBridge } from "../platform.slint";

// Square tick box with a label ("First page is cover page").
export component Check inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    height: 24px;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    // The ring marks keyboard focus only: a click still focuses the box (Return and Space keep
    // working) but draws no ring, as on macOS.
    property <bool> keyboard-focus;
    focus := FocusScope {
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        key-pressed(e) => {
            if root.enabled && (e.text == Key.Return || e.text == " ") { root.checked = !root.checked; root.toggled(); return accept; }
            reject
        }
    }
    // Box and label placed by hand, the box on the right right to left (Preferences ▸ Interface ▸
    // Direction; iLovePDF's mirrored checkboxes).
    // macOS: a label too long for a narrow panel ends in an ellipsis instead of widening the row
    // past it. (Wrapping it loops in Slint 1.18: a FlexboxLayout row cannot follow a height that
    // follows the width.) Elsewhere the row keeps its label's width: the smoke clicks at fixed places.
    min-width: Theme.mac ? 24px + min(label.preferred-width, 96px) : label.preferred-width + 24px;
    preferred-width: label.preferred-width + 24px;
    Rectangle {
            x: PlatformBridge.rtl ? parent.width - self.width : 0;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            border-radius: Theme.radius-small;
            border-width: root.checked ? 0 : 1.5px;
            border-color: focus.has-focus && root.keyboard-focus ? Theme.text-secondary : Theme.option-border;
            background: root.checked ? Theme.accent : Theme.panel-bg;
            if root.checked: Image {
                width: 12px;
                height: 12px;
                source: @image-url("../icons/check.svg");
                colorize: Theme.on-accent;
            }
        }
    label := Text {
            x: PlatformBridge.rtl ? 0 : 24px;
            width: parent.width - 24px;
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.text;
            font-size: Theme.fs-label;
            color: Theme.text;
            vertical-alignment: center;
            overflow: Theme.mac ? TextOverflow.elide : TextOverflow.clip;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.checked = !root.checked;
            root.toggled();
        }
    }
}
