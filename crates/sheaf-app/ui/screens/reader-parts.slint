// Small controls shared by the reader screen and its side panel.

import { PlatformBridge } from "../platform.slint";
import { Theme, Motion } from "../theme.slint";
import { TooltipBridge } from "../widgets/tooltip.slint";

export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    // Said by the tooltip layer (widgets/tooltip.slint) after a rest on the button, with its
    // shortcut after it; to its right in a vertical rail.
    in property <string> tip;
    in property <string> tip-shortcut;
    in property <bool> tip-side;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: Theme.r-pill;
    background: root.active ? Theme.fill-3 : ta.pressed && root.enabled ? Theme.fill-2 : ta.has-hover && root.enabled ? Theme.fill-1 : transparent;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: root.tip;
    accessible-description: root.tip-shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        width: Theme.icon-md;
        height: Theme.icon-md;
        source: root.icon;
        // The pill behind shows the state; an accent icon on it read as a second, louder signal.
        colorize: !root.enabled ? Theme.text-disabled : root.active ? Theme.text : Theme.text-2;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.tip != "" {
                TooltipBridge.hover(root.absolute-position.x, root.absolute-position.y, root.width, root.height, root.tip, root.tip-shortcut, root.tip-side);
            } else if !self.has-hover && root.tip != "" {
                TooltipBridge.leave();
            }
        }
        pointer-event(e) => { if e.kind == PointerEventKind.down { TooltipBridge.cancel(); } }
    }
}

// The one look of everything that floats over the reader (menus, the palette, the options and
// selection bars): an 8 px radius, a hairline, a soft shadow deeper in the dark (macOS popovers).
export component PopoverFrame inherits Rectangle {
    background: Theme.window;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.hairline;
    drop-shadow-blur: Theme.popover-blur;
    drop-shadow-offset-y: Theme.popover-y;
    drop-shadow-color: Theme.popover-shadow;
}

export component Divider inherits Rectangle {
    width: 1px;
    height: 20px;
    background: Theme.hairline;
}

export component ColourDot inherits Rectangle {
    in property <color> colour;
    in property <bool> selected;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.text;
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.colour;
        border-width: 1px;
        border-color: #00000022;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A pen width to pick: a short line as thick as the stroke (Preview's Shape Style), the one in use
// on a pill (no ring: a ring around a dot read as a colour).
export component StrokeWidth inherits Rectangle {
    in property <length> thickness;
    in property <bool> selected;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: Theme.radius-button;
    background: root.selected ? Theme.pill-bg : sw.has-hover ? Theme.popup-hover : transparent;
    Rectangle {
        width: parent.width - 8px;
        height: root.thickness;
        border-radius: root.thickness / 2;
        background: root.selected ? Theme.text : Theme.text-secondary;
    }
    sw := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PanelTab inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 28px;
    border-radius: Theme.r-sm;
    background: root.selected ? Theme.fill-2 : t.has-hover ? Theme.fill-1 : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        Image {
            width: Theme.icon-sm;
            height: Theme.icon-sm;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.selected ? Theme.text : Theme.text-2;
        }
    }
    // Icons of equal width that never move, named on hover (PDF Expert's sidebar) by the layer.
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                TooltipBridge.hover(root.absolute-position.x, root.absolute-position.y, root.width, root.height, root.text, "", false);
            } else {
                TooltipBridge.leave();
            }
        }
        pointer-event(e) => { if e.kind == PointerEventKind.down { TooltipBridge.cancel(); } }
    }
    horizontal-stretch: 1;
}

// `primary` is a committing button (Use, Print, Done, Apply): solid accent. `on` is a toggle or a
// segment chosen (Sans, B, Grey, Every page): an accent tint and accent text, never a solid fill,
// so a bar of choices does not read as a row of default buttons (Apple's HIG, BAMA pass 28/10).
export component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> on;
    in property <bool> enabled: true;
    // Said by the tooltip layer after a rest on the button (a shortcut, as a menu item shows its keys).
    in property <string> tip;
    callback clicked();
    property <bool> solid: root.primary && root.enabled;
    height: 26px;
    // The label's own width.
    width: lbl.preferred-width + 20px;
    border-radius: Theme.r-sm;
    // Hover and press only ever deepen the rest colour, never lighten it (Button, DESIGN §4).
    background: root.solid ? (t.pressed ? Theme.accent-pressed : t.has-hover ? Theme.accent-hover : Theme.accent)
        : root.on ? Theme.accent.transparentize(t.pressed ? 70% : t.has-hover ? 78% : 85%)
        : (t.pressed && root.enabled ? Theme.fill-3 : t.has-hover && root.enabled ? Theme.fill-3 : Theme.fill-2);
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    lbl := Text {
        text: root.text;
        font-size: Theme.fs-body;
        font-weight: root.primary ? Theme.weight-demibold : Theme.weight-regular;
        color: !root.enabled ? Theme.text-disabled : root.solid ? Theme.on-accent : root.on ? Theme.accent-text : Theme.text;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.tip != "" {
                TooltipBridge.hover(root.absolute-position.x, root.absolute-position.y, root.width, root.height, root.tip, "", false);
            } else if !self.has-hover && root.tip != "" {
                TooltipBridge.leave();
            }
        }
        pointer-event(e) => { if e.kind == PointerEventKind.down { TooltipBridge.cancel(); } }
    }
}

// A small one-line field of the side panel (the attachments' Find, a page-number prefix).
export component PanelField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback edited(string);
    height: 26px;
    border-radius: Theme.r-sm;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.focus-ring : Theme.hairline;
    background: Theme.field;
    if input.text == "": Text {
        x: 8px;
        text: root.placeholder;
        font-size: Theme.fs-body;
        color: Theme.text-3;
        vertical-alignment: center;
    }
    input := TextInput {
        // Tools page tools' keys wait while a field has the keyboard.
        changed has-focus => { PlatformBridge.typing = self.has-focus; }
        x: 8px;
        width: parent.width - 16px;
        font-size: Theme.fs-label;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
    }
}
