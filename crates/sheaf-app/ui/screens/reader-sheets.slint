import { SettingsBridge } from "../settings.slint";
// The reader's sheets over the pages: the signature pad, the print sheet, document properties, the page background, the versions.
import { ScrollView } from "std-widgets.slint";
import { Theme, Space } from "../theme.slint";
import { Pad } from "sign-panel.slint";
import { SmallButton, ColourDot, StrokeWidth } from "reader-parts.slint";
import { SortCombo } from "../widgets/sort-combo.slint";
import { TextField } from "../widgets/text-field.slint";
import { Check } from "../widgets/check.slint";
import { Button, ButtonKind } from "../widgets/button.slint";
import { PopupButton, Radio, Checkbox } from "../widgets/controls.slint";
import { ToolTab, ReaderBridge } from "../flow-types.slint";
import { PlatformBridge } from "../platform.slint";

// A handwriting font offered for a typed signature: the name drawn in font `f`.
component FontChoice inherits Rectangle {
    in property <int> f;
    in property <string> name;
    in property <color> ink;
    in property <bool> selected;
    callback picked();
    height: 52px;
    border-radius: Theme.radius-small;
    background: Theme.input-bg;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.input-border;
    Image {
        width: parent.width - 14px;
        height: parent.height - 8px;
        source: ReaderBridge.signature-preview(root.name, root.f);
        image-fit: contain;
        colorize: root.ink;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// The signature pad (PDF Expert's "Create signature"): draw it, or type a name.
export component SignatureSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    // The keyboard back to the pages once the sheet closes.
    callback focus-pages();

    background: Theme.scrim;
    TouchArea { }
    Rectangle {
        width: 440px;
        height: sl.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        sl := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: root.tab.reader.initials ? @tr("Create your initials") : @tr("Create your signature"); font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            // The pen: three inks and three widths, as PDF Expert's signature pad.
            property <int> ink: 0;
            property <int> pen: 1;
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                for c[k] in [#1A1A1F, #1A52D9, #0D2673]: ColourDot { cross-axis-self-alignment: CrossAxisAlignment.center; colour: c; selected: ink == k; clicked => { ink = k; } }
                Rectangle { width: 10px; }
                for w[k] in [2px, 4px, 6px]: StrokeWidth {
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                    width: 24px;
                    height: 24px;
                    thickness: w;
                    selected: pen == k;
                    clicked => { pen = k; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            pad := Pad { ink: [#1A1A1F, #1A52D9, #0D2673][ink]; pen: [1.5px, 2.5px, 4px][pen]; hint: root.tab.reader.initials ? @tr("Draw your initials here") : @tr("Draw your signature here"); }
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: root.tab.reader.initials ? @tr("or type them") : @tr("or type your name"); font-size: Theme.fs-caption; color: Theme.text-muted; }
            typed := TextField { placeholder: root.tab.reader.initials ? @tr("Your initials") : @tr("Your name"); }
            // The name in each handwriting font as it is typed (Stirling's and PDF Expert's choice):
            // the one picked signs.
            property <int> font: 0;
            if typed.text != "": VerticalLayout {
                spacing: 6px;
                // Two tiles a row, placed by hand: a `for` inside a repeated FlexboxLayout overflows
                // the Slint 1.18 compiler's stack, and a FlexboxLayout asks these tiles' height of
                // their width (a binding loop through the sheet's height). Right to left, the first
                // font is on the right.
                for row in 2: Rectangle {
                    height: 52px;
                    FontChoice { x: PlatformBridge.rtl ? parent.width - self.width : 0; width: (parent.width - 6px) / 2; f: row * 2; name: typed.text; ink: [#1A1A1F, #1A52D9, #0D2673][ink]; selected: font == self.f; picked => { font = self.f; } }
                    FontChoice { x: PlatformBridge.rtl ? 0 : parent.width - self.width; width: (parent.width - 6px) / 2; f: row * 2 + 1; name: typed.text; ink: [#1A1A1F, #1A52D9, #0D2673][ink]; selected: font == self.f; picked => { font = self.f; } }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                SmallButton { text: @tr("Clear"); clicked => { pad.commands = ""; typed.text = ""; } }
                // Unticked, the signature is placed this once and not kept (PDF Expert's).
                keep := Check { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Keep for next time"); checked: true; }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: @tr("Cancel"); clicked => { ReaderBridge.signature-made(root.id, "", 1px, 1px, "", 0, 1, 0, true); root.focus-pages(); } }
                SmallButton { text: @tr("Use"); primary: true; clicked => { ReaderBridge.signature-made(root.id, pad.commands, pad.width, pad.height, typed.text, ink, pen, font, keep.checked); root.focus-pages(); } }
            }
        }
    }
}

// The print sheet (PDF Expert's print panel, reduced to what matters): printer, copies, pages,
// scale, paper, orientation, two-sided. Choices stay local until Print.
// A sheet's form row (DESIGN §5.9): 36 tall, the label 120 wide, the controls 8 apart, a hairline
// under it unless it ends a group.
component FormRow inherits Rectangle {
    in property <string> label;
    in property <bool> rule: true;
    height: 36px;
    FlexboxLayout {
        width: parent.width;
        height: parent.height;
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: start;
        spacing: Space.sm;
        Text { width: 112px; text: root.label; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
        @children
    }
    if root.rule: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.hairline; }
}

export component PrintSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    // The keyboard back to the pages once the sheet closes.
    callback focus-pages();

    property <int> copies: 1;
    property <int> pages: 0;
    // Each choice starts from Settings ▸ Tools ▸ Printing (iLovePDF's Printer preferences).
    property <bool> fit: SettingsBridge.print-fit;
    property <bool> two-sided: SettingsBridge.print-two-sided;
    property <int> paper: SettingsBridge.print-paper;
    property <int> orientation: SettingsBridge.print-orientation;
    // Pages per sheet: 1, 2, 4, 6, 9, 16, or a booklet (6).
    property <int> layout: SettingsBridge.print-layout;
    property <bool> gray: SettingsBridge.print-gray;
    property <bool> comments: SettingsBridge.print-comments;
    property <bool> ready: root.tab.reader.printers.length > 0;
    property <int> printer: root.tab.reader.printer;
    // The sheet the preview shows (0-based) of how many: the document's pages, or its n-up sheets.
    property <int> sheet: 0;
    property <int> sheets: root.layout == 6 ? max(1, ceil(root.tab.reader.page-count / 4) * 2) : max(1, ceil(root.tab.reader.page-count / [1, 2, 4, 6, 9, 16, 1][root.layout]));
    // The preview follows the choices that change the sheet.
    function preview() { ReaderBridge.print-preview(root.id, layout, gray, comments, sheet); }
    init => { preview(); }
    changed layout => { sheet = 0; preview(); }
    changed gray => { preview(); }
    changed comments => { preview(); }
    changed sheet => { preview(); }
    background: Theme.scrim;
    TouchArea { }
    // Return prints, Escape cancels (the sheet takes the keyboard when it opens).
    sheet-keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Return { ok.clicked(); return accept; }
            if e.text == Key.Escape { ReaderBridge.print-cancel(root.id); root.focus-pages(); return accept; }
            if e.text == Key.LeftArrow { sheet = max(0, sheet - 1); return accept; }
            if e.text == Key.RightArrow { sheet = min(sheets - 1, sheet + 1); return accept; }
            reject
        }
    }
    // DESIGN §5.9 Print (PDF Expert's 12c-print-dialog): 864×640, a 320-wide preview column on
    // `canvas` with the page and a "Page 1 of 7" capsule, the grouped form on the right, the
    // buttons on the bottom row (Make default left; Cancel · Print right).
    card := Rectangle {
        width: min(864px, root.width - 2 * Space.xl);
        height: min(640px, root.height - 2 * Space.xl);
        border-radius: Theme.r-lg;
        background: Theme.window;
        drop-shadow-blur: Theme.sheet-blur;
        drop-shadow-offset-y: Theme.sheet-y;
        drop-shadow-color: Theme.sheet-shadow;
        clip: true;
        accessible-role: groupbox;
        accessible-label: @tr("Print");
        // Preview column.
        preview-col := Rectangle {
            x: PlatformBridge.rtl ? parent.width - self.width : 0;
            width: 320px;
            height: parent.height;
            background: Theme.canvas;
            page := Rectangle {
                property <image> img: root.tab.reader.print-preview;
                property <float> scale: min((parent.width - 2 * Space.section) / 1px / max(1, self.img.width), (parent.height - 2 * Space.section - 64px) / 1px / max(1, self.img.height));
                x: (parent.width - self.width) / 2;
                y: Space.section;
                width: root.tab.reader.has-print-preview ? max(1, self.img.width) * self.scale * 1px : 210px;
                height: root.tab.reader.has-print-preview ? max(1, self.img.height) * self.scale * 1px : 297px;
                background: #FFFFFF;
                drop-shadow-blur: Theme.page-blur;
                drop-shadow-offset-y: Theme.page-y;
                drop-shadow-color: Theme.page-shadow;
                if root.tab.reader.has-print-preview: Image { width: parent.width; height: parent.height; source: page.img; image-fit: contain; }
                if !root.tab.reader.has-print-preview: Text { text: @tr("Preparing the preview…"); font-size: Theme.fs-subhead; color: Theme.text-2; }
            }
            // "Page 1 of 7" capsule, ← → to page.
            HorizontalLayout {
                x: (parent.width - self.width) / 2;
                y: parent.height - Space.xl - 28px;
                width: self.preferred-width;
                height: 28px;
                spacing: Space.xs;
                SmallButton { text: "‹"; enabled: sheet > 0; tip: @tr("Previous page"); clicked => { sheet = max(0, sheet - 1); } }
                Rectangle {
                    width: cap.preferred-width + 2 * Space.md;
                    border-radius: 14px;
                    background: Theme.fill-2;
                    cap := Text { text: root.layout == 0 ? @tr("Page {} of {}", sheet + 1, sheets) : @tr("Sheet {} of {}", sheet + 1, sheets); font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; }
                }
                SmallButton { text: "›"; enabled: sheet < sheets - 1; tip: @tr("Next page"); clicked => { sheet = min(sheets - 1, sheet + 1); } }
            }
        }
        // The form.
        form := VerticalLayout {
            x: PlatformBridge.rtl ? 0 : 320px;
            width: parent.width - 320px;
            height: parent.height;
            padding: Space.xl;
            spacing: Space.lg;
            Text { text: @tr("Print"); font-size: Theme.fs-title-1; color: Theme.text; horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 0;
                    // Group 1: the printer.
                    FormRow { label: @tr("Printer");
                        if ready: PopupButton { tip: @tr("Printer"); options: root.tab.reader.printers; current-index: root.tab.reader.printer; selected(i) => { printer = i; } }
                        if !ready: Text { text: @tr("No printer is set up"); font-size: Theme.fs-body; color: Theme.text-2; vertical-alignment: center; }
                    }
                    FormRow { label: @tr("Copies");
                        SmallButton { text: "−"; tip: @tr("One copy fewer"); clicked => { copies = max(1, copies - 1); } }
                        Text { text: copies; width: 32px; horizontal-alignment: center; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; }
                        SmallButton { text: "+"; tip: @tr("One copy more"); clicked => { copies = min(999, copies + 1); } }
                    }
                    FormRow { label: @tr("Pages"); rule: false;
                        Radio { text: @tr("All"); checked: pages == 0; clicked => { pages = 0; } }
                        Radio { text: @tr("Current"); checked: pages == 1; clicked => { pages = 1; } }
                        Radio { text: @tr("Range"); checked: pages == 2; clicked => { pages = 2; } }
                    }
                    FormRow { label: "";
                        Rectangle {
                            width: 140px;
                            height: Theme.control-height;
                            border-radius: Theme.r-sm;
                            border-width: range.has-focus ? 2px : 1px;
                            border-color: range.has-focus ? Theme.focus-ring : Theme.hairline;
                            background: Theme.field;
                            if range.text == "": Text { x: Space.sm; text: "1-3, 5"; font-size: Theme.fs-body; color: Theme.text-3; vertical-alignment: center; }
                            range := TextInput {
                                changed has-focus => { PlatformBridge.typing = self.has-focus; }
                                x: Space.sm;
                                width: parent.width - 2 * Space.sm;
                                font-size: Theme.fs-body;
                                color: Theme.text;
                                vertical-alignment: center;
                                single-line: true;
                                changed text => { if self.text != "" { pages = 2; } }
                                accepted => { ok.clicked(); }
                            }
                        }
                    }
                    FormRow { label: @tr("Paper size");
                        PopupButton { tip: @tr("Paper size"); options: [@tr("Printer's default"), @tr("A4"), @tr("Letter"), @tr("Legal")]; current-index: paper; selected(i) => { paper = i; } }
                    }
                    FormRow { label: @tr("Orientation");
                        Radio { text: @tr("Auto"); checked: orientation == 0; clicked => { orientation = 0; } }
                        Radio { text: @tr("Portrait"); checked: orientation == 1; clicked => { orientation = 1; } }
                        Radio { text: @tr("Landscape"); checked: orientation == 2; clicked => { orientation = 2; } }
                    }
                    // Group 2 (PDF Expert's own group): how the pages go on the paper.
                    Rectangle { height: Space.lg; }
                    Text { height: 24px; text: @tr("Sheaf").to-uppercase(); font-size: Theme.fs-subhead; font-weight: Theme.weight-demibold; color: Theme.text-2; vertical-alignment: bottom; horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    FormRow { label: @tr("Scale");
                        Radio { text: @tr("Fit to paper"); checked: fit; clicked => { fit = true; } }
                        Radio { text: @tr("Actual size"); checked: !fit; clicked => { fit = false; } }
                    }
                    FormRow { label: @tr("Layout");
                        PopupButton { tip: @tr("Layout"); options: [@tr("1 page per sheet"), @tr("2 per sheet"), @tr("4 per sheet"), @tr("6 per sheet"), @tr("9 per sheet"), @tr("16 per sheet"), @tr("Booklet")]; current-index: layout; selected(i) => { layout = i; } }
                    }
                    FormRow { label: @tr("Two-sided");
                        Checkbox { text: @tr("Print on both sides"); checked: two-sided || layout == 6; enabled: layout != 6; toggled(v) => { two-sided = v; } }
                    }
                    FormRow { label: @tr("Colour");
                        Radio { text: @tr("Colour"); checked: !gray; clicked => { gray = false; } }
                        Radio { text: @tr("Grey"); checked: gray; clicked => { gray = true; } }
                    }
                    FormRow { label: @tr("Comments"); rule: false;
                        Checkbox { text: @tr("Print comments and forms"); checked: comments; toggled(v) => { comments = v; } }
                    }
                }
            }
            HorizontalLayout {
                spacing: Space.sm;
                // These choices kept as how the sheet opens (Preview's Save Current Settings as Preset).
                Button { text: @tr("Make Default"); clicked => { SettingsBridge.set-print-defaults(two-sided, paper, gray, comments, fit, orientation, layout); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Cancel"); clicked => { ReaderBridge.print-cancel(root.id); root.focus-pages(); } }
                ok := Button {
                    text: @tr("Print");
                    kind: ButtonKind.primary;
                    enabled: ready;
                    clicked => {
                        if ready {
                            ReaderBridge.print(root.id, printer, copies, pages, range.text, fit, two-sided, paper, orientation, layout, gray, comments);
                            root.focus-pages();
                        }
                    }
                }
            }
        }
    }
}

// Document Properties (Acrobat's ⌘D): the four entries to edit, then what the file is.
export component PropertiesSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    // When opened's choices, from the document's own (properties.rs opening_controls).
    property <int> open-layout: root.tab.reader.props-opening[1];
    property <int> open-zoom: root.tab.reader.props-opening[2];
    property <int> open-panel: root.tab.reader.props-opening[3];
    // Its window options, bits as properties.rs opening_controls.
    property <int> open-window: root.tab.reader.props-opening[4];
    // The About line shown in full (−1: none).
    property <int> open-row: -1;
    // The keyboard back to the pages once the sheet closes.
    callback focus-pages();

    background: Theme.scrim;
    TouchArea { }
    // Escape from any field cancels (keys bubble up from the fields inside).
    FocusScope {
        init => { title-in.focus-input(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.props-cancel(root.id); root.focus-pages(); return accept; }
            reject
        }
        // As tall as it needs, within the window: past that its fields scroll, Cancel and Save stay.
        Rectangle {
            width: 460px;
            // Its title, buttons, spacing and padding take 110 px.
            height: min(ppl.preferred-height + 110px, root.height - 48px);
            border-radius: Theme.radius-card;
            background: Theme.card;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Document properties"); font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
                ScrollView {
                    vertical-stretch: 1;
                    // Never across; room left for the scroll bar.
                    content-width: self.visible-width;
                    ppl := VerticalLayout {
                        x: PlatformBridge.rtl ? parent.width - (0) - self.width : 0;
                        width: parent.width - 12px;
                        spacing: 10px;
                        title-in := TextField { label: @tr("Title"); text: root.tab.reader.props-title; accepted => { save.clicked(); } }
                        author-in := TextField { label: @tr("Author"); text: root.tab.reader.props-author; accepted => { save.clicked(); } }
                        subject-in := TextField { label: @tr("Subject"); text: root.tab.reader.props-subject; accepted => { save.clicked(); } }
                        keywords-in := TextField { label: @tr("Keywords"); text: root.tab.reader.props-keywords; accepted => { save.clicked(); } }
                        custom-in := TextField { label: @tr("Custom properties"); placeholder: @tr("Name: value; another: value"); text: root.tab.reader.props-custom; accepted => { save.clicked(); } }
                        // Acrobat's Initial View: how the document opens, in Sheaf and other readers.
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("When opened"); font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text-secondary; }
                        // One row each, a caption to the left: the four fit the sheet's width.
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            spacing: 6px;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 56px; text: @tr("Page"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            page-in := TextField { width: 70px; placeholder: "1"; text: root.tab.reader.props-opening[0] > 1 ? root.tab.reader.props-opening[0] : ""; accepted => { save.clicked(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 56px; text: @tr("Layout"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            for l[i] in [@tr("Any"), @tr("One page"), @tr("Two pages"), @tr("Cover first")]: SmallButton { text: l; on: root.open-layout == i; clicked => { root.open-layout = i; } }
                        }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 56px; text: @tr("Zoom"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            for z[i] in [@tr("Any"), @tr("Fit page"), @tr("Fit width"), @tr("Actual size")]: SmallButton { text: z; on: root.open-zoom == i; clicked => { root.open-zoom = i; } }
                        }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 56px; text: @tr("Panel"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            for n[i] in [@tr("None"), @tr("Bookmarks"), @tr("Pages")]: SmallButton { text: n; on: root.open-panel == i; clicked => { root.open-panel = i; } }
                        }
                        // Acrobat's Window and User interface options: toggled, each a bit of open-window.
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 56px; text: @tr("Window"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            for w[i] in [{ t: @tr("Full screen"), b: 1 }, { t: @tr("Title"), b: 2 }, { t: @tr("Fit"), b: 4 }, { t: @tr("Centre"), b: 8 }, { t: @tr("No bar"), b: 16 }]: SmallButton {
                                text: w.t;
                                on: Math.mod(Math.floor(root.open-window / w.b), 2) == 1;
                                clicked => { root.open-window += Math.mod(Math.floor(root.open-window / w.b), 2) == 1 ? -w.b : w.b; }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.sidebar-border; }
                        // A line cut short opens in full on a click (a certificate's issuer and dates; Sol, 25/10).
                        // Placed by hand: a line opened in full wraps, and a FlexboxLayout asks a
                        // wrapped text's height of its width (a binding loop through the sheet's).
                        for p[i] in root.tab.reader.props-about: Rectangle {
                            height: max(name-text.preferred-height, value-text.preferred-height);
                            name-text := Text { x: PlatformBridge.rtl ? parent.width - self.width : 0; y: 0; width: 150px; horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: p.name; font-size: Theme.fs-label; color: Theme.text-secondary; }
                            value-text := Text {
                                x: PlatformBridge.rtl ? 0 : 160px;
                                y: 0;
                                width: parent.width - 160px;
                                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                text: p.value;
                                font-size: Theme.fs-label;
                                color: Theme.text;
                                overflow: elide;
                                wrap: root.open-row == i ? word-wrap : no-wrap;
                                TouchArea { mouse-cursor: pointer; clicked => { root.open-row = root.open-row == i ? -1 : i; } }
                            }
                        }
                        for label[k] in root.tab.reader.props-signed: FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: start;
                            spacing: 6px;
                            SmallButton { text: label; clicked => { ReaderBridge.open-signed(root.id, k); } }
                            // Acrobat's Add to Trusted Certificates.
                            if root.tab.reader.props-trust[k] != "": SmallButton { text: root.tab.reader.props-trust[k]; clicked => { ReaderBridge.trust-signature(root.id, k); } }
                            // Acrobat's Clear Signature: the field unsigned, to be signed again.
                            SmallButton { text: @tr("Clear signature"); clicked => { ReaderBridge.clear-signature(root.id, k); root.focus-pages(); } }
                        }
                    }
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 8px;
                    // Acrobat's PDF info report: everything above and the fonts, as text.
                    SmallButton { text: @tr("Copy report"); clicked => { ReaderBridge.props-copy(root.id); } }
                    SmallButton { text: @tr("Save report…"); clicked => { ReaderBridge.props-report(root.id); } }
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { text: @tr("Cancel"); clicked => { ReaderBridge.props-cancel(root.id); root.focus-pages(); } }
                    save := SmallButton {
                        text: @tr("Save");
                        primary: true;
                        clicked => {
                            ReaderBridge.props-save(root.id, title-in.text, author-in.text, subject-in.text, keywords-in.text, custom-in.text, page-in.text, root.open-layout, root.open-zoom, root.open-panel, root.open-window);
                            root.focus-pages();
                        }
                    }
                }
            }
        }
    }
}

// More ▸ Background… (Acrobat's Edit a PDF ▸ Background): a colour or a picture behind every page's
// content, one undo step; Remove takes out the backgrounds a file already has.
export component BackgroundSheet inherits Rectangle {
    in property <int> id;
    callback focus-pages();
    // Colours as reader_ui::BACKGROUNDS; strength (opacity) as BACKGROUND_OPACITY.
    property <int> colour: 0;
    property <int> strength: 0;
    background: Theme.scrim;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Return { ReaderBridge.background-apply(root.id, root.colour, root.strength, 0); root.focus-pages(); return accept; }
            if e.text == Key.Escape { ReaderBridge.background-apply(root.id, 0, 0, 3); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 400px;
        height: bl.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        bl := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Page background"); font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Behind the content of every page. ⌘Z undoes it."); font-size: Theme.fs-caption; color: Theme.text-muted; }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Colour"); width: 70px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                for c[i] in [#FFF8D6, #E3F0FF, #E8F7E4, #FDE7EC, #EFEFEF, #FFFFFF]: ColourDot { colour: c; selected: root.colour == i; clicked => { root.colour = i; } }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Opacity"); width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                for o[i] in ["100 %", "75 %", "50 %"]: SmallButton { text: o; on: root.strength == i; clicked => { root.strength = i; } }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                SmallButton { text: @tr("Picture…"); clicked => { ReaderBridge.background-apply(root.id, root.colour, root.strength, 1); root.focus-pages(); } }
                SmallButton { text: @tr("Remove"); clicked => { ReaderBridge.background-apply(root.id, 0, 0, 2); root.focus-pages(); } }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: @tr("Cancel"); clicked => { ReaderBridge.background-apply(root.id, 0, 0, 3); root.focus-pages(); } }
                SmallButton { text: @tr("Apply"); primary: true; clicked => { ReaderBridge.background-apply(root.id, root.colour, root.strength, 0); root.focus-pages(); } }
            }
        }
    }
}

// More ▸ Versions… (Acrobat's File ▸ Revert, and the versions an incremental save keeps): each
// version saved in the file opens on its own; Revert drops the unsaved edits.
export component VersionsSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    background: Theme.scrim;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.version-action(root.id, -1); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 400px;
        height: vl.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Versions"); font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.tab.reader.versions == 1 ? @tr("The file holds one version: each save that adds to it keeps the one before.") : @tr("The file holds {} versions, the oldest first.", root.tab.reader.versions);
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            for i in root.tab.reader.versions: FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Version {}", (i + 1)) + (i + 1 == root.tab.reader.versions ? @tr(" (as last saved)") : ""); font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: @tr("Open"); clicked => { ReaderBridge.version-action(root.id, i + 1); root.focus-pages(); } }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                if root.tab.reader.dirty: SmallButton { text: @tr("Revert to saved"); clicked => { ReaderBridge.version-action(root.id, 0); root.focus-pages(); } }
                if root.tab.reader.dirty: Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Unsaved changes are lost"); font-size: Theme.fs-caption; color: Theme.danger; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: @tr("Close"); primary: true; clicked => { ReaderBridge.version-action(root.id, -1); root.focus-pages(); } }
            }
        }
    }
}

// The search panel's In a folder… (Acrobat's Advanced Search): the pages of the folder's PDFs that
// hold the words, a line around them; a click opens the file at its page.
export component FolderSearchSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    background: Theme.scrim;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.folder-result(root.id, -1); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 560px;
        height: min(vl.preferred-height, root.height - 80px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: root.tab.reader.folder-title; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; overflow: elide; }
            Text {
                text: root.tab.reader.folder-status;
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            ScrollView {
                min-height: min((root.tab.reader.folder-results.length + root.tab.reader.folder-skipped.length) * 40px + (root.tab.reader.folder-skipped.length > 0 ? 28px : 0px), 420px);
                VerticalLayout {
                    for h[k] in root.tab.reader.folder-results: Rectangle {
                        height: 40px;
                        border-radius: Theme.radius-small;
                        background: ht.has-hover ? Theme.popup-hover : transparent;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: h.file + " · " + h.page; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; overflow: elide; }
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: h.line; font-size: Theme.fs-caption; color: Theme.text-muted; overflow: elide; }
                        }
                        ht := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ReaderBridge.folder-result(root.id, k); root.focus-pages(); }
                        }
                    }
                    // The PDFs not searched, each with why (Acrobat lists the documents it skipped).
                    if root.tab.reader.folder-skipped.length > 0: Text {
                        height: 28px;
                        vertical-alignment: bottom;
                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Not searched");
                        font-size: Theme.fs-caption;
                        font-weight: Theme.weight-demibold;
                        color: Theme.text-muted;
                    }
                    for h in root.tab.reader.folder-skipped: VerticalLayout {
                        height: 40px;
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: h.file; font-size: Theme.fs-label; color: Theme.text; overflow: elide; }
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: h.line; font-size: Theme.fs-caption; color: Theme.text-muted; overflow: elide; }
                    }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: end;
                SmallButton { text: @tr("Close"); clicked => { ReaderBridge.folder-result(root.id, -1); root.focus-pages(); } }
            }
        }
    }
}

// More tools ▸ Accessibility check (Acrobat's Full Check): the rules failed first, each with where
// and why; Fix on the ones Sheaf can fix, then checked again; Save report… as Acrobat's.
export component AccessibilitySheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    background: Theme.scrim;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.accessibility-fix(root.id, -1); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 600px;
        height: min(vl.preferred-height, root.height - 80px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Accessibility check"); font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.tab.reader.a11y-busy ? @tr("Checking…") : root.tab.reader.a11y-summary;
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
            }
            ScrollView {
                min-height: min(root.tab.reader.a11y-rows.length * 52px, 440px);
                VerticalLayout {
                    for c[k] in root.tab.reader.a11y-rows: Rectangle {
                        height: 52px;
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            padding-left: 4px;
                            padding-right: 8px;
                            spacing: 10px;
                            Rectangle {
                                width: 10px;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: c.status == 0 ? Theme.danger : c.status == 1 ? #D9A21B : Theme.success-strong;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: c.name + (c.status == 1 ? @tr(" (check by hand)") : ""); font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; overflow: elide; }
                                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: c.detail; font-size: Theme.fs-caption; color: Theme.text-muted; overflow: elide; }
                            }
                            if c.fix: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Fix"); clicked => { ReaderBridge.accessibility-fix(root.id, k); } }
                        }
                    }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                SmallButton { text: @tr("Save report…"); clicked => { ReaderBridge.accessibility-report(root.id); } }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: @tr("Close"); primary: true; clicked => { ReaderBridge.accessibility-fix(root.id, -1); root.focus-pages(); } }
            }
        }
    }
}

// More tools ▸ Voice… (Acrobat's Reading ▸ Voice): the system's voices; a click picks one, kept.
export component VoicesSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    background: Theme.scrim;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.voice-pick(root.id, -2); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 360px;
        height: min(vl.preferred-height, root.height - 80px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 8px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Voice"); font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            if root.tab.reader.voices.length == 0: Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("No voice was found on this computer."); font-size: Theme.fs-caption; color: Theme.text-muted; }
            ScrollView {
                min-height: min((root.tab.reader.voices.length + 1) * 30px, 400px);
                VerticalLayout {
                    for name[k] in [""]: Rectangle {
                        height: 30px;
                        background: dt.has-hover ? Theme.popup-hover : transparent;
                        border-radius: Theme.radius-small;
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; x: PlatformBridge.rtl ? parent.width - (8px) - self.width : 8px; text: @tr("The system's default"); font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                        dt := TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.voice-pick(root.id, -1); root.focus-pages(); } }
                    }
                    for v[k] in root.tab.reader.voices: Rectangle {
                        height: 30px;
                        background: vt.has-hover ? Theme.popup-hover : transparent;
                        border-radius: Theme.radius-small;
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; x: PlatformBridge.rtl ? parent.width - (8px) - self.width : 8px; text: v; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; overflow: elide; }
                        vt := TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.voice-pick(root.id, k); root.focus-pages(); } }
                    }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: end;
                SmallButton { text: @tr("Close"); clicked => { ReaderBridge.voice-pick(root.id, -2); root.focus-pages(); } }
            }
        }
    }
}

// Help ▸ Keyboard shortcuts (Acrobat's and PDF Expert's ⌘/): the reader's keys, by what they do.
// ⌘ is Ctrl on Linux and Windows.
export component HelpSheet inherits Rectangle {
    in property <int> id;
    callback focus-pages();
    background: Theme.scrim;
    TouchArea { clicked => { ReaderBridge.show-help(root.id, false); root.focus-pages(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape || e.text == "?" { ReaderBridge.show-help(root.id, false); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 760px;
        height: min(vl.preferred-height, root.height - 60px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        TouchArea { }
        vl := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Keyboard shortcuts"); font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 28px;
                for col in [
                    [
                        { k: "", t: @tr("Tools") },
                        { k: PlatformBridge.tool-letters[0], t: @tr("Select text") }, { k: PlatformBridge.tool-letters[1], t: @tr("Highlight") }, { k: PlatformBridge.tool-letters[2], t: @tr("Underline") }, { k: PlatformBridge.tool-letters[3], t: @tr("Strikethrough") },
                        { k: PlatformBridge.tool-letters[4], t: @tr("Note") }, { k: PlatformBridge.tool-letters[6], t: @tr("Text box") }, { k: PlatformBridge.tool-letters[5], t: @tr("Pen") }, { k: PlatformBridge.tool-letters[10], t: @tr("Shapes") }, { k: PlatformBridge.tool-letters[11], t: @tr("Eraser") },
                        { k: PlatformBridge.tool-letters[12], t: @tr("Stamp") }, { k: PlatformBridge.tool-letters[9], t: @tr("Sign") }, { k: PlatformBridge.tool-letters[7], t: @tr("Edit text and objects") }, { k: PlatformBridge.tool-letters[8], t: @tr("Add image") },
                        { k: PlatformBridge.tool-letters[13], t: @tr("Link") }, { k: PlatformBridge.tool-letters[14], t: @tr("Prepare form") },
                    ],
                    [
                        { k: "", t: @tr("View") },
                        { k: "⌘ +  ⌘ −", t: @tr("Zoom in, out") }, { k: PlatformBridge.key-labels[18], t: @tr("Actual size") }, { k: PlatformBridge.key-labels[20], t: @tr("Fit width") }, { k: PlatformBridge.key-labels[19], t: @tr("Fit page") },
                        { k: "⇧⌘ +  ⇧⌘ −", t: @tr("Rotate view") }, { k: PlatformBridge.key-labels[22], t: @tr("One page, two, cover alone") }, { k: PlatformBridge.key-labels[21], t: @tr("Side panel") },
                        { k: PlatformBridge.key-labels[25], t: @tr("Full screen") }, { k: "Space drag", t: @tr("Move the pages") }, { k: "← →  PgUp PgDn", t: @tr("Previous, next page") },
                        { k: "Home  End", t: @tr("First, last page") }, { k: PlatformBridge.key-labels[31], t: @tr("Go to page") },
                    ],
                    [
                        { k: "", t: @tr("Document") },
                        { k: PlatformBridge.key-labels[11], t: @tr("Find") }, { k: "⌘ G  ⇧⌘ G", t: @tr("Next, previous result") }, { k: PlatformBridge.key-labels[2], t: @tr("Save") }, { k: PlatformBridge.key-labels[3], t: @tr("Save as") },
                        { k: PlatformBridge.key-labels[4], t: @tr("Print") }, { k: PlatformBridge.key-labels[5], t: @tr("Document properties") }, { k: "⌘ Z  ⇧⌘ Z", t: @tr("Undo, redo") },
                        { k: "⌘ C  ⌘ X  ⌘ V", t: @tr("Copy, cut, paste") }, { k: "⌘ K", t: @tr("Link the selected text") }, { k: "Delete", t: @tr("Delete the selection") },
                        { k: "⇧⌘ [  ⇧⌘ ]", t: @tr("Previous, next tab") }, { k: PlatformBridge.key-labels[6], t: @tr("Close the tab") }, { k: "?  ⌘ /", t: @tr("These shortcuts") },
                    ],
                ]: VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    for row in col: FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: LayoutAlignment.stretch;
                        spacing: 10px;
                        if row.k != "": Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 96px; text: row.k; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text-secondary; }
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: row.t; font-size: Theme.fs-label; font-weight: row.k == "" ? Theme.weight-demibold : 400; color: row.k == "" ? Theme.text-heading : Theme.text; }
                    }
                }
            }
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("⌘ is Ctrl on Linux and Windows."); font-size: Theme.fs-caption; color: Theme.text-muted; }
        }
    }
}
