// The reader's sheets over the pages: the signature pad, the print sheet, document properties, the page background, the versions.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Pad } from "sign-panel.slint";
import { SmallButton, ColourDot } from "reader-parts.slint";
import { SortCombo } from "../widgets/sort-combo.slint";
import { TextField } from "../widgets/text-field.slint";
import { Check } from "../widgets/check.slint";
import { ToolTab, ReaderBridge } from "../flow-types.slint";
import { PlatformBridge } from "../platform.slint";

// The signature pad (PDF Expert's "Create signature"): draw it, or type a name.
export component SignatureSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    // The keyboard back to the pages once the sheet closes.
    callback focus-pages();

    background: #00000044;
    TouchArea { }
    Rectangle {
        width: 440px;
        height: sl.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        sl := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: root.tab.reader.initials ? "Create your initials" : "Create your signature"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            // The pen: three inks and three widths, as PDF Expert's signature pad.
            property <int> ink: 0;
            property <int> pen: 1;
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                for c[k] in [#1A1A1F, #1A52D9, #0D2673]: ColourDot { cross-axis-self-alignment: CrossAxisAlignment.center; colour: c; selected: ink == k; clicked => { ink = k; } }
                Rectangle { width: 10px; }
                for w[k] in [2px, 4px, 6px]: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    border-width: pen == k ? 2px : 0px;
                    border-color: Theme.text;
                    Rectangle { width: w; height: w; border-radius: w / 2; background: Theme.text-secondary; }
                    TouchArea { mouse-cursor: pointer; clicked => { pen = k; } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            pad := Pad { ink: [#1A1A1F, #1A52D9, #0D2673][ink]; pen: [1.5px, 2.5px, 4px][pen]; hint: root.tab.reader.initials ? "Draw your initials here" : "Draw your signature here"; }
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: root.tab.reader.initials ? "or type them" : "or type your name"; font-size: Theme.fs-caption; color: Theme.text-muted; }
            typed := TextField { placeholder: root.tab.reader.initials ? "Your initials" : "Your name"; }
            // The name in each handwriting font as it is typed (Stirling's and PDF Expert's choice):
            // the one picked signs.
            property <int> font: 0;
            if typed.text != "": VerticalLayout {
                spacing: 6px;
                for row in [[0, 1], [2, 3]]: FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 6px;
                    for f in row: Rectangle {
                        height: 52px;
                        border-radius: Theme.radius-small;
                        background: Theme.input-bg;
                        border-width: font == f ? 2px : 1px;
                        border-color: font == f ? Theme.accent : Theme.input-border;
                        Image {
                            width: parent.width - 14px;
                            height: parent.height - 8px;
                            source: ReaderBridge.signature-preview(typed.text, f);
                            image-fit: contain;
                            colorize: [#1A1A1F, #1A52D9, #0D2673][ink];
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { font = f; } }
                    }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                SmallButton { text: "Clear"; clicked => { pad.commands = ""; typed.text = ""; } }
                // Unticked, the signature is placed this once and not kept (PDF Expert's).
                keep := Check { cross-axis-self-alignment: CrossAxisAlignment.center; text: "Keep for next time"; checked: true; }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: "Cancel"; clicked => { ReaderBridge.signature-made(root.id, "", 1px, 1px, "", 0, 1, 0, true); root.focus-pages(); } }
                SmallButton { text: "Use"; primary: true; clicked => { ReaderBridge.signature-made(root.id, pad.commands, pad.width, pad.height, typed.text, ink, pen, font, keep.checked); root.focus-pages(); } }
            }
        }
    }
}

// The print sheet (PDF Expert's print panel, reduced to what matters): printer, copies, pages,
// scale, paper, orientation, two-sided. Choices stay local until Print.
export component PrintSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    // The keyboard back to the pages once the sheet closes.
    callback focus-pages();

    property <int> copies: 1;
    property <int> pages: 0;
    property <bool> fit: true;
    property <bool> two-sided: false;
    property <int> paper: 0;
    property <int> orientation: 0;
    // Pages per sheet: 1, 2, 4, 6, 9, 16, or a booklet (6).
    property <int> layout: 0;
    property <bool> gray: false;
    property <bool> comments: true;
    property <bool> ready: root.tab.reader.printers.length > 0;
    property <int> printer: root.tab.reader.printer;
    // The preview follows the choices that change the sheet.
    function preview() { ReaderBridge.print-preview(root.id, layout, gray, comments); }
    init => { preview(); }
    changed layout => { preview(); }
    changed gray => { preview(); }
    changed comments => { preview(); }
    background: #00000044;
    TouchArea { }
    // Return prints, Escape cancels (the sheet takes the keyboard when it opens).
    sheet-keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Return { ok.clicked(); return accept; }
            if e.text == Key.Escape { ReaderBridge.print-cancel(root.id); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 720px;
        height: pl.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
        pl := VerticalLayout {
            width: 420px;
            padding: 18px;
            spacing: 12px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Print"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 10px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Printer"; width: 70px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                if ready: SortCombo {
                    width: 250px;
                    options: root.tab.reader.printers;
                    current-index: root.tab.reader.printer;
                    chevron: @image-url("../icons/chevron-down.svg");
                    selected(i) => { printer = i; }
                }
                if !ready: Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "No printer is set up"; font-size: Theme.fs-label; color: Theme.text-muted; vertical-alignment: center; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Copies"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                SmallButton { text: "−"; clicked => { copies = max(1, copies - 1); } }
                Text { text: copies; width: 30px; horizontal-alignment: center; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                SmallButton { text: "+"; clicked => { copies = min(999, copies + 1); } }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Pages"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                SmallButton { text: "All"; primary: pages == 0; clicked => { pages = 0; } }
                SmallButton { text: "Current"; primary: pages == 1; clicked => { pages = 1; } }
                SmallButton { text: "Range"; primary: pages == 2; clicked => { pages = 2; } }
                Rectangle {
                    width: 110px;
                    height: 26px;
                    border-radius: Theme.radius-small;
                    border-width: 1px;
                    border-color: range.has-focus ? Theme.text-secondary : Theme.input-border;
                    background: Theme.input-bg;
                    if range.text == "": Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; x: PlatformBridge.rtl ? parent.width - (8px) - self.width : 8px; text: "1-3, 5"; font-size: Theme.fs-label; color: Theme.text-muted; }
                    range := TextInput {
                        // Tools page tools' keys wait while a field has the keyboard.
                        changed has-focus => { PlatformBridge.typing = self.has-focus; }
                        x: PlatformBridge.rtl ? parent.width - (8px) - self.width : 8px;
                        width: parent.width - 16px;
                        font-size: Theme.fs-label;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        changed text => { if self.text != "" { pages = 2; } }
                        accepted => { ok.clicked(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Scale"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                SmallButton { text: "Fit to paper"; primary: fit; clicked => { fit = true; } }
                SmallButton { text: "Actual size"; primary: !fit; clicked => { fit = false; } }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 10px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Paper"; width: 70px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                SortCombo {
                    width: 150px;
                    options: ["Printer's default", "A4", "Letter", "Legal"];
                    current-index <=> paper;
                    chevron: @image-url("../icons/chevron-down.svg");
                }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Orientation"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                SmallButton { text: "Auto"; primary: orientation == 0; clicked => { orientation = 0; } }
                SmallButton { text: "Portrait"; primary: orientation == 1; clicked => { orientation = 1; } }
                SmallButton { text: "Landscape"; primary: orientation == 2; clicked => { orientation = 2; } }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Two-sided"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                SmallButton { text: "Off"; primary: !two-sided && layout != 6; clicked => { two-sided = false; } }
                SmallButton { text: "On"; primary: two-sided || layout == 6; clicked => { two-sided = true; } }
                Rectangle { horizontal-stretch: 1; }
            }
            // Preview's Pages per Sheet and Acrobat's Booklet (both sides, folded in the middle).
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 10px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Layout"; width: 70px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                SortCombo {
                    width: 150px;
                    options: ["1 page per sheet", "2 per sheet", "4 per sheet", "6 per sheet", "9 per sheet", "16 per sheet", "Booklet"];
                    current-index <=> layout;
                    chevron: @image-url("../icons/chevron-down.svg");
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // Acrobat's Print in grayscale, and Comments and Forms ▸ Document and Markups or Document.
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Print"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                SmallButton { text: "Colour"; primary: !gray; clicked => { gray = false; } }
                SmallButton { text: "Grey"; primary: gray; clicked => { gray = true; } }
                SmallButton { text: comments ? "With comments" : "Without comments"; primary: comments; clicked => { comments = !comments; } }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: "Cancel"; clicked => { ReaderBridge.print-cancel(root.id); root.focus-pages(); } }
                ok := SmallButton {
                    text: "Print";
                    primary: ready;
                    clicked => {
                        if ready {
                            ReaderBridge.print(root.id, printer, copies, pages, range.text, fit, two-sided, paper, orientation, layout, gray, comments);
                            root.focus-pages();
                        }
                    }
                }
            }
        }
        // Acrobat's print preview: the first sheet as it will print.
        Rectangle {
            width: 300px;
            Rectangle {
                y: 18px;
                width: 264px;
                height: 340px;
                background: Theme.panel-bg;
                border-radius: Theme.radius-small;
                if root.tab.reader.has-print-preview: Image { width: parent.width - 16px; height: parent.height - 16px; source: root.tab.reader.print-preview; image-fit: contain; }
                if !root.tab.reader.has-print-preview: Text { text: "Preparing the preview…"; font-size: Theme.fs-caption; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        }
    }
}

// Document Properties (Acrobat's ⌘D): the four entries to edit, then what the file is.
export component PropertiesSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    // When opened's choices, from the document's own (properties.rs opening_controls).
    property <int> open-layout: root.tab.reader.props-opening[1];
    property <int> open-zoom: root.tab.reader.props-opening[2];
    property <int> open-panel: root.tab.reader.props-opening[3];
    // Its window options, bits as properties.rs opening_controls.
    property <int> open-window: root.tab.reader.props-opening[4];
    // The About line shown in full (−1: none).
    property <int> open-row: -1;
    // The keyboard back to the pages once the sheet closes.
    callback focus-pages();

    background: #00000044;
    TouchArea { }
    // Escape from any field cancels (keys bubble up from the fields inside).
    FocusScope {
        init => { title-in.focus-input(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.props-cancel(root.id); root.focus-pages(); return accept; }
            reject
        }
        // As tall as it needs, within the window: past that its fields scroll, Cancel and Save stay.
        Rectangle {
            width: 460px;
            // Its title, buttons, spacing and padding take 110 px.
            height: min(ppl.preferred-height + 110px, root.height - 48px);
            border-radius: Theme.radius-card;
            background: Theme.card;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Document properties"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
                ScrollView {
                    vertical-stretch: 1;
                    // Never across; room left for the scroll bar.
                    content-width: self.visible-width;
                    ppl := VerticalLayout {
                        x: PlatformBridge.rtl ? parent.width - (0) - self.width : 0;
                        width: parent.width - 12px;
                        spacing: 10px;
                        title-in := TextField { label: "Title"; text: root.tab.reader.props-title; accepted => { save.clicked(); } }
                        author-in := TextField { label: "Author"; text: root.tab.reader.props-author; accepted => { save.clicked(); } }
                        subject-in := TextField { label: "Subject"; text: root.tab.reader.props-subject; accepted => { save.clicked(); } }
                        keywords-in := TextField { label: "Keywords"; text: root.tab.reader.props-keywords; accepted => { save.clicked(); } }
                        custom-in := TextField { label: "Custom properties"; placeholder: "Name: value; another: value"; text: root.tab.reader.props-custom; accepted => { save.clicked(); } }
                        // Acrobat's Initial View: how the document opens, in Sheaf and other readers.
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "When opened"; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text-secondary; }
                        // One row each, a caption to the left: the four fit the sheet's width.
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            spacing: 6px;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 48px; text: "Page"; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            page-in := TextField { width: 70px; placeholder: "1"; text: root.tab.reader.props-opening[0] > 1 ? root.tab.reader.props-opening[0] : ""; accepted => { save.clicked(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 48px; text: "Layout"; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            for l[i] in ["Any", "One page", "Two pages", "Cover first"]: SmallButton { text: l; primary: root.open-layout == i; clicked => { root.open-layout = i; } }
                        }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 48px; text: "Zoom"; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            for z[i] in ["Any", "Fit page", "Fit width", "Actual size"]: SmallButton { text: z; primary: root.open-zoom == i; clicked => { root.open-zoom = i; } }
                        }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 48px; text: "Panel"; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            for n[i] in ["None", "Bookmarks", "Pages"]: SmallButton { text: n; primary: root.open-panel == i; clicked => { root.open-panel = i; } }
                        }
                        // Acrobat's Window and User interface options: toggled, each a bit of open-window.
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 48px; text: "Window"; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                            for w[i] in [{ t: "Full screen", b: 1 }, { t: "Title", b: 2 }, { t: "Fit", b: 4 }, { t: "Centre", b: 8 }, { t: "No bar", b: 16 }]: SmallButton {
                                text: w.t;
                                primary: Math.mod(Math.floor(root.open-window / w.b), 2) == 1;
                                clicked => { root.open-window += Math.mod(Math.floor(root.open-window / w.b), 2) == 1 ? -w.b : w.b; }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.sidebar-border; }
                        // A line cut short opens in full on a click (a certificate's issuer and dates; Sol, 25/10).
                        for p[i] in root.tab.reader.props-about: FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            spacing: 10px;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: p.name; width: 150px; font-size: Theme.fs-label; color: Theme.text-secondary; }
                            Text {
                                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                text: p.value;
                                font-size: Theme.fs-label;
                                color: Theme.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                                wrap: root.open-row == i ? word-wrap : no-wrap;
                                TouchArea { mouse-cursor: pointer; clicked => { root.open-row = root.open-row == i ? -1 : i; } }
                            }
                        }
                        for label[k] in root.tab.reader.props-signed: FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: start;
                            spacing: 6px;
                            SmallButton { text: label; clicked => { ReaderBridge.open-signed(root.id, k); } }
                            // Acrobat's Add to Trusted Certificates.
                            if root.tab.reader.props-trust[k] != "": SmallButton { text: root.tab.reader.props-trust[k]; clicked => { ReaderBridge.trust-signature(root.id, k); } }
                            // Acrobat's Clear Signature: the field unsigned, to be signed again.
                            SmallButton { text: "Clear signature"; clicked => { ReaderBridge.clear-signature(root.id, k); root.focus-pages(); } }
                        }
                    }
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 8px;
                    // Acrobat's PDF info report: everything above and the fonts, as text.
                    SmallButton { text: "Copy report"; clicked => { ReaderBridge.props-copy(root.id); } }
                    SmallButton { text: "Save report…"; clicked => { ReaderBridge.props-report(root.id); } }
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { text: "Cancel"; clicked => { ReaderBridge.props-cancel(root.id); root.focus-pages(); } }
                    save := SmallButton {
                        text: "Save";
                        primary: true;
                        clicked => {
                            ReaderBridge.props-save(root.id, title-in.text, author-in.text, subject-in.text, keywords-in.text, custom-in.text, page-in.text, root.open-layout, root.open-zoom, root.open-panel, root.open-window);
                            root.focus-pages();
                        }
                    }
                }
            }
        }
    }
}

// More ▸ Background… (Acrobat's Edit a PDF ▸ Background): a colour or a picture behind every page's
// content, one undo step; Remove takes out the backgrounds a file already has.
export component BackgroundSheet inherits Rectangle {
    in property <int> id;
    callback focus-pages();
    // Colours as reader_ui::BACKGROUNDS; strength (opacity) as BACKGROUND_OPACITY.
    property <int> colour: 0;
    property <int> strength: 0;
    background: #00000044;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Return { ReaderBridge.background-apply(root.id, root.colour, root.strength, 0); root.focus-pages(); return accept; }
            if e.text == Key.Escape { ReaderBridge.background-apply(root.id, 0, 0, 3); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 400px;
        height: bl.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        bl := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Page background"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Behind the content of every page. ⌘Z undoes it."; font-size: Theme.fs-caption; color: Theme.text-muted; }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Colour"; width: 70px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                for c[i] in [#FFF8D6, #E3F0FF, #E8F7E4, #FDE7EC, #EFEFEF, #FFFFFF]: ColourDot { colour: c; selected: root.colour == i; clicked => { root.colour = i; } }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Opacity"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                for o[i] in ["100 %", "75 %", "50 %"]: SmallButton { text: o; primary: root.strength == i; clicked => { root.strength = i; } }
                Rectangle { horizontal-stretch: 1; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                SmallButton { text: "Picture…"; clicked => { ReaderBridge.background-apply(root.id, root.colour, root.strength, 1); root.focus-pages(); } }
                SmallButton { text: "Remove"; clicked => { ReaderBridge.background-apply(root.id, 0, 0, 2); root.focus-pages(); } }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: "Cancel"; clicked => { ReaderBridge.background-apply(root.id, 0, 0, 3); root.focus-pages(); } }
                SmallButton { text: "Apply"; primary: true; clicked => { ReaderBridge.background-apply(root.id, root.colour, root.strength, 0); root.focus-pages(); } }
            }
        }
    }
}

// More ▸ Versions… (Acrobat's File ▸ Revert, and the versions an incremental save keeps): each
// version saved in the file opens on its own; Revert drops the unsaved edits.
export component VersionsSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    background: #00000044;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.version-action(root.id, -1); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 400px;
        height: vl.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Versions"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.tab.reader.versions == 1 ? "The file holds one version: each save that adds to it keeps the one before." : "The file holds " + root.tab.reader.versions + " versions, the oldest first.";
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            for i in root.tab.reader.versions: FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Version " + (i + 1) + (i + 1 == root.tab.reader.versions ? " (as last saved)" : ""); font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: "Open"; clicked => { ReaderBridge.version-action(root.id, i + 1); root.focus-pages(); } }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                if root.tab.reader.dirty: SmallButton { text: "Revert to saved"; clicked => { ReaderBridge.version-action(root.id, 0); root.focus-pages(); } }
                if root.tab.reader.dirty: Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Unsaved changes are lost"; font-size: Theme.fs-caption; color: Theme.danger; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: "Close"; primary: true; clicked => { ReaderBridge.version-action(root.id, -1); root.focus-pages(); } }
            }
        }
    }
}

// The search panel's In a folder… (Acrobat's Advanced Search): the pages of the folder's PDFs that
// hold the words, a line around them; a click opens the file at its page.
export component FolderSearchSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    background: #00000044;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.folder-result(root.id, -1); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 560px;
        height: min(vl.preferred-height, root.height - 80px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: root.tab.reader.folder-title; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; overflow: elide; }
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.tab.reader.folder-busy ? "Searching…" : root.tab.reader.folder-results.length == 0 ? "Not found in the folder's PDFs." : root.tab.reader.folder-results.length + " pages found";
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
            }
            ScrollView {
                min-height: min(root.tab.reader.folder-results.length * 40px, 420px);
                VerticalLayout {
                    for h[k] in root.tab.reader.folder-results: Rectangle {
                        height: 40px;
                        border-radius: Theme.radius-small;
                        background: ht.has-hover ? Theme.popup-hover : transparent;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: h.file + " · " + h.page; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; overflow: elide; }
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: h.line; font-size: Theme.fs-caption; color: Theme.text-muted; overflow: elide; }
                        }
                        ht := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ReaderBridge.folder-result(root.id, k); root.focus-pages(); }
                        }
                    }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: end;
                SmallButton { text: "Close"; clicked => { ReaderBridge.folder-result(root.id, -1); root.focus-pages(); } }
            }
        }
    }
}

// More tools ▸ Accessibility check (Acrobat's Full Check): the rules failed first, each with where
// and why; Fix on the ones Sheaf can fix, then checked again; Save report… as Acrobat's.
export component AccessibilitySheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    background: #00000044;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.accessibility-fix(root.id, -1); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 600px;
        height: min(vl.preferred-height, root.height - 80px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Accessibility check"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.tab.reader.a11y-busy ? "Checking…" : root.tab.reader.a11y-summary;
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
            }
            ScrollView {
                min-height: min(root.tab.reader.a11y-rows.length * 52px, 440px);
                VerticalLayout {
                    for c[k] in root.tab.reader.a11y-rows: Rectangle {
                        height: 52px;
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            padding-left: 4px;
                            padding-right: 8px;
                            spacing: 10px;
                            Rectangle {
                                width: 10px;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: c.status == 0 ? Theme.danger : c.status == 1 ? #D9A21B : Theme.success-strong;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: c.name + (c.status == 1 ? " (check by hand)" : ""); font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; overflow: elide; }
                                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: c.detail; font-size: Theme.fs-caption; color: Theme.text-muted; overflow: elide; }
                            }
                            if c.fix: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: "Fix"; clicked => { ReaderBridge.accessibility-fix(root.id, k); } }
                        }
                    }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                SmallButton { text: "Save report…"; clicked => { ReaderBridge.accessibility-report(root.id); } }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: "Close"; primary: true; clicked => { ReaderBridge.accessibility-fix(root.id, -1); root.focus-pages(); } }
            }
        }
    }
}

// More tools ▸ Voice… (Acrobat's Reading ▸ Voice): the system's voices; a click picks one, kept.
export component VoicesSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    background: #00000044;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.voice-pick(root.id, -2); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 360px;
        height: min(vl.preferred-height, root.height - 80px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 8px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Voice"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            if root.tab.reader.voices.length == 0: Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "No voice was found on this computer."; font-size: Theme.fs-caption; color: Theme.text-muted; }
            ScrollView {
                min-height: min((root.tab.reader.voices.length + 1) * 30px, 400px);
                VerticalLayout {
                    for name[k] in [""]: Rectangle {
                        height: 30px;
                        background: dt.has-hover ? Theme.popup-hover : transparent;
                        border-radius: Theme.radius-small;
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; x: PlatformBridge.rtl ? parent.width - (8px) - self.width : 8px; text: "The system's default"; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                        dt := TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.voice-pick(root.id, -1); root.focus-pages(); } }
                    }
                    for v[k] in root.tab.reader.voices: Rectangle {
                        height: 30px;
                        background: vt.has-hover ? Theme.popup-hover : transparent;
                        border-radius: Theme.radius-small;
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; x: PlatformBridge.rtl ? parent.width - (8px) - self.width : 8px; text: v; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; overflow: elide; }
                        vt := TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.voice-pick(root.id, k); root.focus-pages(); } }
                    }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: end;
                SmallButton { text: "Close"; clicked => { ReaderBridge.voice-pick(root.id, -2); root.focus-pages(); } }
            }
        }
    }
}

// Help ▸ Keyboard shortcuts (Acrobat's and PDF Expert's ⌘/): the reader's keys, by what they do.
// ⌘ is Ctrl on Linux and Windows.
export component HelpSheet inherits Rectangle {
    in property <int> id;
    callback focus-pages();
    background: #00000044;
    TouchArea { clicked => { ReaderBridge.show-help(root.id, false); root.focus-pages(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape || e.text == "?" { ReaderBridge.show-help(root.id, false); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: 760px;
        height: min(vl.preferred-height, root.height - 60px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        TouchArea { }
        vl := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "Keyboard shortcuts"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 28px;
                for col in [
                    [
                        { k: "", t: "Tools" },
                        { k: PlatformBridge.tool-letters[0], t: "Select text" }, { k: PlatformBridge.tool-letters[1], t: "Highlight" }, { k: PlatformBridge.tool-letters[2], t: "Underline" }, { k: PlatformBridge.tool-letters[3], t: "Strikethrough" },
                        { k: PlatformBridge.tool-letters[4], t: "Note" }, { k: PlatformBridge.tool-letters[6], t: "Text box" }, { k: PlatformBridge.tool-letters[5], t: "Pen" }, { k: PlatformBridge.tool-letters[10], t: "Shapes" }, { k: PlatformBridge.tool-letters[11], t: "Eraser" },
                        { k: PlatformBridge.tool-letters[12], t: "Stamp" }, { k: PlatformBridge.tool-letters[9], t: "Sign" }, { k: PlatformBridge.tool-letters[7], t: "Edit text and objects" }, { k: PlatformBridge.tool-letters[8], t: "Add image" },
                        { k: PlatformBridge.tool-letters[13], t: "Link" }, { k: PlatformBridge.tool-letters[14], t: "Prepare form" },
                    ],
                    [
                        { k: "", t: "View" },
                        { k: "⌘ +  ⌘ −", t: "Zoom in, out" }, { k: PlatformBridge.key-labels[18], t: "Actual size" }, { k: PlatformBridge.key-labels[20], t: "Fit width" }, { k: PlatformBridge.key-labels[19], t: "Fit page" },
                        { k: "⇧⌘ +  ⇧⌘ −", t: "Rotate view" }, { k: PlatformBridge.key-labels[22], t: "One page, two, cover alone" }, { k: PlatformBridge.key-labels[21], t: "Side panel" },
                        { k: PlatformBridge.key-labels[25], t: "Full screen" }, { k: "Space drag", t: "Move the pages" }, { k: "← →  PgUp PgDn", t: "Previous, next page" },
                        { k: "Home  End", t: "First, last page" }, { k: PlatformBridge.key-labels[31], t: "Go to page" },
                    ],
                    [
                        { k: "", t: "Document" },
                        { k: PlatformBridge.key-labels[11], t: "Find" }, { k: "⌘ G  ⇧⌘ G", t: "Next, previous result" }, { k: PlatformBridge.key-labels[2], t: "Save" }, { k: PlatformBridge.key-labels[3], t: "Save as" },
                        { k: PlatformBridge.key-labels[4], t: "Print" }, { k: PlatformBridge.key-labels[5], t: "Document properties" }, { k: "⌘ Z  ⇧⌘ Z", t: "Undo, redo" },
                        { k: "⌘ C  ⌘ X  ⌘ V", t: "Copy, cut, paste" }, { k: "⌘ K", t: "Link the selected text" }, { k: "Delete", t: "Delete the selection" },
                        { k: "⇧⌘ [  ⇧⌘ ]", t: "Previous, next tab" }, { k: PlatformBridge.key-labels[6], t: "Close the tab" }, { k: "?  ⌘ /", t: "These shortcuts" },
                    ],
                ]: VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    for row in col: FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: LayoutAlignment.stretch;
                        spacing: 10px;
                        if row.k != "": Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 96px; text: row.k; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text-secondary; }
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: row.t; font-size: Theme.fs-label; font-weight: row.k == "" ? Theme.weight-demibold : 400; color: row.k == "" ? Theme.text-heading : Theme.text; }
                    }
                }
            }
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: "⌘ is Ctrl on Linux and Windows."; font-size: Theme.fs-caption; color: Theme.text-muted; }
        }
    }
}
