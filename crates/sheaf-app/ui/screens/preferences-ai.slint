// Preferences ▸ AI (src/ai_ui.rs): the provider that answers the AI panel (Acrobat's and PDF
// Expert's AI settings, opened to OpenAI, Anthropic, Gemini, Mistral, xAI, any OpenAI-compatible
// server and local models), its model, address and API key (kept encrypted), auto-open, off.
import { Theme } from "../theme.slint";
import { SecondaryButton } from "dialogs.slint";
import { Check } from "../widgets/check.slint";
import { SortCombo } from "../widgets/sort-combo.slint";
import { TextField } from "../widgets/text-field.slint";
import { AiBridge } from "../ai.slint";

export component AiSection inherits Rectangle {
    border-radius: Theme.r-md;
    background: Theme.window;
    border-width: 1px;
    border-color: Theme.hairline;
    height: lay.preferred-height;
    // The fields as typed (they live inside conditional rows), refilled when the provider changes.
    property <string> model-text: AiBridge.pref-model;
    property <string> base-text: AiBridge.pref-base;
    property <string> key-text;
    property <int> chosen: AiBridge.pref-provider;
    changed chosen => {
        root.model-text = AiBridge.pref-model;
        root.base-text = AiBridge.pref-base;
        root.key-text = "";
        provider.current-index = AiBridge.pref-provider;
    }
    lay := VerticalLayout {
        padding: 16px;
        padding-top: 8px;
        spacing: 12px;
        Text { height: 16px; text: @tr("AI").to-uppercase(); font-size: Theme.fs-subhead; font-weight: Theme.weight-demibold; color: Theme.text-2; vertical-alignment: bottom; }
        Text {
            text: @tr("The AI Assistant (✦ in a document's toolbar) sends only the document's text, never the file, to the provider below. Automatic uses Ollama or a llama.cpp server on this computer when one is running.");
            font-size: Theme.fs-caption;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: @tr("Provider"); font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; width: 90px; }
            provider := SortCombo {
                width: 300px;
                options: AiBridge.providers;
                current-index: AiBridge.pref-provider;
                chevron: @image-url("../icons/chevron-down.svg");
                selected(k) => { AiBridge.pref("provider", "" + k); }
            }
        }
        if AiBridge.pref-provider > 0: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: @tr("Model"); font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; width: 90px; }
            TextField { width: 300px; text <=> root.model-text; placeholder: AiBridge.pref-model-hint; accepted => { AiBridge.pref("model", self.text); } }
        }
        if AiBridge.pref-provider > 0: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: @tr("Address"); font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; width: 90px; }
            TextField { width: 300px; text <=> root.base-text; placeholder: AiBridge.pref-base-hint; accepted => { AiBridge.pref("base", self.text); } }
        }
        if AiBridge.pref-provider > 0: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: @tr("API key"); font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; width: 90px; }
            TextField { width: 300px; text <=> root.key-text; password: true; allow-reveal: true; placeholder: AiBridge.pref-has-key ? @tr("Saved (encrypted) — type to replace") : AiBridge.pref-needs-key ? @tr("Needed") : @tr("Optional"); accepted => { AiBridge.pref("key", self.text); self.text = ""; } }
            if AiBridge.pref-has-key: SecondaryButton { text: @tr("Forget key"); clicked => { AiBridge.pref("forget-key", ""); } }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if AiBridge.pref-provider > 0: SecondaryButton {
                text: @tr("Save");
                clicked => {
                    AiBridge.pref("model", root.model-text);
                    AiBridge.pref("base", root.base-text);
                    if root.key-text != "" { AiBridge.pref("key", root.key-text); root.key-text = ""; }
                }
            }
            SecondaryButton { text: @tr("Test connection"); clicked => { AiBridge.pref("test", ""); } }
        }
        if AiBridge.pref-status != "": Text { text: AiBridge.pref-status; font-size: Theme.fs-label; color: Theme.text-secondary; wrap: word-wrap; }
        Check { text: @tr("Open the AI panel with every document"); checked: AiBridge.pref-auto-open; toggled => { AiBridge.pref("auto-open", self.checked ? "1" : "0"); } }
        Check { text: @tr("Turn AI off (nothing is ever sent)"); checked: AiBridge.off; toggled => { AiBridge.pref("off", self.checked ? "1" : "0"); } }
    }
}
