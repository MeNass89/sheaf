// Preferences ▸ Plugins (Acrobat's plug-ins, Stirling's custom scripts) and the warning before a
// plugin's first run (the PluginBridge global, src/plugins_ui.rs, src/plugins.rs).
import { Theme } from "../theme.slint";
import { Segment } from "../widgets/radio-card.slint";
import { SecondaryButton, Modal } from "dialogs.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { PlatformBridge } from "../platform.slint";

// A plugin of the plugins folder.
export struct PluginRow {
    id: string,
    name: string,
    // "1.0 · by Someone".
    about: string,
    description: string,
    // Its tools' names, joined.
    tools: string,
    enabled: bool,
    allowed: bool,
}

export global PluginBridge {
    in property <[PluginRow]> rows;
    // Folders whose plugin.json is wrong, with why.
    in property <[string]> broken;
    in property <string> folder;
    callback set-enabled(string, bool);
    callback remove(string);
    callback add();
    callback open-folder();
    // The warning before a plugin's first run: its name, author, the command it runs.
    in property <string> ask-name;
    in property <string> ask-author;
    in property <string> ask-command;
    callback answer(bool);
}

component Card inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius-card;
    background: Theme.card;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.title;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
        }
        @children
    }
}

// The plugins found, each turned on or off, removed; Add a plugin… copies a plugin folder in.
export component PluginsSection inherits Card {
    title: @tr("Plugins");
    property <string> removing;
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("A plugin adds tools to the Tools page and to actions. Each runs as a separate program on a copy of the PDF; Sheaf asks before a plugin runs for the first time.");
        font-size: Theme.fs-caption;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if PluginBridge.rows.length == 0: Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("No plugin installed.");
        font-size: Theme.fs-body;
        color: Theme.text-secondary;
    }
    for p in PluginBridge.rows: Rectangle {
        height: row.preferred-height;
        border-radius: Theme.radius-item;
        background: Theme.panel-bg;
        row := VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: p.name + "  ·  " + p.about;
                font-size: Theme.fs-body;
                font-weight: Theme.weight-demibold;
                color: Theme.text;
                overflow: elide;
            }
            if p.description != "": Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: p.description;
                font-size: Theme.fs-caption;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Tools: {}", p.tools) + (p.allowed ? "" : @tr(" · not run yet"));
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.start;
                spacing: 8px;
                Segment { width: self.fit-width; text: @tr("On"); selected: p.enabled; clicked => { PluginBridge.set-enabled(p.id, true); } }
                Segment { width: self.fit-width; text: @tr("Off"); selected: !p.enabled; clicked => { PluginBridge.set-enabled(p.id, false); } }
                // Removing deletes the plugin's folder: a second click confirms it.
                SecondaryButton {
                    text: root.removing == p.id ? @tr("Click again to remove") : @tr("Remove");
                    clicked => {
                        if root.removing == p.id { root.removing = ""; PluginBridge.remove(p.id); } else { root.removing = p.id; }
                    }
                }
            }
        }
    }
    for b in PluginBridge.broken: Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: b;
        font-size: Theme.fs-caption;
        color: Theme.danger;
        wrap: word-wrap;
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        SecondaryButton { text: @tr("Add a plugin…"); clicked => { PluginBridge.add(); } }
        SecondaryButton { text: @tr("Open the plugins folder"); clicked => { PluginBridge.open-folder(); } }
    }
}

// Acrobat's warning before an untrusted plug-in runs: what runs, from whom; allowed once per version.
export component PluginWarningDialog inherits Modal {
    card-width: 460px;
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("Run the plugin “{}”?", PluginBridge.ask-name);
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: PluginBridge.ask-author == "" ? @tr("Its author is not named.") : @tr("By {}.", PluginBridge.ask-author);
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("It runs this program on a copy of your PDF, with your account's rights: it can read and change your files. Allow it only if you trust where the plugin comes from.");
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    Rectangle {
        // A fixed height: a wrapped text's height asked of its width loops in the dialog's layout.
        height: 48px;
        border-radius: Theme.radius-small;
        background: Theme.input-bg;
        Text { x: 8px; width: parent.width - 16px; height: parent.height; text: PluginBridge.ask-command; font-size: Theme.fs-caption; color: Theme.text; wrap: word-wrap; overflow: elide; vertical-alignment: center; }
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: 10px;
        SecondaryButton { text: @tr("Don’t run"); clicked => { PluginBridge.answer(false); } }
        PrimaryButton { text: @tr("Allow and run"); clicked => { PluginBridge.answer(true); } }
    }
}
