import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolTab } from "../flow-types.slint";
import { PrimaryButton } from "../widgets/button.slint";

component SmallIcon inherits Rectangle {
    in property <image> icon;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: Theme.radius-small;
    background: touch.has-hover ? Theme.popup-hover : transparent;
    Image {
        width: 15px;
        height: 15px;
        source: root.icon;
        colorize: Theme.text-secondary;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    height: 22px;
    width: label.preferred-width + 20px;
    border-radius: Theme.radius-small;
    background: root.strong ? Theme.success-strong : Theme.pill-bg;
    label := Text {
        text: root.text;
        font-size: Theme.fs-caption;
        font-weight: Theme.weight-demibold;
        color: root.strong ? Theme.on-success : Theme.text-muted;
    }
}

// Same tab after the job: output cards, "Continue to…", summary bar.
export component ResultScreen inherits Rectangle {
    in property <ToolTab> tab;
    callback open-output(int);
    callback reveal-output(int);
    callback open-folder();
    callback start-over();
    callback continue-to(string);

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.content-padding;
        padding-top: 18px;
        spacing: 16px;

        Text {
            text: root.tab.name;
            font-size: Theme.fs-result-title;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            // Outputs
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.content-bg;
                border-radius: Theme.radius-item;
                VerticalLayout {
                if root.tab.failure-title != "": Rectangle {
                    height: fails.preferred-height;
                    fails := VerticalLayout {
                        padding: 14px;
                        padding-bottom: 0px;
                        spacing: 4px;
                        Text {
                            text: root.tab.failure-title;
                            font-size: Theme.fs-label;
                            font-weight: Theme.weight-demibold;
                            color: Theme.danger;
                        }
                        for f in root.tab.failures: Text {
                            text: f;
                            font-size: Theme.fs-caption;
                            color: Theme.danger;
                            overflow: elide;
                        }
                    }
                }
                if root.tab.notes-title != "": Rectangle {
                    height: min(notes.preferred-height, 160px);
                    ScrollView {
                        content-width: self.visible-width;
                        content-height: notes.preferred-height;
                        notes := VerticalLayout {
                            width: parent.visible-width;
                            padding: 14px;
                            padding-bottom: 0px;
                            spacing: 4px;
                            Text {
                                text: root.tab.notes-title;
                                font-size: Theme.fs-label;
                                font-weight: Theme.weight-demibold;
                                color: Theme.warning;
                            }
                            for n in root.tab.notes: Text {
                                text: n;
                                font-size: Theme.fs-caption;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: outs.preferred-height;
                    outs := FlexboxLayout {
                        width: parent.visible-width;
                        padding: 14px;
                        spacing: 14px;
                        flex-wrap: wrap;
                        for o[i] in root.tab.outputs: Rectangle {
                            width: 190px;
                            height: 150px;
                            border-radius: Theme.radius-item;
                            background: Theme.card;
                            Rectangle {
                                x: 12px;
                                y: 12px;
                                width: 32px;
                                height: 32px;
                                border-radius: Theme.radius-small;
                                background: root.tab.tile.with-alpha(0.15);
                                Image {
                                    width: 18px;
                                    height: 18px;
                                    source: o.is-pdf ? @image-url("../icons/file-text.svg")
                                        : o.kind == "docx" ? @image-url("../icons/file-type.svg")
                                        : o.kind == "pptx" ? @image-url("../icons/presentation.svg")
                                        : o.kind == "xlsx" ? @image-url("../icons/sheet.svg")
                                        : @image-url("../icons/image.svg");
                                    colorize: root.tab.tile;
                                }
                            }
                            Text {
                                x: 12px;
                                y: 56px;
                                width: parent.width - 24px;
                                text: o.name;
                                font-size: Theme.fs-label;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                x: 12px;
                                y: 75px;
                                text: o.info;
                                font-size: Theme.fs-caption;
                                color: Theme.text-muted;
                            }
                            if o.note != "": HorizontalLayout {
                                x: 12px;
                                y: 96px;
                                height: 16px;
                                spacing: 6px;
                                Rectangle {
                                    width: 16px;
                                    border-radius: 8px;
                                    background: Theme.success-strong;
                                    Image {
                                        width: 10px;
                                        height: 10px;
                                        source: @image-url("../icons/check.svg");
                                        colorize: Theme.on-success;
                                    }
                                }
                                Text {
                                    text: o.note;
                                    font-size: Theme.fs-caption;
                                    color: Theme.success-strong;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                x: parent.width - 70px;
                                y: parent.height - 34px;
                                width: 60px;
                                height: 26px;
                                spacing: 4px;
                                SmallIcon {
                                    icon: @image-url("../icons/file.svg");
                                    clicked => { root.open-output(i); }
                                }
                                SmallIcon {
                                    icon: @image-url("../icons/folder.svg");
                                    clicked => { root.reveal-output(i); }
                                }
                            }
                        }
                    }
                }
                }
            }

            // Continue to…
            Rectangle {
                width: Theme.continue-width;
                background: Theme.content-bg;
                border-radius: Theme.radius-item;
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    Text {
                        text: "Continue to…";
                        font-size: Theme.fs-body-large;
                        font-weight: Theme.weight-demibold;
                        color: Theme.text;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: list.preferred-height;
                        list := VerticalLayout {
                            width: parent.visible-width;
                            spacing: 6px;
                            alignment: start;
                            for c in root.tab.continue-tools: Rectangle {
                                height: Theme.continue-row;
                                border-radius: Theme.radius-button;
                                background: ct.has-hover ? Theme.popup-hover : Theme.card;
                                Rectangle {
                                    x: 10px;
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 5px;
                                    background: c.tile;
                                    Image {
                                        width: 13px;
                                        height: 13px;
                                        source: c.icon;
                                        colorize: white;
                                    }
                                }
                                Text {
                                    x: 42px;
                                    width: parent.width - 48px;
                                    text: c.name;
                                    font-size: Theme.fs-label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                ct := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.continue-to(c.id); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Summary bar
        Rectangle {
            height: Theme.result-bar-height + (root.tab.warning != "" ? 18px : 0) + (root.tab.result-verified != "" ? 18px : 0);
            background: Theme.content-bg;
            border-radius: Theme.radius-item;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 18px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    border-width: 2.5px;
                    border-color: Theme.success;
                    Image {
                        width: 22px;
                        height: 22px;
                        source: @image-url("../icons/check.svg");
                        colorize: Theme.success;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: root.tab.result-title;
                        font-size: Theme.fs-label;
                        font-weight: Theme.weight-demibold;
                        color: Theme.text;
                    }
                    if root.tab.result-sub != "": HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: root.tab.result-sub;
                            font-size: Theme.fs-label;
                            color: Theme.text-secondary;
                        }
                        Text {
                            text: root.tab.result-pct;
                            font-size: Theme.fs-label;
                            font-weight: Theme.weight-demibold;
                            color: Theme.success-strong;
                        }
                    }
                    if root.tab.result-verified != "": Text {
                        text: root.tab.result-verified;
                        font-size: Theme.fs-caption;
                        font-weight: Theme.weight-demibold;
                        color: Theme.success-strong;
                    }
                    if root.tab.warning != "": Text {
                        text: root.tab.warning;
                        font-size: Theme.fs-caption;
                        font-weight: Theme.weight-demibold;
                        color: Theme.warning;
                    }
                }
                if root.tab.size-before != "": HorizontalLayout {
                    spacing: 10px;
                    padding-left: 10px;
                    alignment: center;
                    Pill { y: (parent.height - self.height) / 2; text: root.tab.size-before; }
                    Image {
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        source: @image-url("../icons/arrow-right.svg");
                        colorize: Theme.text-muted;
                    }
                    Pill { y: (parent.height - self.height) / 2; text: root.tab.size-after; strong: true; }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: so.has-hover ? Theme.popup-hover : Theme.card;
                    Image {
                        width: 17px;
                        height: 17px;
                        source: @image-url("../icons/rotate-ccw.svg");
                        colorize: Theme.text;
                    }
                    so := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.start-over(); }
                    }
                }
                PrimaryButton {
                    y: (parent.height - self.height) / 2;
                    width: 120px;
                    height: 38px;
                    text: "Open folder";
                    clicked => { root.open-folder(); }
                }
            }
        }
    }
}
