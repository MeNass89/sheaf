// Acrobat's Print Production: choose a scope, then an undoable fix or page-box change.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TextField } from "../widgets/text-field.slint";
import { SmallButton } from "reader-parts.slint";
import { ReaderBridge } from "../flow-types.slint";

export component ProductionSheet inherits Rectangle {
    in property <int> id;
    callback focus-pages();
    property <bool> all: false;
    property <int> box: 0;
    background: #00000044;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.production-close(root.id); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: min(640px, root.width - 32px);
        height: min(720px, root.height - 40px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: "Print production"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            HorizontalLayout {
                spacing: 8px;
                SmallButton { text: "Selected / current page"; primary: !root.all; clicked => { root.all = false; } }
                SmallButton { text: "All pages"; primary: root.all; clicked => { root.all = true; } }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    Text { text: "Fix page hairlines"; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; }
                    Text { text: "Raises thin strokes in page content.\nGrouped art, text and comments stay as they are."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    minimum := TextField { label: "Minimum stroke (points)"; text: "0.25"; }
                    HorizontalLayout {
                        SmallButton { text: "Fix hairlines"; clicked => { ReaderBridge.production-hairlines(root.id, minimum.text, root.all); root.focus-pages(); } }
                    }
                    Rectangle { height: 1px; background: Theme.separator; }
                    Text { text: "Set page boxes"; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; }
                    Text { text: "Margins inward from each media box.\nPDF units, before rotation. Artwork stays put.\nSet boxes before adding crop marks."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        for name[k] in ["Crop", "Trim", "Bleed", "Art"]: SmallButton { text: name; primary: root.box == k; clicked => { root.box = k; } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        left := TextField { label: "Left"; text: "0"; }
                        bottom := TextField { label: "Bottom"; text: "0"; }
                        right := TextField { label: "Right"; text: "0"; }
                        top := TextField { label: "Top"; text: "0"; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SmallButton { text: "Set box"; clicked => { ReaderBridge.production-box(root.id, root.box, left.text, bottom.text, right.text, top.text, false, root.all); root.focus-pages(); } }
                        SmallButton { text: "Reset box"; clicked => { ReaderBridge.production-box(root.id, root.box, "", "", "", "", true, root.all); root.focus-pages(); } }
                    }
                    Rectangle { height: 1px; background: Theme.separator; }
                    Text { text: "Crop marks"; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; }
                    Text { text: "Black marks outside the existing bleed.\nThe sheet grows; hidden art stays clipped.\nNo bleed artwork is created."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    HorizontalLayout {
                        SmallButton { text: "Add crop marks"; clicked => { ReaderBridge.production-marks(root.id, root.all); root.focus-pages(); } }
                    }
                }
            }
            HorizontalLayout {
                Text { text: "Each change can be undone"; font-size: Theme.fs-caption; color: Theme.text-muted; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: "Close"; clicked => { ReaderBridge.production-close(root.id); root.focus-pages(); } }
            }
        }
    }
}
