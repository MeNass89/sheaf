// Acrobat's Print Production: choose a scope, then an undoable fix or page-box change.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TextField } from "../widgets/text-field.slint";
import { SmallButton } from "reader-parts.slint";
import { ToolTab, ReaderBridge } from "../flow-types.slint";

export component ProductionSheet inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    callback focus-pages();
    property <bool> all: false;
    property <int> box: 0;
    property <int> press-level: 0;
    property <int> mark-style: 0;
    background: #00000044;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { ReaderBridge.production-close(root.id); root.focus-pages(); return accept; }
            reject
        }
    }
    Rectangle {
        width: min(640px, root.width - 32px);
        height: min(720px, root.height - 40px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: "Print production"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            HorizontalLayout {
                spacing: 8px;
                SmallButton { text: "Selected / current page"; primary: !root.all; clicked => { root.all = false; } }
                SmallButton { text: "All pages"; primary: root.all; clicked => { root.all = true; } }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 12px;
                    Text { text: "Fix page hairlines"; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; }
                    Text { text: "Raises page, Form and pattern strokes.\nType 3 glyph strokes are included.\nOther font outlines and comments stay."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    minimum := TextField { label: "Minimum stroke (points)"; text: "0.25"; }
                    HorizontalLayout {
                        SmallButton { text: "Fix hairlines"; clicked => { ReaderBridge.production-hairlines(root.id, minimum.text, root.all); root.focus-pages(); } }
                    }
                    Rectangle { height: 1px; background: Theme.separator; }
                    Text { text: "Set page boxes"; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; }
                    Text { text: "Margins inward from each media box.\nPDF units, before rotation. Artwork stays put.\nSet boxes before adding crop marks."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        for name[k] in ["Crop", "Trim", "Bleed", "Art"]: SmallButton { text: name; primary: root.box == k; clicked => { root.box = k; } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        left := TextField { label: "Left"; text: "0"; }
                        bottom := TextField { label: "Bottom"; text: "0"; }
                        right := TextField { label: "Right"; text: "0"; }
                        top := TextField { label: "Top"; text: "0"; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SmallButton { text: "Set box"; clicked => { ReaderBridge.production-box(root.id, root.box, left.text, bottom.text, right.text, top.text, false, root.all); root.focus-pages(); } }
                        SmallButton { text: "Reset box"; clicked => { ReaderBridge.production-box(root.id, root.box, "", "", "", "", true, root.all); root.focus-pages(); } }
                    }
                    Rectangle { height: 1px; background: Theme.separator; }
                    Text { text: "Printer marks"; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; }
                    Text { text: "Marks stay outside the existing bleed.\nThe sheet grows; hidden art stays clipped.\nRegistration targets print on every plate."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        for name[k] in ["Crop", "All", "Register", "Bars", "Page info"]: SmallButton { text: name; primary: root.mark-style == k; clicked => { root.mark-style = k; } }
                    }
                    mark-width := TextField { label: "Mark width (points)"; text: "0.25"; }
                    HorizontalLayout {
                        SmallButton { text: "Add printer marks"; clicked => { ReaderBridge.production-marks(root.id, root.all, root.mark-style, mark-width.text); root.focus-pages(); } }
                    }
                    Text { text: "Trapping and flattener preview unavailable.\nTransparency is kept; no flattening occurs."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    Rectangle { height: 1px; background: Theme.separator; }
                    Text { text: "Save as PDF/X"; font-size: Theme.fs-label; font-weight: Theme.weight-demibold; color: Theme.text; }
                    Text { text: "Whole document; no password protection.\nNeeds a local Ghostscript installation.\nUse the press's CMYK or Gray ICC profile."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        for name[k] in ["X-3:2002", "X-1a:2001", "X-4"]: SmallButton { text: name; primary: root.press-level == k; clicked => { root.press-level = k; } }
                    }
                    Text { text: "Installed press profiles"; font-size: Theme.fs-caption; color: Theme.text-secondary; }
                    HorizontalLayout {
                        spacing: 8px;
                        for name[k] in ["FOGRA39", "GRACoL", "SWOP"]: SmallButton { text: name; clicked => { ReaderBridge.press-preset(root.id, k); condition.text = ""; } }
                    }
                    HorizontalLayout {
                        SmallButton { text: root.tab.reader.press-profile == "" ? "Choose ICC profile…" : "Change ICC profile…"; clicked => { ReaderBridge.press-profile(root.id); } }
                    }
                    if root.tab.reader.press-profile != "": Text { text: root.tab.reader.press-profile; font-size: Theme.fs-caption; color: Theme.text-secondary; overflow: elide; }
                    condition := TextField { label: "Output condition"; placeholder: "Preset condition, or enter the press name"; }
                    Text { text: "Checks ICC, fonts and level restrictions.\nX-4 needs a recent Ghostscript.\nFull ISO validation is not included.\nPDF/E is not available."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                    HorizontalLayout {
                        SmallButton {
                            text: root.tab.reader.press-busy ? "Converting…" : "Save PDF/X copy…";
                            opacity: root.tab.reader.press-busy ? 0.5 : 1;
                            clicked => { if !root.tab.reader.press-busy { ReaderBridge.press-export(root.id, condition.text, root.press-level); } }
                        }
                    }
                }
            }
            HorizontalLayout {
                Text { text: "Page edits can be undone"; font-size: Theme.fs-caption; color: Theme.text-muted; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: "Close"; clicked => { ReaderBridge.production-close(root.id); root.focus-pages(); } }
            }
        }
    }
}
