// Acrobat's Output Preview: every real process or spot plate, as a density mask.
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { SmallButton } from "reader-parts.slint";

component PlateButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 28px;
    width: 170px;
    border-radius: Theme.radius-button;
    background: root.selected ? (touch.has-hover ? Theme.accent-hover : Theme.accent) : (touch.has-hover ? Theme.popup-hover : Theme.pill-bg);
    Text {
        x: 8px; width: parent.width - 16px;
        text: root.text; overflow: elide;
        vertical-alignment: center;
        font-size: Theme.fs-label; font-weight: Theme.weight-demibold;
        color: root.selected ? Theme.on-accent : Theme.text;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// `shown`: ticked for the composite of the inks shown together (Acrobat's Output Preview check boxes).
export struct InkPlate { name: string, image: image, shown: bool }
export global PrintPreviewBridge {
    in-out property <bool> visible;
    in-out property <bool> busy;
    in-out property <int> tab;
    in-out property <int> page;
    in-out property <int> selected;
    in-out property <[InkPlate]> plates;
    // The page as the ticked inks print together; shown while `selected` is −1 (the Output preview's
    // default, as Acrobat opens on all inks).
    in-out property <image> composite;
    in-out property <bool> inks;
    callback toggle(int);
    in-out property <string> error;
    in-out property <string> title;
    in-out property <string> detail;
    callback open(int, int);
    callback close();
}

export component InkPreviewSheet inherits Rectangle {
    callback focus-pages();
    background: #00000044;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { PrintPreviewBridge.close(); root.focus-pages(); return accept; }
            if e.text == Key.UpArrow { PrintPreviewBridge.selected = max(PrintPreviewBridge.inks ? -1 : 0, PrintPreviewBridge.selected - 1); return accept; }
            if e.text == Key.DownArrow && PrintPreviewBridge.plates.length > 0 { PrintPreviewBridge.selected = min(PrintPreviewBridge.plates.length - 1, PrintPreviewBridge.selected + 1); return accept; }
            reject
        }
    }
    Rectangle {
        width: min(920px, root.width - 32px);
        height: min(740px, root.height - 40px);
        border-radius: Theme.radius-card;
        background: Theme.card;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { text: @tr("{} · page {}", PrintPreviewBridge.title, PrintPreviewBridge.page); font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
            Text { text: PrintPreviewBridge.detail; font-size: Theme.fs-caption; color: Theme.text-muted; }
            if PrintPreviewBridge.busy: Text { text: @tr("Rendering preview…"); color: Theme.text-secondary; font-size: Theme.fs-body; }
            if PrintPreviewBridge.error != "": Text { text: PrintPreviewBridge.error; wrap: word-wrap; color: Theme.danger; font-size: Theme.fs-body; }
            if PrintPreviewBridge.plates.length > 0: Text { text: PrintPreviewBridge.selected < 0 ? @tr("The ticked inks together") : PrintPreviewBridge.plates[PrintPreviewBridge.selected].name; wrap: word-wrap; color: Theme.text-secondary; font-size: Theme.fs-caption; }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 16px;
                ScrollView {
                    width: 180px;
                    VerticalLayout {
                        spacing: 8px;
                        if PrintPreviewBridge.inks && PrintPreviewBridge.plates.length > 0: PlateButton {
                            text: @tr("All ticked inks");
                            selected: PrintPreviewBridge.selected < 0;
                            clicked => { PrintPreviewBridge.selected = -1; }
                        }
                        for plate[i] in PrintPreviewBridge.plates: HorizontalLayout {
                            spacing: 6px;
                            if PrintPreviewBridge.inks: Rectangle {
                                width: 18px;
                                height: 18px;
                                y: 5px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.input-border;
                                background: plate.shown ? Theme.accent : transparent;
                                Text { text: plate.shown ? "✓" : ""; color: Theme.on-accent; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { PrintPreviewBridge.toggle(i); } }
                            }
                            PlateButton {
                                width: PrintPreviewBridge.inks ? 146px : 170px;
                                text: plate.name;
                                selected: PrintPreviewBridge.selected == i;
                                clicked => { PrintPreviewBridge.selected = i; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Image {
                    source: PrintPreviewBridge.selected < 0 ? PrintPreviewBridge.composite : PrintPreviewBridge.plates[PrintPreviewBridge.selected].image;
                    image-fit: contain;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                SmallButton { text: @tr("Close"); clicked => { PrintPreviewBridge.close(); root.focus-pages(); } }
            }
        }
    }
}
