import { PortfolioBridge } from "portfolio.slint";
import { ActionBridge } from "actions.slint";
import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolCard, ToolCardView } from "../widgets/tool-card.slint";
import { SortCombo } from "../widgets/sort-combo.slint";

export struct ToolSection {
    title: string,
    collapsed: bool,
    tools: [ToolCard],
}

component CardGrid inherits FlexboxLayout {
    in property <[ToolCard]> tools;
    callback open-tool(string);
    callback star(string);
    // FlexboxLayout's preferred height overestimates wrapped rows, which let the Tools page
    // scroll past its last row: the height is the rows actually laid out at this width.
    property <int> columns: max(1, floor((self.width + Theme.grid-spacing) / (Theme.card-width + Theme.grid-spacing)));
    property <int> rows: ceil(root.tools.length / root.columns);
    spacing: Theme.grid-spacing;
    flex-wrap: wrap;
    height: root.padding-top + root.padding-bottom + root.rows * Theme.card-height + max(0, root.rows - 1) * Theme.grid-spacing;
    for tool in root.tools: ToolCardView {
        tool: tool;
        clicked(id) => { root.open-tool(id); }
        star(id) => { root.star(id); }
    }
}

// Tools page: title, sort choice, and the card grid.
export component ToolsScreen inherits Rectangle {
    in-out property <[ToolSection]> sections;
    in property <[ToolCard]> all-tools;
    in property <image> chevron;
    in-out property <int> sort: 0; // 0 = Categories, 1 = All
    // Search: what is typed goes to `query`; `results` come back best first; ↑↓ choose, ↩ opens.
    in property <[ToolCard]> results;
    property <string> typed;
    property <int> chosen;
    // What is typed, trimmed and lower-cased by Rust: "" shows the grid (spaces alone search nothing).
    callback query(string) -> string;
    callback open-tool(string);
    // Star or unstar a tool; the starred ones, shown first.
    callback star(string);
    in property <[ToolCard]> favourites;
    // The field takes the keyboard when the page opens (and on ⌘F), as a search should.
    in property <int> focus-seq;
    changed focus-seq => { search.focus(); }
    init => { search.focus(); }
    // Rows are 52 px with 4 px between, under 12 px of padding and the page's header.
    function keep-chosen-in-view() {
        let top = 12px + root.chosen * 56px;
        if top < -scroll.content-y { scroll.content-y = -top; }
        if top + 52px > -scroll.content-y + scroll.visible-height { scroll.content-y = -(top + 52px - scroll.visible-height); }
    }

    background: Theme.content-bg;

    VerticalLayout {
        padding-top: Theme.content-padding;
        spacing: 4px;

        HorizontalLayout {
            padding-left: Theme.content-padding;
            padding-right: Theme.content-padding;
            height: 36px;
            spacing: 12px;
            Text {
                text: "Tools";
                font-size: Theme.fs-page-title;
                font-weight: Theme.weight-bold;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            // Search tools (Stirling's tool search): a name, a word, or letters in order.
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 220px;
                height: 32px;
                border-radius: Theme.radius-small;
                border-width: 1px;
                border-color: search.has-focus ? Theme.text-secondary : Theme.input-border;
                background: Theme.input-bg;
                if search.text == "": Text { x: 10px; text: "Search tools"; font-size: Theme.fs-button; color: Theme.text-muted; vertical-alignment: center; }
                search := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    font-size: Theme.fs-button;
                    color: Theme.text;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { root.typed = root.query(self.text); root.chosen = 0; scroll.content-y = 0; }
                    accepted => { if root.results.length > 0 { root.open-tool(root.results[root.chosen].id); } }
                    key-pressed(e) => {
                        if e.text == Key.DownArrow { root.chosen = max(0, min(root.chosen + 1, root.results.length - 1)); root.keep-chosen-in-view(); return accept; }
                        if e.text == Key.UpArrow { root.chosen = max(root.chosen - 1, 0); root.keep-chosen-in-view(); return accept; }
                        if e.text == Key.Escape { self.text = ""; root.typed = root.query(""); return accept; }
                        reject
                    }
                }
            }
            Text {
                text: "Sort";
                font-size: Theme.fs-button;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            SortCombo {
                y: (parent.height - self.height) / 2;
                options: ["Categories", "All"];
                current-index <=> root.sort;
                chevron: root.chevron;
            }
        }

        HorizontalLayout {
            padding-left: Theme.content-padding; padding-right: Theme.content-padding; spacing: 8px;
            Button { text: "Guided actions…"; clicked => { ActionBridge.open-page("actions"); } }
            Button { text: "Create portfolio…"; clicked => { PortfolioBridge.open(); } }
            Button { text: "Library…"; clicked => { ActionBridge.open-page("library"); } }
            Button { text: "Custom tools…"; clicked => { ActionBridge.command("custom-tools", 0); } }
            Rectangle { horizontal-stretch: 1; }
        }

        scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: body.preferred-height;

            body := VerticalLayout {
                width: scroll.visible-width;
                padding-left: Theme.content-padding;
                padding-right: Theme.content-padding;
                padding-bottom: Theme.content-padding;
                alignment: start;

                // Search results replace the grid while something is typed: a list, as Stirling's
                // tool search, so ↑↓ read naturally; the chosen row stays in view.
                if root.typed != "": VerticalLayout {
                    padding-top: 12px;
                    spacing: 4px;
                    if root.results.length == 0: Text {
                        height: 60px;
                        text: "No tool matches \"" + root.typed + "\".";
                        font-size: Theme.fs-body;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    for tool[i] in root.results: Rectangle {
                        height: 52px;
                        border-radius: Theme.radius-item;
                        background: i == root.chosen ? Theme.menu-selected-bg : rt.has-hover ? Theme.popup-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 12px;
                            Rectangle {
                                y: 10px;
                                width: 32px;
                                height: 32px;
                                border-radius: 6px;
                                background: tool.tile;
                                Image { source: tool.icon; width: 18px; height: 18px; colorize: white; }
                            }
                            Text { text: tool.name; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; }
                        }
                        rt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-tool(tool.id); }
                        }
                    }
                }
                if root.favourites.length > 0 && root.typed == "": VerticalLayout {
                    Text {
                        height: Theme.section-header-height;
                        text: "Favourites";
                        font-size: Theme.fs-section;
                        font-weight: Theme.weight-demibold;
                        color: Theme.text-heading;
                        vertical-alignment: center;
                    }
                    CardGrid {
                        tools: root.favourites;
                        open-tool(id) => { root.open-tool(id); }
                        star(id) => { root.star(id); }
                    }
                }
                if root.sort == 0 && root.typed == "": VerticalLayout {
                    for section in root.sections: VerticalLayout {
                        Rectangle {
                            height: Theme.section-header-height;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: section.title;
                                    font-size: Theme.fs-section;
                                    font-weight: Theme.weight-demibold;
                                    color: Theme.text-heading;
                                    vertical-alignment: center;
                                }
                                Image {
                                    source: root.chevron;
                                    width: 12px;
                                    height: 12px;
                                    y: (parent.height - self.height) / 2 + 1px;
                                    colorize: Theme.text-secondary;
                                    transform-rotation: section.collapsed ? -90deg : 0deg;
                                    animate transform-rotation { duration: 120ms; }
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { section.collapsed = !section.collapsed; }
                            }
                        }
                        if !section.collapsed: CardGrid {
                            padding-bottom: 4px;
                            tools: section.tools;
                            open-tool(id) => { root.open-tool(id); }
                            star(id) => { root.star(id); }
                        }
                    }
                }

                if root.sort == 1 && root.typed == "": CardGrid {
                    padding-top: 12px;
                    tools: root.all-tools;
                    open-tool(id) => { root.open-tool(id); }
                    star(id) => { root.star(id); }
                }
            }
        }
    }
}
