// Home ▸ All Tools (DESIGN §5.1): the batch tools, each opening a tool tab. The title row with
// Custom Tools and the search, the category chips, then the tiles by category, favourites first.
// No coloured squares: W1's ToolTile, a monochrome glyph on a `fill-1` tile.
import { PlatformBridge } from "../platform.slint";
import { ActionBridge } from "actions.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme, Space } from "../theme.slint";
import { ToolCard } from "../widgets/tool-card.slint";
import { Button } from "../widgets/button.slint";
import { Chip } from "../widgets/controls.slint";
import { HomeMetrics, PageTitle, TileGrid, EmptyState, SearchField } from "home-kit.slint";

export struct ToolSection {
    title: string,
    collapsed: bool,
    tools: [ToolCard],
}

// A category's header (`fs-title-3`) over its tiles.
component Category inherits VerticalLayout {
    in property <string> title;
    in property <[ToolCard]> tools;
    callback open-tool(string);
    callback star(string);
    spacing: Space.sm;
    padding-top: Space.lg;
    Text {
        height: Theme.lh-title-3 + Space.xs;
        text: root.title;
        font-size: Theme.fs-title-3;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    }
    TileGrid {
        tools: root.tools;
        open-tool(id) => { root.open-tool(id); }
        star(id) => { root.star(id); }
    }
}

export component ToolsScreen inherits Rectangle {
    in-out property <[ToolSection]> sections;
    in property <[ToolCard]> all-tools;
    // Kept for the window's state (a page switch keeps it): -1 = every category, else its index.
    in-out property <int> sort: -1;
    // Search: what is typed goes to `query`; `results` come back best first; ↑↓ choose, ↩ opens.
    in property <[ToolCard]> results;
    property <string> typed;
    property <int> chosen;
    // What is typed, trimmed and lower-cased by Rust: "" shows the grid (spaces alone search nothing).
    callback query(string) -> string;
    callback open-tool(string);
    // Star or unstar a tool; the starred ones, shown first.
    callback star(string);
    in property <[ToolCard]> favourites;
    // The field takes the keyboard when the page opens (and on ⌘F), as a search should.
    in property <int> focus-seq;
    changed focus-seq => { search.take-focus(); }
    init => { search.take-focus(); }

    background: Theme.window;

    VerticalLayout {
        padding-top: HomeMetrics.top;
        spacing: Space.lg;

        PageTitle {
            padding-left: HomeMetrics.margin;
            padding-right: HomeMetrics.margin;
            text: @tr("All Tools");
            Button {
                text: @tr("Custom Tools…");
                tip: @tr("Make your own tools from saved actions");
                clicked => { ActionBridge.command("custom-tools", 0); }
            }
            search := SearchField {
                width: 240px;
                placeholder: @tr("Search tools");
                edited(t) => { root.typed = root.query(t); root.chosen = 0; scroll.content-y = 0; }
                accepted => { if root.typed != "" && root.results.length > 0 { root.open-tool(root.results[root.chosen].id); } }
                key(e) => {
                    if root.typed != "" && e.text == Key.DownArrow { root.chosen = max(0, min(root.chosen + 1, root.results.length - 1)); return accept; }
                    if root.typed != "" && e.text == Key.UpArrow { root.chosen = max(root.chosen - 1, 0); return accept; }
                    if e.text == Key.Escape && self.text != "" { self.text = ""; root.typed = root.query(""); return accept; }
                    reject
                }
            }
        }

        // The categories as chips: All, then each one (Plugins when any).
        if root.typed == "": HorizontalLayout {
            padding-left: HomeMetrics.margin;
            padding-right: HomeMetrics.margin;
            spacing: Space.sm;
            alignment: PlatformBridge.rtl ? LayoutAlignment.end : LayoutAlignment.start;
            Chip { text: @tr("All"); on: root.sort < 0; clicked => { root.sort = -1; } }
            for s[i] in root.sections: Chip { text: s.title; on: root.sort == i; clicked => { root.sort = i; } }
        }

        scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: body.preferred-height;

            body := VerticalLayout {
                width: scroll.visible-width;
                padding-left: HomeMetrics.margin;
                padding-right: HomeMetrics.margin;
                padding-bottom: HomeMetrics.margin;
                alignment: start;

                // Search results replace the grid while something is typed, best first; ↑↓ move
                // the frame, ↩ opens the framed one.
                if root.typed != "" && root.results.length == 0: EmptyState {
                    icon: @image-url("../icons/search.svg");
                    text: @tr("No tool matches \"{}\".", root.typed);
                }
                if root.typed != "" && root.results.length > 0: TileGrid {
                    tools: root.results;
                    chosen: root.chosen;
                    open-tool(id) => { root.open-tool(id); }
                    star(id) => { root.star(id); }
                }
                if root.typed == "" && root.sort < 0 && root.favourites.length > 0: Category {
                    padding-top: 0;
                    title: @tr("Favourites");
                    tools: root.favourites;
                    open-tool(id) => { root.open-tool(id); }
                    star(id) => { root.star(id); }
                }
                if root.typed == "": VerticalLayout {
                    for section[i] in root.sections: VerticalLayout {
                        if root.sort < 0 || root.sort == i: Category {
                            padding-top: root.sort >= 0 || (i == 0 && root.favourites.length == 0) ? 0 : Space.lg;
                            title: section.title;
                            tools: section.tools;
                            open-tool(id) => { root.open-tool(id); }
                            star(id) => { root.star(id); }
                        }
                    }
                }
            }
        }
    }
}
