// Settings ▸ Tools ▸ Security, and the question a document's web link asks (the SettingsBridge
// global, src/settings_ui.rs).
import { Theme } from "../theme.slint";
import { Segment } from "../widgets/radio-card.slint";
import { SecondaryButton, Modal } from "dialogs.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { Check } from "../widgets/check.slint";
import { PlatformBridge } from "../platform.slint";
import { SettingsBridge } from "../settings.slint";

component Card inherits Rectangle {
    in property <string> title;
    // The Settings window's card (settings-form.slint): small-capital title, hairline edge.
    border-radius: Theme.r-md;
    background: Theme.window;
    border-width: 1px;
    border-color: Theme.hairline;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 16px;
        padding-top: 8px;
        spacing: 12px;
        Text {
            height: 16px;
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.title.to-uppercase();
            font-size: Theme.fs-subhead;
            font-weight: Theme.weight-demibold;
            color: Theme.text-2;
            vertical-alignment: bottom;
        }
        @children
    }
}

// A caption above a row of choices.
component Caption inherits Text {
    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    font-size: Theme.fs-body;
    color: Theme.text;
}

component Note inherits Text {
    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    font-size: Theme.fs-caption;
    color: Theme.text-muted;
    wrap: word-wrap;
}

// Acrobat's Enhanced Security, Trust Manager (Internet Access from PDF files, opening attachments
// with other apps) and Privileged Locations.
export component SecuritySection inherits Card {
    title: @tr("Security");
    Caption { text: @tr("Enhanced security"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: self.fit-width; text: @tr("On"); selected: SettingsBridge.enhanced; clicked => { SettingsBridge.set-trust(true, SettingsBridge.web, SettingsBridge.other-apps); } }
        Segment { width: self.fit-width; text: @tr("Off"); selected: !SettingsBridge.enhanced; clicked => { SettingsBridge.set-trust(false, SettingsBridge.web, SettingsBridge.other-apps); } }
    }
    Note { text: SettingsBridge.enhanced ? @tr("Documents outside the trusted locations ask before opening a web page, and never open a site you blocked.") : @tr("Documents open their web links without asking (sites you blocked stay blocked)."); }
    Caption { text: @tr("Web links in documents"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in [@tr("Ask for each site"), @tr("Allow every site"), @tr("Block every site")]: Segment {
            width: self.fit-width;
            text: label;
            selected: SettingsBridge.web == i;
            clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, i, SettingsBridge.other-apps); }
        }
    }
    Caption { text: @tr("Linked and attached files that are not PDFs"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: self.fit-width; text: @tr("Open in their app, after asking"); selected: SettingsBridge.other-apps; clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, SettingsBridge.web, true); } }
        Segment { width: self.fit-width; text: @tr("Never open them"); selected: !SettingsBridge.other-apps; clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, SettingsBridge.web, false); } }
    }
    Caption { text: @tr("Trusted locations"); }
    if SettingsBridge.locations.length == 0: Note { text: @tr("None: documents in a folder or file added here open their links without asking."); }
    for l[k] in SettingsBridge.locations: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 8px;
        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: l; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        SecondaryButton { text: @tr("Remove"); clicked => { SettingsBridge.trust-list(2, k); } }
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        SecondaryButton { text: @tr("Add a folder…"); clicked => { SettingsBridge.trust-list(0, 0); } }
        SecondaryButton { text: @tr("Add a file…"); clicked => { SettingsBridge.trust-list(1, 0); } }
    }
    if SettingsBridge.sites.length > 0: Caption { text: @tr("Sites remembered"); }
    for s[k] in SettingsBridge.sites: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 8px;
        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: s; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        SecondaryButton { text: @tr("Forget"); clicked => { SettingsBridge.trust-list(3, k); } }
    }
}

// Acrobat's security warning when a document opens a web page: allow or block, remembered for
// the site if asked.
export component LinkWarningDialog inherits Modal {
    card-width: 420px;
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("Open a page of “{}”?", SettingsBridge.ask-site);
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("The document links to {}. It opens in your web browser; allow it only if you trust the document.", SettingsBridge.ask-url);
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    remember := Check { text: @tr("Remember for this site"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: 10px;
        SecondaryButton {
            text: @tr("Block");
            clicked => { SettingsBridge.link-answer(false, remember.checked); }
        }
        PrimaryButton {
            text: @tr("Allow");
            clicked => { SettingsBridge.link-answer(true, remember.checked); }
        }
    }
}
