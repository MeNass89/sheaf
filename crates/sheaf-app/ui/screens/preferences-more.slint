// Preferences' print defaults, security and startup sections, and the question a document's web
// link asks (the SettingsBridge global, src/settings_ui.rs).
import { Theme } from "../theme.slint";
import { Segment } from "../widgets/radio-card.slint";
import { SecondaryButton, Modal } from "dialogs.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { Check } from "../widgets/check.slint";
import { PlatformBridge } from "../platform.slint";
import { SettingsBridge } from "../settings.slint";

// A white card with a title, as the page's other sections.
component Card inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius-card;
    background: Theme.card;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.title;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
        }
        @children
    }
}

// A caption above a row of choices.
component Caption inherits Text {
    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    font-size: Theme.fs-body;
    color: Theme.text;
}

component Note inherits Text {
    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    font-size: Theme.fs-caption;
    color: Theme.text-muted;
    wrap: word-wrap;
}

// iLovePDF's Printer preferences (paper size, grayscale) and Acrobat's print defaults: how the
// print sheet opens. The sheet's own "Make default" sets them too.
export component PrintDefaultsSection inherits Card {
    title: @tr("Printing");
    function set(two-sided: bool, paper: int, gray: bool, comments: bool, fit: bool, orientation: int, layout: int) {
        SettingsBridge.set-print-defaults(two-sided, paper, gray, comments, fit, orientation, layout);
    }
    Caption { text: @tr("Paper"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in [@tr("Printer's default"), @tr("A4"), @tr("Letter"), @tr("Legal")]: Segment {
            width: i == 0 ? 150px : 90px;
            text: label;
            selected: SettingsBridge.print-paper == i;
            clicked => { root.set(SettingsBridge.print-two-sided, i, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); }
        }
    }
    Caption { text: @tr("Sides and colour"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 110px; text: @tr("One-sided"); selected: !SettingsBridge.print-two-sided; clicked => { root.set(false, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Segment { width: 110px; text: @tr("Two-sided"); selected: SettingsBridge.print-two-sided; clicked => { root.set(true, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Rectangle { width: 12px; }
        Segment { width: 90px; text: @tr("Colour"); selected: !SettingsBridge.print-gray; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, false, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Segment { width: 90px; text: @tr("Grey"); selected: SettingsBridge.print-gray; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, true, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
    }
    Caption { text: @tr("Scale and comments"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 120px; text: @tr("Fit to paper"); selected: SettingsBridge.print-fit; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, true, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Segment { width: 120px; text: @tr("Actual size"); selected: !SettingsBridge.print-fit; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, false, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Rectangle { width: 12px; }
        Segment { width: 150px; text: @tr("With comments"); selected: SettingsBridge.print-comments; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, true, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Segment { width: 170px; text: @tr("Without comments"); selected: !SettingsBridge.print-comments; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, false, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
    }
    Caption { text: @tr("Orientation"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in [@tr("Auto"), @tr("Portrait"), @tr("Landscape")]: Segment {
            width: 110px;
            text: label;
            selected: SettingsBridge.print-orientation == i;
            clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, i, SettingsBridge.print-layout); }
        }
    }
    Caption { text: "Quality"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in ["Printer's own", "Draft", "Normal", "High"]: Segment {
            width: i == 0 ? 130px : 90px;
            text: label;
            selected: SettingsBridge.print-quality == i;
            clicked => { SettingsBridge.set-print-quality(i); }
        }
    }
    Caption { text: @tr("Pages per sheet"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in ["1", "2", "4", "6", "9", "16", @tr("Booklet")]: Segment {
            width: i == 6 ? 90px : 48px;
            text: label;
            selected: SettingsBridge.print-layout == i;
            clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, i); }
        }
    }
}

// Acrobat's Enhanced Security, Trust Manager (Internet Access from PDF files, opening attachments
// with other apps) and Privileged Locations.
export component SecuritySection inherits Card {
    title: @tr("Security");
    Caption { text: @tr("Enhanced security"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 90px; text: @tr("On"); selected: SettingsBridge.enhanced; clicked => { SettingsBridge.set-trust(true, SettingsBridge.web, SettingsBridge.other-apps); } }
        Segment { width: 90px; text: @tr("Off"); selected: !SettingsBridge.enhanced; clicked => { SettingsBridge.set-trust(false, SettingsBridge.web, SettingsBridge.other-apps); } }
    }
    Note { text: SettingsBridge.enhanced ? @tr("Documents outside the trusted locations ask before opening a web page, and never open a site you blocked.") : @tr("Documents open their web links without asking (sites you blocked stay blocked)."); }
    Caption { text: @tr("Web links in documents"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in [@tr("Ask for each site"), @tr("Allow every site"), @tr("Block every site")]: Segment {
            width: 170px;
            text: label;
            selected: SettingsBridge.web == i;
            clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, i, SettingsBridge.other-apps); }
        }
    }
    Caption { text: @tr("Linked and attached files that are not PDFs"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 230px; text: @tr("Open in their app, after asking"); selected: SettingsBridge.other-apps; clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, SettingsBridge.web, true); } }
        Segment { width: 150px; text: @tr("Never open them"); selected: !SettingsBridge.other-apps; clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, SettingsBridge.web, false); } }
    }
    Caption { text: @tr("Trusted locations"); }
    if SettingsBridge.locations.length == 0: Note { text: @tr("None: documents in a folder or file added here open their links without asking."); }
    for l[k] in SettingsBridge.locations: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 8px;
        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: l; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        SecondaryButton { text: @tr("Remove"); clicked => { SettingsBridge.trust-list(2, k); } }
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        SecondaryButton { text: @tr("Add a folder…"); clicked => { SettingsBridge.trust-list(0, 0); } }
        SecondaryButton { text: @tr("Add a file…"); clicked => { SettingsBridge.trust-list(1, 0); } }
    }
    if SettingsBridge.sites.length > 0: Caption { text: @tr("Sites remembered"); }
    for s[k] in SettingsBridge.sites: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 8px;
        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: s; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        SecondaryButton { text: @tr("Forget"); clicked => { SettingsBridge.trust-list(3, k); } }
    }
}

// iLovePDF's "Open iLovePDF automatically after you log into the computer" and its Processing
// warning. Sheaf checks for no updates and needs no proxy: it never goes online.
export component StartupSection inherits Card {
    title: @tr("Startup");
    Caption { text: @tr("When I log into the computer"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 150px; text: @tr("Open Sheaf"); selected: SettingsBridge.open-at-login; clicked => { SettingsBridge.set-open-at-login(true); } }
        Segment { width: 150px; text: @tr("Don't open it"); selected: !SettingsBridge.open-at-login; clicked => { SettingsBridge.set-open-at-login(false); } }
    }
    if SettingsBridge.login-error != "": Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: SettingsBridge.login-error; font-size: Theme.fs-caption; color: Theme.danger; wrap: word-wrap; }
    Caption { text: @tr("Quitting while a task runs"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 150px; text: @tr("Ask first"); selected: SettingsBridge.quit-warning; clicked => { SettingsBridge.set-quit-warning(true); } }
        Segment { width: 150px; text: @tr("Quit at once"); selected: !SettingsBridge.quit-warning; clicked => { SettingsBridge.set-quit-warning(false); } }
    }
    Note { text: @tr("Sheaf works offline: it never checks for updates or goes through a proxy."); }
}

// Acrobat's security warning when a document opens a web page: allow or block, remembered for
// the site if asked.
export component LinkWarningDialog inherits Modal {
    card-width: 420px;
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("Open a page of “{}”?", SettingsBridge.ask-site);
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("The document links to {}. It opens in your web browser; allow it only if you trust the document.", SettingsBridge.ask-url);
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    remember := Check { text: @tr("Remember for this site"); }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: 10px;
        SecondaryButton {
            text: @tr("Block");
            clicked => { SettingsBridge.link-answer(false, remember.checked); }
        }
        PrimaryButton {
            text: @tr("Allow");
            clicked => { SettingsBridge.link-answer(true, remember.checked); }
        }
    }
}
