// Preferences' print defaults, security and startup sections, and the question a document's web
// link asks (the SettingsBridge global, src/settings_ui.rs).
import { Theme } from "../theme.slint";
import { Segment } from "../widgets/radio-card.slint";
import { SecondaryButton, Modal } from "dialogs.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { Check } from "../widgets/check.slint";
import { PlatformBridge } from "../platform.slint";
import { SettingsBridge } from "../settings.slint";

// A white card with a title, as the page's other sections.
component Card inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius-card;
    background: Theme.card;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.title;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
        }
        @children
    }
}

// A caption above a row of choices.
component Caption inherits Text {
    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    font-size: Theme.fs-body;
    color: Theme.text;
}

component Note inherits Text {
    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    font-size: Theme.fs-caption;
    color: Theme.text-muted;
    wrap: word-wrap;
}

// iLovePDF's Printer preferences (paper size, grayscale) and Acrobat's print defaults: how the
// print sheet opens. The sheet's own "Make default" sets them too.
export component PrintDefaultsSection inherits Card {
    title: "Printing";
    function set(two-sided: bool, paper: int, gray: bool, comments: bool, fit: bool, orientation: int, layout: int) {
        SettingsBridge.set-print-defaults(two-sided, paper, gray, comments, fit, orientation, layout);
    }
    Caption { text: "Paper"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in ["Printer's default", "A4", "Letter", "Legal"]: Segment {
            width: i == 0 ? 150px : 90px;
            text: label;
            selected: SettingsBridge.print-paper == i;
            clicked => { root.set(SettingsBridge.print-two-sided, i, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); }
        }
    }
    Caption { text: "Sides and colour"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 110px; text: "One-sided"; selected: !SettingsBridge.print-two-sided; clicked => { root.set(false, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Segment { width: 110px; text: "Two-sided"; selected: SettingsBridge.print-two-sided; clicked => { root.set(true, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Rectangle { width: 12px; }
        Segment { width: 90px; text: "Colour"; selected: !SettingsBridge.print-gray; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, false, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Segment { width: 90px; text: "Grey"; selected: SettingsBridge.print-gray; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, true, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
    }
    Caption { text: "Scale and comments"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 120px; text: "Fit to paper"; selected: SettingsBridge.print-fit; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, true, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Segment { width: 120px; text: "Actual size"; selected: !SettingsBridge.print-fit; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, false, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Rectangle { width: 12px; }
        Segment { width: 150px; text: "With comments"; selected: SettingsBridge.print-comments; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, true, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
        Segment { width: 170px; text: "Without comments"; selected: !SettingsBridge.print-comments; clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, false, SettingsBridge.print-fit, SettingsBridge.print-orientation, SettingsBridge.print-layout); } }
    }
    Caption { text: "Orientation"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in ["Auto", "Portrait", "Landscape"]: Segment {
            width: 110px;
            text: label;
            selected: SettingsBridge.print-orientation == i;
            clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, i, SettingsBridge.print-layout); }
        }
    }
    Caption { text: "Quality"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in ["Printer's own", "Draft", "Normal", "High"]: Segment {
            width: i == 0 ? 130px : 90px;
            text: label;
            selected: SettingsBridge.print-quality == i;
            clicked => { SettingsBridge.set-print-quality(i); }
        }
    }
    Caption { text: "Pages per sheet"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in ["1", "2", "4", "6", "9", "16", "Booklet"]: Segment {
            width: i == 6 ? 90px : 48px;
            text: label;
            selected: SettingsBridge.print-layout == i;
            clicked => { root.set(SettingsBridge.print-two-sided, SettingsBridge.print-paper, SettingsBridge.print-gray, SettingsBridge.print-comments, SettingsBridge.print-fit, SettingsBridge.print-orientation, i); }
        }
    }
}

// Acrobat's Enhanced Security, Trust Manager (Internet Access from PDF files, opening attachments
// with other apps) and Privileged Locations.
export component SecuritySection inherits Card {
    title: "Security";
    Caption { text: "Enhanced security"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 90px; text: "On"; selected: SettingsBridge.enhanced; clicked => { SettingsBridge.set-trust(true, SettingsBridge.web, SettingsBridge.other-apps); } }
        Segment { width: 90px; text: "Off"; selected: !SettingsBridge.enhanced; clicked => { SettingsBridge.set-trust(false, SettingsBridge.web, SettingsBridge.other-apps); } }
    }
    Note { text: SettingsBridge.enhanced ? "Documents outside the trusted locations ask before opening a web page, and never open a site you blocked." : "Documents open their web links without asking (sites you blocked stay blocked)."; }
    Caption { text: "Web links in documents"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in ["Ask for each site", "Allow every site", "Block every site"]: Segment {
            width: 170px;
            text: label;
            selected: SettingsBridge.web == i;
            clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, i, SettingsBridge.other-apps); }
        }
    }
    Caption { text: "Linked and attached files that are not PDFs"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 230px; text: "Open in their app, after asking"; selected: SettingsBridge.other-apps; clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, SettingsBridge.web, true); } }
        Segment { width: 150px; text: "Never open them"; selected: !SettingsBridge.other-apps; clicked => { SettingsBridge.set-trust(SettingsBridge.enhanced, SettingsBridge.web, false); } }
    }
    Caption { text: "Trusted locations"; }
    if SettingsBridge.locations.length == 0: Note { text: "None: documents in a folder or file added here open their links without asking."; }
    for l[k] in SettingsBridge.locations: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 8px;
        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: l; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        SecondaryButton { text: "Remove"; clicked => { SettingsBridge.trust-list(2, k); } }
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        SecondaryButton { text: "Add a folder…"; clicked => { SettingsBridge.trust-list(0, 0); } }
        SecondaryButton { text: "Add a file…"; clicked => { SettingsBridge.trust-list(1, 0); } }
    }
    if SettingsBridge.sites.length > 0: Caption { text: "Sites remembered"; }
    for s[k] in SettingsBridge.sites: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 8px;
        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: s; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        SecondaryButton { text: "Forget"; clicked => { SettingsBridge.trust-list(3, k); } }
    }
}

// iLovePDF's "Open iLovePDF automatically after you log into the computer" and its Processing
// warning. Sheaf checks for no updates and needs no proxy: it never goes online.
export component StartupSection inherits Card {
    title: "Startup";
    Caption { text: "When I log into the computer"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 150px; text: "Open Sheaf"; selected: SettingsBridge.open-at-login; clicked => { SettingsBridge.set-open-at-login(true); } }
        Segment { width: 150px; text: "Don't open it"; selected: !SettingsBridge.open-at-login; clicked => { SettingsBridge.set-open-at-login(false); } }
    }
    if SettingsBridge.login-error != "": Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: SettingsBridge.login-error; font-size: Theme.fs-caption; color: Theme.danger; wrap: word-wrap; }
    Caption { text: "Quitting while a task runs"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 150px; text: "Ask first"; selected: SettingsBridge.quit-warning; clicked => { SettingsBridge.set-quit-warning(true); } }
        Segment { width: 150px; text: "Quit at once"; selected: !SettingsBridge.quit-warning; clicked => { SettingsBridge.set-quit-warning(false); } }
    }
    Note { text: "Sheaf works offline: it never checks for updates or goes through a proxy."; }
}

// Acrobat's security warning when a document opens a web page: allow or block, remembered for
// the site if asked.
export component LinkWarningDialog inherits Modal {
    card-width: 420px;
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: "Open a page of “\{SettingsBridge.ask-site}”?";
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: "The document links to " + SettingsBridge.ask-url + ". It opens in your web browser; allow it only if you trust the document.";
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    remember := Check { text: "Remember for this site"; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: 10px;
        SecondaryButton {
            text: "Block";
            clicked => { SettingsBridge.link-answer(false, remember.checked); }
        }
        PrimaryButton {
            text: "Allow";
            clicked => { SettingsBridge.link-answer(true, remember.checked); }
        }
    }
}
