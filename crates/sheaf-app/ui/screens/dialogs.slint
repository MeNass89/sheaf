import { PlatformBridge } from "../platform.slint";
import { Theme, Space, Motion } from "../theme.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { TextField } from "../widgets/text-field.slint";

// The secondary button of a dialog (DESIGN §4 Button, secondary): min 72×28, `fill-2`, no border.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.control-height;
    min-width: max(72px, label.preferred-width + 24px);
    border-radius: Theme.r-sm;
    border-width: focus.has-focus && root.keyboard-focus && root.enabled ? 2px : 0px;
    border-color: Theme.focus-ring;
    background: !root.enabled ? Theme.fill-1 : touch.pressed ? Theme.fill-3 : touch.has-hover ? Theme.fill-3 : Theme.fill-2;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    // The ring marks keyboard focus only: a click still focuses the button but draws no ring.
    property <bool> keyboard-focus;
    focus := FocusScope {
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        key-pressed(e) => {
            if root.enabled && (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
    label := Text {
        text: root.text;
        font-size: Theme.fs-body;
        color: root.enabled ? Theme.text : Theme.text-disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

// Dialog (DESIGN §4): a 360-wide card (`window`, radius 12, the `sheet` shadow) centred on a
// `scrim`; title 13/600, message 13, the buttons right; it rises 8 px and fades in.
export component Modal inherits Rectangle {
    in property <length> card-width: 360px;
    in property <length> shake;
    property <bool> shown;
    init => { self.shown = true; }
    background: Theme.scrim;
    TouchArea { }
    Rectangle {
        x: (parent.width - self.width) / 2 + root.shake;
        y: (parent.height - self.height) / 2 - (root.shown ? 0px : 8px);
        width: min(root.card-width, root.width - 2 * Space.xl);
        height: body.preferred-height;
        opacity: root.shown ? 1 : 0;
        animate opacity, y { duration: Motion.appear; }
        border-radius: Theme.r-lg;
        background: Theme.window;
        drop-shadow-blur: Theme.sheet-blur;
        drop-shadow-offset-y: Theme.sheet-y;
        drop-shadow-color: Theme.sheet-shadow;
        accessible-role: groupbox;
        body := VerticalLayout {
            padding: Space.xl;
            spacing: Space.lg;
            @children
        }
    }
}

// "<file> is password protected": asked when a file is added.
export component PasswordDialog inherits Modal {
    in property <string> file-name;
    in property <bool> wrong;
    // Bumped by Rust on each wrong attempt to replay the shake.
    in property <int> attempt;
    // Acrobat opens a certificate-encrypted file with the recipient's digital ID: which one,
    // Choose… for another, and the ID's own password.
    in property <bool> certificate;
    in property <string> id-name;
    in property <string> error-text;
    callback choose-id();
    callback unlock(string);
    callback skip();

    property <string> pw;
    property <duration> since: animation-tick() - root.started;
    property <duration> started;
    changed attempt => { root.started = animation-tick(); root.pw = ""; }
    shake: root.wrong && root.since < 400ms ? 8px * sin(root.since / 400ms * 6 * 360deg) : 0px;

    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.certificate ? @tr("{} is encrypted for certificates", root.file-name) : @tr("{} is password protected", root.file-name);
        font-size: Theme.fs-headline;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    // Escape skips, as Cancel does in every password prompt (the field leaves the key to it).
    if root.certificate: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        spacing: 10px;
        Text {
            text: root.id-name == "" ? @tr("Choose the digital ID it was sent to") : @tr("Digital ID: {}", root.id-name);
            font-size: Theme.fs-label;
            color: Theme.text-secondary;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        SecondaryButton {
            text: @tr("Choose…");
            clicked => { root.choose-id(); }
        }
    }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.skip(); return accept; }
            reject
        }
        VerticalLayout {
            field := TextField {
                password: true;
                placeholder: root.certificate ? @tr("Digital ID password") : @tr("Password");
                text <=> root.pw;
                error: root.error-text != "" ? root.error-text : root.wrong ? @tr("Wrong password") : "";
                accepted => { root.unlock(root.pw); }
            }
        }
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: Space.sm;
        SecondaryButton {
            text: @tr("Skip");
            clicked => { root.skip(); }
        }
        PrimaryButton {
            text: root.certificate ? @tr("Open") : @tr("Unlock");
            enabled: root.pw != "" || root.certificate;
            clicked => { root.unlock(root.pw); }
        }
    }
    init => { field.focus-input(); }
}

// Closing a tab whose job is still running.
export component ConfirmCloseDialog inherits Modal {
    callback cancel-job();
    callback keep();
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("A task is still running");
        font-size: Theme.fs-headline;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("Closing this tab cancels it. Files already written are kept.");
        font-size: Theme.fs-body;
        color: Theme.text-2;
        wrap: word-wrap;
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: Space.sm;
        SecondaryButton {
            text: @tr("Keep");
            clicked => { root.keep(); }
        }
        PrimaryButton {
            text: @tr("Cancel job");
            clicked => { root.cancel-job(); }
        }
    }
}

// A link in a document opens a file that is not a PDF: it runs in its own app, so the user says so
// first (Acrobat's Launch File warning).
export component LaunchFileDialog inherits Modal {
    in property <string> name;
    callback answer(bool);
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("Open “{}”?", root.name);
        font-size: Theme.fs-headline;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("The document links to this file. It opens in the app your system uses for it; open it only if you trust the document.");
        font-size: Theme.fs-body;
        color: Theme.text-2;
        wrap: word-wrap;
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: Space.sm;
        SecondaryButton {
            text: @tr("Cancel");
            clicked => { root.answer(false); }
        }
        PrimaryButton {
            text: @tr("Open");
            clicked => { root.answer(true); }
        }
    }
}

// A document with unsaved annotations is being closed (PDF Expert asks the same three ways).
export component UnsavedDialog inherits Modal {
    in property <string> file-name;
    // Redact marks not applied (their count, 0: a document's unsaved edits): closing drops them,
    // there is nothing to save.
    in property <int> redact-marks;
    callback save();
    callback discard();
    callback cancel();
    // Return takes the default (Save, or Close for redact marks), Escape cancels (DESIGN §7).
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { root.cancel(); return accept; }
            if e.text == Key.Return { if root.redact-marks > 0 { root.discard(); } else { root.save(); } return accept; }
            reject
        }
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.redact-marks > 0 ? @tr("Close “{}” without redacting?", root.file-name) : @tr("Save changes to “{}”?", root.file-name);
        font-size: Theme.fs-headline;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.redact-marks == 1 ? @tr("1 mark is not applied: Redact applies it.")
            : root.redact-marks > 1 ? @tr("{} marks are not applied: Redact applies them.", root.redact-marks)
            : @tr("Your annotations will be lost if you don’t save them.");
        font-size: Theme.fs-body;
        color: Theme.text-2;
        wrap: word-wrap;
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: Space.sm;
        if root.redact-marks == 0: SecondaryButton {
            text: @tr("Don’t Save");
            clicked => { root.discard(); }
        }
        Rectangle { horizontal-stretch: 1; }
        SecondaryButton {
            text: @tr("Cancel");
            clicked => { root.cancel(); }
        }
        if root.redact-marks == 0: PrimaryButton {
            text: @tr("Save");
            clicked => { root.save(); }
        }
        if root.redact-marks > 0: PrimaryButton {
            text: @tr("Close");
            clicked => { root.discard(); }
        }
    }
}

// Bottom-centre message (rejected files, errors).
export component Toast inherits Rectangle {
    in property <string> text;
    height: max(36px, label.preferred-height + 16px);
    width: min(label.preferred-width + 32px, 640px);
    border-radius: 18px;
    background: Theme.toast-bg;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000030;
    label := Text {
        x: 16px;
        y: 8px;
        width: parent.width - 32px;
        height: parent.height - 16px;
        text: root.text;
        font-size: Theme.fs-label;
        color: Theme.on-toast;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}
