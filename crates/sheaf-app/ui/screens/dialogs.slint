import { PlatformBridge } from "../platform.slint";
import { Theme } from "../theme.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { TextField } from "../widgets/text-field.slint";

export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.button-height;
    min-width: label.preferred-width + 32px;
    border-radius: Theme.radius-button;
    border-width: 1px;
    border-color: focus.has-focus && root.enabled ? Theme.text-secondary : Theme.input-border;
    background: touch.has-hover && root.enabled ? Theme.popup-hover : Theme.card;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    focus := FocusScope {
        key-pressed(e) => {
            if root.enabled && (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
    label := Text {
        text: root.text;
        font-size: Theme.fs-button;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

// Dimmed backdrop with a centred card.
export component Modal inherits Rectangle {
    in property <length> card-width: 380px;
    in property <length> shake;
    background: Theme.scrim;
    TouchArea { }
    Rectangle {
        x: (parent.width - self.width) / 2 + root.shake;
        y: (parent.height - self.height) / 2;
        width: root.card-width;
        height: body.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        body := VerticalLayout {
            padding: 22px;
            spacing: 14px;
            @children
        }
    }
}

// "<file> is password protected": asked when a file is added.
export component PasswordDialog inherits Modal {
    in property <string> file-name;
    in property <bool> wrong;
    // Bumped by Rust on each wrong attempt to replay the shake.
    in property <int> attempt;
    // Acrobat opens a certificate-encrypted file with the recipient's digital ID: which one,
    // Choose… for another, and the ID's own password.
    in property <bool> certificate;
    in property <string> id-name;
    in property <string> error-text;
    callback choose-id();
    callback unlock(string);
    callback skip();

    property <string> pw;
    property <duration> since: animation-tick() - root.started;
    property <duration> started;
    changed attempt => { root.started = animation-tick(); root.pw = ""; }
    shake: root.wrong && root.since < 400ms ? 8px * sin(root.since / 400ms * 6 * 360deg) : 0px;

    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.certificate ? root.file-name + " is encrypted for certificates" : root.file-name + " is password protected";
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    // Escape skips, as Cancel does in every password prompt (the field leaves the key to it).
    if root.certificate: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        spacing: 10px;
        Text {
            text: root.id-name == "" ? "Choose the digital ID it was sent to" : "Digital ID: " + root.id-name;
            font-size: Theme.fs-label;
            color: Theme.text-secondary;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        SecondaryButton {
            text: "Choose…";
            clicked => { root.choose-id(); }
        }
    }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.skip(); return accept; }
            reject
        }
        VerticalLayout {
            field := TextField {
                password: true;
                placeholder: root.certificate ? "Digital ID password" : "Password";
                text <=> root.pw;
                error: root.error-text != "" ? root.error-text : root.wrong ? "Wrong password" : "";
                accepted => { root.unlock(root.pw); }
            }
        }
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: 10px;
        SecondaryButton {
            text: "Skip";
            clicked => { root.skip(); }
        }
        PrimaryButton {
            text: root.certificate ? "Open" : "Unlock";
            enabled: root.pw != "" || root.certificate;
            clicked => { root.unlock(root.pw); }
        }
    }
    init => { field.focus-input(); }
}

// Closing a tab whose job is still running.
export component ConfirmCloseDialog inherits Modal {
    callback cancel-job();
    callback keep();
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: "A task is still running";
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: "Closing this tab cancels it. Files already written are kept.";
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: 10px;
        SecondaryButton {
            text: "Keep";
            clicked => { root.keep(); }
        }
        PrimaryButton {
            text: "Cancel job";
            clicked => { root.cancel-job(); }
        }
    }
}

// A link in a document opens a file that is not a PDF: it runs in its own app, so the user says so
// first (Acrobat's Launch File warning).
export component LaunchFileDialog inherits Modal {
    in property <string> name;
    callback answer(bool);
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: "Open “\{root.name}”?";
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: "The document links to this file. It opens in the app your system uses for it; open it only if you trust the document.";
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: end;
        spacing: 10px;
        SecondaryButton {
            text: "Cancel";
            clicked => { root.answer(false); }
        }
        PrimaryButton {
            text: "Open";
            clicked => { root.answer(true); }
        }
    }
}

// A document with unsaved annotations is being closed (PDF Expert asks the same three ways).
export component UnsavedDialog inherits Modal {
    in property <string> file-name;
    // Redact marks not applied (their count, 0: a document's unsaved edits): closing drops them,
    // there is nothing to save.
    in property <int> redact-marks;
    callback save();
    callback discard();
    callback cancel();
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.redact-marks > 0 ? "Close “" + root.file-name + "” without redacting?" : "Save changes to “" + root.file-name + "”?";
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.redact-marks == 1 ? "1 mark is not applied: Redact applies it."
            : root.redact-marks > 1 ? root.redact-marks + " marks are not applied: Redact applies them."
            : "Your annotations will be lost if you don’t save them.";
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 10px;
        if root.redact-marks == 0: SecondaryButton {
            text: "Don’t Save";
            clicked => { root.discard(); }
        }
        Rectangle { horizontal-stretch: 1; }
        SecondaryButton {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
        if root.redact-marks == 0: PrimaryButton {
            text: "Save";
            clicked => { root.save(); }
        }
        if root.redact-marks > 0: PrimaryButton {
            text: "Close";
            clicked => { root.discard(); }
        }
    }
}

// Bottom-centre message (rejected files, errors).
export component Toast inherits Rectangle {
    in property <string> text;
    height: 36px;
    width: min(label.preferred-width + 32px, 640px);
    border-radius: 18px;
    background: Theme.toast-bg;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000030;
    label := Text {
        width: parent.width - 32px;
        text: root.text;
        font-size: Theme.fs-label;
        color: Theme.on-toast;
        horizontal-alignment: center;
        overflow: elide;
    }
}
