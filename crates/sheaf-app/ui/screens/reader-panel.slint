// The reader's sidebar (DESIGN §5.4, PDF Expert's sidebar, evidence 03, 04a–c): segmented tabs 28
// tall at 16 (Thumbnails, Outline, Bookmarks, Annotations, Attachments, Layers), a title row 36 with
// the tab's actions at its right, then the tab's content. Thumbnails end on the page actions bar.
// Every length here is on the 4 grid; colours and type are Theme tokens; tips go through the layer.

import { ScrollView, ListView } from "std-widgets.slint";
import { Theme, Space } from "../theme.slint";
import { ToolTab, ReaderBridge, Parse } from "../flow-types.slint";
import { PlatformBridge } from "../platform.slint";
import { SmallButton, PanelField, PopoverFrame } from "reader-parts.slint";
import { SortCombo } from "../widgets/sort-combo.slint";
import { ResizeHandle } from "../widgets/resize-handle.slint";
import { SidebarTabs, SidebarTabItem, ToolbarButton } from "../widgets/toolbar.slint";
import { Chip, Checkbox } from "../widgets/controls.slint";
import { MenuRow, MenuSeparatorLine } from "../widgets/surfaces.slint";
import { Button, ButtonKind } from "../widgets/button.slint";
import { TipArea } from "../widgets/tooltip.slint";
import { HeaderButton } from "reader-search.slint";

// What a tab shows before it has anything (DESIGN §1 Empty states): a 40 glyph in `text-3`, one or
// two centred lines in `text-2`, a little above the middle of the column.
component EmptyState inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    VerticalLayout {
        y: max(Space.section, parent.height * 0.3 - self.preferred-height / 2);
        height: self.preferred-height;
        padding-left: Space.xxl;
        padding-right: Space.xxl;
        spacing: Space.md;
        alignment: start;
        Image {
            height: 40px;
            source: root.icon;
            colorize: Theme.text-3;
            image-fit: contain;
        }
        Text {
            text: root.text;
            font-size: Theme.fs-body;
            color: Theme.text-2;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// A row's small hover action (rename, delete, save): 20×20, icon 12, radius 4.
component RowAction inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    callback clicked();
    width: 20px;
    height: 20px;
    border-radius: Theme.r-xs;
    background: ta.pressed ? Theme.fill-3 : ta.has-hover ? Theme.fill-2 : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(); }
    Image { width: 12px; height: 12px; source: root.icon; colorize: Theme.text-2; }
    ta := TipArea { tip: root.tip; clicked => { root.clicked(); } }
}

export component ReaderPanel inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    in property <bool> bare;
    in property <length> panel-width;
    // The window's width: the panel never takes more than 45 % of it.
    in property <length> window-width: 1280px;
    // Pages drag: where the press was, and the drop line (−1: no drag); shared with the reader.
    in-out property <length> thumb-down-y;
    in-out property <length> drop-line;
    in-out property <int> thumb-down-page;
    // The thumbnail strip's scroll, for rendering what it shows.
    out property <length> strip-top: -strip.content-y;
    out property <length> strip-h: strip.visible-height;
    // The keyboard goes back to the pages.
    callback focus-pages();

    // The tabs, in PDF Expert's order plus Attachments and Layers; `panel` keeps its old codes.
    property <[int]> codes: [0, 1, 6, 2, 4, 5];
    property <int> tab-index: root.tab.reader.panel == 1 ? 1 : root.tab.reader.panel == 6 ? 2 : root.tab.reader.panel == 2 ? 3
        : root.tab.reader.panel == 4 ? 4 : root.tab.reader.panel == 5 ? 5 : 0;
    property <int> panel: root.codes[root.tab-index];
    // The content starts under the tabs (8 + 28) and the title row (8 + 36 → 80) and its hairline.
    property <length> content-top: 81px;

    // The page actions bar (DESIGN §5.4): 36×36 on a 36 pitch from x 8, Rotate left, Rotate right,
    // Insert blank, Duplicate, Extract…, Number pages…, Delete. Narrower than 260 (7 × 36 + 8), the
    // last ones fold into ⋯: Number pages and Extract first, Delete only when even it has no room
    // (the first icon the panel's edge clipped was the trash: never again).
    property <length> bar-height: 52px;
    property <int> slots: floor((root.width - Space.sm) / 36px);
    property <bool> all-actions: root.slots >= 7;
    property <bool> show-delete: root.all-actions || root.slots >= 6;
    property <bool> show-duplicate: root.all-actions || root.slots >= 5;

    // Where the thumbnails' right-click menu opens.
    property <length> menu-x;
    property <length> menu-y;
    // Attachments: the names must hold this (any case); the one being renamed (−1 none).
    property <string> att-filter;
    property <int> att-renaming: -1;
    // Extract…'s options strip (Acrobat's Extract bar), shown over the page strip.
    property <bool> extract-open;
    property <bool> extract-each;
    property <bool> extract-delete;
    // Number pages…'s strip (Acrobat's Page Labels): style, prefix, first number.
    property <bool> number-open;
    property <int> number-style;
    property <string> number-prefix;
    property <string> number-start;
    property <string> number-through;
    // Pages ▸ Transitions: the effect (0 none, then transitions::STYLES) and the seconds per page.
    property <bool> transition-open;
    property <int> transition-style;
    property <string> transition-advance;
    // An outline item's commands (Acrobat): move, nest, point it at the page in view.
    property <int> mark-row;
    property <length> mark-menu-y;
    // An outline item dragged (Acrobat's): its row, the row it is over, whether it would go inside
    // that row (over its middle) or before it; a drop just made (its release is not a click).
    property <int> drag-mark: -1;
    property <int> drop-row: -1;
    property <bool> drop-inside;
    property <bool> just-dropped;

    function open-strip(k: int) {
        root.extract-open = k == 0 && !root.extract-open;
        root.number-open = k == 1 && !root.number-open;
        root.transition-open = k == 2 && !root.transition-open;
    }

    visible: root.tab.reader.panel-open && !root.bare;
    width: root.tab.reader.panel-open && !root.bare ? root.panel-width : 0px;
    background: Theme.chrome;

    // ---- segmented tabs -------------------------------------------------------------------------
    // The control sets its own `current` on a click (which ends the binding): the tab Rust shows is
    // given back to it whenever it changes (a search, the organiser, When opened).
    changed tab-index => { tabs.current = root.tab-index; }
    tabs := SidebarTabs {
        x: Space.lg;
        y: Space.sm;
        width: parent.width - 2 * Space.lg;
        items: [
            { icon: @image-url("../icons/file.svg"), text: @tr("Thumbnails") },
            { icon: @image-url("../icons/list-tree.svg"), text: @tr("Outline") },
            { icon: @image-url("../icons/bookmark.svg"), text: @tr("Bookmarks") },
            { icon: @image-url("../icons/highlighter.svg"), text: @tr("Annotations") },
            { icon: @image-url("../icons/paperclip.svg"), text: @tr("Attachments") },
            { icon: @image-url("../icons/layers.svg"), text: @tr("Layers") },
        ];
        current: root.tab-index;
        selected(i) => { ReaderBridge.set-panel(root.id, root.codes[i]); }
    }

    // ---- title row: the tab's name at 16 (15/600), its action at the right inside 16 -------------
    Rectangle {
        y: 44px;
        height: 36px;
        Text {
            x: PlatformBridge.rtl ? parent.width - self.width - Space.lg : Space.lg;
            width: min(self.preferred-width, parent.width - 2 * Space.lg - 32px);
            text: root.panel == 0 ? @tr("Thumbnails") : root.panel == 1 ? @tr("Outline") : root.panel == 6 ? @tr("Bookmarks")
                : root.panel == 2 ? @tr("Annotations") : root.panel == 4 ? @tr("Attachments") : @tr("Layers");
            font-size: Theme.fs-title-3;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        // 28 wide, its icon's edge 16 from the sidebar's (the button's own pad is 6).
        HeaderButton {
            x: PlatformBridge.rtl ? Space.lg - 6px : parent.width - self.width - Space.lg + 6px;
            y: 4px;
            icon: root.panel == 1 || root.panel == 6 || root.panel == 4 ? @image-url("../icons/plus.svg") : @image-url("../icons/ellipsis.svg");
            tip: root.panel == 1 ? @tr("Add the page you are on to the outline") : root.panel == 6 ? @tr("Bookmark the page you are on")
                : root.panel == 4 ? @tr("Attach a file…") : root.panel == 0 ? @tr("More page actions")
                : root.panel == 2 ? @tr("Comment actions") : @tr("Layer actions");
            clicked => {
                if root.panel == 1 { ReaderBridge.outline-op(root.id, -1, 0, ""); root.focus-pages(); }
                else if root.panel == 6 { ReaderBridge.bookmark-op(root.id, 0, -1); }
                else if root.panel == 4 { ReaderBridge.attachment-add(root.id); }
                else if root.panel == 0 { pages-more.show(); }
                else if root.panel == 2 { notes-more.show(); }
                else { layers-more.show(); }
            }
        }
    }
    Rectangle { y: 80px; height: 1px; background: Theme.hairline; }

    // ---- Thumbnails -------------------------------------------------------------------------------
    // Cells `width − 32`, 12 apart, the number badge (22×18) 6 under each (reader_ui::THUMB_*). The
    // page in view sits on a `fill-1` ground; selected pages get a 2 px accent frame and an accent
    // badge (PDF Expert). ⌘ / ⇧ select more; a drag reorders; a right click opens the page menu.
    strip := ScrollView {
        y: root.content-top;
        visible: root.panel == 0;
        height: root.panel == 0 ? parent.height - root.content-top - root.bar-height : 0px;
        content-width: self.visible-width;
        content-height: root.tab.viewer-thumbs-height;
        for t in root.tab.viewer-thumbs: Rectangle {
            x: (strip.visible-width - ReaderBridge.thumb-width) / 2;
            y: t.y;
            width: ReaderBridge.thumb-width;
            height: t.h + 24px;
            if t.page == root.tab.viewer-current && !t.selected: Rectangle {
                x: -Space.sm;
                y: -Space.sm;
                width: parent.width + 2 * Space.sm;
                height: parent.height + Space.md;
                border-radius: Theme.r-row;
                background: Theme.fill-1;
            }
            if t.selected: Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: t.h + 6px;
                border-radius: Theme.r-xs;
                border-width: 2px;
                border-color: Theme.accent;
            }
            Rectangle {
                height: t.h;
                y: 0;
                background: Theme.thumb-placeholder;
                drop-shadow-blur: 4px;
                drop-shadow-color: Theme.page-shadow;
                drop-shadow-offset-y: 1px;
                if t.ready: Image {
                    width: parent.width;
                    height: parent.height;
                    source: t.image;
                    image-fit: fill;
                }
            }
            Rectangle {
                y: t.h + 6px;
                x: (parent.width - self.width) / 2;
                width: max(22px, num.preferred-width + 10px);
                height: 18px;
                border-radius: Theme.r-xs;
                background: t.selected ? Theme.accent : transparent;
                num := Text {
                    text: t.page + 1;
                    font-size: Theme.fs-body;
                    font-weight: t.selected ? Theme.weight-demibold : Theme.weight-regular;
                    color: t.selected ? Theme.on-accent : t.page == root.tab.viewer-current ? Theme.text : Theme.text-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        // The page menu at the pointer (Acrobat's and Preview's thumbnail menu; the Organize rail's
        // items). Codes as reader_ui::page_op; −1 Transitions…, −2 Number pages…, −3 Extract….
        page-menu := PopupWindow {
            x: root.menu-x;
            y: root.menu-y;
            width: 248px;
            height: (PlatformBridge.mac ? 15 : 14) * Theme.row-height + 3 * 9px + 8px;
            PopoverFrame {
                VerticalLayout {
                    padding: 4px;
                    for o in [{ t: @tr("Rotate left"), k: 0 }, { t: @tr("Rotate right"), k: 1 }, { t: "", k: -9 },
                              { t: @tr("Insert blank page after"), k: 5 }, { t: @tr("Insert pages from file…"), k: 6 }, { t: @tr("Insert a file's pages before…"), k: 9 },
                              { t: @tr("Insert from clipboard"), k: 10 }, { t: @tr("Insert from scanner…"), k: 11 }, { t: @tr("Insert from iPhone or iPad…"), k: 12 }, { t: "", k: -9 },
                              { t: @tr("Duplicate"), k: 3 }, { t: @tr("Extract…"), k: -3 }, { t: @tr("Replace with a file's pages…"), k: 7 }, { t: @tr("Reverse page order"), k: 8 },
                              { t: @tr("Number pages…"), k: -2 },
                              // Acrobat's Page Transitions (in its page thumbnail menu).
                              { t: @tr("Transitions…"), k: -1 }, { t: "", k: -9 }, { t: @tr("Delete"), k: 2 }]: Rectangle {
                        // Continuity Camera (12) is a Mac's.
                        visible: o.k != 12 || PlatformBridge.mac;
                        height: !self.visible ? 0px : o.k == -9 ? 9px : Theme.row-height;
                        if o.k == -9: MenuSeparatorLine { }
                        if o.k != -9: MenuRow {
                            text: o.t;
                            danger: o.k == 2;
                            activated => {
                                if o.k == -1 { root.open-strip(2); }
                                else if o.k == -2 { root.open-strip(1); }
                                else if o.k == -3 { root.open-strip(0); }
                                else { ReaderBridge.page-op(root.id, o.k); root.focus-pages(); }
                            }
                        }
                    }
                }
            }
        }
        strip-ta := TouchArea {
            // The pointer in the visible strip (y from its top): kept while the strip scrolls under a
            // still pointer. One area over the whole strip: the thumbnails' model is replaced on every
            // refresh, which would drop a press held on one of them.
            property <length> view-y;
            width: strip.visible-width;
            height: max(root.tab.viewer-thumbs-height, strip.visible-height);
            mouse-cursor: root.drop-line >= 0 ? move : pointer;
            pointer-event(e) => {
                // A right click: the page menu at the pointer; a page outside a selection of several
                // is selected first.
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    root.thumb-down-page = ReaderBridge.thumb-at(root.id, self.mouse-y);
                    if root.thumb-down-page >= 0 {
                        if root.tab.reader.pages-selected <= 1 {
                            ReaderBridge.thumb-pressed(root.id, root.thumb-down-page, false, false);
                            ReaderBridge.thumb-released(root.id);
                        }
                        root.menu-x = max(0px, min(self.mouse-x, self.width - 248px));
                        root.menu-y = self.mouse-y;
                        page-menu.show();
                    }
                    return;
                }
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.thumb-down-y = self.mouse-y;
                    root.thumb-down-page = ReaderBridge.thumb-at(root.id, self.mouse-y);
                    if root.thumb-down-page >= 0 {
                        ReaderBridge.thumb-pressed(root.id, root.thumb-down-page, e.modifiers.shift, e.modifiers.control || e.modifiers.meta);
                    }
                    root.focus-pages();
                } else if e.kind == PointerEventKind.up && root.drop-line >= 0 {
                    ReaderBridge.thumb-drop(root.id, self.mouse-y);
                    root.drop-line = -1px;
                } else if e.kind == PointerEventKind.up {
                    ReaderBridge.thumb-released(root.id);
                }
            }
            moved => {
                self.view-y = self.mouse-y + strip.content-y;
                if self.pressed && root.thumb-down-page >= 0 && abs(self.mouse-y - root.thumb-down-y) > 8px {
                    root.drop-line = ReaderBridge.thumb-drag(root.id, root.thumb-down-page, self.mouse-y);
                }
            }
        }
        // Dragging near the top or bottom of the strip scrolls it (a long book's page can be carried
        // anywhere), the drop line following.
        Timer {
            interval: 30ms;
            running: root.drop-line >= 0;
            triggered => {
                let edge = 40px;
                let step = strip-ta.view-y < edge ? 14px : strip-ta.view-y > strip.visible-height - edge ? -14px : 0px;
                if step != 0px {
                    strip.content-y = max(min(0px, strip.content-y + step), min(0px, strip.visible-height - strip.content-height));
                    root.drop-line = ReaderBridge.thumb-drag(root.id, root.thumb-down-page, strip-ta.view-y - strip.content-y);
                }
            }
        }
        // What is carried: a capsule under the pointer (PDF Expert shows the pages).
        if root.drop-line >= 0: Rectangle {
            x: strip-ta.mouse-x + 12px;
            // Under the pointer even while the strip scrolls beneath it.
            y: strip-ta.view-y - strip.content-y + 8px;
            width: ghost.preferred-width + 16px;
            height: 24px;
            border-radius: 12px;
            background: Theme.accent;
            drop-shadow-blur: Theme.toast-blur;
            drop-shadow-offset-y: Theme.toast-y;
            drop-shadow-color: Theme.toast-shadow;
            ghost := Text {
                text: root.tab.reader.pages-selected <= 1 ? @tr("1 page") : @tr("{} pages", root.tab.reader.pages-selected);
                font-size: Theme.fs-subhead;
                font-weight: Theme.weight-demibold;
                color: Theme.on-accent;
            }
        }
        // The insertion bar: 2 px accent across the cell, in the middle of the gap.
        if root.drop-line >= 0: Rectangle {
            x: Space.sm;
            y: root.drop-line - 1px;
            width: strip.visible-width - 2 * Space.sm;
            height: 2px;
            border-radius: 1px;
            background: Theme.accent;
        }
    }

    // ---- Thumbnails: the page actions bar (on the selection, or the page in view) -----------------
    if root.panel == 0: Rectangle {
        y: parent.height - root.bar-height;
        height: root.bar-height;
        background: Theme.chrome;
        Rectangle { y: 0; height: 1px; background: Theme.hairline; }
        FlexboxLayout {
            y: Space.sm;
            height: 36px;
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            padding-left: Space.sm;
            padding-right: Space.sm;
            spacing: 0px;
            alignment: start;
            ToolbarButton { icon: @image-url("../icons/rotate-ccw.svg"); tip: @tr("Rotate left"); clicked => { ReaderBridge.page-op(root.id, 0); } }
            ToolbarButton { icon: @image-url("../icons/rotate-cw.svg"); tip: @tr("Rotate right"); clicked => { ReaderBridge.page-op(root.id, 1); } }
            ToolbarButton { icon: @image-url("../icons/plus.svg"); tip: @tr("Insert blank page after"); clicked => { ReaderBridge.page-op(root.id, 5); } }
            if root.show-duplicate: ToolbarButton { icon: @image-url("../icons/copy.svg"); tip: @tr("Duplicate"); clicked => { ReaderBridge.page-op(root.id, 3); } }
            if root.all-actions: ToolbarButton { icon: @image-url("../icons/file-output.svg"); tip: @tr("Extract…"); clicked => { root.open-strip(0); } }
            if root.all-actions: ToolbarButton { icon: @image-url("../icons/list-ordered.svg"); tip: @tr("Number pages…"); clicked => { root.open-strip(1); } }
            if root.show-delete: ToolbarButton { icon: @image-url("../icons/trash-2.svg"); tip: @tr("Delete"); clicked => { ReaderBridge.page-op(root.id, 2); } }
            if !root.all-actions: ToolbarButton {
                icon: @image-url("../icons/ellipsis.svg");
                tip: @tr("More page actions");
                clicked => { actions-more.show(); }
                // Opens above the bar (at the window's bottom edge there is no room under it).
                actions-more := PopupWindow {
                    x: 0;
                    y: -self.height - 4px;
                    width: 200px;
                    height: (2 + (root.show-duplicate ? 0 : 1) + (root.show-delete ? 0 : 1)) * Theme.row-height + (root.show-delete ? 0px : 9px) + 8px;
                    PopoverFrame {
                        VerticalLayout {
                            padding: 4px;
                            if !root.show-duplicate: MenuRow { text: @tr("Duplicate"); activated => { ReaderBridge.page-op(root.id, 3); } }
                            MenuRow { text: @tr("Extract…"); activated => { root.open-strip(0); } }
                            MenuRow { text: @tr("Number pages…"); activated => { root.open-strip(1); } }
                            if !root.show-delete: MenuSeparatorLine { }
                            if !root.show-delete: MenuRow { text: @tr("Delete"); danger: true; activated => { ReaderBridge.page-op(root.id, 2); } }
                        }
                    }
                }
            }
        }
    }
    // The strips over the bar: Number pages…, Transitions…, Replace's pages, Extract….
    if root.panel == 0 && root.number-open: Rectangle {
        y: parent.height - root.bar-height - self.height;
        height: 152px;
        background: Theme.chrome;
        Rectangle { y: 0; height: 1px; background: Theme.hairline; }
        VerticalLayout {
            padding: Space.lg;
            padding-top: Space.md;
            spacing: Space.sm;
            Text {
                text: @tr("Number ") + (root.tab.reader.pages-selected <= 1 ? @tr("this page") : @tr("the {} pages", root.tab.reader.pages-selected)) + (root.number-through != "" ? @tr(" through page {}", root.number-through) : root.tab.reader.pages-selected <= 1 ? @tr(" and the next ones") : "");
                font-size: Theme.fs-callout;
                color: Theme.text-2;
                // One line, so the rows under it keep their place.
                overflow: elide;
            }
            SortCombo {
                width: parent.width - 2 * Space.lg;
                options: ["1, 2, 3", @tr("i, ii, iii"), @tr("I, II, III"), @tr("a, b, c"), @tr("A, B, C"), @tr("No number")];
                current-index <=> root.number-style;
                chevron: @image-url("../icons/chevron-down.svg");
            }
            HorizontalLayout {
                spacing: Space.sm;
                PanelField { placeholder: @tr("Prefix"); text <=> root.number-prefix; }
                PanelField { width: 64px; placeholder: @tr("Start: 1"); text <=> root.number-start; }
                // Acrobat's Pages from … to …: the last page numbered so (empty: as selected).
                PanelField { width: 88px; placeholder: @tr("Through: end"); text <=> root.number-through; }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Space.sm;
                Button { text: @tr("Cancel"); clicked => { root.number-open = false; } }
                Button {
                    text: @tr("Number");
                    kind: ButtonKind.primary;
                    clicked => {
                        root.number-open = false;
                        ReaderBridge.number-pages(root.id, root.number-style, root.number-prefix, root.number-start, root.number-through);
                    }
                }
            }
        }
    }
    if root.panel == 0 && root.transition-open: Rectangle {
        y: parent.height - root.bar-height - self.height;
        height: 152px;
        background: Theme.chrome;
        Rectangle { y: 0; height: 1px; background: Theme.hairline; }
        VerticalLayout {
            padding: Space.lg;
            padding-top: Space.md;
            spacing: Space.sm;
            Text {
                text: @tr("In full screen, ") + (root.tab.reader.pages-selected <= 1 ? @tr("this page comes") : @tr("the {} pages come", root.tab.reader.pages-selected)) + @tr(" in with");
                font-size: Theme.fs-callout;
                color: Theme.text-2;
                // One line, so the rows under it keep their place.
                overflow: elide;
            }
            SortCombo {
                width: parent.width - 2 * Space.lg;
                options: [@tr("No effect"), @tr("Fade"), @tr("Dissolve"), @tr("Wipe"), @tr("Push"), @tr("Cover"), @tr("Uncover"), @tr("Split"), @tr("Blinds"), @tr("Box"), @tr("Glitter"), @tr("Fly")];
                current-index <=> root.transition-style;
                chevron: @image-url("../icons/chevron-down.svg");
            }
            PanelField { placeholder: @tr("Next page after (seconds): when turned"); text <=> root.transition-advance; }
            HorizontalLayout {
                alignment: end;
                spacing: Space.sm;
                Button { text: @tr("Cancel"); clicked => { root.transition-open = false; } }
                Button {
                    text: @tr("Set");
                    kind: ButtonKind.primary;
                    clicked => {
                        root.transition-open = false;
                        ReaderBridge.page-transition(root.id, root.transition-style - 1, root.transition-advance);
                    }
                }
            }
        }
    }
    // Replace Pages from a longer file: which of its pages (Acrobat's pages … to … of it).
    if root.panel == 0 && root.tab.reader.replace-ask != "": Rectangle {
        y: parent.height - root.bar-height - self.height;
        height: 116px;
        background: Theme.chrome;
        Rectangle { y: 0; height: 1px; background: Theme.hairline; }
        VerticalLayout {
            padding: Space.lg;
            padding-top: Space.md;
            spacing: Space.sm;
            // The question takes what is left: the field and buttons keep the strip's last row.
            Text { text: root.tab.reader.replace-ask; font-size: Theme.fs-callout; color: Theme.text-2; wrap: word-wrap; overflow: elide; vertical-stretch: 1; }
            HorizontalLayout {
                spacing: Space.sm;
                from-in := PanelField { placeholder: "1"; }
                SmallButton { text: @tr("Cancel"); clicked => { ReaderBridge.replace-from(root.id, ""); root.focus-pages(); } }
                SmallButton { text: @tr("Replace"); primary: true; clicked => { ReaderBridge.replace-from(root.id, from-in.text == "" ? "1" : from-in.text); root.focus-pages(); } }
            }
        }
    }
    if root.panel == 0 && root.extract-open: Rectangle {
        y: parent.height - root.bar-height - self.height;
        height: 120px;
        background: Theme.chrome;
        Rectangle { y: 0; height: 1px; background: Theme.hairline; }
        VerticalLayout {
            padding: Space.lg;
            padding-top: Space.md;
            spacing: Space.xs;
            Checkbox { text: @tr("One file per page"); checked <=> root.extract-each; }
            Checkbox { text: @tr("Delete pages after extracting"); checked <=> root.extract-delete; }
            HorizontalLayout {
                alignment: end;
                spacing: Space.sm;
                Button { text: @tr("Cancel"); clicked => { root.extract-open = false; } }
                Button {
                    text: @tr("Extract");
                    kind: ButtonKind.primary;
                    clicked => {
                        root.extract-open = false;
                        ReaderBridge.extract(root.id, root.extract-each, root.extract-delete);
                    }
                }
            }
        }
    }

    // ---- Outline --------------------------------------------------------------------------------
    // Rows 28, text 13 inset 8, hover and current fill inset 6 (radius 6); disclosure 12 at depth ×
    // 16; the page number right in `text-2`. On hover: rename, delete, more; a drag moves an item.
    if root.panel == 1 && root.tab.reader.outline-empty: EmptyState {
        y: root.content-top;
        height: parent.height - root.content-top;
        icon: @image-url("../icons/list-tree.svg");
        text: @tr("Click + to add the page you are on. With text selected, its words become the title.");
    }
    if root.panel == 1 && !root.tab.reader.outline-empty: ScrollView {
        y: root.content-top;
        height: parent.height - root.content-top;
        VerticalLayout {
            padding-top: Space.xs;
            padding-bottom: Space.sm;
            for r[i] in root.tab.reader.outline: Rectangle {
                height: Theme.row-height;
                accessible-role: list-item;
                accessible-label: r.title;
                accessible-value: r.page-label;
                accessible-item-selected: r.current;
                accessible-action-default => { ReaderBridge.outline-clicked(root.id, i); }
                Rectangle {
                    x: 6px;
                    width: parent.width - 12px;
                    border-radius: Theme.r-row;
                    background: r.current ? Theme.fill-2 : ot.has-hover ? Theme.fill-1 : transparent;
                }
                // Where a dragged item would land: a line above this row, or the row ringed.
                if root.drag-mark >= 0 && root.drop-row == i: Rectangle {
                    x: 6px;
                    width: parent.width - 12px;
                    y: root.drop-inside ? 0px : -1px;
                    height: root.drop-inside ? parent.height : 2px;
                    border-radius: root.drop-inside ? Theme.r-row : 1px;
                    border-width: root.drop-inside ? 2px : 0px;
                    border-color: Theme.accent;
                    background: root.drop-inside ? transparent : Theme.accent;
                }
                ot := TouchArea {
                    mouse-cursor: root.drag-mark >= 0 ? grabbing : pointer;
                    moved => {
                        if root.drag-mark >= 0 || abs(self.mouse-y - self.pressed-y) > 6px {
                            root.drag-mark = i;
                            root.drop-row = i + floor(self.mouse-y / Theme.row-height);
                            root.drop-inside = mod(self.mouse-y / 1px + 2800, 28) > 8 && mod(self.mouse-y / 1px + 2800, 28) < 20;
                        }
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up && root.drag-mark == i {
                            if root.drop-row != i { ReaderBridge.outline-drop(root.id, i, root.drop-row, root.drop-inside); }
                            root.drag-mark = -1;
                            root.drop-row = -1;
                            root.just-dropped = true;
                        }
                    }
                    clicked => {
                        if root.just-dropped { root.just-dropped = false; return; }
                        ReaderBridge.outline-clicked(root.id, i);
                        root.focus-pages();
                    }
                    double-clicked => { ReaderBridge.outline-op(root.id, i, 1, ""); }
                    // On hover: rename, delete, and the rest in a menu (Acrobat's bookmark context menu);
                    // inside the TouchArea so reaching them keeps the row hovered.
                    if ot.has-hover && !r.editing: HorizontalLayout {
                        x: PlatformBridge.rtl ? 10px : parent.width - self.width - 10px;
                        y: 4px;
                        width: 3 * 20px + 2 * 2px;
                        height: 20px;
                        spacing: 2px;
                        RowAction { icon: @image-url("../icons/pencil.svg"); tip: @tr("Rename"); clicked => { ReaderBridge.outline-op(root.id, i, 1, ""); } }
                        RowAction { icon: @image-url("../icons/trash-2.svg"); tip: @tr("Delete bookmark"); clicked => { ReaderBridge.outline-op(root.id, i, 4, ""); root.focus-pages(); } }
                        RowAction { icon: @image-url("../icons/ellipsis.svg"); tip: @tr("More"); clicked => { root.mark-row = i; root.mark-menu-y = self.absolute-position.y - root.absolute-position.y + 24px; mark-menu.show(); } }
                    }
                }
                if r.has-children: Rectangle {
                    x: PlatformBridge.rtl ? parent.width - (6px + r.depth * 16px) - self.width : 6px + r.depth * 16px;
                    width: 16px;
                    Image {
                        width: 12px;
                        height: 12px;
                        source: @image-url("../icons/chevron-right.svg");
                        colorize: Theme.text-2;
                        transform-rotation: r.expanded ? 90deg : 0deg;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ReaderBridge.outline-toggled(root.id, i); }
                    }
                }
                if !r.editing: Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    x: PlatformBridge.rtl ? parent.width - (24px + r.depth * 16px) - self.width : 24px + r.depth * 16px;
                    width: parent.width - (24px + r.depth * 16px) - (ot.has-hover ? 80px : 52px);
                    text: r.title;
                    font-size: Theme.fs-body;
                    // Its own look when it has one (bold, italic, colour), as Acrobat shows it.
                    font-weight: r.bold ? Theme.weight-bold : r.depth == 0 ? Theme.weight-demibold : Theme.weight-regular;
                    font-italic: r.italic;
                    color: r.has-colour ? r.colour : Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // Renamed in place: ↩ keeps the new title, Escape the old one.
                if r.editing: Rectangle {
                    x: PlatformBridge.rtl ? parent.width - (20px + r.depth * 16px) - self.width : 20px + r.depth * 16px;
                    y: 2px;
                    width: parent.width - (20px + r.depth * 16px) - 12px;
                    height: 24px;
                    border-radius: Theme.r-sm;
                    border-width: 2px;
                    border-color: Theme.focus-ring;
                    background: Theme.field;
                    rename := TextInput {
                        // Tools page tools' keys wait while a field has the keyboard.
                        changed has-focus => { PlatformBridge.typing = self.has-focus; }
                        x: 6px;
                        width: parent.width - 12px;
                        text: r.title;
                        font-size: Theme.fs-body;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        init => { self.focus(); self.select-all(); }
                        accepted => { ReaderBridge.outline-op(root.id, i, 2, self.text); root.focus-pages(); }
                        key-pressed(e) => {
                            if e.text == Key.Escape { ReaderBridge.outline-op(root.id, i, 3, ""); root.focus-pages(); return accept; }
                            reject
                        }
                    }
                }
                if !ot.has-hover && !r.editing: Text {
                    x: PlatformBridge.rtl ? 14px : parent.width - self.width - 14px;
                    width: 32px;
                    text: r.page-label;
                    font-size: Theme.fs-callout;
                    color: Theme.text-2;
                    horizontal-alignment: PlatformBridge.rtl ? left : right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // ---- Bookmarks (PDF Expert's page bookmarks) ------------------------------------------------
    if root.panel == 6 && root.tab.reader.bookmarks.length == 0: EmptyState {
        y: root.content-top;
        height: parent.height - root.content-top;
        icon: @image-url("../icons/bookmark.svg");
        text: @tr("Click + to bookmark the page you are on.");
    }
    if root.panel == 6 && root.tab.reader.bookmarks.length > 0: ScrollView {
        y: root.content-top;
        height: parent.height - root.content-top;
        VerticalLayout {
            padding-top: Space.xs;
            padding-bottom: Space.sm;
            for b[i] in root.tab.reader.bookmarks: Rectangle {
                height: Theme.row-height;
                accessible-role: list-item;
                accessible-label: b.title;
                accessible-value: b.page-label;
                accessible-action-default => { ReaderBridge.bookmark-op(root.id, 1, i); }
                Rectangle {
                    x: 6px;
                    width: parent.width - 12px;
                    border-radius: Theme.r-row;
                    background: b.current ? Theme.fill-2 : bt.has-hover ? Theme.fill-1 : transparent;
                }
                Image {
                    x: PlatformBridge.rtl ? parent.width - self.width - 14px : 14px;
                    width: Theme.icon-sm;
                    height: Theme.icon-sm;
                    source: @image-url("../icons/bookmark.svg");
                    colorize: Theme.text-2;
                }
                Text {
                    x: PlatformBridge.rtl ? 52px : 38px;
                    width: parent.width - 38px - 52px;
                    text: b.title;
                    font-size: Theme.fs-body;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-alignment: PlatformBridge.rtl ? right : left;
                }
                bt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ReaderBridge.bookmark-op(root.id, 1, i); root.focus-pages(); }
                    if bt.has-hover: RowAction {
                        x: PlatformBridge.rtl ? 10px : parent.width - self.width - 10px;
                        y: 4px;
                        icon: @image-url("../icons/x.svg");
                        tip: @tr("Remove bookmark");
                        clicked => { ReaderBridge.bookmark-op(root.id, 2, i); }
                    }
                }
                if !bt.has-hover: Text {
                    x: PlatformBridge.rtl ? 14px : parent.width - self.width - 14px;
                    width: 32px;
                    text: b.page-label;
                    font-size: Theme.fs-callout;
                    color: Theme.text-2;
                    horizontal-alignment: PlatformBridge.rtl ? left : right;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- Annotations ----------------------------------------------------------------------------
    // Filter chips (they scroll sideways when the sidebar is narrow), then the count and the order,
    // then CommentCards grouped by page under "Page 3 · 4".
    if root.panel == 2 && root.tab.reader.annots.length == 0 && root.tab.reader.notes-filter == 0: EmptyState {
        y: root.content-top;
        height: parent.height - root.content-top;
        icon: @image-url("../icons/highlighter.svg");
        text: @tr("Highlights, notes and drawings will be listed here.");
    }
    if root.panel == 2 && (root.tab.reader.annots.length > 0 || root.tab.reader.notes-filter != 0): Rectangle {
        y: root.content-top;
        height: parent.height - root.content-top;
        Flickable {
            y: Space.sm;
            height: 22px;
            content-width: chip-row.preferred-width;
            chip-row := HorizontalLayout {
                padding-left: Space.lg;
                padding-right: Space.lg;
                spacing: Space.sm;
                // reader::notes_filter's codes.
                for c in [{ t: @tr("All"), k: 0 }, { t: @tr("Highlights"), k: 1 }, { t: @tr("Notes"), k: 2 }, { t: @tr("Drawings"), k: 3 }, { t: @tr("Stamps"), k: 4 },
                          { t: @tr("Accepted"), k: 5 }, { t: @tr("Rejected"), k: 6 }, { t: @tr("Cancelled"), k: 7 }, { t: @tr("Completed"), k: 8 }, { t: @tr("No status"), k: 9 }, { t: @tr("Checked"), k: 10 }]: Chip {
                    text: c.t;
                    on: root.tab.reader.notes-filter == c.k;
                    clicked => { ReaderBridge.notes-view(root.id, 0, c.k); }
                }
            }
        }
        Rectangle {
            y: 38px;
            height: Theme.control-height;
            Text {
                x: PlatformBridge.rtl ? parent.width - self.width - Space.lg : Space.lg;
                width: parent.width - 2 * Space.lg - sort.width - Space.sm;
                text: root.tab.reader.annots.length == 1 ? @tr("1 comment") : @tr("{} comments", root.tab.reader.annots.length);
                font-size: Theme.fs-callout;
                color: Theme.text-2;
                vertical-alignment: center;
                overflow: elide;
                horizontal-alignment: PlatformBridge.rtl ? right : left;
            }
            // "By page ⌄": 88 at least, its label elided before the chevron, never the chevron.
            sort := SortCombo {
                x: PlatformBridge.rtl ? Space.lg : parent.width - self.width - Space.lg;
                width: clamp(parent.width / 2 - Space.lg, 88px, 120px);
                options: [@tr("By page"), @tr("Newest"), @tr("By author"), @tr("By type")];
                current-index: root.tab.reader.notes-sort;
                chevron: @image-url("../icons/chevron-down.svg");
                selected(i) => { ReaderBridge.notes-view(root.id, 1, i); }
            }
        }
        if root.tab.reader.annots.length == 0: Text {
            x: Space.lg;
            y: 84px;
            width: parent.width - 2 * Space.lg;
            text: @tr("No comments of this kind.");
            font-size: Theme.fs-body;
            color: Theme.text-2;
            wrap: word-wrap;
        }
        ScrollView {
            y: 74px;
            height: parent.height - 74px;
            VerticalLayout {
                padding-left: Space.sm;
                padding-right: Space.sm;
                padding-bottom: Space.sm;
                spacing: Space.sm;
                for a[i] in root.tab.reader.annots: VerticalLayout {
                    spacing: 0px;
                    if a.group != "": Text {
                        height: Theme.row-height;
                        text: a.group;
                        font-size: Theme.fs-callout;
                        font-weight: Theme.weight-demibold;
                        color: Theme.text-2;
                        vertical-alignment: center;
                        horizontal-alignment: PlatformBridge.rtl ? right : left;
                    }
                    // A CommentCard: `window` and a hairline, radius 6, pad 10, its colour as a 3 px
                    // strip inset 6 (radius 2); hover a shade darker, selected an accent border.
                    Rectangle {
                        height: al.preferred-height;
                        border-radius: Theme.r-row;
                        background: at.has-hover && !a.selected ? Theme.window.mix(Theme.text, 0.96) : Theme.window;
                        border-width: a.selected ? 2px : 1px;
                        border-color: a.selected ? Theme.accent : Theme.hairline;
                        accessible-role: list-item;
                        accessible-label: a.kind + ", " + a.page-label;
                        accessible-description: a.text;
                        accessible-item-selected: a.selected;
                        accessible-action-default => { ReaderBridge.annot-clicked(root.id, a.index); }
                        // The card's delete is inside its area: reaching it keeps the card hovered.
                        at := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ReaderBridge.annot-clicked(root.id, a.index); root.focus-pages(); }
                            if at.has-hover || a.selected: RowAction {
                                x: PlatformBridge.rtl ? 6px : parent.width - self.width - 6px;
                                y: 6px;
                                icon: @image-url("../icons/trash-2.svg");
                                tip: @tr("Delete comment");
                                clicked => { ReaderBridge.annot-delete(root.id, a.index); }
                            }
                        }
                        Rectangle {
                            x: PlatformBridge.rtl ? parent.width - self.width - 6px : 6px;
                            y: 6px;
                            width: 3px;
                            height: parent.height - 12px;
                            border-radius: 2px;
                            background: a.colour;
                        }
                        al := VerticalLayout {
                            padding: 10px;
                            padding-left: PlatformBridge.rtl ? 10px : 16px;
                            padding-right: PlatformBridge.rtl ? 16px : 10px;
                            spacing: Space.xs;
                            HorizontalLayout {
                                // Room for the delete button that shows on hover.
                                padding-right: 24px;
                                spacing: Space.sm;
                                Text {
                                    text: a.kind;
                                    font-size: Theme.fs-subhead;
                                    font-weight: Theme.weight-demibold;
                                    color: Theme.text-2;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                // The page is in the group's heading when listed by page.
                                if root.tab.reader.notes-sort != 0: Text {
                                    text: a.page-label;
                                    font-size: Theme.fs-subhead;
                                    color: Theme.text-2;
                                }
                            }
                            if a.text != "": Text {
                                text: a.text;
                                font-size: Theme.fs-body;
                                color: Theme.text;
                                wrap: word-wrap;
                                overflow: elide;
                                max-height: 64px;
                            }
                            if a.meta != "": Text {
                                text: a.meta + (a.status != "" ? " · " + a.status : "");
                                font-size: Theme.fs-subhead;
                                color: Theme.text-2;
                                overflow: elide;
                            }
                            // Replies, under the comment (Acrobat's and PDF Expert's threads), each
                            // deleted alone by the bin on its hover.
                            for rp in a.replies: Rectangle {
                                height: max(rl.preferred-height, 20px);
                                rt := TouchArea {
                                    if rt.has-hover: RowAction {
                                        x: parent.width - self.width;
                                        y: 0;
                                        icon: @image-url("../icons/trash-2.svg");
                                        tip: @tr("Delete reply");
                                        clicked => { ReaderBridge.reply-delete(root.id, rp.page, rp.index); }
                                    }
                                }
                                rl := Text {
                                    x: 0;
                                    width: parent.width - 24px;
                                    text: rp.text;
                                    font-size: Theme.fs-callout;
                                    color: Theme.text-2;
                                    wrap: word-wrap;
                                }
                            }
                            if a.selected: HorizontalLayout {
                                alignment: start;
                                spacing: Space.sm;
                                SmallButton { text: @tr("Reply"); clicked => { ReaderBridge.annot-reply(root.id, a.index); } }
                                // Acrobat's Set Status.
                                SortCombo {
                                    width: 120px;
                                    options: [@tr("No status"), @tr("Accepted"), @tr("Rejected"), @tr("Cancelled"), @tr("Completed")];
                                    current-index: a.status == "Accepted" ? 1 : a.status == "Rejected" ? 2 : a.status == "Cancelled" ? 3 : a.status == "Completed" ? 4 : 0;
                                    chevron: @image-url("../icons/chevron-down.svg");
                                    selected(i) => { ReaderBridge.annot-status(root.id, a.index, i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- Attachments ----------------------------------------------------------------------------
    // Rows 28: the clip, the name, the size right; on hover Save a copy…, Rename, Delete. A click
    // opens one; + attaches a file to the page in view; past three, a field finds them by name.
    if root.panel == 4 && root.tab.reader.attachments.length == 0: EmptyState {
        y: root.content-top;
        height: parent.height - root.content-top;
        icon: @image-url("../icons/paperclip.svg");
        text: @tr("Files attached to this PDF appear here. Click + to attach one.");
    }
    if root.panel == 4 && root.tab.reader.attachments.length > 0: VerticalLayout {
        y: root.content-top;
        height: parent.height - root.content-top;
        padding-top: Space.sm;
        spacing: Space.xs;
        if root.tab.reader.attachments.length > 3: HorizontalLayout {
            padding-left: Space.lg;
            padding-right: Space.lg;
            PanelField {
                height: Theme.control-height;
                placeholder: @tr("Find");
                edited(t) => { root.att-filter = t; }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                for f[i] in root.tab.reader.attachments: Rectangle {
                    visible: Parse.name-matches(f.name, root.att-filter);
                    height: self.visible ? Theme.row-height : 0px;
                    accessible-role: list-item;
                    accessible-label: f.name;
                    accessible-value: f.value;
                    accessible-action-default => { ReaderBridge.attachment-open(root.id, i); }
                    Rectangle {
                        x: 6px;
                        width: parent.width - 12px;
                        border-radius: Theme.r-row;
                        background: fa.has-hover ? Theme.fill-1 : transparent;
                    }
                    Image {
                        x: PlatformBridge.rtl ? parent.width - self.width - 14px : 14px;
                        width: Theme.icon-sm;
                        height: Theme.icon-sm;
                        source: @image-url("../icons/paperclip.svg");
                        colorize: Theme.text-2;
                    }
                    if root.att-renaming != i: Text {
                        x: PlatformBridge.rtl ? 76px : 38px;
                        width: parent.width - 38px - 76px;
                        text: f.name;
                        font-size: Theme.fs-body;
                        color: Theme.text;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-alignment: PlatformBridge.rtl ? right : left;
                    }
                    if !fa.has-hover && root.att-renaming != i: Text {
                        x: PlatformBridge.rtl ? 14px : parent.width - self.width - 14px;
                        width: 56px;
                        text: f.value;
                        font-size: Theme.fs-callout;
                        color: Theme.text-2;
                        horizontal-alignment: PlatformBridge.rtl ? left : right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    fa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ReaderBridge.attachment-open(root.id, i); }
                        if fa.has-hover && root.att-renaming != i: HorizontalLayout {
                            x: PlatformBridge.rtl ? 10px : parent.width - self.width - 10px;
                            y: 4px;
                            width: 3 * 20px + 2 * 2px;
                            height: 20px;
                            spacing: 2px;
                            RowAction { icon: @image-url("../icons/download.svg"); tip: @tr("Save a copy…"); clicked => { ReaderBridge.attachment-save(root.id, i); } }
                            RowAction { icon: @image-url("../icons/pencil.svg"); tip: @tr("Rename"); clicked => { root.att-renaming = i; } }
                            RowAction { icon: @image-url("../icons/trash-2.svg"); tip: @tr("Delete attachment"); clicked => { ReaderBridge.attachment-change(root.id, i, ""); } }
                        }
                    }
                    if root.att-renaming == i: Rectangle {
                        x: PlatformBridge.rtl ? 12px : 34px;
                        y: 2px;
                        width: parent.width - 46px;
                        height: 24px;
                        background: Theme.field;
                        border-radius: Theme.r-sm;
                        border-width: 2px;
                        border-color: Theme.focus-ring;
                        att-name := TextInput {
                            // Tools page tools' keys wait while a field has the keyboard.
                            changed has-focus => { PlatformBridge.typing = self.has-focus; }
                            x: 6px;
                            width: parent.width - 12px;
                            text: f.name;
                            font-size: Theme.fs-body;
                            color: Theme.text;
                            vertical-alignment: center;
                            single-line: true;
                            init => { self.focus(); self.select-all(); }
                            // The field goes: the keys (⌘S…) back to the pages.
                            accepted => { ReaderBridge.attachment-change(root.id, i, self.text); root.att-renaming = -1; root.focus-pages(); }
                            key-pressed(e) => {
                                if e.text == Key.Escape { root.att-renaming = -1; root.focus-pages(); return accept; }
                                reject
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- Layers ---------------------------------------------------------------------------------
    // Rows 28 with a checkbox: shown or hidden on screen; the file keeps them as it sets them.
    if root.panel == 5 && root.tab.reader.layers.length == 0: EmptyState {
        y: root.content-top;
        height: parent.height - root.content-top;
        icon: @image-url("../icons/layers.svg");
        text: @tr("This PDF has no layers.");
    }
    if root.panel == 5 && root.tab.reader.layers.length > 0: ScrollView {
        y: root.content-top;
        height: parent.height - root.content-top;
        VerticalLayout {
            padding-top: Space.xs;
            for l[i] in root.tab.reader.layers: Rectangle {
                height: Theme.row-height;
                Rectangle {
                    x: 6px;
                    width: parent.width - 12px;
                    border-radius: Theme.r-row;
                    background: la.has-hover ? Theme.fill-1 : transparent;
                }
                Checkbox {
                    x: PlatformBridge.rtl ? parent.width - self.width - 14px : 14px;
                    width: min(self.preferred-width, parent.width - 28px);
                    text: l.name;
                    checked: l.shown;
                    toggled(on) => { ReaderBridge.layer-set(root.id, i, on); }
                }
                la := TouchArea {
                    x: 36px;
                    width: parent.width - self.x - 14px;
                    mouse-cursor: pointer;
                    clicked => { ReaderBridge.layer-set(root.id, i, !l.shown); }
                }
            }
        }
    }

    // The edge next to the pages drags to resize the sidebar (PDF Expert's): the design system's
    // handle (widgets/resize-handle.slint), 200–480 and at most 45 % of the window; a double click
    // puts back the default. The thumbnails take the new width once it is let go.
    ResizeHandle {
        edge-x: PlatformBridge.rtl ? 0 : parent.width;
        leading: PlatformBridge.rtl;
        current-width: root.panel-width;
        resized(w) => { ReaderBridge.panel-width = clamp(w, Theme.sidebar-min, max(Theme.sidebar-min, min(Theme.sidebar-max, root.window-width * Theme.sidebar-max-share))); }
        reset => { ReaderBridge.panel-width = Theme.sidebar-default; }
        committed => { ReaderBridge.panel-resized(ReaderBridge.panel-width); }
    }

    // ---- the title row's menus ------------------------------------------------------------------
    // Thumbnails ⋯: what the bar does not hold (PDF Expert's page menu).
    pages-more := PopupWindow {
        x: root.width - self.width - Space.sm;
        y: 76px;
        width: min(248px, root.width - 2 * Space.sm);
        height: (PlatformBridge.mac ? 10 : 9) * Theme.row-height + 2 * 9px + 8px;
        PopoverFrame {
            VerticalLayout {
                padding: 4px;
                MenuRow { text: @tr("Insert pages from file…"); activated => { ReaderBridge.page-op(root.id, 6); } }
                MenuRow { text: @tr("Insert a file's pages before…"); activated => { ReaderBridge.page-op(root.id, 9); } }
                MenuRow { text: @tr("Insert from clipboard"); activated => { ReaderBridge.page-op(root.id, 10); } }
                MenuRow { text: @tr("Insert from scanner…"); activated => { ReaderBridge.page-op(root.id, 11); } }
                if PlatformBridge.mac: MenuRow { text: @tr("Insert from iPhone or iPad…"); activated => { ReaderBridge.page-op(root.id, 12); } }
                MenuSeparatorLine { }
                MenuRow { text: @tr("Replace with a file's pages…"); activated => { ReaderBridge.page-op(root.id, 7); } }
                MenuRow { text: @tr("Reverse page order"); activated => { ReaderBridge.page-op(root.id, 8); } }
                MenuSeparatorLine { }
                MenuRow { text: @tr("Extract…"); activated => { root.open-strip(0); } }
                MenuRow { text: @tr("Number pages…"); activated => { root.open-strip(1); } }
                MenuRow { text: @tr("Transitions…"); activated => { root.open-strip(2); } }
            }
        }
    }
    // Annotations ⋯ (Acrobat's comment list actions; ⌘Z undoes Remove all).
    notes-more := PopupWindow {
        x: root.width - self.width - Space.sm;
        y: 76px;
        width: min(248px, root.width - 2 * Space.sm);
        height: (root.tab.reader.annots.length > 0 ? 5 : 4) * Theme.row-height + (root.tab.reader.annots.length > 0 ? 2 : 1) * 9px + 8px;
        PopoverFrame {
            VerticalLayout {
                padding: 4px;
                MenuRow { text: root.tab.reader.comments-hidden ? @tr("Show all") : @tr("Hide all"); activated => { ReaderBridge.notes-action(root.id, 0); root.focus-pages(); } }
                MenuSeparatorLine { }
                MenuRow { text: @tr("Summary of comments…"); activated => { ReaderBridge.notes-action(root.id, 1); } }
                MenuRow { text: @tr("Export comments (XFDF, FDF)…"); activated => { ReaderBridge.notes-action(root.id, 3); } }
                MenuRow { text: @tr("Import comments…"); activated => { ReaderBridge.notes-action(root.id, 4); } }
                if root.tab.reader.annots.length > 0: MenuSeparatorLine { }
                if root.tab.reader.annots.length > 0: MenuRow { text: @tr("Remove all comments"); danger: true; activated => { ReaderBridge.notes-action(root.id, 2); root.focus-pages(); } }
            }
        }
    }
    // Layers ⋯.
    layers-more := PopupWindow {
        x: root.width - self.width - Space.sm;
        y: 76px;
        width: 200px;
        height: (root.tab.reader.layers-changed ? 3 : 2) * Theme.row-height + 8px;
        PopoverFrame {
            VerticalLayout {
                padding: 4px;
                MenuRow { text: @tr("Show all"); enabled: root.tab.reader.layers.length > 0; activated => { ReaderBridge.layers-all(root.id, 0); } }
                MenuRow { text: @tr("Hide all"); enabled: root.tab.reader.layers.length > 0; activated => { ReaderBridge.layers-all(root.id, 1); } }
                if root.tab.reader.layers-changed: MenuRow { text: @tr("Reset"); activated => { ReaderBridge.layers-all(root.id, 2); } }
            }
        }
    }
    // An outline item's commands (Acrobat): move, nest, point it at the page in view, its look.
    mark-menu := PopupWindow {
        x: root.width - self.width - Space.sm;
        y: root.mark-menu-y;
        width: 232px;
        height: 9 * Theme.row-height + 2 * 9px + 8px;
        PopoverFrame {
            VerticalLayout {
                padding: 4px;
                for item in [
                    { text: @tr("Move up"), op: 6 },
                    { text: @tr("Move down"), op: 7 },
                    { text: @tr("Indent"), op: 8 },
                    { text: @tr("Outdent"), op: 9 },
                    { text: "", op: -1 },
                    { text: @tr("Set destination to this view"), op: 5 },
                    { text: "", op: -1 },
                    // Acrobat's bookmark Appearance: style and colour.
                    { text: @tr("Bold"), op: 10 },
                    { text: @tr("Italic"), op: 11 },
                    { text: @tr("In the pen's colour"), op: 12 },
                    { text: @tr("In the usual colour"), op: 13 },
                ]: Rectangle {
                    height: item.op < 0 ? 9px : Theme.row-height;
                    if item.op < 0: MenuSeparatorLine { }
                    if item.op >= 0: MenuRow { text: item.text; activated => { ReaderBridge.outline-op(root.id, root.mark-row, item.op, ""); root.focus-pages(); } }
                }
            }
        }
    }
}
