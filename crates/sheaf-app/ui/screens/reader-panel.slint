// The reader's side panel: Pages (thumbnails, drag to reorder, page operations), Outline, Notes
// and search Results.

import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolTab, ReaderBridge, Parse } from "../flow-types.slint";
import { PlatformBridge } from "../platform.slint";
import { ToolButton, PanelTab, SmallButton, PanelField } from "reader-parts.slint";
import { SortCombo } from "../widgets/sort-combo.slint";
import { Check } from "../widgets/check.slint";

export component ReaderPanel inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    in property <bool> bare;
    in property <length> panel-width;
    // The search field's text (the options re-run the search with it).
    in property <string> search-text;
    // Pages drag: where the press was, and the drop line (−1: no drag); shared with the reader.
    in-out property <length> thumb-down-y;
    in-out property <length> drop-line;
    in-out property <int> thumb-down-page;
    // Where the thumbnails' right-click menu opens.
    property <length> menu-x;
    property <length> menu-y;
    // The thumbnail strip's scroll, for rendering what it shows.
    out property <length> strip-top: -strip.content-y;
    out property <length> strip-h: strip.visible-height;
    // The keyboard goes back to the pages.
    callback focus-pages();
    // A recent search picked: it goes back in the search field and runs.
    callback search-again(string);
    // Files panel: the attachments' names must hold this (any case); the one being renamed (−1 none).
    property <string> att-filter;
    // Extract…'s options strip (Acrobat's Extract bar), shown over the page strip.
    property <bool> extract-open;
    property <bool> extract-each;
    property <bool> extract-delete;
    // Number pages…'s strip (Acrobat's Page Labels): style, prefix, first number.
    property <bool> number-open;
    // Pages ▸ Transitions: the effect (0 none, then transitions::STYLES) and the seconds per page.
    property <bool> transition-open;
    property <int> transition-style;
    property <string> transition-advance;
    property <int> number-style;
    property <string> number-prefix;
    property <string> number-start;
    property <string> number-through;
    property <int> att-renaming: -1;
        visible: root.tab.reader.panel-open && !root.bare;
        width: root.tab.reader.panel-open && !root.bare ? root.panel-width : 0px;
        background: Theme.panel-bg;
        VerticalLayout {
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                padding: 8px;
                spacing: 2px;
                PanelTab { text: @tr("Pages"); icon: @image-url("../icons/layout-grid.svg"); selected: root.tab.reader.panel == 0; clicked => { ReaderBridge.set-panel(root.id, 0); } }
                PanelTab { text: @tr("Outline"); icon: @image-url("../icons/list-tree.svg"); selected: root.tab.reader.panel == 1; clicked => { ReaderBridge.set-panel(root.id, 1); } }
                PanelTab { text: @tr("Notes"); icon: @image-url("../icons/message-square.svg"); selected: root.tab.reader.panel == 2; clicked => { ReaderBridge.set-panel(root.id, 2); } }
                PanelTab { text: @tr("Files"); icon: @image-url("../icons/paperclip.svg"); selected: root.tab.reader.panel == 4; clicked => { ReaderBridge.set-panel(root.id, 4); } }
                if root.tab.reader.layers.length > 0: PanelTab { text: @tr("Layers"); icon: @image-url("../icons/layers.svg"); selected: root.tab.reader.panel == 5; clicked => { ReaderBridge.set-panel(root.id, 5); } }
            }
            Rectangle { height: 1px; background: Theme.sidebar-border; }
            Rectangle {
                vertical-stretch: 1;
                if root.tab.reader.panel == 3: VerticalLayout {
                    // The search options on one row, how many results and where on the next.
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: LayoutAlignment.stretch;
                        padding: 10px;
                        padding-bottom: 4px;
                        spacing: 6px;
                        SmallButton {
                            text: @tr("Aa");
                            primary: root.tab.reader.case-sensitive;
                            clicked => { ReaderBridge.search-options(root.id, !root.tab.reader.case-sensitive, root.tab.reader.whole-words, root.search-text); }
                        }
                        SmallButton {
                            text: @tr("Whole words");
                            primary: root.tab.reader.whole-words;
                            clicked => { ReaderBridge.search-options(root.id, root.tab.reader.case-sensitive, !root.tab.reader.whole-words, root.search-text); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.tab.reader.search-history.length > 1: ToolButton {
                            cross-axis-self-alignment: CrossAxisAlignment.center;
                            icon: @image-url("../icons/history.svg");
                            tip: @tr("Recent searches");
                            clicked => { recent.show(); }
                        }
                    }
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: LayoutAlignment.stretch;
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-bottom: 6px;
                        Text {
                            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.tab.reader.search-count == "None" ? "No results" : root.tab.reader.results.length + (root.tab.reader.search-busy ? "+ results" : root.tab.reader.results.length == 1 ? " result" : " results")
                                + (root.tab.reader.search-pages > 1 ? " on \{root.tab.reader.search-pages} pages" : "");
                            font-size: Theme.fs-caption;
                            font-weight: Theme.weight-demibold;
                            color: Theme.text-secondary;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // Acrobat's Advanced Search ▸ All PDF documents in a folder: the same words there.
                        Text {
                            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("In a folder…");
                            font-size: Theme.fs-caption;
                            color: Theme.accent;
                            TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.folder-search(root.id, root.search-text); } }
                        }
                    }
                    // Acrobat's Find and Replace: the words found rewritten in the pages' text. The field
                    // has the row to itself (beside two buttons it was too narrow to read).
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 6px;
                        spacing: 6px;
                        replace-in := PanelField { placeholder: @tr("Replace with"); }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            spacing: 6px;
                            alignment: start;
                            // Acrobat's Replace: the match in view only.
                            SmallButton { text: @tr("Replace"); clicked => { ReaderBridge.replace-one(root.id, root.search-text, replace-in.text); root.focus-pages(); } }
                            SmallButton { text: @tr("Replace all"); clicked => { ReaderBridge.replace-all(root.id, root.search-text, replace-in.text); root.focus-pages(); } }
                        }
                    }
                    recent := PopupWindow {
                        x: 10px;
                        y: 40px;
                        width: root.panel-width - 20px;
                        Rectangle {
                            background: Theme.input-bg;
                            border-radius: Theme.radius-small;
                            border-width: 1px;
                            border-color: Theme.input-border;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: #00000022;
                            VerticalLayout {
                                padding: 4px;
                                Text {
                                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                    text: @tr("Recent searches");
                                    font-size: Theme.fs-caption;
                                    color: Theme.text-muted;
                                    height: 22px;
                                    vertical-alignment: center;
                                    x: 6px;
                                }
                                for q in root.tab.reader.search-history: Rectangle {
                                    height: 28px;
                                    border-radius: 3px;
                                    background: qt.has-hover ? Theme.popup-hover : transparent;
                                    Text {
                                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        text: q;
                                        font-size: Theme.fs-label;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    qt := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.search-again(q); }
                                    }
                                }
                            }
                        }
                    }
                    // A ListView makes only the rows in view: tens of thousands of results stay cheap.
                    ListView {
                        vertical-stretch: 1;
                            for h[i] in root.tab.reader.results: Rectangle {
                                height: hl.preferred-height + 2px;
                                Rectangle {
                                x: PlatformBridge.rtl ? parent.width - (6px) - self.width : 6px;
                                width: parent.width - 12px;
                                height: parent.height - 2px;
                                border-radius: Theme.radius-button;
                                background: h.current ? Theme.menu-selected-bg : ht.has-hover ? Theme.popup-hover : transparent;
                                hl := VerticalLayout {
                                    padding: 8px;
                                    padding-top: h.first ? 10px : 4px;
                                    spacing: 2px;
                                    // The page heads its results (PDF Expert groups them by page).
                                    if h.first: Text {
                                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        text: h.page-label;
                                        font-size: Theme.fs-caption;
                                        font-weight: Theme.weight-demibold;
                                        color: Theme.text-secondary;
                                    }
                                    // The match in bold inside its context, as PDF Expert lists results.
                                    StyledText {
                                        text: @markdown("\{h.before}**\{h.hit}**\{h.after}");
                                        default-font-size: Theme.fs-label;
                                        default-color: Theme.text;
                                        // A fixed width makes it wrap; three lines at most.
                                        width: root.panel-width - 28px;
                                        max-lines: 3;
                                    }
                                }
                                // Above the text: StyledText takes clicks for its links.
                                ht := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { ReaderBridge.result-clicked(root.id, i); }
                                }
                                }
                            }
                    }
                }
                if root.tab.reader.panel == 1 && root.tab.reader.outline-empty: Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    x: PlatformBridge.rtl ? parent.width - (16px) - self.width : 16px;
                    y: 50px;
                    width: parent.width - 32px;
                    text: @tr("No bookmarks yet: + Bookmark adds the page in view.");
                    font-size: Theme.fs-label;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                if root.tab.reader.panel == 1: VerticalLayout {
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        padding: 8px;
                        padding-bottom: 0px;
                        alignment: start;
                        SmallButton { text: @tr("+ Bookmark"); clicked => { ReaderBridge.outline-op(root.id, -1, 0, ""); root.focus-pages(); } }
                    }
                ScrollView {
                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 8px;
                        for r[i] in root.tab.reader.outline: Rectangle {
                            height: 30px;
                            background: r.current ? Theme.menu-selected-bg : ot.has-hover ? Theme.popup-hover : transparent;
                            // Where a dragged bookmark would land: a line above this row, or the row ringed.
                            if root.drag-mark >= 0 && root.drop-row == i: Rectangle {
                                y: root.drop-inside ? 0px : -1px;
                                height: root.drop-inside ? parent.height : 2px;
                                border-width: root.drop-inside ? 2px : 0px;
                                border-color: Theme.accent;
                                background: root.drop-inside ? transparent : Theme.accent;
                            }
                            ot := TouchArea {
                                mouse-cursor: root.drag-mark >= 0 ? grabbing : pointer;
                                moved => {
                                    if root.drag-mark >= 0 || abs(self.mouse-y - self.pressed-y) > 6px {
                                        root.drag-mark = i;
                                        root.drop-row = i + floor(self.mouse-y / 30px);
                                        root.drop-inside = mod(self.mouse-y / 1px + 3000, 30) > 8 && mod(self.mouse-y / 1px + 3000, 30) < 22;
                                    }
                                }
                                pointer-event(e) => {
                                    if e.kind == PointerEventKind.up && root.drag-mark == i {
                                        if root.drop-row != i { ReaderBridge.outline-drop(root.id, i, root.drop-row, root.drop-inside); }
                                        root.drag-mark = -1;
                                        root.drop-row = -1;
                                        root.just-dropped = true;
                                    }
                                }
                                clicked => {
                                    if root.just-dropped { root.just-dropped = false; return; }
                                    ReaderBridge.outline-clicked(root.id, i);
                                    root.focus-pages();
                                }
                                double-clicked => { ReaderBridge.outline-op(root.id, i, 1, ""); }
                                // On hover: rename, delete, and the rest in a menu (Acrobat's bookmark context menu); inside
                                // the TouchArea so reaching them keeps the row hovered.
                                if ot.has-hover && !r.editing: FlexboxLayout {
                                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                                    alignment: LayoutAlignment.stretch;
                                    x: PlatformBridge.rtl ? parent.width - (parent.width - 34px - 90px) - self.width : parent.width - 34px - 90px;
                                    width: 90px;
                                    ToolButton { icon: @image-url("../icons/pencil.svg"); tip: @tr("Rename"); clicked => { ReaderBridge.outline-op(root.id, i, 1, ""); } }
                                    ToolButton { icon: @image-url("../icons/trash-2.svg"); tip: @tr("Delete bookmark"); clicked => { ReaderBridge.outline-op(root.id, i, 4, ""); root.focus-pages(); } }
                                    ToolButton { icon: @image-url("../icons/ellipsis.svg"); tip: @tr("More"); clicked => { root.mark-row = i; root.mark-menu-y = self.absolute-position.y - root.absolute-position.y + 30px; mark-menu.show(); } }
                                }
                            }
                            if r.has-children: Rectangle {
                                x: PlatformBridge.rtl ? parent.width - (6px + r.depth * 14px) - self.width : 6px + r.depth * 14px;
                                width: 18px;
                                Image {
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../icons/chevron-right.svg");
                                    colorize: Theme.text-muted;
                                    transform-rotation: r.expanded ? 90deg : 0deg;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { ReaderBridge.outline-toggled(root.id, i); }
                                }
                            }
                            if !r.editing: Text {
                                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                x: PlatformBridge.rtl ? parent.width - (26px + r.depth * 14px) - self.width : 26px + r.depth * 14px;
                                width: parent.width - (26px + r.depth * 14px) - (ot.has-hover ? 84px : 40px);
                                text: r.title;
                                font-size: Theme.fs-label;
                                // Its own look when it has one (bold, italic, colour), as Acrobat shows it.
                                font-weight: r.bold ? 700 : r.depth == 0 ? Theme.weight-demibold : 400;
                                font-italic: r.italic;
                                color: r.has-colour ? r.colour : Theme.text;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            // Renamed in place: ↩ keeps the new title, Escape the old one.
                            if r.editing: Rectangle {
                                x: PlatformBridge.rtl ? parent.width - (22px + r.depth * 14px) - self.width : 22px + r.depth * 14px;
                                width: parent.width - (22px + r.depth * 14px) - 40px;
                                height: 24px;
                                border-radius: Theme.radius-small;
                                border-width: 1px;
                                border-color: Theme.text-secondary;
                                background: Theme.input-bg;
                                rename := TextInput {
                                    // Tools page tools' keys wait while a field has the keyboard.
                                    changed has-focus => { PlatformBridge.typing = self.has-focus; }
                                    x: PlatformBridge.rtl ? parent.width - (4px) - self.width : 4px;
                                    width: parent.width - 8px;
                                    text: r.title;
                                    font-size: Theme.fs-label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    init => { self.focus(); self.select-all(); }
                                    accepted => { ReaderBridge.outline-op(root.id, i, 2, self.text); root.focus-pages(); }
                                    key-pressed(e) => {
                                        if e.text == Key.Escape { ReaderBridge.outline-op(root.id, i, 3, ""); root.focus-pages(); return accept; }
                                        reject
                                    }
                                }
                            }
                            Text {
                                x: PlatformBridge.rtl ? parent.width - (parent.width - 34px) - self.width : parent.width - 34px;
                                width: 26px;
                                text: r.page-label;
                                font-size: Theme.fs-caption;
                                color: Theme.text-muted;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                }
                // Attached files (Acrobat's Attachments pane): a click opens one, its arrow saves it,
                // Attach… adds one; past three, a field finds them by name.
                // The document's layers (Acrobat's Layers pane): a click shows or hides one on screen;
                // the file keeps them as it sets them.
                if root.tab.reader.panel == 5: VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: LayoutAlignment.stretch;
                        spacing: 6px;
                        SmallButton { text: @tr("Show all"); clicked => { ReaderBridge.layers-all(root.id, 0); } }
                        SmallButton { text: @tr("Hide all"); clicked => { ReaderBridge.layers-all(root.id, 1); } }
                        if root.tab.reader.layers-changed: SmallButton { text: @tr("Reset"); clicked => { ReaderBridge.layers-all(root.id, 2); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.tab.reader.layers.length == 0: Text {
                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("No layers.");
                        font-size: Theme.fs-label;
                        color: Theme.text-muted;
                    }
                    for l[i] in root.tab.reader.layers: Rectangle {
                        height: 30px;
                        border-radius: Theme.radius-item;
                        background: la.has-hover ? Theme.popup-hover : transparent;
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Image {
                                cross-axis-self-alignment: CrossAxisAlignment.center;
                                width: 14px;
                                height: 14px;
                                source: l.shown ? @image-url("../icons/eye.svg") : @image-url("../icons/eye-off.svg");
                                colorize: l.shown ? Theme.text-secondary : Theme.text-muted;
                            }
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: l.name; font-size: Theme.fs-label; color: l.shown ? Theme.text : Theme.text-muted; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        la := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ReaderBridge.layer-set(root.id, i, !l.shown); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                if root.tab.reader.panel == 4: VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: LayoutAlignment.stretch;
                        spacing: 6px;
                        SmallButton { text: @tr("Attach…"); clicked => { ReaderBridge.attachment-add(root.id); } }
                        if root.tab.reader.attachments.length <= 3: Rectangle { horizontal-stretch: 1; }
                        if root.tab.reader.attachments.length > 3: PanelField {
                            horizontal-stretch: 1;
                            placeholder: @tr("Find");
                            edited(t) => { root.att-filter = t; }
                        }
                    }
                    if root.tab.reader.attachments.length == 0: Text {
                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("No attached files.");
                        font-size: Theme.fs-label;
                        color: Theme.text-muted;
                    }
                    for f[i] in root.tab.reader.attachments: Rectangle {
                        visible: Parse.name-matches(f.name, root.att-filter);
                        height: self.visible ? 34px : 0px;
                        border-radius: Theme.radius-item;
                        background: fa.has-hover ? Theme.popup-hover : transparent;
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Image { cross-axis-self-alignment: CrossAxisAlignment.center; width: 14px; height: 14px; source: @image-url("../icons/paperclip.svg"); colorize: Theme.text-secondary; }
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: f.name; font-size: Theme.fs-label; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            // Its size gives way to the buttons on hover.
                            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: f.value; opacity: fa.has-hover ? 0 : 1; font-size: Theme.fs-caption; color: Theme.text-muted; vertical-alignment: center; }
                            Rectangle { width: 22px; }
                        }
                        fa := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ReaderBridge.attachment-open(root.id, i); }
                            // On hover (Acrobat's Attachments pane): save a copy, rename, delete.
                            if fa.has-hover && root.att-renaming != i: FlexboxLayout {
                                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                                flex-wrap: FlexboxLayoutWrap.no-wrap;
                                alignment: LayoutAlignment.stretch;
                                x: PlatformBridge.rtl ? parent.width - (parent.width - 92px) - self.width : parent.width - 92px;
                                y: 2px;
                                width: 90px;
                                ToolButton { icon: @image-url("../icons/download.svg"); tip: @tr("Save a copy…"); clicked => { ReaderBridge.attachment-save(root.id, i); } }
                                ToolButton { icon: @image-url("../icons/pencil.svg"); tip: @tr("Rename"); clicked => { root.att-renaming = i; } }
                                ToolButton { icon: @image-url("../icons/trash-2.svg"); tip: @tr("Delete attachment"); clicked => { ReaderBridge.attachment-change(root.id, i, ""); } }
                            }
                        }
                        if root.att-renaming == i: Rectangle {
                            x: PlatformBridge.rtl ? parent.width - (28px) - self.width : 28px;
                            width: parent.width - 36px;
                            height: 24px;
                            background: Theme.input-bg;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.accent;
                            att-name := TextInput {
                                // Tools page tools' keys wait while a field has the keyboard.
                                changed has-focus => { PlatformBridge.typing = self.has-focus; }
                                x: PlatformBridge.rtl ? parent.width - (5px) - self.width : 5px;
                                width: parent.width - 10px;
                                text: f.name;
                                font-size: Theme.fs-label;
                                color: Theme.text;
                                vertical-alignment: center;
                                single-line: true;
                                init => { self.focus(); self.select-all(); }
                                // The field goes: the keys (⌘S…) back to the pages.
                                accepted => { ReaderBridge.attachment-change(root.id, i, self.text); root.att-renaming = -1; root.focus-pages(); }
                                key-pressed(e) => {
                                    if e.text == Key.Escape { root.att-renaming = -1; root.focus-pages(); return accept; }
                                    reject
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                if root.tab.reader.panel == 2 && root.tab.reader.annots.length == 0: Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    x: PlatformBridge.rtl ? parent.width - (16px) - self.width : 16px;
                    y: 86px;
                    width: parent.width - 32px;
                    text: @tr("No annotations yet. Select text and pick Highlight, or choose a tool above.");
                    font-size: Theme.fs-label;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                if root.tab.reader.panel == 2: VerticalLayout {
                    // Acrobat's comment list actions: hide all, a summary, remove all (⌘Z undoes it).
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: LayoutAlignment.stretch;
                        padding: 8px;
                        padding-bottom: 0px;
                        spacing: 6px;
                        SmallButton { text: root.tab.reader.comments-hidden ? @tr("Show all") : @tr("Hide all"); clicked => { ReaderBridge.notes-action(root.id, 0); root.focus-pages(); } }
                        ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/file-text.svg"); tip: @tr("Summary of comments…"); clicked => { ReaderBridge.notes-action(root.id, 1); } }
                        ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/file-output.svg"); tip: @tr("Export comments (XFDF, FDF)…"); clicked => { ReaderBridge.notes-action(root.id, 3); } }
                        ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/file-input.svg"); tip: @tr("Import comments…"); clicked => { ReaderBridge.notes-action(root.id, 4); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.tab.reader.annots.length > 0: ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/trash-2.svg"); tip: @tr("Remove all comments"); clicked => { ReaderBridge.notes-action(root.id, 2); root.focus-pages(); } }
                    }
                    // Which comments, in which order (Acrobat's comment list filter and sort).
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: LayoutAlignment.stretch;
                        padding: 8px;
                        padding-bottom: 0px;
                        spacing: 6px;
                        SortCombo {
                            width: 112px;
                            options: [@tr("All"), @tr("Markup"), @tr("Notes"), @tr("Drawings"), @tr("Stamps"), @tr("Accepted"), @tr("Rejected"), @tr("Cancelled"), @tr("Completed"), @tr("No status"), @tr("Checked")];
                            current-index: root.tab.reader.notes-filter;
                            chevron: @image-url("../icons/chevron-down.svg");
                            selected(i) => { ReaderBridge.notes-view(root.id, 0, i); }
                        }
                        SortCombo {
                            width: 112px;
                            options: [@tr("By page"), @tr("Newest"), @tr("By author"), @tr("By type")];
                            current-index: root.tab.reader.notes-sort;
                            chevron: @image-url("../icons/chevron-down.svg");
                            selected(i) => { ReaderBridge.notes-view(root.id, 1, i); }
                        }
                    }
                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            for a[i] in root.tab.reader.annots: Rectangle {
                                height: al.preferred-height;
                                border-radius: Theme.radius-item;
                                background: a.selected ? Theme.menu-selected-bg : at.has-hover ? Theme.popup-hover : Theme.card;
                                border-width: 1px;
                                border-color: Theme.sidebar-border;
                                at := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { ReaderBridge.annot-clicked(root.id, a.index); root.focus-pages(); }
                                }
                                Rectangle {
                                    x: PlatformBridge.rtl ? parent.width - (0) - self.width : 0;
                                    width: 4px;
                                    border-radius: 2px;
                                    background: a.colour;
                                }
                                al := VerticalLayout {
                                    padding: 10px;
                                    padding-left: 14px;
                                    spacing: 4px;
                                    FlexboxLayout {
                                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                                        alignment: LayoutAlignment.stretch;
                                        // Room for the delete button that shows on hover.
                                        padding-right: 22px;
                                        Text {
                                            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                            text: a.kind;
                                            font-size: Theme.fs-caption;
                                            font-weight: Theme.weight-demibold;
                                            color: Theme.text-secondary;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                            text: a.page-label;
                                            font-size: Theme.fs-caption;
                                            color: Theme.text-muted;
                                        }
                                    }
                                    if a.text != "": Text {
                                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        text: a.text;
                                        font-size: Theme.fs-label;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        max-height: 60px;
                                    }
                                    if a.meta != "": Text {
                                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        text: a.meta + (a.status != "" ? " · " + a.status : "");
                                        font-size: Theme.fs-caption;
                                        color: Theme.text-muted;
                                        overflow: elide;
                                    }
                                    // Replies, under the comment (Acrobat's and PDF Expert's threads),
                                    // each deleted alone by the bin on its hover.
                                    for rp in a.replies: Rectangle {
                                        height: max(rl.preferred-height, 20px);
                                        rt := TouchArea {}
                                        rl := Text {
                                            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                            x: PlatformBridge.rtl ? parent.width - (0) - self.width : 0;
                                            width: parent.width - 24px;
                                            text: rp.text;
                                            font-size: Theme.fs-caption;
                                            color: Theme.text-secondary;
                                            wrap: word-wrap;
                                        }
                                        if rt.has-hover || rd.has-hover: Rectangle {
                                            x: PlatformBridge.rtl ? parent.width - (parent.width - 20px) - self.width : parent.width - 20px;
                                            y: 0;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: Theme.radius-small;
                                            background: rd.has-hover ? Theme.pill-bg : transparent;
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                source: @image-url("../icons/trash-2.svg");
                                                colorize: Theme.text-muted;
                                            }
                                        }
                                        rd := TouchArea {
                                            x: PlatformBridge.rtl ? parent.width - (parent.width - 20px) - self.width : parent.width - 20px;
                                            width: 20px;
                                            height: 20px;
                                            y: 0;
                                            mouse-cursor: pointer;
                                            clicked => { ReaderBridge.reply-delete(root.id, rp.page, rp.index); }
                                        }
                                    }
                                    if a.selected: FlexboxLayout {
                                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                                        alignment: start;
                                        spacing: 6px;
                                        SmallButton { text: @tr("Reply"); clicked => { ReaderBridge.annot-reply(root.id, a.index); } }
                                        // Acrobat's Set Status.
                                        SortCombo {
                                            width: 120px;
                                            options: [@tr("No status"), @tr("Accepted"), @tr("Rejected"), @tr("Cancelled"), @tr("Completed")];
                                            current-index: a.status == "Accepted" ? 1 : a.status == "Rejected" ? 2 : a.status == "Cancelled" ? 3 : a.status == "Completed" ? 4 : 0;
                                            chevron: @image-url("../icons/chevron-down.svg");
                                            selected(i) => { ReaderBridge.annot-status(root.id, a.index, i); }
                                        }
                                    }
                                }
                                if at.has-hover || a.selected: Rectangle {
                                    x: PlatformBridge.rtl ? parent.width - (parent.width - 28px) - self.width : parent.width - 28px;
                                    y: 6px;
                                    width: 22px;
                                    height: 22px;
                                    border-radius: Theme.radius-small;
                                    background: dt.has-hover ? Theme.pill-bg : transparent;
                                    Image {
                                        width: 13px;
                                        height: 13px;
                                        source: @image-url("../icons/trash-2.svg");
                                        colorize: Theme.text-muted;
                                    }
                                    dt := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { ReaderBridge.annot-delete(root.id, a.index); }
                                    }
                                }
                            }
                        }
                    }
                }
                strip := ScrollView {
                    visible: root.tab.reader.panel == 0;
                    height: parent.height - (root.tab.reader.panel == 0 ? 44px : 0px);
                    content-width: self.visible-width;
                    content-height: root.tab.viewer-thumbs-height + 20px;
                    for t in root.tab.viewer-thumbs: Rectangle {
                        x: (strip.visible-width - ReaderBridge.thumb-width) / 2;
                        y: t.y;
                        width: ReaderBridge.thumb-width;
                        height: t.h + 18px;
                        Rectangle {
                            height: t.h;
                            y: 0;
                            background: Theme.thumb-placeholder;
                            border-width: t.selected || t.page == root.tab.viewer-current ? 2px : 0px;
                            border-color: t.selected ? Theme.info : Theme.accent;
                            drop-shadow-blur: 5px;
                            drop-shadow-color: Theme.thumb-shadow;
                            drop-shadow-offset-y: 1px;
                            if t.ready: Image {
                                x: PlatformBridge.rtl ? parent.width - (2px) - self.width : 2px;
                                y: 2px;
                                width: parent.width - 4px;
                                height: parent.height - 4px;
                                source: t.image;
                                image-fit: fill;
                            }
                            if t.selected: Rectangle {
                                background: Theme.info.with-alpha(0.12);
                            }
                        }
                        Text {
                            y: t.h + 3px;
                            width: parent.width;
                            text: t.page + 1;
                            font-size: Theme.fs-caption;
                            color: t.page == root.tab.viewer-current ? Theme.accent : Theme.text-muted;
                            horizontal-alignment: center;
                        }
                    }
                    // One area over the whole strip: the thumbnails' model is replaced on
                    // every refresh, which would drop a press held on one of them.
                    page-menu := PopupWindow {
                        x: root.menu-x;
                        y: root.menu-y;
                        width: 220px;
                        height: 12 * 30px + 8px;
                        Rectangle {
                            background: Theme.card;
                            border-radius: Theme.radius-small;
                            border-width: 1px;
                            border-color: Theme.input-border;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: #00000040;
                            VerticalLayout {
                                padding: 4px;
                                // Codes as reader_ui::page_op.
                                for o in [{ t: @tr("Rotate left"), k: 0 }, { t: @tr("Rotate right"), k: 1 }, { t: @tr("Insert blank page after"), k: 5 }, { t: @tr("Duplicate"), k: 3 },
                                          { t: @tr("Insert pages from file…"), k: 6 }, { t: @tr("Insert a file's pages before…"), k: 9 }, { t: @tr("Insert from clipboard"), k: 10 }, { t: @tr("Insert from scanner…"), k: 11 },
                                          { t: @tr("Replace with a file's pages…"), k: 7 }, { t: @tr("Reverse page order"), k: 8 },
                                          // Acrobat's Page Transitions (in its page thumbnail menu).
                                          { t: @tr("Transitions…"), k: -1 }, { t: @tr("Delete"), k: 2 }]: Rectangle {
                                    height: 30px;
                                    background: pm.has-hover ? Theme.popup-hover : transparent;
                                    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; x: 10px; text: o.t; font-size: Theme.fs-label; color: o.k == 2 ? Theme.danger : Theme.text; vertical-alignment: center; }
                                    pm := TouchArea {
                                        clicked => {
                                            if o.k < 0 { root.transition-open = true; root.number-open = false; root.extract-open = false; } else { ReaderBridge.page-op(root.id, o.k); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    strip-ta := TouchArea {
                        // The pointer in the visible strip (y from its top): kept while the strip
                        // scrolls under a still pointer.
                        property <length> view-y;
                        width: strip.visible-width;
                        height: root.tab.viewer-thumbs-height + 20px;
                        mouse-cursor: root.drop-line >= 0 ? move : pointer;
                        pointer-event(e) => {
                            // A right click: the page actions at the pointer (Acrobat's and Preview's
                            // thumbnail menu); a page outside a selection of several is selected first.
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                root.thumb-down-page = ReaderBridge.thumb-at(root.id, self.mouse-y);
                                if root.thumb-down-page >= 0 {
                                    if root.tab.reader.pages-selected <= 1 {
                                        ReaderBridge.thumb-pressed(root.id, root.thumb-down-page, false, false);
                                        ReaderBridge.thumb-released(root.id);
                                    }
                                    root.menu-x = min(self.mouse-x, self.width - 220px);
                                    root.menu-y = self.mouse-y;
                                    page-menu.show();
                                }
                                return;
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                root.thumb-down-y = self.mouse-y;
                                root.thumb-down-page = ReaderBridge.thumb-at(root.id, self.mouse-y);
                                if root.thumb-down-page >= 0 {
                                    ReaderBridge.thumb-pressed(root.id, root.thumb-down-page, e.modifiers.shift, e.modifiers.control || e.modifiers.meta);
                                }
                                root.focus-pages();
                            } else if e.kind == PointerEventKind.up && root.drop-line >= 0 {
                                ReaderBridge.thumb-drop(root.id, self.mouse-y);
                                root.drop-line = -1px;
                            } else if e.kind == PointerEventKind.up {
                                ReaderBridge.thumb-released(root.id);
                            }
                        }
                        moved => {
                            self.view-y = self.mouse-y + strip.content-y;
                            if self.pressed && root.thumb-down-page >= 0 && abs(self.mouse-y - root.thumb-down-y) > 8px {
                                root.drop-line = ReaderBridge.thumb-drag(root.id, root.thumb-down-page, self.mouse-y);
                            }
                        }
                    }
                    // Dragging near the top or bottom of the strip scrolls it (a long book's page can
                    // be carried anywhere), the drop line following.
                    Timer {
                        interval: 30ms;
                        running: root.drop-line >= 0;
                        triggered => {
                            let edge = 40px;
                            let step = strip-ta.view-y < edge ? 14px : strip-ta.view-y > strip.visible-height - edge ? -14px : 0px;
                            if step != 0px {
                                strip.content-y = max(min(0px, strip.content-y + step), min(0px, strip.visible-height - strip.content-height));
                                root.drop-line = ReaderBridge.thumb-drag(root.id, root.thumb-down-page, strip-ta.view-y - strip.content-y);
                            }
                        }
                    }
                    // What is carried: a badge under the pointer (PDF Expert shows the pages).
                    if root.drop-line >= 0: Rectangle {
                        x: strip-ta.mouse-x + 10px;
                        // Under the pointer even while the strip scrolls beneath it.
                        y: strip-ta.view-y - strip.content-y + 8px;
                        width: ghost.preferred-width + 16px;
                        height: 24px;
                        border-radius: 12px;
                        background: Theme.info;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000033;
                        ghost := Text {
                            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.tab.reader.pages-selected <= 1 ? @tr("1 page") : @tr("{} pages", root.tab.reader.pages-selected);
                            font-size: Theme.fs-caption;
                            font-weight: Theme.weight-demibold;
                            color: white;
                        }
                    }
                    if root.drop-line >= 0: Rectangle {
                        x: PlatformBridge.rtl ? parent.width - (12px) - self.width : 12px;
                        y: root.drop-line - 1.5px;
                        width: strip.visible-width - 24px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.info;
                    }
                }
                // Page actions on the selection (or the page shown), PDF Expert's page strip.
                if root.tab.reader.panel == 0: Rectangle {
                    y: parent.height - 44px;
                    height: 44px;
                    background: Theme.panel-bg;
                    Rectangle { y: 0; height: 1px; background: Theme.sidebar-border; }
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        padding: 7px;
                        spacing: 2px;
                        alignment: center;
                        ToolButton { icon: @image-url("../icons/rotate-ccw.svg"); tip: @tr("Rotate left"); clicked => { ReaderBridge.page-op(root.id, 0); } }
                        ToolButton { icon: @image-url("../icons/rotate-cw.svg"); tip: @tr("Rotate right"); clicked => { ReaderBridge.page-op(root.id, 1); } }
                        ToolButton { icon: @image-url("../icons/plus.svg"); tip: @tr("Insert blank page after"); clicked => { ReaderBridge.page-op(root.id, 5); } }
                        ToolButton { icon: @image-url("../icons/copy.svg"); tip: @tr("Duplicate"); clicked => { ReaderBridge.page-op(root.id, 3); } }
                        ToolButton { icon: @image-url("../icons/file-output.svg"); tip: @tr("Extract…"); clicked => { root.extract-open = !root.extract-open; root.number-open = false; root.transition-open = false; } }
                        ToolButton { icon: @image-url("../icons/list-ordered.svg"); tip: @tr("Number pages…"); clicked => { root.number-open = !root.number-open; root.extract-open = false; root.transition-open = false; } }
                        ToolButton { icon: @image-url("../icons/trash-2.svg"); tip: @tr("Delete"); clicked => { ReaderBridge.page-op(root.id, 2); } }
                    }
                }
                if root.tab.reader.panel == 0 && root.number-open: Rectangle {
                    y: parent.height - 44px - self.height;
                    height: 136px;
                    background: Theme.panel-bg;
                    Rectangle { y: 0; height: 1px; background: Theme.sidebar-border; }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Number ") + (root.tab.reader.pages-selected <= 1 ? @tr("this page") : @tr("the {} pages", root.tab.reader.pages-selected)) + (root.number-through != "" ? @tr(" through page {}", root.number-through) : root.tab.reader.pages-selected <= 1 ? @tr(" and the next ones") : "");
                            font-size: Theme.fs-caption;
                            color: Theme.text-secondary;
                        }
                        SortCombo {
                            options: ["1, 2, 3", @tr("i, ii, iii"), @tr("I, II, III"), @tr("a, b, c"), @tr("A, B, C"), @tr("No number")];
                            current-index <=> root.number-style;
                            chevron: @image-url("../icons/chevron-down.svg");
                        }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            spacing: 6px;
                            PanelField { placeholder: @tr("Prefix"); text <=> root.number-prefix; }
                            PanelField { width: 70px; placeholder: @tr("Start: 1"); text <=> root.number-start; }
                            // Acrobat's Pages from … to …: the last page numbered so (empty: as selected).
                            PanelField { width: 86px; placeholder: @tr("Through: end"); text <=> root.number-through; }
                        }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: end;
                            spacing: 6px;
                            SmallButton { text: @tr("Cancel"); clicked => { root.number-open = false; } }
                            SmallButton {
                                text: @tr("Number");
                                primary: true;
                                clicked => {
                                    root.number-open = false;
                                    ReaderBridge.number-pages(root.id, root.number-style, root.number-prefix, root.number-start, root.number-through);
                                }
                            }
                        }
                    }
                }
                if root.tab.reader.panel == 0 && root.transition-open: Rectangle {
                    y: parent.height - 44px - self.height;
                    height: 136px;
                    background: Theme.panel-bg;
                    Rectangle { y: 0; height: 1px; background: Theme.sidebar-border; }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("In full screen, ") + (root.tab.reader.pages-selected <= 1 ? @tr("this page comes") : @tr("the {} pages come", root.tab.reader.pages-selected)) + @tr(" in with");
                            font-size: Theme.fs-caption;
                            color: Theme.text-secondary;
                        }
                        SortCombo {
                            options: [@tr("No effect"), @tr("Fade"), @tr("Dissolve"), @tr("Wipe"), @tr("Push"), @tr("Cover"), @tr("Uncover"), @tr("Split"), @tr("Blinds"), @tr("Box"), @tr("Glitter"), @tr("Fly")];
                            current-index <=> root.transition-style;
                            chevron: @image-url("../icons/chevron-down.svg");
                        }
                        PanelField { placeholder: @tr("Next page after (seconds): when turned"); text <=> root.transition-advance; }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: end;
                            spacing: 6px;
                            SmallButton { text: @tr("Cancel"); clicked => { root.transition-open = false; } }
                            SmallButton {
                                text: @tr("Set");
                                primary: true;
                                clicked => {
                                    root.transition-open = false;
                                    ReaderBridge.page-transition(root.id, root.transition-style - 1, root.transition-advance);
                                }
                            }
                        }
                    }
                }
                // Replace Pages from a longer file: which of its pages (Acrobat's pages … to … of it).
                if root.tab.reader.panel == 0 && root.tab.reader.replace-ask != "": Rectangle {
                    y: parent.height - 44px - self.height;
                    height: 112px;
                    background: Theme.panel-bg;
                    Rectangle { y: 0; height: 1px; background: Theme.sidebar-border; }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: root.tab.reader.replace-ask; font-size: Theme.fs-caption; color: Theme.text-secondary; wrap: word-wrap; }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: LayoutAlignment.stretch;
                            spacing: 6px;
                            from-in := PanelField { placeholder: "1"; }
                            SmallButton { text: @tr("Cancel"); clicked => { ReaderBridge.replace-from(root.id, ""); root.focus-pages(); } }
                            SmallButton { text: @tr("Replace"); primary: true; clicked => { ReaderBridge.replace-from(root.id, from-in.text == "" ? "1" : from-in.text); root.focus-pages(); } }
                        }
                    }
                }
                if root.tab.reader.panel == 0 && root.extract-open: Rectangle {
                    y: parent.height - 44px - self.height;
                    height: 104px;
                    background: Theme.panel-bg;
                    Rectangle { y: 0; height: 1px; background: Theme.sidebar-border; }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Check { text: @tr("One file per page"); checked <=> root.extract-each; }
                        Check { text: @tr("Delete pages after extracting"); checked <=> root.extract-delete; }
                        FlexboxLayout {
                            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                            flex-wrap: FlexboxLayoutWrap.no-wrap;
                            alignment: end;
                            spacing: 6px;
                            SmallButton { text: @tr("Cancel"); clicked => { root.extract-open = false; } }
                            SmallButton {
                                text: @tr("Extract");
                                primary: true;
                                clicked => {
                                    root.extract-open = false;
                                    ReaderBridge.extract(root.id, root.extract-each, root.extract-delete);
                                }
                            }
                        }
                    }
                }
            }
        }
        // The edge next to the pages: the panel's right, its left right to left.
        Rectangle {
            x: PlatformBridge.rtl ? 0 : parent.width - 1px;
            width: 1px;
            background: edge.has-hover || edge.pressed ? Theme.accent : Theme.sidebar-border;
        }
        // The edge drags to resize the panel (PDF Expert's sidebar), 200–480 px; the thumbnails
        // take the new width once it is let go.
        edge := TouchArea {
            x: PlatformBridge.rtl ? -3px : parent.width - 4px;
            width: 7px;
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed {
                    // Right to left the panel's right edge stays put (the window's) and its left one is dragged.
                    ReaderBridge.panel-width = clamp(PlatformBridge.rtl ? root.absolute-position.x + root.width - (self.absolute-position.x + self.mouse-x) : self.absolute-position.x + self.mouse-x - root.absolute-position.x, 200px, 480px);
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.up {
                    ReaderBridge.panel-resized(ReaderBridge.panel-width);
                }
            }
        }
    // A bookmark's commands (Acrobat): move, nest, point it at the page in view.
    property <int> mark-row;
    property <length> mark-menu-y;
    // A bookmark dragged (Acrobat's): its row, the row it is over, whether it would go inside that
    // row (over its middle) or before it; a drop just made (its release is not a click).
    property <int> drag-mark: -1;
    property <int> drop-row: -1;
    property <bool> drop-inside;
    property <bool> just-dropped;
    mark-menu := PopupWindow {
        x: root.width - 216px;
        y: root.mark-menu-y;
        width: 210px;
        height: 9 * 30px + 8px;
        Rectangle {
            background: Theme.input-bg;
            border-radius: Theme.radius-small;
            border-width: 1px;
            border-color: Theme.input-border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000033;
            VerticalLayout {
                padding: 4px;
                for item in [
                    { text: @tr("Move up"), op: 6 },
                    { text: @tr("Move down"), op: 7 },
                    { text: @tr("Indent"), op: 8 },
                    { text: @tr("Outdent"), op: 9 },
                    { text: @tr("Set destination to this view"), op: 5 },
                    // Acrobat's bookmark Appearance: style and colour.
                    { text: @tr("Bold"), op: 10 },
                    { text: @tr("Italic"), op: 11 },
                    { text: @tr("In the pen's colour"), op: 12 },
                    { text: @tr("In the usual colour"), op: 13 },
                ]: Rectangle {
                    height: 30px;
                    border-radius: Theme.radius-small;
                    background: mt.has-hover ? Theme.popup-hover : transparent;
                    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; x: 10px; text: item.text; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                    mt := TouchArea { clicked => { ReaderBridge.outline-op(root.id, root.mark-row, item.op, ""); root.focus-pages(); } }
                }
            }
        }
    }
}
