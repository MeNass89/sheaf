import { Theme } from "../theme.slint";
import { ToolOptions } from "../flow-types.slint";
import { TextField } from "../widgets/text-field.slint";
import { RadioCard, Segment, InfoBox } from "../widgets/radio-card.slint";

component SectionLabel inherits Text {
    font-size: Theme.fs-label;
    font-weight: Theme.weight-demibold;
    color: Theme.text;
}

// -/+ number picker (Split "every N pages").
component Stepper inherits HorizontalLayout {
    in-out property <int> value: 1;
    in property <int> minimum: 1;
    spacing: 8px;
    height: 32px;
    Segment {
        width: 32px;
        text: "−";
        clicked => { root.value = max(root.minimum, root.value - 1); }
    }
    Rectangle {
        width: 56px;
        border-radius: Theme.radius-button;
        border-width: 1px;
        border-color: Theme.option-border;
        Text {
            text: root.value;
            font-size: Theme.fs-label;
            color: Theme.text;
        }
    }
    Segment {
        width: 32px;
        text: "+";
        clicked => { root.value += 1; }
    }
}

// Square tick box with a label ("First page is cover page").
component Check inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    height: 24px;
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            border-radius: Theme.radius-small;
            border-width: root.checked ? 0 : 1.5px;
            border-color: Theme.option-border;
            background: root.checked ? Theme.success-strong : Theme.panel-bg;
            if root.checked: Image {
                width: 12px;
                height: 12px;
                source: @image-url("../icons/check.svg");
                colorize: Theme.on-success;
            }
        }
        Text {
            text: root.text;
            font-size: Theme.fs-label;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

// Position picker: a page outline with a 3×3 grid of small squares. `edges-only` hides the
// middle row (page numbers go at the top or bottom).
component PositionGrid inherits Rectangle {
    in-out property <int> selected: 7;
    in property <bool> edges-only;
    in property <bool> enabled: true;
    property <length> cell: 18px;
    width: 96px;
    height: 120px;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.option-border;
    background: Theme.panel-bg;
    opacity: root.enabled ? 1 : 0.4;
    for i in 9: Rectangle {
        x: 8px + mod(i, 3) * (root.width - 16px - root.cell) / 2;
        y: 8px + floor(i / 3) * (root.height - 16px - root.cell) / 2;
        width: root.cell;
        height: root.cell;
        visible: !root.edges-only || floor(i / 3) != 1;
        border-radius: Theme.radius-small;
        border-width: root.selected == i && root.enabled ? 0 : 1px;
        border-color: t.has-hover ? Theme.text-secondary : Theme.option-border;
        background: root.selected == i && root.enabled ? Theme.success-strong : Theme.input-bg;
        t := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.selected = i; }
        }
    }
}

// Two page fields side by side ("From page" / "To page").
component PageRange inherits HorizontalLayout {
    in-out property <string> from;
    in-out property <string> to;
    spacing: 10px;
    TextField { width: (parent.width - 10px) / 2; label: "From page"; placeholder: "1"; text <=> root.from; }
    TextField { width: (parent.width - 10px) / 2; label: "To page"; placeholder: "Last"; text <=> root.to; }
}

// Crop: page 1 with the kept area outlined and the cut margins dimmed.
component CropPreview inherits Rectangle {
    in property <image> source;
    in property <bool> ready;
    // Page size in points, and the margins in points.
    in property <float> page-w;
    in property <float> page-h;
    in property <float> top;
    in property <float> bottom;
    in property <float> left;
    in property <float> right;
    property <length> box: 200px;
    property <float> k: root.page-w > 0 && root.page-h > 0 ? min(root.box / 1px / root.page-w, root.box / 1px / root.page-h) : 0;
    property <length> pw: root.page-w * root.k * 1px;
    property <length> ph: root.page-h * root.k * 1px;
    property <length> px: (root.width - root.pw) / 2;
    property <length> py: (root.box - root.ph) / 2;
    property <length> t: clamp(root.top, 0, root.page-h) * root.k * 1px;
    property <length> b: clamp(root.bottom, 0, root.page-h) * root.k * 1px;
    property <length> l: clamp(root.left, 0, root.page-w) * root.k * 1px;
    property <length> r: clamp(root.right, 0, root.page-w) * root.k * 1px;
    height: root.box;
    background: Theme.filearea-bg;
    border-radius: Theme.radius-small;
    if !root.ready: Text {
        text: "Preview…";
        font-size: Theme.fs-caption;
        color: Theme.text-muted;
    }
    if root.ready: Rectangle {
        x: root.px;
        y: root.py;
        width: root.pw;
        height: root.ph;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: fill;
        }
        Rectangle { x: 0; y: 0; width: parent.width; height: root.t; background: Theme.scrim; }
        Rectangle { x: 0; y: parent.height - root.b; width: parent.width; height: root.b; background: Theme.scrim; }
        Rectangle { x: 0; y: root.t; width: root.l; height: max(0, parent.height - root.t - root.b); background: Theme.scrim; }
        Rectangle { x: parent.width - root.r; y: root.t; width: root.r; height: max(0, parent.height - root.t - root.b); background: Theme.scrim; }
        Rectangle {
            x: root.l;
            y: root.t;
            width: max(0, parent.width - root.l - root.r);
            height: max(0, parent.height - root.t - root.b);
            border-width: 2px;
            border-color: Theme.accent;
        }
    }
}

// The tool-specific options between the panel title and the action button.
// Holds its own state; `options` exposes it, `valid` says whether the action may run.
export component OptionsPanel inherits VerticalLayout {
    in property <string> tool;
    in property <int> file-count;
    in property <string> default-out;
    in property <bool> office-missing;
    // Crop preview: page 1 and its size in points.
    in property <image> preview;
    in property <bool> has-preview;
    in property <float> preview-w;
    in property <float> preview-h;
    out property <bool> valid: !root.office-missing && (
        root.tool == "protect" ? root.password != "" && root.password == root.confirm
        : root.tool == "remove_pages" || root.tool == "extract_pages" ? root.pages != ""
        : root.tool == "split" ? (root.split-mode == 0 ? root.ranges != "" : root.every >= 1)
        : root.tool == "page_numbers" ? (root.num-text != 3 || root.num-custom != "")
        : root.tool == "watermark" ? (root.wm-image-mode ? root.wm-image != "" : root.wm-text != "")
        : root.tool == "crop" ? (root.crop-mode == 2 || ((root.crop-mode == 0 || root.pages != "")
            && root.crop-top.to-float() + root.crop-bottom.to-float() + root.crop-left.to-float() + root.crop-right.to-float() > 0))
        : true);
    out property <ToolOptions> options: {
        level: root.level, password: root.password, confirm: root.confirm, owner: root.owner,
        pages: root.pages, split-mode: root.split-mode, ranges: root.ranges, every: root.every,
        degrees: root.degrees, layout: root.layout, margin: root.margin, quality: root.quality,
        out-name: root.out-name,
        from-page: root.from-page, to-page: root.to-page,
        num-position: root.num-position, num-double: root.num-double, num-cover: root.num-cover,
        num-margin: root.num-margin, num-start: root.num-start, num-text: root.num-text, num-custom: root.num-custom,
        wm-image-mode: root.wm-image-mode, wm-text: root.wm-text, wm-font-size: root.wm-font-size,
        wm-color: root.wm-color, wm-image: root.wm-image, wm-scale: root.wm-scale, wm-position: root.wm-position,
        wm-mosaic: root.wm-mosaic, wm-transparency: root.wm-transparency, wm-rotation: root.wm-rotation,
        wm-below: root.wm-below,
        crop-mode: root.crop-mode, crop-top: root.crop-top, crop-bottom: root.crop-bottom,
        crop-left: root.crop-left, crop-right: root.crop-right,
    };
    callback insert-blank();
    callback get-libreoffice();
    // Watermark: a picture file chosen in a dialog ("" when cancelled).
    callback pick-image() -> string;

    in-out property <int> level: 1;
    in-out property <string> password;
    in-out property <string> confirm;
    in-out property <string> owner;
    in-out property <string> pages;
    in-out property <int> split-mode: 0;
    in-out property <string> ranges;
    in-out property <int> every: 1;
    in-out property <int> degrees: 90;
    in-out property <int> layout: 0;
    in-out property <int> margin: 0;
    in-out property <int> quality: 0;
    in-out property <string> out-name;
    in-out property <string> from-page;
    in-out property <string> to-page;
    in-out property <int> num-position: 7;
    in-out property <bool> num-double;
    in-out property <bool> num-cover;
    in-out property <int> num-margin: 1;
    in-out property <string> num-start: "1";
    in-out property <int> num-text: 0;
    in-out property <string> num-custom;
    in-out property <bool> wm-image-mode;
    in-out property <string> wm-text;
    in-out property <string> wm-font-size: "48";
    in-out property <int> wm-color: 0;
    in-out property <string> wm-image;
    in-out property <int> wm-scale: 50;
    in-out property <int> wm-position: 4;
    in-out property <bool> wm-mosaic;
    in-out property <int> wm-transparency: 0;
    in-out property <int> wm-rotation: 0;
    in-out property <bool> wm-below;
    in-out property <int> crop-mode: 0;
    in-out property <string> crop-top: "10";
    in-out property <string> crop-bottom: "10";
    in-out property <string> crop-left: "10";
    in-out property <string> crop-right: "10";

    spacing: 10px;
    alignment: start;

    if root.tool == "merge": TextField {
        label: "Output file name";
        placeholder: root.default-out;
        text <=> root.out-name;
    }

    if root.tool == "split": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: "Split by range";
            description: "One file for each range you type";
            selected: root.split-mode == 0;
            clicked => { root.split-mode = 0; }
        }
        RadioCard {
            title: "Split every N pages";
            description: "Fixed-size chunks";
            selected: root.split-mode == 1;
            clicked => { root.split-mode = 1; }
        }
        Rectangle { height: 4px; }
        if root.split-mode == 0: TextField {
            label: "Ranges";
            placeholder: "1-3,5,8-10";
            text <=> root.ranges;
        }
        if root.split-mode == 1: VerticalLayout {
            spacing: 6px;
            SectionLabel { text: "Pages per file"; }
            Stepper { value <=> root.every; }
        }
    }

    if root.tool == "remove_pages" || root.tool == "extract_pages": VerticalLayout {
        spacing: 10px;
        TextField {
            label: root.tool == "remove_pages" ? "Pages to remove" : "Pages to extract";
            placeholder: "1-3,5";
            text <=> root.pages;
        }
        InfoBox { text: "Use commas and dashes: 2,4-6 means pages 2, 4, 5 and 6."; }
    }

    if root.tool == "organize": VerticalLayout {
        spacing: 10px;
        Segment {
            text: "Insert blank page";
            clicked => { root.insert-blank(); }
        }
        InfoBox { text: "Hover a page to move it with the arrows or drop it with ×. The blank page is added at the end."; }
    }

    if root.tool == "rotate": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Rotation (clockwise)"; }
        HorizontalLayout {
            spacing: 8px;
            Segment { text: "90°"; selected: root.degrees == 90; clicked => { root.degrees = 90; } }
            Segment { text: "180°"; selected: root.degrees == 180; clicked => { root.degrees = 180; } }
            Segment { text: "270°"; selected: root.degrees == 270; clicked => { root.degrees = 270; } }
        }
        Rectangle { height: 4px; }
        TextField {
            label: "Pages (optional)";
            placeholder: "All pages";
            text <=> root.pages;
        }
    }

    if root.tool == "compress": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: "Extreme compression";
            description: "Smallest file, softer images";
            selected: root.level == 0;
            clicked => { root.level = 0; }
        }
        RadioCard {
            title: "Recommended compression";
            description: "Small file, sharp enough to read";
            selected: root.level == 1;
            clicked => { root.level = 1; }
        }
        RadioCard {
            title: "Low compression";
            description: "Best image quality, modest saving";
            selected: root.level == 2;
            clicked => { root.level = 2; }
        }
        Rectangle { height: 4px; }
        InfoBox { text: "Recommended and Extreme recompress images; text and vector graphics are never touched."; }
    }

    if root.tool == "protect": VerticalLayout {
        spacing: 12px;
        TextField {
            label: "Password";
            password: true;
            placeholder: "Type a password";
            text <=> root.password;
        }
        TextField {
            label: "Repeat password";
            password: true;
            placeholder: "Type it again";
            text <=> root.confirm;
            error: root.confirm != "" && root.confirm != root.password ? "Passwords do not match" : "";
        }
        TextField {
            label: "Owner password (optional)";
            password: true;
            placeholder: "Same as the password";
            text <=> root.owner;
        }
    }

    if root.tool == "unlock": InfoBox {
        text: "Sheaf asks for each file's password when you add it. The copies are saved without one.";
    }

    if root.tool == "repair": InfoBox {
        text: "The file is rebuilt from what can still be read. Keep the original until you have checked the copy.";
    }

    if root.tool == "jpg_to_pdf": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Page size"; }
        RadioCard { title: "Fit to image"; selected: root.layout == 0; clicked => { root.layout = 0; } }
        RadioCard { title: "A4 portrait"; selected: root.layout == 1; clicked => { root.layout = 1; } }
        RadioCard { title: "A4 landscape"; selected: root.layout == 2; clicked => { root.layout = 2; } }
        if root.layout != 0: VerticalLayout {
            spacing: 10px;
            padding-top: 6px;
            SectionLabel { text: "Margin"; }
            HorizontalLayout {
                spacing: 8px;
                Segment { text: "None"; selected: root.margin == 0; clicked => { root.margin = 0; } }
                Segment { text: "Small"; selected: root.margin == 1; clicked => { root.margin = 1; } }
                Segment { text: "Big"; selected: root.margin == 2; clicked => { root.margin = 2; } }
            }
        }
    }

    if root.tool == "pdf_to_jpg": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: "Normal quality";
            description: "150 dpi, smaller images";
            selected: root.quality == 0;
            clicked => { root.quality = 0; }
        }
        RadioCard {
            title: "High quality";
            description: "300 dpi, for print";
            selected: root.quality == 1;
            clicked => { root.quality = 1; }
        }
    }

    if root.tool == "page_numbers": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Page mode"; }
        HorizontalLayout {
            spacing: 8px;
            Segment { text: "Single page"; selected: !root.num-double; clicked => { root.num-double = false; } }
            Segment { text: "Double-sided"; selected: root.num-double; clicked => { root.num-double = true; } }
        }
        Check { text: "First page is cover page"; checked <=> root.num-cover; }
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 6px;
                SectionLabel { text: "Position"; }
                PositionGrid { edges-only: true; selected <=> root.num-position; }
            }
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                SectionLabel { text: "Margin"; }
                Segment { text: "Small"; selected: root.num-margin == 0; clicked => { root.num-margin = 0; } }
                Segment { text: "Recommended"; selected: root.num-margin == 1; clicked => { root.num-margin = 1; } }
                Segment { text: "Big"; selected: root.num-margin == 2; clicked => { root.num-margin = 2; } }
            }
        }
        if root.file-count <= 1: PageRange { from <=> root.from-page; to <=> root.to-page; }
        if root.file-count > 1: InfoBox { text: "All pages will be numbered because multiple PDFs have been selected."; }
        TextField { label: "First number"; placeholder: "1"; text <=> root.num-start; }
        SectionLabel { text: "Text"; }
        RadioCard { title: "Insert page number only (recommended)"; selected: root.num-text == 0; clicked => { root.num-text = 0; } }
        RadioCard { title: "Page {n}"; selected: root.num-text == 1; clicked => { root.num-text = 1; } }
        RadioCard { title: "Page {n} of {p}"; selected: root.num-text == 2; clicked => { root.num-text = 2; } }
        RadioCard { title: "Custom"; selected: root.num-text == 3; clicked => { root.num-text = 3; } }
        if root.num-text == 3: TextField {
            placeholder: "Sheet {n} of {p}";
            text <=> root.num-custom;
        }
    }

    if root.tool == "watermark": VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Segment { text: "Place Text"; selected: !root.wm-image-mode; clicked => { root.wm-image-mode = false; } }
            Segment { text: "Place Image"; selected: root.wm-image-mode; clicked => { root.wm-image-mode = true; } }
        }
        if !root.wm-image-mode: VerticalLayout {
            spacing: 10px;
            TextField { label: "Text"; placeholder: "CONFIDENTIAL"; text <=> root.wm-text; }
            TextField { label: "Font size"; placeholder: "48"; text <=> root.wm-font-size; }
            SectionLabel { text: "Colour"; }
            HorizontalLayout {
                spacing: 6px;
                Segment { text: "Black"; selected: root.wm-color == 0; clicked => { root.wm-color = 0; } }
                Segment { text: "Grey"; selected: root.wm-color == 1; clicked => { root.wm-color = 1; } }
                Segment { text: "Red"; selected: root.wm-color == 2; clicked => { root.wm-color = 2; } }
                Segment { text: "Blue"; selected: root.wm-color == 3; clicked => { root.wm-color = 3; } }
            }
        }
        if root.wm-image-mode: VerticalLayout {
            spacing: 10px;
            Segment {
                text: root.wm-image == "" ? "Choose an image…" : "Change image…";
                clicked => {
                    let p = root.pick-image();
                    if p != "" { root.wm-image = p; }
                }
            }
            if root.wm-image != "": Text {
                text: root.wm-image;
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
            SectionLabel { text: "Size"; }
            HorizontalLayout {
                spacing: 6px;
                Segment { text: "25%"; selected: root.wm-scale == 25; clicked => { root.wm-scale = 25; } }
                Segment { text: "50%"; selected: root.wm-scale == 50; clicked => { root.wm-scale = 50; } }
                Segment { text: "75%"; selected: root.wm-scale == 75; clicked => { root.wm-scale = 75; } }
                Segment { text: "100%"; selected: root.wm-scale == 100; clicked => { root.wm-scale = 100; } }
            }
        }
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 6px;
                SectionLabel { text: "Position"; }
                PositionGrid { selected <=> root.wm-position; enabled: !root.wm-mosaic; }
            }
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                SectionLabel { text: "Layer"; }
                Segment { text: "Over the content"; selected: !root.wm-below; clicked => { root.wm-below = false; } }
                Segment { text: "Below the content"; selected: root.wm-below; clicked => { root.wm-below = true; } }
                Check { text: "Mosaic"; checked <=> root.wm-mosaic; }
            }
        }
        SectionLabel { text: "Transparency"; }
        HorizontalLayout {
            spacing: 6px;
            Segment { text: "No"; selected: root.wm-transparency == 0; clicked => { root.wm-transparency = 0; } }
            Segment { text: "25%"; selected: root.wm-transparency == 1; clicked => { root.wm-transparency = 1; } }
            Segment { text: "50%"; selected: root.wm-transparency == 2; clicked => { root.wm-transparency = 2; } }
            Segment { text: "75%"; selected: root.wm-transparency == 3; clicked => { root.wm-transparency = 3; } }
        }
        SectionLabel { text: "Rotate"; }
        HorizontalLayout {
            spacing: 6px;
            Segment { text: "None"; selected: root.wm-rotation == 0; clicked => { root.wm-rotation = 0; } }
            Segment { text: "45°"; selected: root.wm-rotation == 1; clicked => { root.wm-rotation = 1; } }
            Segment { text: "90°"; selected: root.wm-rotation == 2; clicked => { root.wm-rotation = 2; } }
        }
        HorizontalLayout {
            spacing: 6px;
            Segment { text: "180°"; selected: root.wm-rotation == 3; clicked => { root.wm-rotation = 3; } }
            Segment { text: "270°"; selected: root.wm-rotation == 4; clicked => { root.wm-rotation = 4; } }
            Segment { text: "−45°"; selected: root.wm-rotation == 5; clicked => { root.wm-rotation = 5; } }
        }
        if root.file-count <= 1: PageRange { from <=> root.from-page; to <=> root.to-page; }
        if root.file-count > 1: InfoBox { text: "All pages will be stamped because multiple PDFs have been selected."; }
    }

    if root.tool == "crop": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Apply to:"; }
        RadioCard { title: "All pages"; description: "Apply the same crop to every page"; selected: root.crop-mode == 0; clicked => { root.crop-mode = 0; } }
        RadioCard { title: "Selected pages"; description: "Choose which pages to crop"; selected: root.crop-mode == 1; clicked => { root.crop-mode = 1; } }
        RadioCard { title: "Remove crop"; description: "Show the full pages again"; selected: root.crop-mode == 2; clicked => { root.crop-mode = 2; } }
        if root.crop-mode == 1: TextField { label: "Pages"; placeholder: "1-3,5"; text <=> root.pages; }
        if root.crop-mode != 2: VerticalLayout {
            spacing: 10px;
            SectionLabel { text: "Margins to cut (mm)"; }
            HorizontalLayout {
                spacing: 10px;
                TextField { width: (parent.width - 10px) / 2; label: "Top"; placeholder: "0"; text <=> root.crop-top; }
                TextField { width: (parent.width - 10px) / 2; label: "Bottom"; placeholder: "0"; text <=> root.crop-bottom; }
            }
            HorizontalLayout {
                spacing: 10px;
                TextField { width: (parent.width - 10px) / 2; label: "Left"; placeholder: "0"; text <=> root.crop-left; }
                TextField { width: (parent.width - 10px) / 2; label: "Right"; placeholder: "0"; text <=> root.crop-right; }
            }
            CropPreview {
                source: root.preview;
                ready: root.has-preview;
                page-w: root.preview-w;
                page-h: root.preview-h;
                top: root.crop-top.to-float() * 72 / 25.4;
                bottom: root.crop-bottom.to-float() * 72 / 25.4;
                left: root.crop-left.to-float() * 72 / 25.4;
                right: root.crop-right.to-float() * 72 / 25.4;
            }
        }
    }

    if !root.office-missing && (root.tool == "word_to_pdf" || root.tool == "powerpoint_to_pdf"
            || root.tool == "excel_to_pdf" || root.tool == "html_to_pdf"): InfoBox {
        text: "Converted with LibreOffice on this Mac. Nothing is uploaded.";
    }

    if root.office-missing: VerticalLayout {
        spacing: 10px;
        InfoBox {
            icon: @image-url("../icons/triangle-alert.svg");
            text: "Install LibreOffice to enable this tool. Sheaf uses it to read Office and HTML files.";
        }
        Segment {
            text: "Get LibreOffice";
            clicked => { root.get-libreoffice(); }
        }
    }

    public function reset() {
        root.password = "";
        root.confirm = "";
        root.owner = "";
        root.pages = "";
        root.ranges = "";
        root.out-name = "";
        root.from-page = "";
        root.to-page = "";
    }
}
