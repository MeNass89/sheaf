import { Theme } from "../theme.slint";
import { ToolOptions, Parse, OcrInfo, SignBridge, Picked } from "../flow-types.slint";
import { TextField } from "../widgets/text-field.slint";
import { Check } from "../widgets/check.slint";
import { RadioCard, Segment, InfoBox } from "../widgets/radio-card.slint";
import { SectionLabel, Stepper, PositionGrid, PageRange, CropPreview, FontRow, ColourRow } from "options-parts.slint";

// Holds its own state; `options` exposes it, `valid` says whether the action may run.
export component OptionsPanel inherits VerticalLayout {
    in property <string> tool;
    in property <int> file-count;
    // A file looks scanned (PDF to Office suggests OCR).
    in property <bool> any-scanned;
    in property <bool> any-locked;
    in property <string> default-out;
    in property <bool> office-missing;
    // Crop preview: page 1 and its size in points.
    in property <image> preview;
    in property <bool> has-preview;
    in property <float> preview-w;
    in property <float> preview-h;
    out property <bool> valid: !root.office-missing && (
        root.tool == "protect" ? (root.require-open ? root.password != "" && root.password == root.confirm : root.owner != "")
        : root.tool == "remove_pages" ? root.pages != "" || root.remove-blank
        : root.tool == "extract_pages" ? root.pages != ""
        : root.tool == "split" ? (root.split-mode == 0 ? root.ranges != "" && root.split-files >= 0 : root.split-mode == 3 ? root.split-size.is-float() && root.split-size.to-float() > 0 : root.split-mode == 2 || root.every >= 1)
        : root.tool == "page_numbers" ? (root.num-text != 3 || (root.num-custom != "" && Parse.custom-text-error(root.num-custom) == "")) && Parse.colour-error(root.num-hex) == ""
            && (root.num-text != 4 || root.hf-tl != "" || root.hf-tc != "" || root.hf-tr != "" || root.hf-bl != "" || root.hf-bc != "" || root.hf-br != "")
        : root.tool == "watermark" ? (root.wm-remove || (root.wm-image-mode ? root.wm-image != "" : root.wm-text != "" && Parse.colour-error(root.wm-hex) == ""))
        : root.tool == "ocr" ? OcrInfo.available && root.ocr-languages != ","
        : root.tool == "pdf_to_word" || root.tool == "pdf_to_powerpoint" || root.tool == "pdf_to_excel" || root.tool == "pdf_to_text" ? !root.export-ocr || OcrInfo.available
        : root.tool == "crop" ? (root.crop-mode >= 2 || ((root.crop-mode == 0 || root.pages != "")
            && Parse.mm(root.crop-top) + Parse.mm(root.crop-bottom) + Parse.mm(root.crop-left) + Parse.mm(root.crop-right) > 0))
        : root.tool == "sign" ? !root.sign-cert || root.sign-p12 != ""
        : root.tool == "merge" ? Parse.file-name-error(root.out-name) == ""
        : true);
    // Add watermark: the preview follows every option and the file.
    changed options => { if root.tool == "watermark" { Picked.preview-watermark(root.tab-id, root.options); } }
    changed file-count => { if root.tool == "watermark" { Picked.preview-watermark(root.tab-id, root.options); } }
    init => {
        if root.has-restore { root.restore-options(root.restore); }
        if root.tool == "watermark" { Picked.preview-watermark(root.tab-id, root.options); }
    }
    // Run again (Home ▸ History): the options of the task as it ran, passwords left out
    // (saved_options.rs); they start the panel instead of the defaults.
    in property <ToolOptions> restore;
    in property <bool> has-restore;
    function restore-options(o: ToolOptions) {
        root.level = o.level;
        root.allow-printing = o.allow-printing;
        root.allow-copying = o.allow-copying;
        root.allow-editing = o.allow-editing;
        root.allow-commenting = o.allow-commenting;
        root.allow-filling-forms = o.allow-filling-forms;
        root.pages = o.pages;
        root.remove-blank = o.remove-blank;
        root.blank-level = o.blank-level;
        root.rotate-parity = o.rotate-parity;
        root.protect-sanitize = o.protect-sanitize;
        root.compare-old-pages = o.compare-old-pages;
        root.compare-new-pages = o.compare-new-pages;
        root.rotate-orientation = o.rotate-orientation;
        root.split-mode = o.split-mode;
        root.ranges = o.ranges;
        root.every = o.every;
        root.split-one-file = o.split-one-file;
        root.split-size = o.split-size;
        root.degrees = o.degrees;
        root.layout = o.layout;
        root.landscape = o.landscape;
        root.merge-images = !o.one-per-image;
        root.margin = o.margin;
        root.quality = o.quality;
        root.png = o.png;
        root.extract-images = o.extract-images;
        root.out-name = o.out-name;
        root.from-page = o.from-page;
        root.to-page = o.to-page;
        root.num-position = o.num-position;
        root.num-double = o.num-double;
        root.num-cover = o.num-cover;
        root.num-margin = o.num-margin;
        root.num-start = o.num-start;
        root.num-text = o.num-text;
        root.num-custom = o.num-custom;
        root.num-font-size = o.num-font-size;
        root.num-color = o.num-color;
        root.num-family = o.num-family;
        root.num-bold = o.num-bold;
        root.num-italic = o.num-italic;
        root.num-underline = o.num-underline;
        root.num-hex = o.num-hex;
        root.hf-tl = o.hf-tl;
        root.hf-tc = o.hf-tc;
        root.hf-tr = o.hf-tr;
        root.hf-bl = o.hf-bl;
        root.hf-bc = o.hf-bc;
        root.hf-br = o.hf-br;
        root.bates-prefix = o.bates-prefix;
        root.bates-digits = o.bates-digits;
        root.bates-start = o.bates-start;
        root.hf-replace = o.hf-replace;
        root.wm-image-mode = o.wm-image-mode;
        root.wm-text = o.wm-text;
        root.wm-font-size = o.wm-font-size;
        root.wm-color = o.wm-color;
        root.wm-family = o.wm-family;
        root.wm-bold = o.wm-bold;
        root.wm-italic = o.wm-italic;
        root.wm-underline = o.wm-underline;
        root.wm-hex = o.wm-hex;
        root.wm-image = o.wm-image;
        root.wm-scale = o.wm-scale;
        root.wm-position = o.wm-position;
        root.wm-mosaic = o.wm-mosaic;
        root.wm-transparency = o.wm-transparency;
        root.wm-rotation = o.wm-rotation;
        root.wm-below = o.wm-below;
        root.wm-replace = o.wm-replace;
        root.wm-remove = o.wm-remove;
        root.crop-mode = o.crop-mode;
        root.crop-top = o.crop-top;
        root.crop-bottom = o.crop-bottom;
        root.crop-left = o.crop-left;
        root.crop-right = o.crop-right;
        root.pdfa-level = o.pdfa-level;
        root.ocr-languages = o.ocr-languages;
        root.ocr-all-pages = o.ocr-all-pages;
        root.export-ocr = o.export-ocr;
        root.export-exact = o.export-exact;
        root.excel-layout = o.excel-layout;
        root.text-format = o.text-format;
        root.compare-mode = o.compare-mode;
        root.sign-cert = o.sign-cert;
        root.sign-p12 = o.sign-p12;
        root.sign-reason = o.sign-reason;
        root.sign-location = o.sign-location;
    }
    out property <ToolOptions> options: {
        level: root.level, password: root.require-open ? root.password : "", confirm: root.confirm, owner: root.owner,
        allow-printing: root.allow-printing, allow-copying: root.allow-copying,
        allow-editing: root.allow-editing, allow-commenting: root.allow-commenting,
        allow-filling-forms: root.allow-filling-forms,
        pages: root.pages, remove-blank: root.remove-blank, blank-level: root.blank-level, rotate-parity: root.rotate-parity, rotate-orientation: root.rotate-orientation, protect-sanitize: root.protect-sanitize, compare-old-pages: root.compare-old-pages, compare-new-pages: root.compare-new-pages, split-mode: root.split-mode, ranges: root.ranges, every: root.every, split-one-file: root.split-one-file, split-size: root.split-size,
        degrees: root.degrees, layout: root.layout, landscape: root.landscape, one-per-image: !root.merge-images, margin: root.margin, quality: root.quality, png: root.png, extract-images: root.extract-images,
        out-name: root.out-name,
        from-page: root.from-page, to-page: root.to-page,
        num-position: root.num-position, num-double: root.num-double, num-cover: root.num-cover,
        num-margin: root.num-margin, num-start: root.num-start, num-text: root.num-text, num-custom: root.num-custom,
        num-font-size: root.num-font-size, num-color: root.num-color,
        num-family: root.num-family, num-bold: root.num-bold, num-italic: root.num-italic, num-underline: root.num-underline, num-hex: root.num-hex,
        hf-tl: root.hf-tl, hf-tc: root.hf-tc, hf-tr: root.hf-tr, hf-bl: root.hf-bl, hf-bc: root.hf-bc, hf-br: root.hf-br,
        bates-prefix: root.bates-prefix, bates-digits: root.bates-digits, bates-start: root.bates-start, hf-replace: root.hf-replace,
        wm-family: root.wm-family, wm-bold: root.wm-bold, wm-italic: root.wm-italic, wm-underline: root.wm-underline, wm-hex: root.wm-hex,
        wm-image-mode: root.wm-image-mode, wm-text: root.wm-text, wm-font-size: root.wm-font-size,
        wm-color: root.wm-color, wm-image: root.wm-image, wm-scale: root.wm-scale, wm-position: root.wm-position,
        wm-mosaic: root.wm-mosaic, wm-transparency: root.wm-transparency, wm-rotation: root.wm-rotation,
        wm-below: root.wm-below, wm-replace: root.wm-replace, wm-remove: root.wm-remove,
        crop-mode: root.crop-mode, crop-top: root.crop-top, crop-bottom: root.crop-bottom,
        crop-left: root.crop-left, crop-right: root.crop-right,
        pdfa-level: root.pdfa-level,
        ocr-languages: root.ocr-languages, ocr-all-pages: root.ocr-all-pages,
        export-ocr: root.export-ocr, export-exact: root.export-exact, excel-layout: root.excel-layout, text-format: root.text-format,
        compare-mode: root.compare-mode,
        sign-cert: root.sign-cert, sign-p12: root.sign-p12, sign-p12-password: root.sign-p12-password,
        sign-reason: root.sign-reason, sign-location: root.sign-location,
    };
    callback insert-blank();
    // Merge: its pages shown one by one (see above).
    in property <bool> merge-pages;
    callback show-pages(bool);
    callback get-libreoffice();
    // Watermark: a picture file chosen in a dialog ("" when cancelled).
    in property <int> tab-id;
    property <int> watermark-seq: Picked.watermark-seq;
    property <int> p12-seq: Picked.p12-seq;
    changed watermark-seq => { if Picked.tab == root.tab-id { root.wm-image = Picked.watermark; } }
    changed p12-seq => { if Picked.tab == root.tab-id { root.sign-p12 = Picked.p12; } }

    in-out property <bool> sign-cert;
    in-out property <string> sign-p12;
    in-out property <string> sign-p12-password;
    in-out property <string> sign-reason;
    in-out property <string> sign-location;
    in-out property <int> level: 1;
    in-out property <string> password;
    in-out property <string> confirm;
    in-out property <string> owner;
    // Protect: an open password asked (off: only the permissions password restricts the file).
    in-out property <bool> require-open: true;
    in-out property <bool> allow-printing: true;
    in-out property <bool> allow-copying: true;
    in-out property <bool> allow-editing: true;
    in-out property <bool> allow-commenting: true;
    in-out property <bool> allow-filling-forms: true;
    in-out property <string> pages;
    in-out property <bool> remove-blank;
    in-out property <int> blank-level: 1;
    in-out property <int> rotate-parity: 0;
    in-out property <bool> protect-sanitize;
    in-out property <string> compare-old-pages;
    in-out property <string> compare-new-pages;
    in-out property <int> rotate-orientation: 0;
    in-out property <int> split-mode: 0;
    in-out property <string> split-size;
    in-out property <string> ranges;
    in-out property <int> every: 1;
    in-out property <bool> split-one-file;
    // Split: the document's page count (0 until read), for the summary of what will be made.
    in property <int> page-count;
    property <int> split-files: root.page-count > 0 ? Parse.split-count(root.ranges, root.page-count) : 0;
    in-out property <int> degrees: 90;
    in-out property <int> layout: 0;
    in-out property <bool> landscape: false;
    in-out property <bool> merge-images: true;
    in-out property <int> margin: 0;
    in-out property <int> quality: 0;
    in-out property <bool> png;
    in-out property <bool> extract-images;
    in-out property <string> out-name;
    in-out property <string> from-page;
    in-out property <string> to-page;
    in-out property <int> num-position: 7;
    in-out property <bool> num-double;
    in-out property <bool> num-cover;
    in-out property <int> num-margin: 1;
    in-out property <string> num-start: "1";
    in-out property <int> num-text: 0;
    in-out property <string> num-custom;
    in-out property <string> num-font-size;
    in-out property <int> num-color: 0;
    in-out property <int> num-family: 0;
    in-out property <bool> num-bold;
    in-out property <bool> num-italic;
    in-out property <bool> num-underline;
    in-out property <string> num-hex;
    in-out property <string> hf-tl;
    in-out property <string> hf-tc;
    in-out property <string> hf-tr;
    in-out property <string> hf-bl;
    in-out property <string> hf-bc;
    in-out property <string> hf-br;
    in-out property <string> bates-prefix;
    in-out property <int> bates-digits: 6;
    in-out property <string> bates-start;
    in-out property <bool> hf-replace;
    in-out property <bool> wm-image-mode;
    in-out property <string> wm-text;
    in-out property <string> wm-font-size;
    in-out property <int> wm-color: 0;
    in-out property <int> wm-family: 0;
    in-out property <bool> wm-bold;
    in-out property <bool> wm-italic;
    in-out property <bool> wm-underline;
    in-out property <string> wm-hex;
    in-out property <string> wm-image;
    in-out property <int> wm-scale: 50;
    in-out property <int> wm-position: 4;
    in-out property <bool> wm-mosaic;
    in-out property <int> wm-transparency: 0;
    in-out property <int> wm-rotation: 0;
    in-out property <bool> wm-below;
    in-out property <bool> wm-replace;
    in-out property <bool> wm-remove;
    in-out property <int> crop-mode: 0;
    in-out property <string> crop-top: "10";
    in-out property <string> crop-bottom: "10";
    in-out property <string> crop-left: "10";
    in-out property <string> crop-right: "10";
    in-out property <int> pdfa-level: 0;
    in-out property <string> ocr-languages: "," + OcrInfo.default-language + ",";
    in-out property <bool> ocr-all-pages;
    in-out property <bool> export-ocr;
    in-out property <bool> export-exact;
    in-out property <int> excel-layout: 0;
    in-out property <int> text-format: 0;
    in-out property <int> compare-mode: 0;

    spacing: 10px;
    alignment: start;

    if root.tool == "merge": TextField {
        label: "Output file name";
        placeholder: root.default-out;
        text <=> root.out-name;
        error: Parse.file-name-error(root.out-name);
    }
    // Merge: the files as cards, or opened out into their pages to put in any order (Acrobat's
    // Combine Files ▸ Expand all).
    if root.tool == "merge" && root.file-count > 0: HorizontalLayout {
        spacing: 8px;
        Segment { width: 100px; text: "Files"; selected: !root.merge-pages; clicked => { root.show-pages(false); } }
        Segment { width: 100px; text: "Pages"; selected: root.merge-pages; clicked => { root.show-pages(true); } }
    }
    if root.tool == "merge" && root.merge-pages: InfoBox { text: "Every page of every file, in the order they will be merged: hover a page to move it with the arrows or drop it with ×."; }

    if root.tool == "split": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: "Split by range";
            description: "One file for each range you type";
            selected: root.split-mode == 0;
            clicked => { root.split-mode = 0; }
        }
        RadioCard {
            title: "Split every N pages";
            description: "Fixed-size chunks";
            selected: root.split-mode == 1;
            clicked => { root.split-mode = 1; }
        }
        // Acrobat's other two ways.
        RadioCard {
            title: "Split by bookmarks";
            description: "One file per top-level bookmark, named after it";
            selected: root.split-mode == 2;
            clicked => { root.split-mode = 2; }
        }
        RadioCard {
            title: "Split by file size";
            description: "Files no larger than the size you type";
            selected: root.split-mode == 3;
            clicked => { root.split-mode = 3; }
        }
        Rectangle { height: 4px; }
        if root.split-mode == 0: TextField {
            label: "Ranges";
            placeholder: "1-3,5,8-10";
            text <=> root.ranges;
            error: root.ranges != "" && root.split-files < 0 ? "Pages run from 1 to \{root.page-count}" : "";
        }
        if root.split-mode == 0 && root.page-count > 0: InfoBox {
            text: root.ranges == "" ? "Click between pages on the left to cut there, or type ranges."
                : root.split-files < 0 ? "Click between pages on the left to cut there."
                : root.split-one-file ? "One PDF with these \{root.split-files} ranges in order."
                : root.split-files == 1 ? "1 PDF will be created." : "\{root.split-files} PDFs will be created.";
        }
        if root.split-mode == 0: Check { text: "Merge all ranges into one PDF file"; checked <=> root.split-one-file; }
        if root.split-mode == 1: VerticalLayout {
            spacing: 6px;
            SectionLabel { text: "Pages per file"; }
            Stepper { value <=> root.every; }
        }
        if root.split-mode == 3: TextField {
            label: "Largest file (MB)";
            placeholder: "2";
            text <=> root.split-size;
            error: root.split-size != "" && !(root.split-size.is-float() && root.split-size.to-float() > 0) ? "Type megabytes, such as 2 or 1.5" : "";
        }
        if root.split-mode == 1 && root.page-count > 0: InfoBox {
            text: "\{ceil(root.page-count / max(1, root.every))} PDFs of \{root.every} pages will be created.";
        }
    }

    if root.tool == "remove_pages" || root.tool == "extract_pages": VerticalLayout {
        spacing: 10px;
        // Acrobat's Remove Blank Pages: no text and nothing drawn but specks.
        if root.tool == "remove_pages": Check { text: "The blank pages (found for you)"; checked <=> root.remove-blank; }
        // How blank (Stirling's threshold): a scan's grey paper needs the lenient step.
        if root.tool == "remove_pages" && root.remove-blank: HorizontalLayout {
            spacing: 8px;
            for label[i] in ["Strict", "Normal", "Scans"]: Segment {
                width: 96px;
                text: label;
                selected: root.blank-level == i;
                clicked => { root.blank-level = i; }
            }
        }
        if !(root.tool == "remove_pages" && root.remove-blank): TextField {
            label: root.tool == "remove_pages" ? "Pages to remove" : "Pages to extract";
            placeholder: "1-3,5";
            text <=> root.pages;
        }
        InfoBox { text: "Use commas and dashes: 2,4-6 means pages 2, 4, 5 and 6."; }
    }

    if root.tool == "organize": VerticalLayout {
        spacing: 10px;
        Segment {
            text: "Insert blank page";
            clicked => { root.insert-blank(); }
        }
        InfoBox { text: "Hover a page to move it with the arrows or drop it with ×. The blank page is added at the end."; }
    }

    if root.tool == "rotate": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Rotation"; }
        // Acrobat's directions; the files' cards show page 1 turned as chosen.
        HorizontalLayout {
            spacing: 8px;
            Segment { text: "Left 90°"; selected: root.degrees == 270; clicked => { root.degrees = 270; } }
            Segment { text: "Right 90°"; selected: root.degrees == 90; clicked => { root.degrees = 90; } }
            Segment { text: "180°"; selected: root.degrees == 180; clicked => { root.degrees = 180; } }
        }
        Rectangle { height: 4px; }
        TextField {
            label: "Pages (optional)";
            placeholder: "All pages";
            text <=> root.pages;
        }
        // Acrobat's Rotate Pages: of those, the even or odd ones, the portrait or landscape ones.
        HorizontalLayout {
            spacing: 8px;
            for label[i] in ["Even and odd", "Odd only", "Even only"]: Segment { width: 116px; text: label; selected: root.rotate-parity == i; clicked => { root.rotate-parity = i; } }
        }
        HorizontalLayout {
            spacing: 8px;
            for label[i] in ["Any orientation", "Portrait", "Landscape"]: Segment { width: 116px; text: label; selected: root.rotate-orientation == i; clicked => { root.rotate-orientation = i; } }
        }
    }

    if root.tool == "compress": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: "Extreme compression";
            description: "Smallest file, softer images";
            selected: root.level == 0;
            clicked => { root.level = 0; }
        }
        RadioCard {
            title: "Recommended compression";
            description: "Small file, sharp enough to read";
            selected: root.level == 1;
            clicked => { root.level = 1; }
        }
        RadioCard {
            title: "Low compression";
            description: "Best image quality, modest saving";
            selected: root.level == 2;
            clicked => { root.level = 2; }
        }
        Rectangle { height: 4px; }
        InfoBox { text: "Recommended and Extreme recompress images; text and vector graphics are never touched."; }
    }

    if root.tool == "protect": VerticalLayout {
        spacing: 12px;
        // A file opened with its password: Protect is Acrobat's Change Password.
        if root.any-locked: InfoBox { text: "This PDF already has a password: the new ones replace it."; }
        Check { text: "Require a password to open"; checked <=> root.require-open; }
        if root.require-open: TextField {
            label: "Password";
            password: true;
            allow-reveal: true;
            placeholder: "Type a password";
            text <=> root.password;
        }
        if root.require-open && root.password != "": meter := VerticalLayout {
            spacing: 4px;
            property <int> strength: Parse.password-strength(root.password);
            HorizontalLayout {
                spacing: 4px;
                for i in 3: Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: i > meter.strength ? Theme.progress-track
                        : meter.strength == 0 ? Theme.danger
                        : meter.strength == 1 ? Theme.warning : Theme.success-strong;
                }
            }
            Text {
                text: meter.strength == 0 ? "Weak" : meter.strength == 1 ? "Fair" : "Strong";
                font-size: Theme.fs-caption;
                color: Theme.text-secondary;
            }
        }
        if root.require-open: TextField {
            label: "Repeat password";
            password: true;
            allow-reveal: true;
            placeholder: "Type it again";
            text <=> root.confirm;
            error: root.confirm != "" && root.confirm != root.password ? "Passwords do not match" : "";
        }
        TextField {
            label: root.require-open ? "Permissions password (optional)" : "Permissions password";
            password: true;
            allow-reveal: true;
            placeholder: "Needed to lift the restrictions";
            text <=> root.owner;
        }
        SectionLabel { text: "Allow"; }
        Check { text: "Printing"; checked <=> root.allow-printing; }
        Check { text: "Copying text and images"; checked <=> root.allow-copying; }
        Check { text: "Editing"; checked <=> root.allow-editing; }
        Check { text: "Commenting"; checked <=> root.allow-commenting; }
        Check { text: "Filling forms"; checked <=> root.allow-filling-forms; }
        // Acrobat's Protect ▸ Sanitize Document, in the same panel.
        SectionLabel { text: "Hidden information"; }
        Check { text: "Remove it first: metadata, scripts, attachments, links, hidden text, layers"; checked <=> root.protect-sanitize; }
    }

    if root.tool == "unlock": InfoBox {
        text: "Sheaf asks for each file's password when you add it. The copies are saved without one.";
    }

    if root.tool == "repair": InfoBox {
        text: "The file is rebuilt from what can still be read. Keep the original until you have checked the copy.";
    }

    if root.tool == "jpg_to_pdf": VerticalLayout {
        spacing: 10px;
        // iLovePDF's options: page size, orientation (for paper), margin, one PDF or one each.
        SectionLabel { text: "Page size"; }
        RadioCard { title: "Fit"; description: "Same page size as image"; selected: root.layout == 0; clicked => { root.layout = 0; } }
        RadioCard { title: "A4"; description: "210 × 297 mm"; selected: root.layout == 1; clicked => { root.layout = 1; } }
        RadioCard { title: "US Letter"; description: "8.5 × 11 in"; selected: root.layout == 2; clicked => { root.layout = 2; } }
        if root.layout != 0: VerticalLayout {
            spacing: 10px;
            padding-top: 6px;
            SectionLabel { text: "Orientation"; }
            HorizontalLayout {
                spacing: 8px;
                Segment { text: "Portrait"; selected: !root.landscape; clicked => { root.landscape = false; } }
                Segment { text: "Landscape"; selected: root.landscape; clicked => { root.landscape = true; } }
            }
            SectionLabel { text: "Margin"; }
            HorizontalLayout {
                spacing: 8px;
                Segment { text: "None"; selected: root.margin == 0; clicked => { root.margin = 0; } }
                Segment { text: "Small"; selected: root.margin == 1; clicked => { root.margin = 1; } }
                Segment { text: "Big"; selected: root.margin == 2; clicked => { root.margin = 2; } }
            }
        }
        if root.file-count > 1: VerticalLayout {
            padding-top: 6px;
            Check { text: "Merge all images into one PDF file"; checked <=> root.merge-images; }
        }
    }

    if root.tool == "pdf_to_jpg": VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Segment { text: "Page to image"; selected: !root.extract-images; clicked => { root.extract-images = false; } }
            Segment { text: "Extract images"; selected: root.extract-images; clicked => { root.extract-images = true; } }
        }
        if root.extract-images: InfoBox { text: "Every picture placed in the pages is saved as stored, each once."; }
        if !root.extract-images: VerticalLayout {
            spacing: 10px;
            RadioCard {
                title: "Normal quality";
                description: "150 dpi, smaller images";
                selected: root.quality == 0;
                clicked => { root.quality = 0; }
            }
            RadioCard {
                title: "High quality";
                description: "300 dpi, for print";
                selected: root.quality == 1;
                clicked => { root.quality = 1; }
            }
            RadioCard {
                title: "Very high quality";
                description: "600 dpi, for enlargements";
                selected: root.quality == 2;
                clicked => { root.quality = 2; }
            }
        }
        SectionLabel { text: "Format"; }
        HorizontalLayout {
            spacing: 8px;
            Segment { text: "JPG"; selected: !root.png; clicked => { root.png = false; } }
            Segment { text: "PNG (lossless)"; selected: root.png; clicked => { root.png = true; } }
        }
    }

    if root.tool == "page_numbers": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Page mode"; }
        HorizontalLayout {
            spacing: 8px;
            Segment { text: "Single page"; selected: !root.num-double; clicked => { root.num-double = false; } }
            Segment { text: "Double-sided"; selected: root.num-double; clicked => { root.num-double = true; } }
        }
        Check { text: "First page is cover page"; checked <=> root.num-cover; }
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 6px;
                SectionLabel { text: "Position"; }
                PositionGrid { edges-only: true; selected <=> root.num-position; }
            }
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                SectionLabel { text: "Margin"; }
                Segment { text: "Small"; selected: root.num-margin == 0; clicked => { root.num-margin = 0; } }
                Segment { text: "Recommended"; selected: root.num-margin == 1; clicked => { root.num-margin = 1; } }
                Segment { text: "Big"; selected: root.num-margin == 2; clicked => { root.num-margin = 2; } }
            }
        }
        if root.file-count <= 1: PageRange { from <=> root.from-page; to <=> root.to-page; }
        if root.file-count > 1: InfoBox { text: "All pages will be numbered because multiple PDFs have been selected."; }
        TextField { label: "First number"; placeholder: "1"; text <=> root.num-start; }
        SectionLabel { text: "Text"; }
        RadioCard { title: "Insert page number only (recommended)"; selected: root.num-text == 0; clicked => { root.num-text = 0; } }
        RadioCard { title: "Page {n}"; selected: root.num-text == 1; clicked => { root.num-text = 1; } }
        RadioCard { title: "Page {n} of {p}"; selected: root.num-text == 2; clicked => { root.num-text = 2; } }
        RadioCard { title: "Custom"; selected: root.num-text == 3; clicked => { root.num-text = 3; } }
        RadioCard { title: "No page number (header and footer text only)"; selected: root.num-text == 4; clicked => { root.num-text = 4; } }
        if root.num-text == 3: TextField {
            placeholder: "Sheet {n} of {p}";
            text <=> root.num-custom;
            error: Parse.custom-text-error(root.num-custom);
        }
        if root.num-text == 3: InfoBox { text: "{n} is the page number; {p} is the document's total page count."; }
        // How the numbers look (Acrobat's and Stirling's font, size and colour).
        FontRow {
            family <=> root.num-family; bold <=> root.num-bold; italic <=> root.num-italic; underline <=> root.num-underline;
            size <=> root.num-font-size; size-placeholder: "Size: 12";
        }
        ColourRow { colour <=> root.num-color; hex <=> root.num-hex; }
        // Acrobat's Header & Footer: text in any of the six places, Bates numbers among it.
        SectionLabel { text: "Header and footer"; }
        HorizontalLayout {
            spacing: 6px;
            Text { width: 48px; text: "Top"; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            TextField { placeholder: "Left"; text <=> root.hf-tl; error: Parse.custom-text-error(root.hf-tl); }
            TextField { placeholder: "Centre"; text <=> root.hf-tc; error: Parse.custom-text-error(root.hf-tc); }
            TextField { placeholder: "Right"; text <=> root.hf-tr; error: Parse.custom-text-error(root.hf-tr); }
        }
        HorizontalLayout {
            spacing: 6px;
            Text { width: 48px; text: "Bottom"; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            TextField { placeholder: "Left"; text <=> root.hf-bl; error: Parse.custom-text-error(root.hf-bl); }
            TextField { placeholder: "Centre"; text <=> root.hf-bc; error: Parse.custom-text-error(root.hf-bc); }
            TextField { placeholder: "Right"; text <=> root.hf-br; error: Parse.custom-text-error(root.hf-br); }
        }
        InfoBox { text: "{n} page number, {p} page count, {date} today, {bates} the Bates number below."; }
        HorizontalLayout {
            spacing: 6px;
            TextField { label: "Bates prefix"; placeholder: "ACME-"; text <=> root.bates-prefix; }
            TextField { label: "From"; placeholder: "1"; text <=> root.bates-start; }
            VerticalLayout {
                spacing: 4px;
                SectionLabel { text: "Digits"; }
                Stepper { value <=> root.bates-digits; minimum: 3; }
            }
        }
        Check { text: "Replace the headers and footers already in the file"; checked <=> root.hf-replace; }
    }

    if root.tool == "watermark": VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Segment { text: "Place Text"; selected: !root.wm-remove && !root.wm-image-mode; clicked => { root.wm-image-mode = false; root.wm-remove = false; } }
            Segment { text: "Place Image"; selected: !root.wm-remove && root.wm-image-mode; clicked => { root.wm-image-mode = true; root.wm-remove = false; } }
            Segment { text: "Remove"; selected: root.wm-remove; clicked => { root.wm-remove = true; } }
        }
        if root.wm-remove: InfoBox {
            text: "Takes out the watermarks Sheaf, Acrobat and other PDF editors placed. The page's own text and images stay.";
        }
        if !root.wm-remove: VerticalLayout {
            spacing: 10px;
            if !root.wm-image-mode: VerticalLayout {
                spacing: 10px;
                TextField { label: "Text"; placeholder: "CONFIDENTIAL"; text <=> root.wm-text; }
                FontRow {
                    family <=> root.wm-family; bold <=> root.wm-bold; italic <=> root.wm-italic; underline <=> root.wm-underline;
                    size <=> root.wm-font-size; size-placeholder: "Size: 48";
                }
                ColourRow { colour <=> root.wm-color; hex <=> root.wm-hex; }
            }
            if root.wm-image-mode: VerticalLayout {
                spacing: 10px;
                Segment {
                    text: root.wm-image == "" ? "Choose an image…" : "Change image…";
                    clicked => {
                        Picked.pick-watermark(root.tab-id);
                    }
                }
                if root.wm-image != "": Text {
                    text: root.wm-image;
                    font-size: Theme.fs-caption;
                    color: Theme.text-muted;
                    overflow: elide;
                }
                SectionLabel { text: "Size"; }
                HorizontalLayout {
                    spacing: 6px;
                    Segment { text: "25%"; selected: root.wm-scale == 25; clicked => { root.wm-scale = 25; } }
                    Segment { text: "50%"; selected: root.wm-scale == 50; clicked => { root.wm-scale = 50; } }
                    Segment { text: "75%"; selected: root.wm-scale == 75; clicked => { root.wm-scale = 75; } }
                    Segment { text: "100%"; selected: root.wm-scale == 100; clicked => { root.wm-scale = 100; } }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    spacing: 6px;
                    SectionLabel { text: "Position"; }
                    PositionGrid { selected <=> root.wm-position; enabled: !root.wm-mosaic; }
                }
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    SectionLabel { text: "Layer"; }
                    Segment { text: "Over the content"; selected: !root.wm-below; clicked => { root.wm-below = false; } }
                    Segment { text: "Below the content"; selected: root.wm-below; clicked => { root.wm-below = true; } }
                    Check { text: "Mosaic"; checked <=> root.wm-mosaic; }
                }
            }
            SectionLabel { text: "Transparency"; }
            HorizontalLayout {
                spacing: 6px;
                Segment { text: "No"; selected: root.wm-transparency == 0; clicked => { root.wm-transparency = 0; } }
                Segment { text: "25%"; selected: root.wm-transparency == 1; clicked => { root.wm-transparency = 1; } }
                Segment { text: "50%"; selected: root.wm-transparency == 2; clicked => { root.wm-transparency = 2; } }
                Segment { text: "75%"; selected: root.wm-transparency == 3; clicked => { root.wm-transparency = 3; } }
            }
            SectionLabel { text: "Rotate"; }
            HorizontalLayout {
                spacing: 6px;
                Segment { text: "None"; selected: root.wm-rotation == 0; clicked => { root.wm-rotation = 0; } }
                Segment { text: "45°"; selected: root.wm-rotation == 1; clicked => { root.wm-rotation = 1; } }
                Segment { text: "90°"; selected: root.wm-rotation == 2; clicked => { root.wm-rotation = 2; } }
            }
            HorizontalLayout {
                spacing: 6px;
                Segment { text: "180°"; selected: root.wm-rotation == 3; clicked => { root.wm-rotation = 3; } }
                Segment { text: "270°"; selected: root.wm-rotation == 4; clicked => { root.wm-rotation = 4; } }
                Segment { text: "−45°"; selected: root.wm-rotation == 5; clicked => { root.wm-rotation = 5; } }
            }
            if root.file-count <= 1: PageRange { from <=> root.from-page; to <=> root.to-page; }
            if root.file-count > 1: InfoBox { text: "All pages will be stamped because multiple PDFs have been selected."; }
            Check { text: "Replace the watermarks already there"; checked <=> root.wm-replace; }
        }
    }

    if root.tool == "crop": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Apply to:"; }
        RadioCard { title: "All pages"; description: "Apply the same crop to every page"; selected: root.crop-mode == 0; clicked => { root.crop-mode = 0; } }
        RadioCard { title: "Selected pages"; description: "Choose which pages to crop"; selected: root.crop-mode == 1; clicked => { root.crop-mode = 1; } }
        RadioCard { title: "Remove crop"; description: "Show the full pages again"; selected: root.crop-mode == 2; clicked => { root.crop-mode = 2; } }
        RadioCard { title: "Remove white margins"; description: "Cut each page to what is drawn on it"; selected: root.crop-mode == 3; clicked => { root.crop-mode = 3; } }
        if root.crop-mode == 1: TextField { label: "Pages"; placeholder: "1-3,5"; text <=> root.pages; }
        if root.crop-mode < 2: VerticalLayout {
            spacing: 10px;
            SectionLabel { text: "Margins to cut (mm)"; }
            HorizontalLayout {
                spacing: 10px;
                TextField { width: (parent.width - 10px) / 2; label: "Top"; placeholder: "0"; text <=> root.crop-top; }
                TextField { width: (parent.width - 10px) / 2; label: "Bottom"; placeholder: "0"; text <=> root.crop-bottom; }
            }
            HorizontalLayout {
                spacing: 10px;
                TextField { width: (parent.width - 10px) / 2; label: "Left"; placeholder: "0"; text <=> root.crop-left; }
                TextField { width: (parent.width - 10px) / 2; label: "Right"; placeholder: "0"; text <=> root.crop-right; }
            }
            CropPreview {
                source: root.preview;
                ready: root.has-preview;
                page-w: root.preview-w;
                page-h: root.preview-h;
                top: Parse.mm(root.crop-top) * 72 / 25.4;
                bottom: Parse.mm(root.crop-bottom) * 72 / 25.4;
                left: Parse.mm(root.crop-left) * 72 / 25.4;
                right: Parse.mm(root.crop-right) * 72 / 25.4;
                // Points to millimetres, to a tenth.
                boxed(t, b, l, r) => {
                    root.crop-top = Math.round(t * 254 / 72) / 10;
                    root.crop-bottom = Math.round(b * 254 / 72) / 10;
                    root.crop-left = Math.round(l * 254 / 72) / 10;
                    root.crop-right = Math.round(r * 254 / 72) / 10;
                }
            }
        }
    }

    if root.tool == "ocr": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Document languages"; }
        for l in OcrInfo.languages: Check {
            text: l.name;
            checked: Parse.has-code(root.ocr-languages, l.code);
            toggled => { root.ocr-languages = Parse.toggle-code(root.ocr-languages, l.code); }
        }
        InfoBox { text: "Recognises Latin-script text (English, French, Spanish, German, …). The accuracy of detection is increased by correctly selecting the document's languages."; }
        Check { text: "Also read pages with text"; checked <=> root.ocr-all-pages; }
        InfoBox { text: "The text is added as an invisible layer: the pages look the same, and the words become searchable and selectable. Pages that already contain text are left alone unless you tick the box above; then only words not already there are added."; }
        if !OcrInfo.available: InfoBox {
            icon: @image-url("../icons/triangle-alert.svg");
            text: "The OCR models are missing from this copy of Sheaf. Reinstall Sheaf to enable OCR.";
        }
    }

    if root.tool == "pdf_to_word" || root.tool == "pdf_to_powerpoint" || root.tool == "pdf_to_excel" || root.tool == "pdf_to_text": VerticalLayout {
        property <string> what: root.tool == "pdf_to_word" ? "Word" : root.tool == "pdf_to_powerpoint" ? "PowerPoint" : root.tool == "pdf_to_excel" ? "Excel"
            : ["HTML", "Markdown", "RTF", "text", "XML"][root.text-format];
        spacing: 10px;
        RadioCard {
            title: "No OCR (text PDFs)";
            description: "OCR is not required";
            selected: !root.export-ocr;
            clicked => { root.export-ocr = false; }
        }
        RadioCard {
            title: "OCR (scanned PDFs)";
            description: "Reads the text of scanned pages";
            selected: root.export-ocr;
            clicked => { root.export-ocr = true; }
        }
        InfoBox {
            text: root.export-ocr
                ? "Converts scanned PDFs with non-selectable text to editable " + what + " files."
                : "Converts PDFs with selectable text to editable " + what + " files.";
        }
        // iLovePDF converts a scan's pages as pictures unless OCR is chosen: say so when a file is one.
        if !root.export-ocr && root.any-scanned: InfoBox {
            icon: @image-url("../icons/triangle-alert.svg");
            text: "This PDF looks scanned: its text can't be selected. Choose OCR to get editable text.";
        }
        if root.export-ocr && !OcrInfo.available: InfoBox {
            icon: @image-url("../icons/triangle-alert.svg");
            text: "The OCR models are missing from this copy of Sheaf. Reinstall Sheaf to enable OCR.";
        }
        // Acrobat's Word settings: flowing text (editable paragraphs and tables) or the page layout.
        if root.tool == "pdf_to_word": VerticalLayout {
            spacing: 10px;
            padding-top: 4px;
            SectionLabel { text: "Layout:"; }
            HorizontalLayout {
                spacing: 8px;
                Segment { text: "Flowing text"; selected: !root.export-exact; clicked => { root.export-exact = false; } }
                Segment { text: "Page layout"; selected: root.export-exact; clicked => { root.export-exact = true; } }
            }
            InfoBox {
                text: root.export-exact
                    ? "Each page looks as it does in the PDF, its text in boxes you can edit."
                    : "Paragraphs and tables you can edit and reflow; pictures and watermarks stay where they are.";
            }
        }
        if root.tool == "pdf_to_excel": VerticalLayout {
            spacing: 10px;
            padding-top: 4px;
            SectionLabel { text: "Layout:"; }
            HorizontalLayout {
                spacing: 8px;
                Segment { text: "One sheet"; selected: root.excel-layout == 0; clicked => { root.excel-layout = 0; } }
                Segment { text: "Multiple sheets"; selected: root.excel-layout == 1; clicked => { root.excel-layout = 1; } }
            }
            InfoBox { text: "Choose to place all tables on one sheet or create a new sheet for each table. Pages without a table keep their text in column A."; }
        }
        // Acrobat's Export ▸ HTML Web Page and More Formats (Text, Rich Text), and Markdown.
        if root.tool == "pdf_to_text": VerticalLayout {
            spacing: 10px;
            padding-top: 4px;
            SectionLabel { text: "Format:"; }
            HorizontalLayout {
                spacing: 8px;
                for label[i] in ["Web page", "Markdown", "Rich text", "Plain text", "XML"]: Segment {
                    text: label;
                    selected: root.text-format == i;
                    clicked => { root.text-format = i; }
                }
            }
            InfoBox {
                text: [
                    "One .html file that opens in any browser, its pictures inside it.",
                    "A .md file: headings, paragraphs and tables in Markdown. Pictures are left out.",
                    "An .rtf file that word processors open, with its sizes, bold, italic and colours.",
                    "A .txt file: the text in reading order, a paragraph per line, table cells split by tabs.",
                    "An .xml file: each page's headings, paragraphs, tables and pictures, in reading order.",
                ][root.text-format];
            }
        }
        InfoBox { text: "Layout is approximate: text, paragraphs, tables and images are recovered; exact formatting may differ."; }
    }

    if root.tool == "compare": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: "Semantic Text";
            description: "A report of the words that changed";
            selected: root.compare-mode == 0;
            clicked => { root.compare-mode = 0; }
        }
        RadioCard {
            title: "Content Overlay";
            description: "Marks on the changed PDF";
            selected: root.compare-mode == 1;
            clicked => { root.compare-mode = 1; }
        }
        InfoBox {
            text: root.compare-mode == 0
                ? "Words are compared in reading order. Layout and pictures are not part of the report."
                : "Changed words are highlighted (blue changed, green added, a red note where words were removed); other changed areas, such as pictures, are outlined in red.";
        }
        // Acrobat's page ranges: part of each document compared.
        TextField { label: "Original's pages (optional)"; placeholder: "All pages"; text <=> root.compare-old-pages; }
        TextField { label: "Changed document's pages (optional)"; placeholder: "All pages"; text <=> root.compare-new-pages; }
    }

    if root.tool == "pdf_to_pdfa": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: "Set the PDF/A conformance level"; }
        RadioCard {
            title: "PDF/A-2b (recommended)";
            description: "For long-term archiving";
            selected: root.pdfa-level == 0;
            clicked => { root.pdfa-level = 0; }
        }
        RadioCard {
            title: "PDF/A-3b";
            description: "Archiving, attachments allowed";
            selected: root.pdfa-level == 1;
            clicked => { root.pdfa-level = 1; }
        }
        InfoBox { text: "Metadata, a colour profile and the other required parts are added, then the file is checked. Anything that cannot be fixed (a font that is not embedded, for example) is listed on the result page."; }
    }

    if root.tool == "sign": VerticalLayout {
        spacing: 10px;
        Rectangle { height: 1px; background: Theme.separator; }
        Check {
            text: "Use a certificate (.p12)";
            checked: root.sign-cert;
            toggled => { root.sign-cert = !root.sign-cert; }
        }
        if root.sign-cert: VerticalLayout {
            spacing: 10px;
            Text {
                text: "Signs the document digitally with your digital ID, so changes made after signing can be detected.";
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            Segment {
                text: root.sign-p12 == "" ? "Choose certificate file" : "Change certificate file";
                clicked => {
                    Picked.pick-p12(root.tab-id);
                }
            }
            if root.sign-p12 != "": Text {
                text: root.sign-p12;
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
            TextField {
                label: "Certificate password";
                password: true;
                placeholder: "Password of the .p12 file";
                text <=> root.sign-p12-password;
            }
            TextField {
                label: "Reason (optional)";
                placeholder: "I approve this document";
                text <=> root.sign-reason;
            }
            TextField {
                label: "Location (optional)";
                placeholder: "City";
                text <=> root.sign-location;
            }
        }
    }

    if !root.office-missing && (root.tool == "word_to_pdf" || root.tool == "powerpoint_to_pdf"
            || root.tool == "excel_to_pdf" || root.tool == "html_to_pdf"): InfoBox {
        text: "Converted with LibreOffice on this computer. Nothing is uploaded.";
    }
    // Every tool runs here, offline (iLovePDF Desktop's offline tools): said at the foot of the
    // options; Office conversion says it above, with LibreOffice.
    if !(root.tool == "word_to_pdf" || root.tool == "powerpoint_to_pdf" || root.tool == "excel_to_pdf" || root.tool == "html_to_pdf"): HorizontalLayout {
        spacing: 6px;
        Image {
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            source: @image-url("../icons/lock.svg");
            colorize: Theme.text-muted;
        }
        Text {
            text: "Runs on this computer. Nothing is uploaded.";
            font-size: Theme.fs-caption;
            color: Theme.text-muted;
        }
    }

    if root.office-missing: VerticalLayout {
        spacing: 10px;
        InfoBox {
            icon: @image-url("../icons/triangle-alert.svg");
            text: "Install LibreOffice to enable this tool. Sheaf uses it to read Office and HTML files.";
        }
        Segment {
            text: "Get LibreOffice";
            clicked => { root.get-libreoffice(); }
        }
    }

    public function reset() {
        root.sign-p12-password = "";
        root.password = "";
        root.confirm = "";
        root.owner = "";
        root.pages = "";
        root.ranges = "";
        root.out-name = "";
        root.from-page = "";
        root.to-page = "";
    }
}
