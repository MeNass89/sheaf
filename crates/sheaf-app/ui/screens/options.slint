import { PlatformBridge } from "../platform.slint";
import { Slider, ScrollView, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolOptions, Parse, OcrInfo, SignBridge, Picked } from "../flow-types.slint";
import { TextField } from "../widgets/text-field.slint";
import { Check } from "../widgets/check.slint";
import { RadioCard, Segment, InfoBox } from "../widgets/radio-card.slint";
import { SectionLabel, Stepper, PositionGrid, PageRange, CropPreview, FontRow, ColourRow } from "options-parts.slint";
import { Chip } from "redact-panel.slint";

// Holds its own state; `options` exposes it, `valid` says whether the action may run.
export component OptionsPanel inherits VerticalLayout {
    in property <string> tool;
    in property <int> file-count;
    // A file looks scanned (PDF to Office suggests OCR).
    in property <bool> any-scanned;
    in property <bool> any-locked;
    in property <string> default-out;
    in property <bool> office-missing;
    // Crop preview: page 1 and its size in points.
    in property <image> preview;
    in property <bool> has-preview;
    in property <float> preview-w;
    in property <float> preview-h;
    out property <bool> valid: (!root.office-missing || (root.tool == "excel_to_pdf" && root.layout == 2) || (root.tool == "html_to_pdf" && root.layout != 0 && root.html-screen-width > 0)) && (
        root.tool == "protect" ? (root.require-open ? root.password != "" && root.password == root.confirm : root.owner != "")
        : root.tool == "remove_pages" ? root.pages != "" || root.remove-blank
        : root.tool == "extract_pages" ? root.pages != ""
        : root.tool == "split" ? (root.split-mode == 0 ? root.ranges != "" && root.split-files >= 0 : root.split-mode == 3 ? root.split-size.is-float() && root.split-size.to-float() > 0 : root.split-mode == 2 || root.split-mode == 4 || root.every >= 1)
        : root.tool == "page_numbers" ? (root.num-text != 3 || (root.num-custom != "" && Parse.custom-text-error(root.num-custom) == "")) && Parse.colour-error(root.num-hex) == ""
            && (root.num-text != 4 || root.hf-tl != "" || root.hf-tc != "" || root.hf-tr != "" || root.hf-bl != "" || root.hf-bc != "" || root.hf-br != "")
        : root.tool == "watermark" ? (root.wm-remove || (root.wm-image-mode ? root.wm-image != "" : root.wm-text != "" && Parse.colour-error(root.wm-hex) == ""))
        : root.tool == "ocr" ? OcrInfo.available && root.ocr-languages != "," && root.ocr-languages != ",," && root.ocr-languages != ""
        : root.tool == "pdf_to_word" || root.tool == "pdf_to_powerpoint" || root.tool == "pdf_to_excel" || root.tool == "pdf_to_text" ? !root.export-ocr || OcrInfo.available
        : root.tool == "crop" ? (root.crop-mode >= 2 || ((root.crop-mode == 0 || root.pages != "")
            && Parse.mm(root.crop-top) + Parse.mm(root.crop-bottom) + Parse.mm(root.crop-left) + Parse.mm(root.crop-right) > 0))
        : root.tool == "sign" ? (!root.sign-cert || root.sign-p12 != "") && (!root.sign-timestamp || root.sign-tsa != "")
        : root.tool == "merge" ? Parse.file-name-error(root.out-name) == ""
        : root.tool == "compress" ? root.level != 3 || (root.compress-target.is-float() && root.compress-target.to-float() > 0)
        : true);
    // Add watermark: the preview follows every option and the file.
    changed options => { if root.tool == "watermark" { Picked.preview-watermark(root.tab-id, root.options); } }
    changed file-count => { if root.tool == "watermark" { Picked.preview-watermark(root.tab-id, root.options); } }
    init => {
        if root.has-restore { root.restore-options(root.restore); }
        if root.tool == "watermark" { Picked.preview-watermark(root.tab-id, root.options); }
    }
    // Run again (Home ▸ History): the options of the task as it ran, passwords left out
    // (saved_options.rs); they start the panel instead of the defaults.
    in property <ToolOptions> restore;
    in property <bool> has-restore;
    function restore-options(o: ToolOptions) {
        root.level = o.level;
        root.compress-target = o.compress-target;
        root.allow-printing = o.allow-printing;
        root.allow-copying = o.allow-copying;
        root.allow-editing = o.allow-editing;
        root.allow-commenting = o.allow-commenting;
        root.allow-filling-forms = o.allow-filling-forms;
        root.pages = o.pages;
        root.remove-blank = o.remove-blank;
        root.blank-level = o.blank-level;
        root.rotate-parity = o.rotate-parity;
        root.protect-sanitize = o.protect-sanitize;
        root.compare-old-pages = o.compare-old-pages;
        root.compare-new-pages = o.compare-new-pages;
        root.rotate-orientation = o.rotate-orientation;
        root.split-mode = o.split-mode;
        root.ranges = o.ranges;
        root.every = o.every;
        root.split-one-file = o.split-one-file;
        root.split-size = o.split-size;
        root.split-cols = o.split-cols;
        root.organize-order = o.organize-order;
        root.split-rows = o.split-rows;
        root.degrees = o.degrees;
        root.layout = o.layout;
        root.landscape = o.landscape;
        root.html-long-page = o.html-long-page;
        root.html-screen-width = o.html-screen-width;
        root.merge-images = !o.one-per-image;
        root.margin = o.margin;
        root.quality = o.quality;
        root.png = o.png;
        root.extract-images = o.extract-images;
        root.out-name = o.out-name;
        root.from-page = o.from-page;
        root.to-page = o.to-page;
        root.num-position = o.num-position;
        root.num-double = o.num-double;
        root.num-cover = o.num-cover;
        root.num-margin = o.num-margin;
        root.num-start = o.num-start;
        root.num-text = o.num-text;
        root.num-custom = o.num-custom;
        root.num-font-size = o.num-font-size;
        root.num-color = o.num-color;
        root.num-family = o.num-family;
        root.num-bold = o.num-bold;
        root.num-italic = o.num-italic;
        root.num-underline = o.num-underline;
        root.num-hex = o.num-hex;
        root.hf-tl = o.hf-tl;
        root.hf-tc = o.hf-tc;
        root.hf-tr = o.hf-tr;
        root.hf-bl = o.hf-bl;
        root.hf-bc = o.hf-bc;
        root.hf-br = o.hf-br;
        root.bates-prefix = o.bates-prefix;
        root.bates-digits = o.bates-digits;
        root.bates-start = o.bates-start;
        root.hf-replace = o.hf-replace;
        root.wm-image-mode = o.wm-image-mode;
        root.wm-text = o.wm-text;
        root.wm-font-size = o.wm-font-size;
        root.wm-color = o.wm-color;
        root.wm-family = o.wm-family;
        root.wm-bold = o.wm-bold;
        root.wm-italic = o.wm-italic;
        root.wm-underline = o.wm-underline;
        root.wm-hex = o.wm-hex;
        root.wm-image = o.wm-image;
        root.wm-scale = o.wm-scale;
        root.wm-position = o.wm-position;
        root.wm-mosaic = o.wm-mosaic;
        root.wm-transparency = o.wm-transparency;
        root.wm-rotation = o.wm-rotation;
        root.wm-below = o.wm-below;
        root.wm-replace = o.wm-replace;
        root.wm-remove = o.wm-remove;
        root.crop-mode = o.crop-mode;
        root.crop-paper = o.crop-paper;
        root.per-sheet = o.per-sheet;
        root.crop-top = o.crop-top;
        root.crop-bottom = o.crop-bottom;
        root.crop-left = o.crop-left;
        root.crop-right = o.crop-right;
        root.pdfa-level = o.pdfa-level;
        root.pdfa-allow-incomplete = o.pdfa-allow-incomplete;
        root.ocr-languages = o.ocr-languages;
        root.ocr-local-engine = o.ocr-local-engine;
        root.ocr-all-pages = o.ocr-all-pages;
        root.ocr-enhance = o.ocr-enhance;
        root.export-ocr = o.export-ocr;
        root.export-exact = o.export-exact;
        root.excel-layout = o.excel-layout;
        root.text-format = o.text-format;
        root.compare-mode = o.compare-mode;
        root.sign-cert = o.sign-cert;
        root.sign-p12 = o.sign-p12;
        root.sign-reason = o.sign-reason;
        root.sign-location = o.sign-location;
        root.sign-certify = o.sign-certify;
        root.sign-timestamp = o.sign-timestamp;
        root.sign-tsa = o.sign-tsa;
        root.redact-fill = o.redact-fill;
        root.compress-ppi = o.compress-ppi;
        root.compress-quality = o.compress-quality;
        root.discard-thumbs = o.discard-thumbs;
        root.discard-tags = o.discard-tags;
        root.discard-meta = o.discard-meta;
        root.compress-gray = o.compress-gray;
        root.unembed-fonts = o.unembed-fonts;
        root.flatten-transparency = o.flatten-transparency;
        root.linearize = o.linearize;
        root.compress-advanced = o.flatten-transparency || o.linearize || o.unembed-fonts || o.discard-thumbs || o.discard-tags || o.discard-meta || o.compress-ppi != "" || o.compress-quality != "";
        root.adjust-brightness = o.adjust-brightness;
        root.adjust-contrast = o.adjust-contrast;
        root.adjust-saturation = o.adjust-saturation;
        root.adjust-invert = o.adjust-invert;
        root.redact-overlay = o.redact-overlay;
        root.redact-margin = o.redact-margin;
        root.redact-repeat = o.redact-repeat;
    }
    out property <ToolOptions> options: {
        level: root.level, compress-target: root.compress-target, password: root.require-open ? root.password : "", confirm: root.confirm, owner: root.owner,
        allow-printing: root.allow-printing, allow-copying: root.allow-copying,
        allow-editing: root.allow-editing, allow-commenting: root.allow-commenting,
        allow-filling-forms: root.allow-filling-forms,
        pages: root.pages, remove-blank: root.remove-blank, blank-level: root.blank-level, rotate-parity: root.rotate-parity, rotate-orientation: root.rotate-orientation, protect-sanitize: root.protect-sanitize, compare-old-pages: root.compare-old-pages, compare-new-pages: root.compare-new-pages, split-mode: root.split-mode, ranges: root.ranges, every: root.every, split-one-file: root.split-one-file, split-size: root.split-size, split-cols: root.split-cols, split-rows: root.split-rows, organize-order: root.organize-order,
        html-screen-width: root.html-screen-width, html-long-page: root.html-long-page, degrees: root.degrees, layout: root.layout, landscape: root.landscape, one-per-image: !root.merge-images, margin: root.margin, quality: root.quality, png: root.png, extract-images: root.extract-images,
        out-name: root.out-name,
        from-page: root.from-page, to-page: root.to-page,
        num-position: root.num-position, num-double: root.num-double, num-cover: root.num-cover,
        num-margin: root.num-margin, num-start: root.num-start, num-text: root.num-text, num-custom: root.num-custom,
        num-font-size: root.num-font-size, num-color: root.num-color,
        num-family: root.num-family, num-bold: root.num-bold, num-italic: root.num-italic, num-underline: root.num-underline, num-hex: root.num-hex,
        hf-tl: root.hf-tl, hf-tc: root.hf-tc, hf-tr: root.hf-tr, hf-bl: root.hf-bl, hf-bc: root.hf-bc, hf-br: root.hf-br,
        bates-prefix: root.bates-prefix, bates-digits: root.bates-digits, bates-start: root.bates-start, hf-replace: root.hf-replace,
        wm-family: root.wm-family, wm-bold: root.wm-bold, wm-italic: root.wm-italic, wm-underline: root.wm-underline, wm-hex: root.wm-hex,
        wm-image-mode: root.wm-image-mode, wm-text: root.wm-text, wm-font-size: root.wm-font-size,
        wm-color: root.wm-color, wm-image: root.wm-image, wm-scale: root.wm-scale, wm-position: root.wm-position,
        wm-mosaic: root.wm-mosaic, wm-transparency: root.wm-transparency, wm-rotation: root.wm-rotation,
        wm-below: root.wm-below, wm-replace: root.wm-replace, wm-remove: root.wm-remove,
        crop-mode: root.crop-mode, crop-paper: root.crop-paper, per-sheet: root.per-sheet, crop-top: root.crop-top, crop-bottom: root.crop-bottom,
        crop-left: root.crop-left, crop-right: root.crop-right,
        pdfa-level: root.pdfa-level,
        pdfa-allow-incomplete: root.pdfa-allow-incomplete,
        ocr-languages: root.ocr-languages, ocr-local-engine: root.ocr-local-engine, ocr-all-pages: root.ocr-all-pages, ocr-enhance: root.ocr-enhance,
        export-ocr: root.export-ocr, export-exact: root.export-exact, excel-layout: root.excel-layout, text-format: root.text-format,
        compare-mode: root.compare-mode,
        sign-cert: root.sign-cert, sign-p12: root.sign-p12, sign-p12-password: root.sign-p12-password,
        sign-reason: root.sign-reason, sign-location: root.sign-location, sign-certify: root.sign-certify,
        sign-timestamp: root.sign-timestamp, sign-tsa: root.sign-tsa,
        compress-ppi: root.compress-ppi, compress-quality: root.compress-quality, discard-thumbs: root.discard-thumbs, discard-tags: root.discard-tags, discard-meta: root.discard-meta, compress-gray: root.compress-gray, unembed-fonts: root.unembed-fonts, flatten-transparency: root.flatten-transparency, linearize: root.linearize,
        adjust-brightness: root.adjust-brightness, adjust-contrast: root.adjust-contrast, adjust-saturation: root.adjust-saturation, adjust-invert: root.adjust-invert,
        redact-fill: root.redact-fill, redact-overlay: root.redact-overlay, redact-margin: root.redact-margin, redact-repeat: root.redact-repeat,
    };
    callback insert-blank();
    // Crop: the page previewed, of how many; ‹ › step through them.
    in property <int> preview-page: 1;
    in property <int> preview-pages: 1;
    callback preview-step(int);
    // Merge: its pages shown one by one (see above).
    in property <bool> merge-pages;
    callback show-pages(bool);
    callback get-libreoffice();
    // Watermark: a picture file chosen in a dialog ("" when cancelled).
    in property <int> tab-id;
    property <int> watermark-seq: Picked.watermark-seq;
    property <int> p12-seq: Picked.p12-seq;
    changed watermark-seq => { if Picked.tab == root.tab-id { root.wm-image = Picked.watermark; } }
    changed p12-seq => { if Picked.tab == root.tab-id { root.sign-p12 = Picked.p12; } }

    in-out property <bool> sign-cert;
    in-out property <string> sign-p12;
    // A smart card or token ID (a pkcs11: reference): signed with its PIN, no file shown.
    property <bool> sign-token: root.sign-p12.starts-with("pkcs11:");
    in-out property <string> sign-p12-password;
    in-out property <string> sign-reason;
    in-out property <string> sign-location;
    in-out property <int> sign-certify;
    in-out property <bool> sign-timestamp;
    in-out property <string> sign-tsa;
    in-out property <int> redact-fill;
    in-out property <string> compress-ppi;
    in-out property <string> compress-quality;
    in-out property <bool> discard-thumbs;
    in-out property <bool> discard-tags;
    in-out property <bool> discard-meta;
    in-out property <bool> compress-gray;
    in-out property <bool> unembed-fonts;
    in-out property <bool> flatten-transparency;
    in-out property <bool> linearize;
    in-out property <int> adjust-brightness;
    in-out property <int> adjust-contrast;
    in-out property <int> adjust-saturation;
    in-out property <bool> adjust-invert;
    property <bool> compress-advanced;
    in-out property <string> redact-overlay;
    in-out property <string> redact-margin;
    in-out property <bool> redact-repeat;
    in-out property <int> level: 1;
    in-out property <string> compress-target;
    in-out property <string> password;
    in-out property <string> confirm;
    in-out property <string> owner;
    // Protect: an open password asked (off: only the permissions password restricts the file).
    in-out property <bool> require-open: true;
    in-out property <bool> allow-printing: true;
    in-out property <bool> allow-copying: true;
    in-out property <bool> allow-editing: true;
    in-out property <bool> allow-commenting: true;
    in-out property <bool> allow-filling-forms: true;
    in-out property <string> pages;
    in-out property <bool> remove-blank;
    in-out property <int> blank-level: 1;
    in-out property <int> rotate-parity: 0;
    in-out property <bool> protect-sanitize;
    in-out property <string> compare-old-pages;
    in-out property <string> compare-new-pages;
    in-out property <int> rotate-orientation: 0;
    in-out property <int> split-mode: 0;
    in-out property <string> split-size;
    in-out property <string> organize-order;
    in-out property <int> split-cols: 2;
    in-out property <int> split-rows: 1;
    in-out property <string> ranges;
    in-out property <int> every: 1;
    in-out property <bool> split-one-file;
    // Split: the document's page count (0 until read), for the summary of what will be made.
    in property <int> page-count;
    property <int> split-files: root.page-count > 0 ? Parse.split-count(root.ranges, root.page-count) : 0;
    in-out property <int> degrees: 90;
    in-out property <int> layout: 0;
    in-out property <bool> landscape: false;
    in-out property <bool> html-long-page: false;
    in-out property <int> html-screen-width: 0;
    in-out property <bool> merge-images: true;
    in-out property <int> margin: 0;
    in-out property <int> quality: 0;
    in-out property <bool> png;
    in-out property <bool> extract-images;
    in-out property <string> out-name;
    in-out property <string> from-page;
    in-out property <string> to-page;
    in-out property <int> num-position: 7;
    in-out property <bool> num-double;
    in-out property <bool> num-cover;
    in-out property <int> num-margin: 1;
    in-out property <string> num-start: "1";
    in-out property <int> num-text: 0;
    in-out property <string> num-custom;
    in-out property <string> num-font-size;
    in-out property <int> num-color: 0;
    in-out property <int> num-family: 0;
    in-out property <bool> num-bold;
    in-out property <bool> num-italic;
    in-out property <bool> num-underline;
    in-out property <string> num-hex;
    in-out property <string> hf-tl;
    in-out property <string> hf-tc;
    in-out property <string> hf-tr;
    in-out property <string> hf-bl;
    in-out property <string> hf-bc;
    in-out property <string> hf-br;
    in-out property <string> bates-prefix;
    in-out property <int> bates-digits: 6;
    in-out property <string> bates-start;
    in-out property <bool> hf-replace;
    in-out property <bool> wm-image-mode;
    in-out property <string> wm-text;
    in-out property <string> wm-font-size;
    in-out property <int> wm-color: 0;
    in-out property <int> wm-family: 0;
    in-out property <bool> wm-bold;
    in-out property <bool> wm-italic;
    in-out property <bool> wm-underline;
    in-out property <string> wm-hex;
    in-out property <string> wm-image;
    in-out property <int> wm-scale: 50;
    in-out property <int> wm-position: 4;
    in-out property <bool> wm-mosaic;
    in-out property <int> wm-transparency: 0;
    in-out property <int> wm-rotation: 0;
    in-out property <bool> wm-below;
    in-out property <bool> wm-replace;
    in-out property <bool> wm-remove;
    in-out property <int> crop-mode: 0;
    in-out property <int> crop-paper: 0;
    in-out property <int> per-sheet: 0;
    in-out property <string> crop-top: "10";
    in-out property <string> crop-bottom: "10";
    in-out property <string> crop-left: "10";
    in-out property <string> crop-right: "10";
    in-out property <int> pdfa-level: 0;
    // This self-inverse order map keeps saved ids 0/1/2 while listing ISO versions in order.
    property <[int]> pdfa-index-map: [2, 5, 0, 3, 6, 1, 4, 7];
    property <int> pdfa-choice: 2;
    changed pdfa-level => { root.pdfa-choice = root.pdfa-level >= 0 && root.pdfa-level < 8 ? root.pdfa-index-map[root.pdfa-level] : 2; }
    changed pdfa-choice => { root.pdfa-level = root.pdfa-choice >= 0 && root.pdfa-choice < 8 ? root.pdfa-index-map[root.pdfa-choice] : 0; }
    in-out property <bool> pdfa-allow-incomplete: true;
    in-out property <string> ocr-languages: "," + OcrInfo.default-language + ",";
    in-out property <bool> ocr-local-engine;
    in-out property <bool> ocr-all-pages;
    in-out property <bool> ocr-enhance;
    in-out property <bool> export-ocr;
    in-out property <bool> export-exact;
    in-out property <int> excel-layout: 0;
    in-out property <int> text-format: 0;
    in-out property <int> compare-mode: 0;

    spacing: 10px;
    alignment: start;

    if root.tool == "merge": TextField {
        label: @tr("Output file name");
        placeholder: root.default-out;
        text <=> root.out-name;
        error: Parse.file-name-error(root.out-name);
    }
    // Merge: the files as cards, or opened out into their pages to put in any order (Acrobat's
    // Combine Files ▸ Expand all).
    if root.tool == "merge" && root.file-count > 0: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 8px;
        Segment { width: 100px; text: @tr("Files"); selected: !root.merge-pages; clicked => { root.show-pages(false); } }
        Segment { width: 100px; text: @tr("Pages"); selected: root.merge-pages; clicked => { root.show-pages(true); } }
    }
    if root.tool == "merge" && root.merge-pages: InfoBox { text: @tr("Every page of every file, in the order they will be merged: hover a page to move it with the arrows or drop it with ×."); }

    if root.tool == "split": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: @tr("Split by range");
            description: @tr("One file for each range you type");
            selected: root.split-mode == 0;
            clicked => { root.split-mode = 0; }
        }
        RadioCard {
            title: @tr("Split every N pages");
            description: @tr("Fixed-size chunks");
            selected: root.split-mode == 1;
            clicked => { root.split-mode = 1; }
        }
        // Acrobat's other two ways.
        RadioCard {
            title: @tr("Split by bookmarks");
            description: @tr("One file per top-level bookmark, named after it");
            selected: root.split-mode == 2;
            clicked => { root.split-mode = 2; }
        }
        RadioCard {
            title: @tr("Split by file size");
            description: @tr("Files no larger than the size you type");
            selected: root.split-mode == 3;
            clicked => { root.split-mode = 3; }
        }
        // Stirling PDF's Split pages into sections: a scanned spread made two pages again.
        RadioCard {
            title: @tr("Cut each page into parts");
            description: @tr("A spread scanned on one page becomes two pages; a poster, sheets");
            selected: root.split-mode == 4;
            clicked => { root.split-mode = 4; }
        }
        if root.split-mode == 4: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Segment { text: @tr("Left | right"); selected: root.split-cols == 2 && root.split-rows == 1; clicked => { root.split-cols = 2; root.split-rows = 1; } }
            Segment { text: @tr("Top / bottom"); selected: root.split-cols == 1 && root.split-rows == 2; clicked => { root.split-cols = 1; root.split-rows = 2; } }
            Segment {
                text: @tr("Grid");
                selected: !(root.split-cols == 2 && root.split-rows == 1) && !(root.split-cols == 1 && root.split-rows == 2);
                clicked => { root.split-cols = 2; root.split-rows = 2; }
            }
        }
        // Stirling PDF's sections: any grid, across then down.
        if root.split-mode == 4 && !(root.split-cols == 2 && root.split-rows == 1) && !(root.split-cols == 1 && root.split-rows == 2): FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Across"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            Stepper { value <=> root.split-cols; minimum: 1; }
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Down"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            Stepper { value <=> root.split-rows; minimum: 1; }
        }
        Rectangle { height: 4px; }
        if root.split-mode == 0: TextField {
            label: @tr("Ranges");
            placeholder: "1-3,5,8-10";
            text <=> root.ranges;
            error: root.ranges != "" && root.split-files < 0 ? "Pages run from 1 to \{root.page-count}" : "";
        }
        if root.split-mode == 0 && root.page-count > 0: InfoBox {
            text: root.ranges == "" ? "Click between pages on the left to cut there, or type ranges."
                : root.split-files < 0 ? "Click between pages on the left to cut there."
                : root.split-one-file ? "One PDF with these \{root.split-files} ranges in order."
                : root.split-files == 1 ? "1 PDF will be created." : "\{root.split-files} PDFs will be created.";
        }
        if root.split-mode == 0: Check { text: @tr("Merge all ranges into one PDF file"); checked <=> root.split-one-file; }
        if root.split-mode == 1: VerticalLayout {
            spacing: 6px;
            SectionLabel { text: @tr("Pages per file"); }
            Stepper { value <=> root.every; }
        }
        if root.split-mode == 3: TextField {
            label: @tr("Largest file (MB)");
            placeholder: "2";
            text <=> root.split-size;
            error: root.split-size != "" && !(root.split-size.is-float() && root.split-size.to-float() > 0) ? "Type megabytes, such as 2 or 1.5" : "";
        }
        if root.split-mode == 1 && root.page-count > 0: InfoBox {
            text: @tr("{} PDFs of {} pages will be created.", ceil(root.page-count / max(1, root.every)), root.every);
        }
    }

    if root.tool == "remove_pages" || root.tool == "extract_pages": VerticalLayout {
        spacing: 10px;
        // Acrobat's Remove Blank Pages: no text and nothing drawn but specks.
        if root.tool == "remove_pages": Check { text: @tr("The blank pages (found for you)"); checked <=> root.remove-blank; }
        // How blank (Stirling's threshold): a scan's grey paper needs the lenient step.
        if root.tool == "remove_pages" && root.remove-blank: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            for label[i] in [@tr("Strict"), @tr("Normal"), @tr("Scans")]: Segment {
                width: 96px;
                text: label;
                selected: root.blank-level == i;
                clicked => { root.blank-level = i; }
            }
        }
        if !(root.tool == "remove_pages" && root.remove-blank): TextField {
            label: root.tool == "remove_pages" ? @tr("Pages to remove") : @tr("Pages to extract");
            placeholder: "1-3,5";
            text <=> root.pages;
        }
        InfoBox { text: @tr("Use commas and dashes: 2,4-6 means pages 2, 4, 5 and 6."); }
    }

    if root.tool == "organize": VerticalLayout {
        spacing: 10px;
        Segment {
            text: @tr("Insert blank page");
            clicked => { root.insert-blank(); }
        }
        InfoBox { text: @tr("Hover a page to move it with the arrows or drop it with ×. The blank page is added at the end."); }
        // Acrobat's custom order and its odd-and-even and duplex rules: typed, it replaces the grid's.
        TextField { label: @tr("Or an order"); placeholder: "3,1,2,5-4"; text <=> root.organize-order; }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 6px;
            Segment { text: @tr("Odd, then even"); selected: root.organize-order == "odd,even"; clicked => { root.organize-order = "odd,even"; } }
            Segment { text: @tr("Collate a 2-sided scan"); selected: root.organize-order == "collate"; clicked => { root.organize-order = "collate"; } }
        }
        // Acrobat's Multiple pages per sheet and Booklet; iLovePDF's Pages per sheet.
        SectionLabel { text: @tr("Pages per sheet"); }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 6px;
            for l[i] in ["1", "2", "4", "6", "9"]: Segment { width: 40px; text: l; selected: root.per-sheet == i; clicked => { root.per-sheet = i; } }
        }
        // Folded, or every page on one (Acrobat's Booklet, Stirling's Single large page).
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 6px;
            Segment { text: @tr("Booklet"); selected: root.per-sheet == 5; clicked => { root.per-sheet = 5; } }
            Segment { text: @tr("One long page"); selected: root.per-sheet == 6; clicked => { root.per-sheet = 6; } }
        }
        if root.per-sheet == 6: InfoBox { text: @tr("Every page one under the other on a single long page (200 inches at most)."); }
        if root.per-sheet == 5: InfoBox { text: @tr("Two pages to a side, in the order that reads 1, 2, 3… once the sheets are printed on both sides and folded."); }
    }

    if root.tool == "rotate": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: @tr("Rotation"); }
        // Acrobat's directions; the files' cards show page 1 turned as chosen.
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Segment { text: @tr("Left 90°"); selected: root.degrees == 270; clicked => { root.degrees = 270; } }
            Segment { text: @tr("Right 90°"); selected: root.degrees == 90; clicked => { root.degrees = 90; } }
            Segment { text: "180°"; selected: root.degrees == 180; clicked => { root.degrees = 180; } }
        }
        // A mirror image of the pages (for transfers and printing on film).
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Segment { text: @tr("Flip ↔"); selected: root.degrees == -1; clicked => { root.degrees = -1; } }
            Segment { text: @tr("Flip ↕"); selected: root.degrees == -2; clicked => { root.degrees = -2; } }
        }
        Rectangle { height: 4px; }
        TextField {
            label: @tr("Pages (optional)");
            placeholder: @tr("All pages");
            text <=> root.pages;
        }
        // Acrobat's Rotate Pages: of those, the even or odd ones, the portrait or landscape ones.
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            for label[i] in [@tr("All pages"), @tr("Odd"), @tr("Even")]: Segment { text: label; selected: root.rotate-parity == i; clicked => { root.rotate-parity = i; } }
        }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            for label[i] in [@tr("Any shape"), @tr("Portrait"), @tr("Landscape")]: Segment { text: label; selected: root.rotate-orientation == i; clicked => { root.rotate-orientation = i; } }
        }
    }

    if root.tool == "compress": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: @tr("Extreme compression");
            description: @tr("Smallest file, softer images");
            selected: root.level == 0;
            clicked => { root.level = 0; }
        }
        RadioCard {
            title: @tr("Recommended compression");
            description: @tr("Small file, sharp enough to read");
            selected: root.level == 1;
            clicked => { root.level = 1; }
        }
        RadioCard {
            title: @tr("Low compression");
            description: @tr("Best image quality, modest saving");
            selected: root.level == 2;
            clicked => { root.level = 2; }
        }
        // iLovePDF's and Smallpdf's target size: stronger settings in turn until the file fits.
        RadioCard {
            title: @tr("To a size");
            description: @tr("The largest file, in MB");
            selected: root.level == 3;
            clicked => { root.level = 3; }
        }
        if root.level == 3: TextField { label: @tr("Largest file (MB)"); placeholder: "2"; text <=> root.compress-target; }
        // Stirling's Convert to grayscale (Acrobat's Convert Colors to Gray): text and drawings stay vector.
        Check { text: @tr("Convert to grayscale"); checked <=> root.compress-gray; }
        // Acrobat's PDF Optimizer: the images' resolution and quality chosen, parts that do not show taken out.
        Check { text: @tr("Advanced settings"); checked <=> root.compress-advanced; }
        if root.compress-advanced: VerticalLayout {
            spacing: 8px;
            if root.level != 3: FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                TextField { label: @tr("Images at most (ppi)"); placeholder: "150"; text <=> root.compress-ppi; }
                TextField { label: @tr("JPEG quality (1–100)"); placeholder: "70"; text <=> root.compress-quality; }
            }
            Check { text: @tr("Remove page thumbnails"); checked <=> root.discard-thumbs; }
            Check { text: @tr("Remove structure tags (accessibility)"); checked <=> root.discard-tags; }
            Check { text: @tr("Remove document information and metadata"); checked <=> root.discard-meta; }
            // Acrobat's Unembed fonts: the faces every reader has (Arial, Times, Courier…).
            Check { text: @tr("Unembed standard fonts (Arial, Times, Courier…)"); checked <=> root.unembed-fonts; }
            Check { text: @tr("Flatten transparency (PDF 1.3 copy)"); checked <=> root.flatten-transparency; }
            if root.flatten-transparency: InfoBox { text: @tr("Needs local Ghostscript. Artwork may become images. Use an untagged copy without forms, layers, signatures or attachments."); }
            Check { text: @tr("Fast Web View (linearize)"); checked <=> root.linearize; }
            if root.linearize: InfoBox { text: @tr("Needs local qpdf. The first page loads before the rest of the file. These settings may increase file size."); }
        }
        Rectangle { height: 4px; }
        InfoBox { text: root.level == 3 ? @tr("Sheaf tries stronger settings in turn until the file is that size or smaller; if none gets there, it keeps the smallest and says so.") : @tr("Recommended and Extreme recompress images; text and vector graphics stay as they are (grey with Convert to grayscale)."); }
    }

    if root.tool == "protect": VerticalLayout {
        spacing: 12px;
        // A file opened with its password: Protect is Acrobat's Change Password.
        if root.any-locked: InfoBox { text: @tr("This PDF already has a password: the new ones replace it."); }
        Check { text: @tr("Require a password to open"); checked <=> root.require-open; }
        if root.require-open: TextField {
            label: @tr("Password");
            password: true;
            allow-reveal: true;
            placeholder: @tr("Type a password");
            text <=> root.password;
        }
        if root.require-open && root.password != "": meter := VerticalLayout {
            spacing: 4px;
            property <int> strength: Parse.password-strength(root.password);
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 4px;
                for i in 3: Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: i > meter.strength ? Theme.progress-track
                        : meter.strength == 0 ? Theme.danger
                        : meter.strength == 1 ? Theme.warning : Theme.success-strong;
                }
            }
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: meter.strength == 0 ? @tr("Weak") : meter.strength == 1 ? @tr("Fair") : @tr("Strong");
                font-size: Theme.fs-caption;
                color: Theme.text-secondary;
            }
        }
        if root.require-open: TextField {
            label: @tr("Repeat password");
            password: true;
            allow-reveal: true;
            placeholder: @tr("Type it again");
            text <=> root.confirm;
            error: root.confirm != "" && root.confirm != root.password ? "Passwords do not match" : "";
        }
        TextField {
            label: root.require-open ? @tr("Permissions password (optional)") : @tr("Permissions password");
            password: true;
            allow-reveal: true;
            placeholder: @tr("Needed to lift the restrictions");
            text <=> root.owner;
        }
        SectionLabel { text: @tr("Allow"); }
        Check { text: @tr("Printing"); checked <=> root.allow-printing; }
        Check { text: @tr("Copying text and images"); checked <=> root.allow-copying; }
        Check { text: @tr("Editing"); checked <=> root.allow-editing; }
        Check { text: @tr("Commenting"); checked <=> root.allow-commenting; }
        Check { text: @tr("Filling forms"); checked <=> root.allow-filling-forms; }
        // Acrobat's Protect ▸ Sanitize Document, in the same panel.
        SectionLabel { text: @tr("Hidden information"); }
        Check { text: @tr("Remove it first: metadata, scripts, attachments, links, hidden text, layers"); checked <=> root.protect-sanitize; }
    }

    if root.tool == "unlock": InfoBox {
        text: @tr("Sheaf asks for each file's password when you add it. The copies are saved without one.");
    }

    if root.tool == "repair": InfoBox {
        text: @tr("The file is rebuilt from what can still be read. Keep the original until you have checked the copy.");
    }

    // iLovePDF's Excel to PDF: use saved print areas or one complete sheet per page.
    if root.tool == "excel_to_pdf": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: @tr("Spreadsheet layout"); }
        RadioCard {
            title: @tr("Saved print layout");
            description: @tr("Use the workbook's paper and print areas");
            selected: root.layout == 0;
            clicked => { root.layout = 0; }
        }
        RadioCard {
            title: @tr("One page per whole sheet");
            description: @tr("Page size grows to fit each sheet");
            selected: root.layout == 1;
            clicked => { root.layout = 1; }
        }
        if root.layout == 1: InfoBox { text: @tr("Includes hidden sheets. Saved paper sizes and print areas are ignored."); }
        RadioCard {
            title: @tr("Built-in data report");
            description: @tr("Cell addresses and saved values; no LibreOffice");
            selected: root.layout == 2;
            clicked => { root.layout = 2; }
        }
        if root.layout == 2: VerticalLayout {
            spacing: 10px;
            TextField { label: @tr("Sheet numbers (blank = visible sheets)"); placeholder: @tr("For example, 1,3-5"); text <=> root.pages; }
            InfoBox { text: @tr("XLS, XLSX, XLSB and ODS; values only.\nNo styles, charts or formula recalculation.\nWestern European text; raw date values.\nHidden sheets need an explicit number."); }
        }

    }

    if root.tool == "jpg_to_pdf" || root.tool == "html_to_pdf": VerticalLayout {
        spacing: 10px;
        // iLovePDF's options: page size, orientation (for paper), margin, one PDF or one each.
        SectionLabel { text: @tr("Page size"); }
        RadioCard { title: root.tool == "html_to_pdf" ? @tr("Original layout") : @tr("Fit"); description: root.tool == "html_to_pdf" ? @tr("Use the file's print settings") : @tr("Same page size as image"); selected: root.layout == 0; clicked => { root.layout = 0; } }
        RadioCard { title: @tr("A4"); description: @tr("210 × 297 mm"); selected: root.layout == 1; clicked => { root.layout = 1; } }
        RadioCard { title: @tr("US Letter"); description: @tr("8.5 × 11 in"); selected: root.layout == 2; clicked => { root.layout = 2; } }
        if root.layout != 0: VerticalLayout {
            spacing: 10px;
            padding-top: 6px;
            SectionLabel { text: @tr("Orientation"); }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Segment { text: @tr("Portrait"); selected: !root.landscape; clicked => { root.landscape = false; } }
                Segment { text: @tr("Landscape"); selected: root.landscape; clicked => { root.landscape = true; } }
            }
            SectionLabel { text: @tr("Margin"); }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Segment { text: @tr("None"); selected: root.margin == 0; clicked => { root.margin = 0; } }
                Segment { text: @tr("Small"); selected: root.margin == 1; clicked => { root.margin = 1; } }
                Segment { text: @tr("Big"); selected: root.margin == 2; clicked => { root.margin = 2; } }
            }
        }
        if root.tool == "jpg_to_pdf" && root.file-count > 1: VerticalLayout {
            padding-top: 6px;
            Check { text: @tr("Merge all images into one PDF file"); checked <=> root.merge-images; }
        }
    }

    if root.tool == "html_to_pdf" && root.layout != 0: VerticalLayout {
        spacing: 10px;
        SectionLabel { text: @tr("Layout engine and screen width"); }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.start;
            spacing: 8px;
            Segment { text: @tr("LibreOffice"); selected: root.html-screen-width == 0; clicked => { root.html-screen-width = 0; } }
            for width in [800, 1280, 1920]: Segment { text: @tr("{} px", width); selected: root.html-screen-width == width; clicked => { root.html-screen-width = width; } }
        }
        Check { text: root.html-screen-width > 0 ? @tr("One continuous screen page") : @tr("Stack printed paper pages"); checked <=> root.html-long-page; }
        if root.html-screen-width > 0: InfoBox { text: @tr("Uses local Chromium, Chrome or Edge.\nKeeps screen CSS, grid and flex layout.\nLocal images and styles only; scripts off.\nNothing is downloaded or uploaded."); }
        if root.html-long-page && root.html-screen-width == 0: InfoBox { text: @tr("Keeps text, pictures and links.\nPaper page breaks and margins remain.\nThis is not a browser screen layout."); }
    }

    if root.tool == "html_to_pdf": InfoBox {
        text: @tr("Local HTML, Markdown or email.\nPictures use the source base address.\nNo URL capture.\nScreen mode uses local resources only.");
    }

    if root.tool == "pdf_to_jpg": VerticalLayout {
        spacing: 10px;
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Segment { text: @tr("Page to image"); selected: !root.extract-images; clicked => { root.extract-images = false; } }
            Segment { text: @tr("Extract images"); selected: root.extract-images; clicked => { root.extract-images = true; } }
        }
        if root.extract-images: InfoBox { text: @tr("Every picture placed in the pages is saved as stored, each once."); }
        if !root.extract-images: VerticalLayout {
            spacing: 10px;
            RadioCard {
                title: @tr("Normal quality");
                description: @tr("150 dpi, smaller images");
                selected: root.quality == 0;
                clicked => { root.quality = 0; }
            }
            RadioCard {
                title: @tr("High quality");
                description: @tr("300 dpi, for print");
                selected: root.quality == 1;
                clicked => { root.quality = 1; }
            }
            RadioCard {
                title: @tr("Very high quality");
                description: @tr("600 dpi, for enlargements");
                selected: root.quality == 2;
                clicked => { root.quality = 2; }
            }
        }
        SectionLabel { text: @tr("Format"); }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Segment { text: @tr("JPG"); selected: !root.png; clicked => { root.png = false; } }
            Segment { text: @tr("PNG (lossless)"); selected: root.png; clicked => { root.png = true; } }
        }
    }

    if root.tool == "page_numbers": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: @tr("Page mode"); }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Segment { text: @tr("Single page"); selected: !root.num-double; clicked => { root.num-double = false; } }
            Segment { text: @tr("Double-sided"); selected: root.num-double; clicked => { root.num-double = true; } }
        }
        Check { text: @tr("First page is cover page"); checked <=> root.num-cover; }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 14px;
            VerticalLayout {
                spacing: 6px;
                SectionLabel { text: @tr("Position"); }
                PositionGrid { edges-only: true; selected <=> root.num-position; }
            }
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                SectionLabel { text: @tr("Margin"); }
                Segment { text: @tr("Small"); selected: root.num-margin == 0; clicked => { root.num-margin = 0; } }
                Segment { text: @tr("Recommended"); selected: root.num-margin == 1; clicked => { root.num-margin = 1; } }
                Segment { text: @tr("Big"); selected: root.num-margin == 2; clicked => { root.num-margin = 2; } }
            }
        }
        if root.file-count <= 1: PageRange { from <=> root.from-page; to <=> root.to-page; }
        if root.file-count > 1: InfoBox { text: @tr("All pages will be numbered because multiple PDFs have been selected."); }
        TextField { label: @tr("First number"); placeholder: "1"; text <=> root.num-start; }
        SectionLabel { text: @tr("Text"); }
        RadioCard { title: @tr("Insert page number only (recommended)"); selected: root.num-text == 0; clicked => { root.num-text = 0; } }
        RadioCard { title: "Page {n}"; selected: root.num-text == 1; clicked => { root.num-text = 1; } }
        RadioCard { title: "Page {n} of {p}"; selected: root.num-text == 2; clicked => { root.num-text = 2; } }
        RadioCard { title: @tr("Custom"); selected: root.num-text == 3; clicked => { root.num-text = 3; } }
        RadioCard { title: @tr("No page number (header and footer text only)"); selected: root.num-text == 4; clicked => { root.num-text = 4; } }
        // Acrobat's Header & Footer ▸ Remove: Sheaf's and other apps' (Acrobat's Pagination artifacts).
        RadioCard { title: @tr("Remove page numbers, headers and footers"); selected: root.num-text == 5; clicked => { root.num-text = 5; } }
        if root.num-text == 3: TextField {
            placeholder: "Sheet {n} of {p}";
            text <=> root.num-custom;
            error: Parse.custom-text-error(root.num-custom);
        }
        if root.num-text == 3: InfoBox { text: "{n} is the page number; {p} is the document's total page count."; }
        // How the numbers look (Acrobat's and Stirling's font, size and colour).
        FontRow {
            family <=> root.num-family; bold <=> root.num-bold; italic <=> root.num-italic; underline <=> root.num-underline;
            size <=> root.num-font-size; size-placeholder: @tr("Size: 12");
        }
        ColourRow { colour <=> root.num-color; hex <=> root.num-hex; }
        // Acrobat's Header & Footer: text in any of the six places, Bates numbers among it.
        SectionLabel { text: @tr("Header and footer"); }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 6px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 48px; text: @tr("Top"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            TextField { placeholder: @tr("Left"); text <=> root.hf-tl; error: Parse.custom-text-error(root.hf-tl); }
            TextField { placeholder: @tr("Centre"); text <=> root.hf-tc; error: Parse.custom-text-error(root.hf-tc); }
            TextField { placeholder: @tr("Right"); text <=> root.hf-tr; error: Parse.custom-text-error(root.hf-tr); }
        }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 6px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 48px; text: @tr("Bottom"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            TextField { placeholder: @tr("Left"); text <=> root.hf-bl; error: Parse.custom-text-error(root.hf-bl); }
            TextField { placeholder: @tr("Centre"); text <=> root.hf-bc; error: Parse.custom-text-error(root.hf-bc); }
            TextField { placeholder: @tr("Right"); text <=> root.hf-br; error: Parse.custom-text-error(root.hf-br); }
        }
        InfoBox { text: "{n} page number, {p} page count, {date} today, {bates} the Bates number below."; }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            TextField { label: @tr("Bates prefix"); placeholder: @tr("ACME-"); text <=> root.bates-prefix; }
            TextField { width: 80px; label: @tr("From"); placeholder: "1"; text <=> root.bates-start; }
        }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Digits"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            Stepper { value <=> root.bates-digits; minimum: 3; }
        }
        Check { text: @tr("Replace existing headers, footers"); checked <=> root.hf-replace; }
    }

    if root.tool == "watermark": VerticalLayout {
        spacing: 10px;
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            Segment { text: @tr("Place Text"); selected: !root.wm-remove && !root.wm-image-mode; clicked => { root.wm-image-mode = false; root.wm-remove = false; } }
            Segment { text: @tr("Place Image"); selected: !root.wm-remove && root.wm-image-mode; clicked => { root.wm-image-mode = true; root.wm-remove = false; } }
            Segment { text: @tr("Remove"); selected: root.wm-remove; clicked => { root.wm-remove = true; } }
        }
        if root.wm-remove: InfoBox {
            text: @tr("Takes out the watermarks Sheaf, Acrobat and other PDF editors placed. The page's own text and images stay.");
        }
        if !root.wm-remove: VerticalLayout {
            spacing: 10px;
            if !root.wm-image-mode: VerticalLayout {
                spacing: 10px;
                TextField { label: @tr("Text"); placeholder: @tr("CONFIDENTIAL"); text <=> root.wm-text; }
                FontRow {
                    family <=> root.wm-family; bold <=> root.wm-bold; italic <=> root.wm-italic; underline <=> root.wm-underline;
                    size <=> root.wm-font-size; size-placeholder: @tr("Size: 48");
                }
                ColourRow { colour <=> root.wm-color; hex <=> root.wm-hex; }
            }
            if root.wm-image-mode: VerticalLayout {
                spacing: 10px;
                Segment {
                    text: root.wm-image == "" ? @tr("Choose an image…") : @tr("Change image…");
                    clicked => {
                        Picked.pick-watermark(root.tab-id);
                    }
                }
                if root.wm-image != "": Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.wm-image;
                    font-size: Theme.fs-caption;
                    color: Theme.text-muted;
                    overflow: elide;
                }
                SectionLabel { text: @tr("Size"); }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 6px;
                    Segment { text: "25%"; selected: root.wm-scale == 25; clicked => { root.wm-scale = 25; } }
                    Segment { text: "50%"; selected: root.wm-scale == 50; clicked => { root.wm-scale = 50; } }
                    Segment { text: "75%"; selected: root.wm-scale == 75; clicked => { root.wm-scale = 75; } }
                    Segment { text: "100%"; selected: root.wm-scale == 100; clicked => { root.wm-scale = 100; } }
                }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 14px;
                VerticalLayout {
                    spacing: 6px;
                    SectionLabel { text: @tr("Position"); }
                    PositionGrid { selected <=> root.wm-position; enabled: !root.wm-mosaic; }
                }
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    SectionLabel { text: @tr("Layer"); }
                    Segment { text: @tr("Over the content"); selected: !root.wm-below; clicked => { root.wm-below = false; } }
                    Segment { text: @tr("Below the content"); selected: root.wm-below; clicked => { root.wm-below = true; } }
                    Check { text: @tr("Mosaic"); checked <=> root.wm-mosaic; }
                }
            }
            SectionLabel { text: @tr("Transparency"); }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Segment { text: @tr("No"); selected: root.wm-transparency == 0; clicked => { root.wm-transparency = 0; } }
                Segment { text: "25%"; selected: root.wm-transparency == 1; clicked => { root.wm-transparency = 1; } }
                Segment { text: "50%"; selected: root.wm-transparency == 2; clicked => { root.wm-transparency = 2; } }
                Segment { text: "75%"; selected: root.wm-transparency == 3; clicked => { root.wm-transparency = 3; } }
            }
            SectionLabel { text: @tr("Rotate"); }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Segment { text: @tr("None"); selected: root.wm-rotation == 0; clicked => { root.wm-rotation = 0; } }
                Segment { text: "45°"; selected: root.wm-rotation == 1; clicked => { root.wm-rotation = 1; } }
                Segment { text: "90°"; selected: root.wm-rotation == 2; clicked => { root.wm-rotation = 2; } }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 6px;
                Segment { text: "180°"; selected: root.wm-rotation == 3; clicked => { root.wm-rotation = 3; } }
                Segment { text: "270°"; selected: root.wm-rotation == 4; clicked => { root.wm-rotation = 4; } }
                Segment { text: "−45°"; selected: root.wm-rotation == 5; clicked => { root.wm-rotation = 5; } }
            }
            if root.file-count <= 1: PageRange { from <=> root.from-page; to <=> root.to-page; }
            if root.file-count > 1: InfoBox { text: @tr("All pages will be stamped because multiple PDFs have been selected."); }
            Check { text: @tr("Replace the watermarks already there"); checked <=> root.wm-replace; }
        }
    }

    if root.tool == "crop": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: @tr("Apply to:"); }
        RadioCard { title: @tr("All pages"); description: @tr("Apply the same crop to every page"); selected: root.crop-mode == 0; clicked => { root.crop-mode = 0; } }
        RadioCard { title: @tr("Selected pages"); description: @tr("Choose which pages to crop"); selected: root.crop-mode == 1; clicked => { root.crop-mode = 1; } }
        RadioCard { title: @tr("Remove crop"); description: @tr("Show the full pages again"); selected: root.crop-mode == 2; clicked => { root.crop-mode = 2; } }
        RadioCard { title: @tr("Remove white margins"); description: @tr("Cut each page to what is drawn on it"); selected: root.crop-mode == 3; clicked => { root.crop-mode = 3; } }
        // Acrobat's Set Page Boxes ▸ Change Page Size.
        RadioCard { title: @tr("Change page size"); description: @tr("Scale every page to a paper size"); selected: root.crop-mode == 4; clicked => { root.crop-mode = 4; } }
        if root.crop-mode == 4: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 6px;
            for p[i] in [@tr("A4"), @tr("Letter"), @tr("A3"), @tr("A5"), @tr("Legal")]: Segment { width: 46px; text: p; selected: root.crop-paper == i; clicked => { root.crop-paper = i; } }
        }
        if root.crop-mode == 1: TextField { label: @tr("Pages"); placeholder: "1-3,5"; text <=> root.pages; }
        if root.crop-mode < 2: VerticalLayout {
            spacing: 10px;
            SectionLabel { text: @tr("Margins to cut (mm)"); }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 10px;
                TextField { width: (parent.width - 10px) / 2; label: @tr("Top"); placeholder: "0"; text <=> root.crop-top; }
                TextField { width: (parent.width - 10px) / 2; label: @tr("Bottom"); placeholder: "0"; text <=> root.crop-bottom; }
            }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 10px;
                TextField { width: (parent.width - 10px) / 2; label: @tr("Left"); placeholder: "0"; text <=> root.crop-left; }
                TextField { width: (parent.width - 10px) / 2; label: @tr("Right"); placeholder: "0"; text <=> root.crop-right; }
            }
            CropPreview {
                source: root.preview;
                ready: root.has-preview;
                page-w: root.preview-w;
                page-h: root.preview-h;
                top: Parse.mm(root.crop-top) * 72 / 25.4;
                bottom: Parse.mm(root.crop-bottom) * 72 / 25.4;
                left: Parse.mm(root.crop-left) * 72 / 25.4;
                right: Parse.mm(root.crop-right) * 72 / 25.4;
                // Points to millimetres, to a tenth.
                boxed(t, b, l, r) => {
                    root.crop-top = Math.round(t * 254 / 72) / 10;
                    root.crop-bottom = Math.round(b * 254 / 72) / 10;
                    root.crop-left = Math.round(l * 254 / 72) / 10;
                    root.crop-right = Math.round(r * 254 / 72) / 10;
                }
            }
            // Any page to draw on (a cover differs from the pages after it).
            if root.preview-pages > 1: FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: center;
                spacing: 8px;
                Segment { width: 32px; text: "‹"; clicked => { root.preview-step(-1); } }
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Page {} of {}", root.preview-page, root.preview-pages); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                Segment { width: 32px; text: "›"; clicked => { root.preview-step(1); } }
            }
        }
    }

    if root.tool == "ocr": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: @tr("Document languages"); }
        ScrollView {
            height: 216px;
            VerticalLayout {
                spacing: 4px;
                for l in OcrInfo.languages: Check {
                    text: l.name;
                    checked: Parse.has-code(root.ocr-languages, l.code);
                    toggled => { root.ocr-languages = Parse.toggle-code(root.ocr-languages, l.code); }
                }
            }
        }
        InfoBox { text: @tr("Select every language on the page. Installed Tesseract packs are preferred. Latin text can use built-in recognition."); }
        InfoBox { text: @tr("Mixed scripts need a local pack for every selected language. Run horizontal and vertical packs in separate jobs."); }
        Check { text: @tr("Require installed Tesseract"); checked <=> root.ocr-local-engine; }
        InfoBox { text: @tr("When required, a missing local pack stops the job. Leave this off to allow built-in Latin recognition when local packs are unavailable."); }
        Check { text: @tr("Also read pages with text"); checked <=> root.ocr-all-pages; }
        // Acrobat's Enhance scanned pages, before it reads them.
        Check { text: @tr("Straighten and clean scans first"); checked <=> root.ocr-enhance; }
        InfoBox { text: @tr("The text is added as an invisible layer: the pages look the same, and the words become searchable and selectable. Pages that already contain text are left alone unless you tick the box above; then only words not already there are added. Straightened and cleaned, a scanned page is drawn again level, its paper white and its ink dark."); }
        if !OcrInfo.available: InfoBox {
            warning: true;
            text: @tr("No OCR models or local language packs were found. Reinstall Sheaf or install Tesseract and language packs locally, then restart Sheaf.");
        }
    }

    if root.tool == "pdf_to_word" || root.tool == "pdf_to_powerpoint" || root.tool == "pdf_to_excel" || root.tool == "pdf_to_text": VerticalLayout {
        property <string> what: root.tool == "pdf_to_word" ? "Word" : root.tool == "pdf_to_powerpoint" ? "PowerPoint" : root.tool == "pdf_to_excel" ? "Excel"
            : ["HTML", "Markdown", "RTF", "text", "XML", "EPUB"][root.text-format];
        spacing: 10px;
        RadioCard {
            title: @tr("No OCR (text PDFs)");
            description: @tr("OCR is not required");
            selected: !root.export-ocr;
            clicked => { root.export-ocr = false; }
        }
        RadioCard {
            title: @tr("OCR (scanned PDFs)");
            description: @tr("Reads the text of scanned pages");
            selected: root.export-ocr;
            clicked => { root.export-ocr = true; }
        }
        InfoBox {
            text: root.export-ocr
                ? @tr("Converts scanned PDFs with non-selectable text to editable {} files.", what)
                : @tr("Converts PDFs with selectable text to editable {} files.", what);
        }
        // iLovePDF converts a scan's pages as pictures unless OCR is chosen: say so when a file is one.
        if !root.export-ocr && root.any-scanned: InfoBox {
            warning: true;
            text: @tr("This PDF looks scanned: its text can't be selected. Choose OCR to get editable text.");
        }
        if root.export-ocr && !OcrInfo.available: InfoBox {
            warning: true;
            text: @tr("The OCR models are missing from this copy of Sheaf. Reinstall Sheaf to enable OCR.");
        }
        // Acrobat's Word settings: flowing text (editable paragraphs and tables) or the page layout.
        if root.tool == "pdf_to_word": VerticalLayout {
            spacing: 10px;
            padding-top: 4px;
            SectionLabel { text: @tr("Layout:"); }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Segment { text: @tr("Flowing text"); selected: !root.export-exact; clicked => { root.export-exact = false; } }
                Segment { text: @tr("Page layout"); selected: root.export-exact; clicked => { root.export-exact = true; } }
            }
            InfoBox {
                text: root.export-exact
                    ? @tr("Each page looks as it does in the PDF, its text in boxes you can edit.")
                    : "Paragraphs and tables you can edit and reflow; pictures and watermarks stay where they are.";
            }
        }
        if root.tool == "pdf_to_excel": VerticalLayout {
            spacing: 10px;
            padding-top: 4px;
            SectionLabel { text: @tr("Layout:"); }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                Segment { text: @tr("One sheet"); selected: root.excel-layout == 0; clicked => { root.excel-layout = 0; } }
                Segment { text: @tr("Multiple sheets"); selected: root.excel-layout == 1; clicked => { root.excel-layout = 1; } }
            }
            InfoBox { text: @tr("Choose to place all tables on one sheet or create a new sheet for each table. Pages without a table keep their text in column A."); }
        }
        // Acrobat's Export ▸ HTML Web Page and More Formats (Text, Rich Text), and Markdown.
        if root.tool == "pdf_to_text": VerticalLayout {
            spacing: 10px;
            padding-top: 4px;
            SectionLabel { text: @tr("Format:"); }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                spacing: 8px;
                for label[i] in [@tr("Web page"), @tr("Markdown"), @tr("Rich text"), @tr("Plain text"), @tr("XML"), @tr("Ebook")]: Segment {
                    text: label;
                    selected: root.text-format == i;
                    clicked => { root.text-format = i; }
                }
            }
            InfoBox {
                text: [
                    @tr("One .html file that opens in any browser, its pictures inside it."),
                    @tr("A .md file: headings, paragraphs and tables in Markdown. Pictures are left out."),
                    @tr("An .rtf file that word processors open, with its sizes, bold, italic and colours."),
                    @tr("A .txt file: the text in reading order, a paragraph per line, table cells split by tabs."),
                    @tr("An .xml file: each page's headings, paragraphs, tables and pictures, in reading order."),
                    @tr("An .epub ebook that reflows on any reader's screen: a chapter per page, its pictures and tables."),
                ][root.text-format];
            }
        }
        InfoBox { text: @tr("Layout is approximate: text, paragraphs, tables and images are recovered; exact formatting may differ."); }
    }

    if root.tool == "compare": VerticalLayout {
        spacing: 10px;
        RadioCard {
            title: @tr("Semantic Text");
            description: @tr("A report of what changed: the words, then pictures and drawings");
            selected: root.compare-mode == 0;
            clicked => { root.compare-mode = 0; }
        }
        RadioCard {
            title: @tr("Content Overlay");
            description: @tr("Marks on the changed PDF");
            selected: root.compare-mode == 1;
            clicked => { root.compare-mode = 1; }
        }
        // Acrobat's side-by-side view: both documents on one sheet, scrolled together.
        RadioCard {
            title: @tr("Side by side");
            description: @tr("The original beside the marked copy");
            selected: root.compare-mode == 2;
            clicked => { root.compare-mode = 2; }
        }
        InfoBox {
            text: root.compare-mode == 0
                ? "Words are compared in reading order; pictures, drawings and scanned pages that changed are listed on a last page, as Acrobat's report does."
                : root.compare-mode == 2 ? "Each page of the original stands left of the same page marked, on one sheet: scrolling keeps them together."
                : "Changed words are highlighted (blue changed, green added, a red note where words were removed); other changed areas, such as pictures, are outlined in red.";
        }
        // Acrobat's page ranges: part of each document compared.
        TextField { label: @tr("Original's pages (optional)"); placeholder: @tr("All pages"); text <=> root.compare-old-pages; }
        TextField { label: @tr("Changed document's pages (optional)"); placeholder: @tr("All pages"); text <=> root.compare-new-pages; }
    }

    if root.tool == "pdf_to_pdfa": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: @tr("Set the PDF/A conformance level"); }
        // iLovePDF's version-ordered list; stored option indices 0/1/2 retain their meaning.
        ComboBox {
            model: [@tr("PDF/A-1b"), @tr("PDF/A-1a"), @tr("PDF/A-2b (recommended)"), @tr("PDF/A-2u"), @tr("PDF/A-2a"), @tr("PDF/A-3b"), @tr("PDF/A-3u"), @tr("PDF/A-3a")];
            current-index <=> root.pdfa-choice;
        }
        if root.pdfa-level == 2 || root.pdfa-level == 5: InfoBox { text: @tr("PDF 1.4, without layers or transparency.\nThose features are reported.\nChoose 2b to preserve them."); }
        if root.pdfa-level >= 3: InfoBox { text: @tr("Checks Unicode for every text code.\nLevel a requires existing tags.\nReview reading order before archiving."); }
        Check { text: @tr("Keep a copy even if checks fail"); checked <=> root.pdfa-allow-incomplete; }
        InfoBox { text: @tr("The written PDF is checked before saving.\nUnfixed issues appear in the results.\nChecks cover structure, not full ISO validation."); }
        if !root.pdfa-allow-incomplete: InfoBox { text: @tr("If a check fails, no output is saved.\nThe source file is kept."); }
    }

    // Stirling's Adjust Colours/Contrast, Preview's Adjust Color: −100 to 100 each, or inverted.
    if root.tool == "adjust_colours": VerticalLayout {
        spacing: 10px;
        for a[i] in [
            { label: @tr("Brightness"), value: root.adjust-brightness },
            { label: @tr("Contrast"), value: root.adjust-contrast },
            { label: @tr("Saturation"), value: root.adjust-saturation },
        ]: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 10px;
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; width: 80px; text: a.label; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            Slider {
                minimum: -100;
                maximum: 100;
                value: a.value;
                changed(v) => {
                    if i == 0 { root.adjust-brightness = round(v); }
                    if i == 1 { root.adjust-contrast = round(v); }
                    if i == 2 { root.adjust-saturation = round(v); }
                }
            }
            Text { width: 40px; text: a.value; font-size: Theme.fs-label; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
        }
        Check { text: @tr("Invert the colours (light on dark)"); checked <=> root.adjust-invert; }
        InfoBox { text: @tr("Text and drawings stay sharp and selectable: their colours change, and the pictures'. Gradients and spot colours are left as they are."); }
    }

    // Acrobat's Redaction Properties ▸ Appearance: the boxes' fill and a text over each.
    if root.tool == "redact": VerticalLayout {
        spacing: 10px;
        SectionLabel { text: @tr("Boxes"); }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            spacing: 6px;
            alignment: start;
            for c[i] in [@tr("Black"), @tr("White"), @tr("Grey"), @tr("Red")]: Chip {
                text: c;
                selected: root.redact-fill == i;
                clicked => { root.redact-fill = i; }
            }
        }
        TextField {
            label: @tr("Text over each box (optional)");
            placeholder: @tr("Redacted");
            text <=> root.redact-overlay;
        }
        // Acrobat's margins round each redaction: accents and descenders go too.
        TextField {
            label: @tr("Margin round each mark (points, optional)");
            placeholder: "0";
            text <=> root.redact-margin;
        }
        if root.redact-overlay != "": Check {
            text: @tr("Repeat it to fill the box");
            checked: root.redact-repeat;
            toggled => { root.redact-repeat = !root.redact-repeat; }
        }
    }

    if root.tool == "sign": VerticalLayout {
        spacing: 10px;
        Rectangle { height: 1px; background: Theme.separator; }
        Check {
            text: @tr("Use a digital ID (.p12 or smart card)");
            checked: root.sign-cert;
            toggled => { root.sign-cert = !root.sign-cert; }
        }
        if root.sign-cert: VerticalLayout {
            spacing: 10px;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Signs the document digitally with your digital ID, so changes made after signing can be detected.");
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            // The digital IDs Preferences keeps, a smart card's among them.
            for id[k] in Picked.ids: Segment {
                text: Picked.id-labels[k];
                selected: root.sign-p12 == id;
                clicked => { root.sign-p12 = id; }
            }
            Segment {
                text: root.sign-p12 == "" ? @tr("Choose certificate file") : @tr("Change certificate file");
                clicked => {
                    Picked.pick-p12(root.tab-id);
                }
            }
            if root.sign-p12 != "" && !root.sign-token: Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.sign-p12;
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
            TextField {
                label: root.sign-token ? @tr("PIN of the smart card or token") : @tr("Certificate password");
                password: true;
                placeholder: root.sign-token ? @tr("Its PIN") : @tr("Password of the .p12 file");
                text <=> root.sign-p12-password;
            }
            TextField {
                label: @tr("Reason (optional)");
                placeholder: @tr("I approve this document");
                text <=> root.sign-reason;
            }
            TextField {
                label: @tr("Location (optional)");
                placeholder: @tr("City");
                text <=> root.sign-location;
            }
            // Acrobat's Certify (a certification signature): the first signature, saying which
            // changes stay allowed after it.
            Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Certify the document, allowing"); font-size: Theme.fs-caption; color: Theme.text-muted; }
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                spacing: 6px;
                alignment: start;
                for c[i] in [@tr("Not certified"), @tr("No changes"), @tr("Forms, signing"), @tr("And comments")]: Chip {
                    text: c;
                    selected: root.sign-certify == i;
                    clicked => { root.sign-certify = i; }
                }
            }
        }
        // Acrobat's time stamp (Preferences ▸ Signatures ▸ Time Stamp Servers): the signature's own,
        // or with nothing signed, Time Stamp Document. The server is asked only when Sign runs.
        Check {
            text: @tr("Add a trusted time stamp");
            checked: root.sign-timestamp;
            toggled => {
                root.sign-timestamp = !root.sign-timestamp;
                if root.sign-timestamp && root.sign-tsa == "" && Picked.tsa-servers.length > 0 {
                    root.sign-tsa = Picked.tsa-servers[0];
                }
            }
        }
        if root.sign-timestamp: VerticalLayout {
            spacing: 6px;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("The time stamp server below is asked for the time when you sign. A signature with a digital ID carries it; with no signature placed, the document gets a time stamp of its own.");
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            for s in Picked.tsa-servers: Segment {
                text: s;
                selected: root.sign-tsa == s;
                clicked => { root.sign-tsa = s; }
            }
            if Picked.tsa-servers.length == 0: Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Add a time stamp server in Preferences ▸ Signatures.");
                font-size: Theme.fs-caption;
                color: Theme.warning;
                wrap: word-wrap;
            }
        }
    }

    if !root.office-missing && (root.tool == "word_to_pdf" || root.tool == "powerpoint_to_pdf"
            || (root.tool == "excel_to_pdf" && root.layout != 2) || (root.tool == "html_to_pdf" && (root.layout == 0 || root.html-screen-width == 0))): InfoBox {
        text: @tr("Converted with LibreOffice on this computer. Nothing is uploaded.");
    }
    // Every tool runs here, offline (iLovePDF Desktop's offline tools): said at the foot of the
    // options; Office conversion says it above, with LibreOffice.
    // Lock and text placed by hand, as InfoBox's: the text wraps (a longer translation was cut off)
    // and a FlexboxLayout row cannot follow a wrapped text's height.
    if !(root.tool == "word_to_pdf" || root.tool == "powerpoint_to_pdf" || root.tool == "excel_to_pdf" || root.tool == "html_to_pdf"): Rectangle {
        height: max(12px, local-note.preferred-height);
        Image {
            x: PlatformBridge.rtl ? parent.width - self.width : 0;
            y: max(0px, (min(local-note.preferred-height, 16px) - self.height) / 2);
            width: 12px;
            height: 12px;
            source: @image-url("../icons/lock.svg");
            colorize: Theme.text-muted;
        }
        local-note := Text {
            x: PlatformBridge.rtl ? 0 : 18px;
            width: parent.width - 18px;
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("Runs on this computer. Nothing is uploaded.");
            font-size: Theme.fs-caption;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    if root.tool == "excel_to_pdf" && root.layout == 2: InfoBox { text: @tr("Created in Sheaf. Nothing is uploaded."); }
    if root.office-missing && !(root.tool == "excel_to_pdf" && root.layout == 2) && !(root.tool == "html_to_pdf" && root.layout != 0 && root.html-screen-width > 0): VerticalLayout {
        spacing: 10px;
        InfoBox {
            warning: true;
            text: root.tool == "excel_to_pdf" ? @tr("Choose Built-in data report, or install LibreOffice for the workbook’s print layout.") : @tr("Install LibreOffice to enable this tool. Sheaf uses it to read Office and HTML files.");
        }
        Segment {
            text: @tr("Get LibreOffice");
            clicked => { root.get-libreoffice(); }
        }
    }

    public function reset() {
        root.sign-p12-password = "";
        root.password = "";
        root.confirm = "";
        root.owner = "";
        root.pages = "";
        root.ranges = "";
        root.out-name = "";
        root.from-page = "";
        root.to-page = "";
    }
}
