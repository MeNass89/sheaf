import { SettingsBridge } from "../settings.slint";
import { PlatformBridge } from "../platform.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Segment } from "../widgets/radio-card.slint";
import { SecondaryButton } from "dialogs.slint";
import { TextField } from "../widgets/text-field.slint";
import { Check } from "../widgets/check.slint";
import { Picked } from "../flow-types.slint";
import { SpellingSection, KeyboardSection, InterfaceSection } from "preferences-platform.slint";
import { AiSection } from "preferences-ai.slint";
import { PrintDefaultsSection, SecuritySection, StartupSection } from "preferences-more.slint";
import { PluginsSection } from "preferences-plugins.slint";

// White card with a section title.
// A round colour to pick, ringed when chosen.
component Swatch inherits Rectangle {
    in property <color> colour;
    in property <bool> selected;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.text : Theme.input-border;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.colour;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Section inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius-card;
    background: Theme.card;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: Theme.mac ? 20px : 18px;
        spacing: 12px;
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.title;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
        }
        @children
    }
}

component Radio inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 26px;
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 10px;
        Rectangle {
            cross-axis-self-alignment: CrossAxisAlignment.center;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: root.selected ? 0 : 1.5px;
            border-color: touch.has-hover ? Theme.text-secondary : Theme.option-border;
            background: root.selected ? Theme.accent : transparent;
            if root.selected: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.on-accent;
            }
        }
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.text;
            font-size: Theme.fs-body;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.accent : Theme.option-border;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        animate x { duration: 120ms; }
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// Preferences page: appearance, output location, after processing.
export component PreferencesScreen inherits Rectangle {
    // 0 = System, 1 = Light, 2 = Dark
    in property <int> theme-pref;
    // 0 = Ask, 1 = Next to the original, 2 = Fixed folder
    in property <int> output-mode;
    in property <string> fixed-folder;
    in property <bool> open-after;
    callback set-theme(int);
    callback set-output(int);
    callback choose-folder();
    callback set-open-after(bool);
    // The user's name, on comments and as the Author of the PDFs Sheaf makes from other files;
    // empty: the login name (shown as the placeholder).
    in property <string> author-name;
    in property <string> author-default;
    callback set-author(string);
    // How a document opened for the first time is shown (0 fit width, 1 fit page, 2 actual size).
    in property <int> default-zoom;
    callback set-default-zoom(int);
    // Make Sheaf the system's default PDF app (Acrobat's and PDF Expert's prompt).
    callback make-default();
    in property <int> default-spread;
    callback set-default-spread(int);
    in property <bool> open-first-page;
    callback set-open-first-page(bool);
    in property <[bool]> smooth;
    callback set-smoothing(int, bool);
    in property <string> display-profile;
    callback choose-display-profile();
    callback reset-display-profile();
    // Accent colour (Theme.accent-choice) and the window background behind the pages (0 as the
    // theme, then light grey, mid grey, dark, black; Preview's Window background).
    in property <int> backdrop-pref;
    callback set-accent(int);
    callback set-backdrop(int);
    // How dated stamps write the time (0 Acrobat's, 1 day first, 2 ISO).
    in property <int> stamp-date;
    callback set-stamp-date(int);
    in property <bool> metric;
    callback set-metric(bool);
    in property <int> guide-colour;
    callback set-guide-colour(int);
    in property <bool> gpu;
    callback set-gpu(bool);
    in property <bool> show-boxes;
    in property <bool> physical-numbers;
    in property <bool> transparency-grid;
    callback set-page-display(int, bool);
    in property <[string]> digital-ids;
    in property <[string]> trusted-certs;
    callback signature-prefs(int, int);
    // Acrobat's Add Digital ID ▸ A new digital ID: name, unit, organization, email, country, password twice, for encryption too.
    callback create-digital-id(string, string, string, string, string, string, string, bool);
    property <bool> creating-id;
    background: Theme.content-bg;

    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: scroll.visible-width;
            padding: Theme.content-padding;
            spacing: 16px;
            alignment: start;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                height: 36px;
                text: @tr("Preferences");
                font-size: Theme.fs-page-title;
                font-weight: Theme.weight-bold;
                color: Theme.text;
                vertical-alignment: center;
            }
            Section {
                title: @tr("Appearance");
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    for label[i] in [@tr("System"), @tr("Light"), @tr("Dark")]: Segment {
                        width: Theme.mac ? self.fit-width : 88px;
                        text: label;
                        selected: root.theme-pref == i;
                        clicked => { root.set-theme(i); }
                    }
                }
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Accent colour"); font-size: Theme.fs-label; color: Theme.text-secondary; }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 10px;
                    for c[i] in [#E5322D, #1F6FEB, #1A7F37, #8250DF, #D9730D, #57606A]: Swatch {
                        // On macOS the first choice is the system's accent (ui/theme.slint).
                        colour: Theme.mac && i == 0 ? Theme.system-accent : c;
                        selected: Theme.accent-choice == i;
                        clicked => { root.set-accent(i); }
                    }
                }
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Background behind pages"); font-size: Theme.fs-label; color: Theme.text-secondary; }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 10px;
                    for c[i] in [Theme.content-bg, #E4E4E7, #9A9AA0, #2B2B2E, #000000]: Swatch {
                        colour: c;
                        selected: root.backdrop-pref == i;
                        clicked => { root.set-backdrop(i); }
                    }
                }
            }
            // Acrobat's Page Display ▸ Rendering: smoothing off draws sharper, rougher edges.
            Section {
                title: @tr("Rendering");
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    for label[i] in [@tr("Smooth text"), @tr("Smooth line art"), @tr("Smooth images")]: Segment {
                        width: Theme.mac ? self.fit-width : 140px;
                        text: label;
                        selected: root.smooth[i];
                        clicked => { root.set-smoothing(i, !root.smooth[i]); }
                    }
                }
                // Acrobat's Page Display: the boxes a printer works with, and how pages are numbered.
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    Segment { width: Theme.mac ? self.fit-width : 214px; text: @tr("Show art, trim and bleed boxes"); selected: root.show-boxes; clicked => { root.set-page-display(0, !root.show-boxes); } }
                    Segment { width: Theme.mac ? self.fit-width : 214px; text: @tr("Page numbers as printed (iv)"); selected: !root.physical-numbers; clicked => { root.set-page-display(1, !root.physical-numbers); } }
                }
                // Acrobat's Show transparency grid.
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    Segment { width: Theme.mac ? self.fit-width : 214px; text: @tr("Show transparency grid"); selected: root.transparency-grid; clicked => { root.set-page-display(2, !root.transparency-grid); } }
                }
                // Acrobat's Colour Management: the monitor ICC, after PDFium's sRGB rendering.
                Text { text: @tr("Display colour profile"); font-size: Theme.fs-label; color: Theme.text-secondary; }
                Text { text: root.display-profile; font-size: Theme.fs-caption; color: Theme.text-muted; overflow: elide; }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    spacing: 8px;
                    Segment { width: Theme.mac ? self.fit-width : 214px; text: @tr("Choose monitor ICC…"); clicked => { root.choose-display-profile(); } }
                    Segment { width: Theme.mac ? self.fit-width : 214px; text: @tr("Use sRGB"); selected: root.display-profile == "sRGB"; clicked => { root.reset-display-profile(); } }
                    Segment { width: Theme.mac ? self.fit-width : 214px; text: @tr("Use the system's profile"); selected: SettingsBridge.display-system; clicked => { SettingsBridge.use-system-display(); } }
                }
                // Acrobat's Use 2D GPU acceleration.
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    Segment { width: Theme.mac ? self.fit-width : 214px; text: @tr("Use the graphics card"); selected: root.gpu; clicked => { root.set-gpu(true); } }
                    Segment { width: Theme.mac ? self.fit-width : 214px; text: @tr("Draw with the processor"); selected: !root.gpu; clicked => { root.set-gpu(false); } }
                }
            }
            Section {
                title: @tr("Identity");
                TextField {
                    label: @tr("Your name");
                    text: root.author-name;
                    placeholder: root.author-default;
                    changed text => { root.set-author(self.text); }
                }
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Signs your comments, and is the author of the PDFs Sheaf makes from images and documents.");
                    font-size: Theme.fs-caption;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
            Section {
                title: @tr("Output location");
                Radio {
                    text: @tr("Ask every time");
                    selected: root.output-mode == 0;
                    clicked => { root.set-output(0); }
                }
                Radio {
                    text: @tr("Save next to the original file");
                    selected: root.output-mode == 1;
                    clicked => { root.set-output(1); }
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 12px;
                    Radio {
                        horizontal-stretch: 1;
                        text: root.fixed-folder == "" ? @tr("Always save to a folder") : @tr("Always save to: {}", root.fixed-folder);
                        selected: root.output-mode == 2;
                        clicked => { root.set-output(2); }
                    }
                    SecondaryButton {
                        text: @tr("Choose…");
                        clicked => { root.choose-folder(); }
                    }
                }
            }
            Section {
                title: @tr("After processing");
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 12px;
                    Text {
                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        horizontal-stretch: 1;
                        text: @tr("Open the output folder when done");
                        font-size: Theme.fs-body;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Switch {
                        on: root.open-after;
                        toggled(v) => { root.set-open-after(v); }
                    }
                }
            }
            Section {
                title: @tr("Documents");
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    Segment { width: Theme.mac ? self.fit-width : 260px; text: @tr("Open PDFs with Sheaf by default"); clicked => { root.make-default(); } }
                }
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Open new documents at");
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    for label[i] in [@tr("Fit width"), @tr("Fit page"), @tr("Actual size")]: Segment {
                        width: Theme.mac ? self.fit-width : 104px;
                        text: label;
                        selected: root.default-zoom == i;
                        clicked => { root.set-default-zoom(i); }
                    }
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    for label[i] in [@tr("One page"), @tr("Two pages"), @tr("Two, cover alone")]: Segment {
                        width: Theme.mac ? self.fit-width : 136px;
                        text: label;
                        selected: root.default-spread == i;
                        clicked => { root.set-default-spread(i); }
                    }
                }
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Reopen documents");
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    Segment { width: Theme.mac ? self.fit-width : 180px; text: @tr("Where I left off"); selected: !root.open-first-page; clicked => { root.set-open-first-page(false); } }
                    Segment { width: Theme.mac ? self.fit-width : 180px; text: @tr("On the first page"); selected: root.open-first-page; clicked => { root.set-open-first-page(true); } }
                }
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Dated stamps write the time as");
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    for label[i] in [@tr("2:05 pm, Oct 25, 2026"), "25/10/2026 14:05", "2026-10-25 14:05"]: Segment {
                        width: Theme.mac ? self.fit-width : 168px;
                        text: label;
                        selected: root.stamp-date == i;
                        clicked => { root.set-stamp-date(i); }
                    }
                }
                // Acrobat's Units & Guides: the rulers' units.
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Rulers measure in");
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    Segment { width: Theme.mac ? self.fit-width : 140px; text: @tr("Inches"); selected: !root.metric; clicked => { root.set-metric(false); } }
                    Segment { width: Theme.mac ? self.fit-width : 140px; text: @tr("Centimetres"); selected: root.metric; clicked => { root.set-metric(true); } }
                }
                // Acrobat's Guide colour.
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Guides in");
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: start;
                    spacing: 8px;
                    for c[k] in [{ name: @tr("Cyan"), col: #00A6D6 }, { name: @tr("Magenta"), col: #E0218A }, { name: @tr("Green"), col: #2EA043 }, { name: @tr("Orange"), col: #F08C00 }]: Segment {
                        width: Theme.mac ? self.fit-width : 100px;
                        text: c.name;
                        selected: root.guide-colour == k;
                        clicked => { root.set-guide-colour(k); }
                        Rectangle { x: 8px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: c.col; }
                    }
                }
            }
            // Acrobat's Signatures ▸ Identities & Trusted Certificates.
            Section {
                title: @tr("Signatures");
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Digital IDs signed with"); font-size: Theme.fs-label; color: Theme.text-secondary; }
                if root.digital-ids.length == 0: Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("None yet: one picked to sign is kept here."); font-size: Theme.fs-caption; color: Theme.text-muted; }
                for d[k] in root.digital-ids: FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 8px;
                    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: d; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    SecondaryButton { text: @tr("Remove"); clicked => { root.signature-prefs(1, k); } }
                }
                FlexboxLayout { flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row; flex-wrap: FlexboxLayoutWrap.no-wrap; alignment: start; spacing: 8px; SecondaryButton { text: @tr("Add a digital ID…"); clicked => { root.signature-prefs(0, 0); } } SecondaryButton { text: @tr("Add a smart card or token…"); clicked => { root.signature-prefs(4, 0); } } SecondaryButton { text: @tr("Create a digital ID…"); clicked => { root.creating-id = !root.creating-id; } } }
                if root.creating-id: VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("A self-signed digital ID saved in a password-protected file (.p12), valid five years. Send its certificate to people who encrypt for you."); font-size: Theme.fs-caption; color: Theme.text-secondary; wrap: word-wrap; }
                    id-name := TextField { label: @tr("Name"); }
                    id-unit := TextField { label: @tr("Organizational unit (optional)"); }
                    id-org := TextField { label: @tr("Organization (optional)"); }
                    id-email := TextField { label: @tr("Email (optional)"); }
                    id-country := TextField { label: @tr("Country code (optional, such as BE)"); }
                    id-password := TextField { label: @tr("Password (6 characters or more)"); password: true; allow-reveal: true; }
                    id-confirm := TextField { label: @tr("Confirm password"); password: true; }
                    id-encrypt := Check { text: @tr("Use it for certificate encryption too"); checked: true; }
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: start;
                        SecondaryButton {
                            text: @tr("Create and save…");
                            clicked => { root.create-digital-id(id-name.text, id-unit.text, id-org.text, id-email.text, id-country.text, id-password.text, id-confirm.text, id-encrypt.checked); }
                        }
                    }
                }
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Certificates trusted"); font-size: Theme.fs-label; color: Theme.text-secondary; }
                if root.trusted-certs.length == 0: Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("None: a signature's certificate is trusted from Document properties, or added here."); font-size: Theme.fs-caption; color: Theme.text-muted; wrap: word-wrap; }
                for c[k] in root.trusted-certs: FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 8px;
                    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: c; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    SecondaryButton { text: @tr("Remove"); clicked => { root.signature-prefs(3, k); } }
                }
                FlexboxLayout { flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row; flex-wrap: FlexboxLayoutWrap.no-wrap; alignment: start; SecondaryButton { text: @tr("Trust a certificate…"); clicked => { root.signature-prefs(2, 0); } } }
                // Acrobat's Time Stamp Servers: the default first. None is contacted from here.
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Time stamp servers"); font-size: Theme.fs-label; color: Theme.text-secondary; }
                if Picked.tsa-servers.length == 0: Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("None: add the address of a time stamp server to time stamp documents and signatures."); font-size: Theme.fs-caption; color: Theme.text-muted; wrap: word-wrap; }
                for s[k] in Picked.tsa-servers: FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 8px;
                    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: k == 0 ? @tr("{} (default)", s) : s; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    if k > 0: SecondaryButton { text: @tr("Make default"); clicked => { Picked.tsa-prefs(2, k, ""); } }
                    SecondaryButton { text: @tr("Remove"); clicked => { Picked.tsa-prefs(1, k, ""); } }
                }
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: LayoutAlignment.stretch;
                    spacing: 8px;
                    tsa-url := TextField { horizontal-stretch: 1; label: @tr("Server address"); placeholder: "https://freetsa.org/tsr"; }
                    SecondaryButton {
                        text: @tr("Add server");
                        clicked => {
                            Picked.tsa-prefs(0, 0, tsa-url.text);
                            tsa-url.text = "";
                        }
                    }
                }
                Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Free servers: https://freetsa.org/tsr, http://timestamp.digicert.com. A time stamp sends the server only a fingerprint of the document, never the document."); font-size: Theme.fs-caption; color: Theme.text-muted; wrap: word-wrap; }
            }
            // Spelling, keyboard shortcuts, tools shown, direction (preferences-platform.slint).
            InterfaceSection {}
            SpellingSection {}
            KeyboardSection {}
            // Preferences ▸ AI (preferences-ai.slint).
            AiSection {}
            // Print defaults, Security and Startup (preferences-more.slint).
            PrintDefaultsSection {}
            SecuritySection {}
            StartupSection {}
            PluginsSection {}
        }
    }
}
