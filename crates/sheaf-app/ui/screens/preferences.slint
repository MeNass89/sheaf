import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Segment } from "../widgets/radio-card.slint";
import { SecondaryButton } from "dialogs.slint";
import { TextField } from "../widgets/text-field.slint";

// White card with a section title.
// A round colour to pick, ringed when chosen.
component Swatch inherits Rectangle {
    in property <color> colour;
    in property <bool> selected;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.text : Theme.input-border;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.colour;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Section inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius-card;
    background: Theme.card;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text {
            text: root.title;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
        }
        @children
    }
}

component Radio inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 26px;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: root.selected ? 0 : 1.5px;
            border-color: touch.has-hover ? Theme.text-secondary : Theme.option-border;
            background: root.selected ? Theme.accent : transparent;
            if root.selected: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.on-accent;
            }
        }
        Text {
            text: root.text;
            font-size: Theme.fs-body;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.accent : Theme.option-border;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        animate x { duration: 120ms; }
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// Preferences page: appearance, output location, after processing.
export component PreferencesScreen inherits Rectangle {
    // 0 = System, 1 = Light, 2 = Dark
    in property <int> theme-pref;
    // 0 = Ask, 1 = Next to the original, 2 = Fixed folder
    in property <int> output-mode;
    in property <string> fixed-folder;
    in property <bool> open-after;
    callback set-theme(int);
    callback set-output(int);
    callback choose-folder();
    callback set-open-after(bool);
    // The user's name, on comments and as the Author of the PDFs Sheaf makes from other files;
    // empty: the login name (shown as the placeholder).
    in property <string> author-name;
    in property <string> author-default;
    callback set-author(string);
    // How a document opened for the first time is shown (0 fit width, 1 fit page, 2 actual size).
    in property <int> default-zoom;
    callback set-default-zoom(int);
    // Make Sheaf the system's default PDF app (Acrobat's and PDF Expert's prompt).
    callback make-default();
    in property <int> default-spread;
    callback set-default-spread(int);
    in property <bool> open-first-page;
    callback set-open-first-page(bool);
    in property <[bool]> smooth;
    callback set-smoothing(int, bool);
    // Accent colour (Theme.accent-choice) and the window background behind the pages (0 as the
    // theme, then light grey, mid grey, dark, black; Preview's Window background).
    in property <int> backdrop-pref;
    callback set-accent(int);
    callback set-backdrop(int);
    // How dated stamps write the time (0 Acrobat's, 1 day first, 2 ISO).
    in property <int> stamp-date;
    callback set-stamp-date(int);
    in property <bool> metric;
    callback set-metric(bool);
    in property <int> guide-colour;
    callback set-guide-colour(int);
    in property <bool> gpu;
    callback set-gpu(bool);
    in property <bool> show-boxes;
    in property <bool> physical-numbers;
    callback set-page-display(int, bool);
    in property <[string]> digital-ids;
    in property <[string]> trusted-certs;
    callback signature-prefs(int, int);
    background: Theme.content-bg;

    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: scroll.visible-width;
            padding: Theme.content-padding;
            spacing: 16px;
            alignment: start;
            Text {
                height: 36px;
                text: "Preferences";
                font-size: Theme.fs-page-title;
                font-weight: Theme.weight-bold;
                color: Theme.text;
                vertical-alignment: center;
            }
            Section {
                title: "Appearance";
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for label[i] in ["System", "Light", "Dark"]: Segment {
                        width: 88px;
                        text: label;
                        selected: root.theme-pref == i;
                        clicked => { root.set-theme(i); }
                    }
                }
                Text { text: "Accent colour"; font-size: Theme.fs-label; color: Theme.text-secondary; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    for c[i] in [#E5322D, #1F6FEB, #1A7F37, #8250DF, #D9730D, #57606A]: Swatch {
                        colour: c;
                        selected: Theme.accent-choice == i;
                        clicked => { root.set-accent(i); }
                    }
                }
                Text { text: "Background behind pages"; font-size: Theme.fs-label; color: Theme.text-secondary; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    for c[i] in [Theme.content-bg, #E4E4E7, #9A9AA0, #2B2B2E, #000000]: Swatch {
                        colour: c;
                        selected: root.backdrop-pref == i;
                        clicked => { root.set-backdrop(i); }
                    }
                }
            }
            // Acrobat's Page Display ▸ Rendering: smoothing off draws sharper, rougher edges.
            Section {
                title: "Rendering";
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for label[i] in ["Smooth text", "Smooth line art", "Smooth images"]: Segment {
                        width: 140px;
                        text: label;
                        selected: root.smooth[i];
                        clicked => { root.set-smoothing(i, !root.smooth[i]); }
                    }
                }
                // Acrobat's Page Display: the boxes a printer works with, and how pages are numbered.
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Segment { width: 214px; text: "Show art, trim and bleed boxes"; selected: root.show-boxes; clicked => { root.set-page-display(0, !root.show-boxes); } }
                    Segment { width: 214px; text: "Page numbers as printed (iv)"; selected: !root.physical-numbers; clicked => { root.set-page-display(1, !root.physical-numbers); } }
                }
                // Acrobat's Use 2D GPU acceleration.
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Segment { width: 214px; text: "Use the graphics card"; selected: root.gpu; clicked => { root.set-gpu(true); } }
                    Segment { width: 214px; text: "Draw with the processor"; selected: !root.gpu; clicked => { root.set-gpu(false); } }
                }
            }
            // Acrobat's Signatures ▸ Identities & Trusted Certificates.
            Section {
                title: "Signatures";
                Text { text: "Digital IDs signed with"; font-size: Theme.fs-label; color: Theme.text-secondary; }
                if root.digital-ids.length == 0: Text { text: "None yet: one picked to sign is kept here."; font-size: Theme.fs-caption; color: Theme.text-muted; }
                for d[k] in root.digital-ids: HorizontalLayout {
                    spacing: 8px;
                    Text { text: d; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    SecondaryButton { text: "Remove"; clicked => { root.signature-prefs(1, k); } }
                }
                HorizontalLayout { alignment: start; SecondaryButton { text: "Add a digital ID…"; clicked => { root.signature-prefs(0, 0); } } }
                Text { text: "Certificates trusted"; font-size: Theme.fs-label; color: Theme.text-secondary; }
                if root.trusted-certs.length == 0: Text { text: "None: a signature's certificate is trusted from Document properties, or added here."; font-size: Theme.fs-caption; color: Theme.text-muted; wrap: word-wrap; }
                for c[k] in root.trusted-certs: HorizontalLayout {
                    spacing: 8px;
                    Text { text: c; font-size: Theme.fs-body; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    SecondaryButton { text: "Remove"; clicked => { root.signature-prefs(3, k); } }
                }
                HorizontalLayout { alignment: start; SecondaryButton { text: "Trust a certificate…"; clicked => { root.signature-prefs(2, 0); } } }
            }
            Section {
                title: "Identity";
                TextField {
                    label: "Your name";
                    text: root.author-name;
                    placeholder: root.author-default;
                    changed text => { root.set-author(self.text); }
                }
                Text {
                    text: "Signs your comments, and is the author of the PDFs Sheaf makes from images and documents.";
                    font-size: Theme.fs-caption;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
            Section {
                title: "Output location";
                Radio {
                    text: "Ask every time";
                    selected: root.output-mode == 0;
                    clicked => { root.set-output(0); }
                }
                Radio {
                    text: "Save next to the original file";
                    selected: root.output-mode == 1;
                    clicked => { root.set-output(1); }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Radio {
                        horizontal-stretch: 1;
                        text: root.fixed-folder == "" ? "Always save to a folder" : "Always save to: " + root.fixed-folder;
                        selected: root.output-mode == 2;
                        clicked => { root.set-output(2); }
                    }
                    SecondaryButton {
                        text: "Choose…";
                        clicked => { root.choose-folder(); }
                    }
                }
            }
            Section {
                title: "After processing";
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Open the output folder when done";
                        font-size: Theme.fs-body;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Switch {
                        on: root.open-after;
                        toggled(v) => { root.set-open-after(v); }
                    }
                }
            }
            Section {
                title: "Documents";
                HorizontalLayout {
                    alignment: start;
                    Segment { width: 260px; text: "Open PDFs with Sheaf by default"; clicked => { root.make-default(); } }
                }
                Text {
                    text: "Open new documents at";
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for label[i] in ["Fit width", "Fit page", "Actual size"]: Segment {
                        width: 104px;
                        text: label;
                        selected: root.default-zoom == i;
                        clicked => { root.set-default-zoom(i); }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for label[i] in ["One page", "Two pages", "Two, cover alone"]: Segment {
                        width: 136px;
                        text: label;
                        selected: root.default-spread == i;
                        clicked => { root.set-default-spread(i); }
                    }
                }
                Text {
                    text: "Reopen documents";
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Segment { width: 180px; text: "Where I left off"; selected: !root.open-first-page; clicked => { root.set-open-first-page(false); } }
                    Segment { width: 180px; text: "On the first page"; selected: root.open-first-page; clicked => { root.set-open-first-page(true); } }
                }
                Text {
                    text: "Dated stamps write the time as";
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for label[i] in ["2:05 pm, Oct 25, 2026", "25/10/2026 14:05", "2026-10-25 14:05"]: Segment {
                        width: 168px;
                        text: label;
                        selected: root.stamp-date == i;
                        clicked => { root.set-stamp-date(i); }
                    }
                }
                // Acrobat's Units & Guides: the rulers' units.
                Text {
                    text: "Rulers measure in";
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Segment { width: 140px; text: "Inches"; selected: !root.metric; clicked => { root.set-metric(false); } }
                    Segment { width: 140px; text: "Centimetres"; selected: root.metric; clicked => { root.set-metric(true); } }
                }
                // Acrobat's Guide colour.
                Text {
                    text: "Guides in";
                    font-size: Theme.fs-body;
                    color: Theme.text;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for c[k] in [{ name: "Cyan", col: #00A6D6 }, { name: "Magenta", col: #E0218A }, { name: "Green", col: #2EA043 }, { name: "Orange", col: #F08C00 }]: Segment {
                        width: 100px;
                        text: c.name;
                        selected: root.guide-colour == k;
                        clicked => { root.set-guide-colour(k); }
                        Rectangle { x: 8px; y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: c.col; }
                    }
                }
            }
        }
    }
}
