// The reader's options bar, floating over the top of the pages: the tool in use's options (stamp,
// shapes, pen widths, opacity, text format, signatures, colours) and the form's actions.
import { Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolButton, SmallButton, ColourDot, PanelField } from "reader-parts.slint";
import { SortCombo } from "../widgets/sort-combo.slint";
import { ToolTab, ReaderBridge, Parse } from "../flow-types.slint";

export component ReaderOptionsBar inherits Rectangle {
    property <bool> confirm-clear;
    in property <ToolTab> tab;
    in property <int> id;
    // The palettes, and which one is shown (see reader.slint).
    in property <[color]> light-colours;
    in property <[color]> ink-colours;
    in property <bool> light-tool;
    // The width the bar's content asks for.
    out property <length> bar-width: optbar.preferred-width;
    // The keyboard back to the pages.
    callback focus-pages();

    height: 36px;
    border-radius: Theme.radius-item;
    background: Theme.card;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000030;
    drop-shadow-offset-y: 2px;
    optbar := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 4px;
        // Stamp: which one (a click on the page places it).
        if root.tab.reader.tool == 12: SortCombo {
            y: 2px;
            width: 200px;
            options: root.tab.reader.stamps;
            current-index: root.tab.reader.stamp;
            chevron: @image-url("../icons/chevron-down.svg");
            selected(i) => { ReaderBridge.shape-option(root.id, 3, i); root.focus-pages(); }
        }
        // Shapes: which one, filled or not.
        if root.tab.reader.tool == 10: HorizontalLayout {
            spacing: 0px;
            ToolButton { icon: @image-url("../icons/square.svg"); tip: "Rectangle"; active: root.tab.reader.shape-kind == 0; clicked => { ReaderBridge.shape-option(root.id, 0, 0); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/circle.svg"); tip: "Oval"; active: root.tab.reader.shape-kind == 1; clicked => { ReaderBridge.shape-option(root.id, 0, 1); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/slash.svg"); tip: "Line"; active: root.tab.reader.shape-kind == 2; clicked => { ReaderBridge.shape-option(root.id, 0, 2); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/move-up-right.svg"); tip: "Arrow"; active: root.tab.reader.shape-kind == 3; clicked => { ReaderBridge.shape-option(root.id, 0, 3); root.focus-pages(); } }
            if root.tab.reader.shape-kind < 2 || root.tab.reader.shape-kind == 4 || root.tab.reader.shape-kind == 5: SmallButton { y: 2px; text: "Fill"; primary: root.tab.reader.shape-fill; clicked => { ReaderBridge.shape-option(root.id, 1, 0); root.focus-pages(); } }
            // The arrow's head (a click goes to the next) and both ends (Acrobat's Line Ends).
            if root.tab.reader.shape-kind == 3: SmallButton { y: 2px; text: root.tab.reader.arrow-head; clicked => { ReaderBridge.shape-option(root.id, 8, 0); root.focus-pages(); } }
            if root.tab.reader.shape-kind == 3: SmallButton { y: 2px; text: "Both ends"; primary: root.tab.reader.arrow-both; clicked => { ReaderBridge.shape-option(root.id, 9, 0); root.focus-pages(); } }
        }
        // Link: links of the text's web addresses; new links' look (Acrobat's Link Properties ▸
        // Appearance: invisible by default, else a border in the colour, width and style chosen).
        // Prepare form: the kind of field a drag or a click adds; Detect fields (Acrobat's automatic
        // field detection on a flat form).
        if root.tab.reader.tool == 14: HorizontalLayout {
            spacing: 2px;
            for k[i] in ["Text", "Check box", "Radio", "Dropdown", "List", "Date", "Button", "Signature", "Image"]: SmallButton {
                y: 2px;
                text: k;
                primary: root.tab.reader.field-kind == i;
                clicked => { ReaderBridge.field-kind(root.id, i); root.focus-pages(); }
            }
            Rectangle { width: 8px; }
            SmallButton { y: 2px; text: "Detect fields"; clicked => { ReaderBridge.detect-fields(root.id); root.focus-pages(); } }
            // Acrobat's View ▸ Grid with Snap to Grid: lines every 9 pt; fields placed or moved land on them.
            SmallButton { y: 2px; text: "Grid"; primary: root.tab.reader.form-grid; clicked => { ReaderBridge.form-grid(root.id); root.focus-pages(); } }
            // Acrobat's Tab Order: the order Tab goes through the fields of each page.
            tab-menu := PopupWindow {
                y: 34px;
                width: 160px;
                height: 3 * 28px + 8px;
                Rectangle {
                    background: Theme.card;
                    border-radius: Theme.radius-small;
                    border-width: 1px;
                    border-color: Theme.input-border;
                    VerticalLayout {
                        padding: 4px;
                        for o[k] in ["By rows", "By columns", "By structure"]: Rectangle {
                            height: 28px;
                            background: ta.has-hover ? Theme.popup-hover : transparent;
                            Text { x: 10px; text: o; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                            ta := TouchArea { clicked => { ReaderBridge.tab-order(root.id, k); root.focus-pages(); } }
                        }
                    }
                }
            }
            SmallButton { y: 2px; text: "Tab order"; clicked => { tab-menu.show(); } }
        }
        if root.tab.reader.tool == 13: HorizontalLayout {
            spacing: 4px;
            SmallButton { y: 2px; text: "Link web addresses"; clicked => { ReaderBridge.link-urls(root.id); root.focus-pages(); } }
            Rectangle { width: 6px; }
            SmallButton { y: 2px; text: "Border"; primary: root.tab.reader.link-visible; clicked => { ReaderBridge.shape-option(root.id, 4, 0); root.focus-pages(); } }
            if root.tab.reader.link-visible: SmallButton { y: 2px; text: "Dashed"; primary: root.tab.reader.link-dashed; clicked => { ReaderBridge.shape-option(root.id, 5, 0); root.focus-pages(); } }
        }
        if root.tab.reader.tool == 5 || root.tab.reader.tool == 10 || root.tab.reader.tool == 11 || (root.tab.reader.tool == 13 && root.tab.reader.link-visible) || root.tab.reader.selected-stroke: HorizontalLayout {
            spacing: 2px;
            padding-left: 6px;
            for w[k] in [2px, 4px, 7px, 10px]: Rectangle {
                y: 4px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                border-width: root.tab.reader.pen-width == k ? 2px : 0px;
                border-color: Theme.text;
                Rectangle {
                    width: w;
                    height: w;
                    border-radius: w / 2;
                    background: Theme.text-secondary;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ReaderBridge.set-pen-width(root.id, k); root.focus-pages(); }
                }
            }
            // Acrobat's line style: solid or dashed (pen and shapes, or the one selected).
            if root.tab.reader.tool == 5 || root.tab.reader.tool == 10 || root.tab.reader.selected-stroke: SmallButton { y: 2px; text: "- -"; primary: root.tab.reader.dashed; clicked => { ReaderBridge.shape-option(root.id, 17, 0); root.focus-pages(); } }
        }
        // Opacity: any value on a slider, four quick ones (Acrobat's Properties bar, PDF Expert's slider).
        if root.tab.reader.tool == 5 || root.tab.reader.tool == 10 || root.tab.reader.selected-stroke: Rectangle {
            width: op-btn.width;
            op-btn := SmallButton {
                y: 2px;
                text: root.tab.reader.opacity + " %";
                clicked => { op-menu.show(); }
            }
            op-menu := PopupWindow {
                x: 0;
                y: 34px;
                width: 220px;
                height: 72px;
                Rectangle {
                    background: Theme.input-bg;
                    border-radius: Theme.radius-small;
                    border-width: 1px;
                    border-color: Theme.input-border;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000022;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Slider {
                            minimum: 10;
                            maximum: 100;
                            value: root.tab.reader.opacity;
                            released(v) => { ReaderBridge.shape-option(root.id, 2, round(v / 5) * 5); }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            for p in [100, 75, 50, 25]: SmallButton {
                                text: p + " %";
                                primary: root.tab.reader.opacity == p;
                                clicked => { ReaderBridge.shape-option(root.id, 2, p); op-menu.close(); root.focus-pages(); }
                            }
                        }
                    }
                }
            }
        }
        // Shapes filled: their own fill colour (Acrobat's Fill Color), a tint of the stroke by default.
        if (root.tab.reader.tool == 10 && root.tab.reader.shape-fill && (root.tab.reader.shape-kind < 2 || root.tab.reader.shape-kind == 4 || root.tab.reader.shape-kind == 5)) || root.tab.reader.selected-fillable: HorizontalLayout {
            spacing: 2px;
            padding-left: 4px;
            Text { text: "Fill"; font-size: Theme.fs-caption; color: Theme.text-secondary; vertical-alignment: center; }
            // Acrobat's No Fill Color.
            SmallButton { y: 2px; text: "None"; clicked => { ReaderBridge.shape-option(root.id, 19, 0); root.focus-pages(); } }
            ColourDot {
                y: 4px;
                colour: transparent;
                selected: root.tab.reader.fill-colour == -1;
                clicked => { ReaderBridge.shape-option(root.id, 6, -1); root.focus-pages(); }
            }
            for c[k] in root.light-colours: ColourDot {
                y: 4px;
                colour: c;
                selected: root.tab.reader.fill-colour == k;
                clicked => { ReaderBridge.shape-option(root.id, 6, k); root.focus-pages(); }
            }
        }
        // A page image selected with the Edit tool: turn, flip, replace or delete it (its
        // corners on the page resize it).
        if root.tab.reader.selected-image: HorizontalLayout {
            spacing: 4px;
            ToolButton { y: 0px; icon: @image-url("../icons/rotate-ccw.svg"); tip: "Rotate left"; clicked => { ReaderBridge.image-action(root.id, 0); root.focus-pages(); } }
            ToolButton { y: 0px; icon: @image-url("../icons/rotate-cw.svg"); tip: "Rotate right"; clicked => { ReaderBridge.image-action(root.id, 1); root.focus-pages(); } }
            ToolButton { y: 0px; icon: @image-url("../icons/flip-horizontal-2.svg"); tip: "Flip"; clicked => { ReaderBridge.image-action(root.id, 2); root.focus-pages(); } }
            ToolButton { y: 0px; icon: @image-url("../icons/replace.svg"); tip: "Replace…"; clicked => { ReaderBridge.image-action(root.id, 3); root.focus-pages(); } }
            ToolButton { y: 0px; icon: @image-url("../icons/download.svg"); tip: "Save image as…"; clicked => { ReaderBridge.image-action(root.id, 5); root.focus-pages(); } }
            ToolButton { y: 0px; icon: @image-url("../icons/trash-2.svg"); tip: "Delete"; clicked => { ReaderBridge.image-action(root.id, 4); root.focus-pages(); } }
        }
        // The text format: of text boxes (also the selected one) and of text added on
        // the page (Edit text).
        if !root.tab.reader.selected-image && (root.tab.reader.tool == 6 || root.tab.reader.tool == 7 || root.tab.reader.selected-text-box): HorizontalLayout {
            spacing: 4px;
            SmallButton { y: 2px; text: "Sans"; primary: root.tab.reader.text-family == 0; clicked => { ReaderBridge.text-format(root.id, 1, 0); } }
            SmallButton { y: 2px; text: "Serif"; primary: root.tab.reader.text-family == 1; clicked => { ReaderBridge.text-format(root.id, 1, 1); } }
            SmallButton { y: 2px; text: "Mono"; primary: root.tab.reader.text-family == 2; clicked => { ReaderBridge.text-format(root.id, 1, 2); } }
            SmallButton { y: 2px; text: "B"; primary: root.tab.reader.text-bold; clicked => { ReaderBridge.text-format(root.id, 2, 0); } }
            SmallButton { y: 2px; text: "I"; primary: root.tab.reader.text-italic; clicked => { ReaderBridge.text-format(root.id, 3, 0); } }
            // Text added on the page: underlined, a bulleted list (Acrobat's Edit PDF format panel).
            if root.tab.reader.tool == 7: SmallButton { y: 2px; text: "U"; primary: root.tab.reader.text-underline; clicked => { ReaderBridge.text-format(root.id, 6, 0); } }
            if root.tab.reader.tool == 7: SmallButton { y: 2px; text: "•"; primary: root.tab.reader.text-bullets; clicked => { ReaderBridge.text-format(root.id, 7, 0); } }
            for icon[k] in [@image-url("../icons/align-left.svg"), @image-url("../icons/align-center.svg"), @image-url("../icons/align-right.svg")]: ToolButton {
                icon: icon;
                tip: ["Align left", "Centre", "Align right"][k];
                active: root.tab.reader.text-align == k;
                clicked => { ReaderBridge.text-format(root.id, 4, k); }
            }
            SmallButton { y: 2px; text: "−"; clicked => { ReaderBridge.text-format(root.id, 0, -1); } }
            // The size: − and + step through the presets; any size can be typed (↩).
            Rectangle {
                property <int> shown: root.tab.reader.text-size;
                changed shown => { if !size-field.has-focus { size-field.text = self.shown + " pt"; } }
                init => { size-field.text = self.shown + " pt"; }
                width: 48px;
                height: 26px;
                y: 2px;
                border-radius: Theme.radius-small;
                border-width: size-field.has-focus || size-hover.has-hover ? 1px : 0px;
                border-color: Theme.input-border;
                background: size-field.has-focus ? Theme.input-bg : transparent;
                size-hover := TouchArea { }
                size-field := TextInput {
                    font-size: Theme.fs-label;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => {
                        ReaderBridge.text-size-typed(root.id, self.text);
                        self.text = root.tab.reader.text-size + " pt";
                        root.focus-pages();
                    }
                }
            }
            SmallButton { y: 2px; text: "+"; clicked => { ReaderBridge.text-format(root.id, 0, 1); } }
            // Acrobat's Callout: the text box points at where the click was, by a line with an arrow.
            if root.tab.reader.tool == 6 && !root.tab.reader.selected-text-box: SmallButton { y: 2px; text: "Callout"; primary: root.tab.reader.callout; clicked => { ReaderBridge.shape-option(root.id, 11, 0); root.focus-pages(); } }
        }
        if root.tab.reader.has-signature: HorizontalLayout {
            spacing: 6px;
            // Kept signatures (PDF Expert's list): the first is placed; a click picks another,
            // × forgets one.
            for sig[k] in root.tab.reader.signatures: Rectangle {
                width: 72px;
                height: 28px;
                y: 1px;
                border-radius: Theme.radius-small;
                border-width: k == 0 ? 2px : 1px;
                border-color: k == 0 ? Theme.accent : Theme.input-border;
                background: Theme.input-bg;
                Image { width: parent.width - 8px; height: parent.height - 6px; source: sig; image-fit: contain; }
                sgt := TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.signature-pick(root.id, k, false); root.focus-pages(); } }
                Rectangle {
                    opacity: sgt.has-hover || sgx.has-hover ? 1 : 0;
                    x: parent.width - 14px;
                    y: -4px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.toast-bg;
                    Text { text: "×"; font-size: 11px; color: Theme.on-toast; }
                    sgx := TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.signature-pick(root.id, k, true); root.focus-pages(); } }
                }
            }
            SmallButton { y: 2px; text: "New signature"; clicked => { ReaderBridge.signature-reset(root.id); } }
        }
        // Acrobat's Fill & Sign ▸ Add Initials: kept apart from the signatures, placed smaller.
        if root.tab.reader.tool == 9: SmallButton { y: 2px; text: "Initials"; primary: root.tab.reader.initials; clicked => { ReaderBridge.shape-option(root.id, 13, 0); root.focus-pages(); } }
        if root.tab.reader.tool == 9 && root.tab.reader.initials: SmallButton { y: 2px; text: "New initials"; clicked => { ReaderBridge.shape-option(root.id, 14, 0); root.focus-pages(); } }
        // A stamp, picture or signature selected (Acrobat's Rotate on a stamp): a quarter turn clockwise.
        if root.tab.reader.selected-turnable: SmallButton { y: 2px; text: "Turn ↻"; clicked => { ReaderBridge.shape-option(root.id, 16, 0); root.focus-pages(); } }
        // The same place on every page, one click (initials down a contract's pages).
        if root.tab.reader.tool == 9: SmallButton { y: 2px; text: "Every page"; primary: root.tab.reader.sign-every-page; clicked => { ReaderBridge.shape-option(root.id, 15, 0); root.focus-pages(); } }
        // Which pages (Acrobat's Place on multiple pages: a range, odd, even): empty, all of them.
        if root.tab.reader.tool == 9 && root.tab.reader.sign-every-page: PanelField {
            y: 3px;
            width: 110px;
            placeholder: "All pages";
            edited(t) => { ReaderBridge.sign-pages(root.id, t); }
        }
        if !root.tab.reader.selected-image && ((root.tab.reader.tool != 0 && root.tab.reader.tool != 8 && root.tab.reader.tool != 9 && root.tab.reader.tool != 11 && (root.tab.reader.tool != 12 || root.tab.reader.stamp < 4) && root.tab.reader.tool != 14 && (root.tab.reader.tool != 13 || root.tab.reader.link-visible)) || root.tab.reader.selected-annot): HorizontalLayout {
            spacing: 2px;
            padding-left: 6px;
            for c[k] in (root.light-tool ? root.light-colours : root.ink-colours): ColourDot {
                y: 4px;
                colour: c;
                selected: root.tab.reader.selected-annot ? root.tab.reader.annot-colour == k : root.tab.reader.colour == k;
                clicked => { ReaderBridge.set-colour(root.id, k); root.focus-pages(); }
            }
            // The sixth: any colour, from a palette or typed (Acrobat's Other color, PDF Expert's
            // colour picker); it stays in the row once picked.
            Rectangle {
                width: 22px;
                ColourDot {
                    y: 4px;
                    colour: root.light-tool ? root.tab.reader.custom-light : root.tab.reader.custom-ink;
                    selected: root.tab.reader.selected-annot ? root.tab.reader.annot-colour == 5 : root.tab.reader.colour == 5;
                    clicked => { palette.show(); }
                }
                Text {
                    x: 15px;
                    y: 1px;
                    text: "+";
                    font-size: 10px;
                    font-weight: Theme.weight-bold;
                    color: Theme.text-secondary;
                }
                palette := PopupWindow {
                    x: -80px;
                    y: 30px;
                    width: 196px;
                    height: 128px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: Theme.input-bg;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: Theme.input-border;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000022;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            for row in [
                                ["F2C12E", "F28C28", "E5322D", "D6336C", "AE3EC9", "7048E8"],
                                ["4263EB", "1C7ED6", "1098AD", "0CA678", "37B24D", "74B816"],
                                ["000000", "495057", "868E96", "CED4DA", "8B5A2B", "FFFFFF"],
                            ]: HorizontalLayout {
                                spacing: 6px;
                                for hex in row: Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: Parse.colour(hex, 0);
                                    border-width: sw.has-hover ? 2px : 1px;
                                    border-color: sw.has-hover ? Theme.text : #00000022;
                                    sw := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { ReaderBridge.set-custom-colour(root.id, hex); palette.close(); root.focus-pages(); }
                                    }
                                }
                            }
                            Rectangle {
                                height: 22px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: hex-in.has-focus ? Theme.text-secondary : Theme.input-border;
                                if hex-in.text == "": Text {
                                    x: 6px;
                                    text: "# RRGGBB, then Enter";
                                    font-size: Theme.fs-caption;
                                    color: Theme.text-disabled;
                                    vertical-alignment: center;
                                }
                                hex-in := TextInput {
                                    x: 6px;
                                    width: parent.width - 12px;
                                    font-size: Theme.fs-caption;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accepted => {
                                        if Parse.colour-error(self.text) == "" && self.text != "" {
                                            ReaderBridge.set-custom-colour(root.id, self.text);
                                            palette.close();
                                            root.focus-pages();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Added after the colours and pens, so those keep their places.
        // A picture of one's own as the stamp (Acrobat's custom stamp).
        if root.tab.reader.tool == 12: SmallButton {
            y: 2px;
            text: root.tab.reader.stamp-image == "" ? "Image…" : root.tab.reader.stamp-image;
            primary: root.tab.reader.stamp-image != "";
            clicked => { ReaderBridge.stamp-image(root.id); root.focus-pages(); }
        }
        if root.tab.reader.tool == 10: HorizontalLayout {
            spacing: 0px;
            padding-left: 6px;
            // Clicked out vertex by vertex, a double-click to end (Acrobat's Polygon, Cloud, Polygonal Line);
            // hidden while measuring, so the scale and Calibrate fit (a shape icon brings them back).
            if root.tab.reader.shape-kind < 7: SmallButton { y: 2px; text: "Polygon"; primary: root.tab.reader.shape-kind == 4; clicked => { ReaderBridge.shape-option(root.id, 0, 4); root.focus-pages(); } }
            if root.tab.reader.shape-kind < 7: SmallButton { y: 2px; text: "Cloud"; primary: root.tab.reader.shape-kind == 5; clicked => { ReaderBridge.shape-option(root.id, 0, 5); root.focus-pages(); } }
            if root.tab.reader.shape-kind < 7: SmallButton { y: 2px; text: "Polyline"; primary: root.tab.reader.shape-kind == 6; clicked => { ReaderBridge.shape-option(root.id, 0, 6); root.focus-pages(); } }
            // Acrobat's Measuring tools, in true size or at a scale.
            Rectangle { width: 6px; }
            for m[k] in ["Distance", "Perimeter", "Area"]: SmallButton { y: 2px; text: m; primary: root.tab.reader.shape-kind == 7 + k; clicked => { ReaderBridge.shape-option(root.id, 0, 7 + k); root.focus-pages(); } }
            // The scale they measure at (Acrobat's Scale Ratio): a click goes to the next.
            if root.tab.reader.shape-kind >= 7: SmallButton { y: 2px; text: root.tab.reader.measure-scale; clicked => { ReaderBridge.shape-option(root.id, 10, 0); root.focus-pages(); } }
            // Acrobat's Precision: the decimals the measures are written with.
            if root.tab.reader.shape-kind >= 7: SmallButton { y: 2px; text: root.tab.reader.measure-decimals == 0 ? "1" : root.tab.reader.measure-decimals == 1 ? "0.1" : root.tab.reader.measure-decimals == 2 ? "0.01" : "0.001"; clicked => { ReaderBridge.shape-option(root.id, 18, 0); root.focus-pages(); } }
            // Acrobat's and Bluebeam's Calibrate: measure a length you know, type it.
            if root.tab.reader.shape-kind == 7: SmallButton { y: 2px; text: "Calibrate"; primary: root.tab.reader.calibrating; clicked => { ReaderBridge.shape-option(root.id, 12, 0); root.focus-pages(); } }
        }
        Rectangle { horizontal-stretch: 1; }
        // Filling's form actions; Prepare form has its own row (the two did not fit the window).
        if root.tab.reader.has-form && root.tab.reader.tool != 14: HorizontalLayout {
            spacing: 4px;
            padding-right: 6px;
            // Clear form asks first, as Acrobat's Reset Form ("Are you sure…"): every value is lost.
            if !root.confirm-clear: SmallButton { y: 2px; text: "Clear form"; clicked => { root.confirm-clear = true; } }
            if root.confirm-clear: Text {
                text: "Clear every field?";
                font-size: Theme.fs-caption;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.confirm-clear: SmallButton {
                y: 2px;
                text: "Clear";
                primary: true;
                clicked => {
                    root.confirm-clear = false;
                    ReaderBridge.form-op(root.id, 0);
                }
            }
            if root.confirm-clear: SmallButton { y: 2px; text: "Cancel"; clicked => { root.confirm-clear = false; } }
            if !root.confirm-clear: SmallButton { y: 2px; text: "Flatten"; clicked => { ReaderBridge.form-op(root.id, 1); } }
            // Acrobat's Export Data and Import Data (XFDF, FDF, XML, CSV, text).
            if !root.confirm-clear: SmallButton { y: 2px; text: "Export data…"; clicked => { ReaderBridge.form-op(root.id, 3); } }
            if !root.confirm-clear: SmallButton { y: 2px; text: "Import data…"; clicked => { ReaderBridge.form-op(root.id, 4); } }
        }
    }
}
