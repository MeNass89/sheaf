// The reader's options bar, floating over the top of the pages: the tool in use's options (stamp,
// shapes, pen widths, opacity, text format, signatures, colours) and the form's actions.
import { PlatformBridge } from "../platform.slint";
import { Slider, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolButton, SmallButton, ColourDot, PanelField, PopoverFrame, Divider, StrokeWidth } from "reader-parts.slint";
import { SortCombo } from "../widgets/sort-combo.slint";
import { ToolTab, ReaderBridge, Parse } from "../flow-types.slint";

// macOS: a hairline between the text format's groups (font | B I U | lists | alignment | size |
// more fonts), as Pages's format bar groups them.
component GroupGap inherits Rectangle {
    width: 17px;
    height: 20px;
    Divider { x: 8px; }
}

export component ReaderOptionsBar inherits PopoverFrame {
    property <bool> confirm-clear;
    in property <ToolTab> tab;
    in property <int> id;
    // The palettes, and which one is shown (see reader.slint).
    in property <[color]> light-colours;
    in property <[color]> ink-colours;
    in property <bool> light-tool;
    // The width the bar's content asks for.
    out property <length> bar-width: root.tab.reader.tool == 10 ? max(optbar.preferred-width, shapes2.preferred-width) : optbar.preferred-width;
    // The keyboard back to the pages.
    callback focus-pages();

    height: root.tab.reader.tool == 10 ? 69px : 36px;
    // Flexboxes, not HorizontalLayouts, so that right to left (Preferences ▸ Interface ▸ Direction)
    // reverses the options; an item centred across replaces the small `y` nudge a row allowed.
    optbar := FlexboxLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 36px;
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 4px;
        // Stamp: which one (a click on the page places it).
        if root.tab.reader.tool == 12: SortCombo {
            cross-axis-self-alignment: CrossAxisAlignment.center;
            width: 200px;
            options: root.tab.reader.stamps;
            current-index: root.tab.reader.stamp;
            chevron: @image-url("../icons/chevron-down.svg");
            selected(i) => { ReaderBridge.shape-option(root.id, 3, i); root.focus-pages(); }
        }
        // Shapes: which one, filled or not.
        if root.tab.reader.tool == 10: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 4px;
            ToolButton { icon: @image-url("../icons/square.svg"); tip: @tr("Rectangle"); active: root.tab.reader.shape-kind == 0; clicked => { ReaderBridge.shape-option(root.id, 0, 0); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/circle.svg"); tip: @tr("Oval"); active: root.tab.reader.shape-kind == 1; clicked => { ReaderBridge.shape-option(root.id, 0, 1); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/slash.svg"); tip: @tr("Line"); active: root.tab.reader.shape-kind == 2; clicked => { ReaderBridge.shape-option(root.id, 0, 2); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/move-up-right.svg"); tip: @tr("Arrow"); active: root.tab.reader.shape-kind == 3; clicked => { ReaderBridge.shape-option(root.id, 0, 3); root.focus-pages(); } }
            if root.tab.reader.shape-kind < 2 || root.tab.reader.shape-kind == 4 || root.tab.reader.shape-kind == 5: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Fill"); on: root.tab.reader.shape-fill; clicked => { ReaderBridge.shape-option(root.id, 1, 0); root.focus-pages(); } }
            // The arrow's head (a click goes to the next) and both ends (Acrobat's Line Ends).
            if root.tab.reader.shape-kind == 3: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: root.tab.reader.arrow-head; clicked => { ReaderBridge.shape-option(root.id, 8, 0); root.focus-pages(); } }
            if root.tab.reader.shape-kind == 3: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Both ends"); on: root.tab.reader.arrow-both; clicked => { ReaderBridge.shape-option(root.id, 9, 0); root.focus-pages(); } }
            // Preview's Loupe (the page magnified in a circle dragged) and Mask (the page dimmed
            // outside the rectangle or oval dragged).
            if root.tab.reader.shape-kind < 2: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Loupe"); on: root.tab.reader.shape-special == 1; clicked => { ReaderBridge.shape-option(root.id, 30, 0); root.focus-pages(); } }
            if root.tab.reader.shape-special == 1: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: root.tab.reader.loupe-magnify; clicked => { ReaderBridge.shape-option(root.id, 35, 0); root.focus-pages(); } }
            if root.tab.reader.shape-kind < 2: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Mask"); on: root.tab.reader.shape-special == 2; clicked => { ReaderBridge.shape-option(root.id, 31, 0); root.focus-pages(); } }
            // Acrobat's Article tool: boxes dragged one after the other make an article's reading
            // order, across columns and pages; End starts the next article; Delete removes one.
            if root.tab.reader.shape-kind < 2: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Article"); on: root.tab.reader.shape-special == 3; clicked => { ReaderBridge.shape-option(root.id, 32, 0); root.focus-pages(); } }
            if root.tab.reader.shape-special == 3: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("End article"); clicked => { ReaderBridge.shape-option(root.id, 33, 0); root.focus-pages(); } }
            if root.tab.reader.shape-special == 3: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Delete article"); clicked => { ReaderBridge.shape-option(root.id, 34, 0); root.focus-pages(); } }
        }
        // A loupe selected (Preview's): its magnification, a click goes to the next.
        if root.tab.reader.selected-loupe && root.tab.reader.tool != 10: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 4px;
            Text { text: @tr("Loupe"); font-size: Theme.fs-caption; color: Theme.text-secondary; vertical-alignment: center; }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: root.tab.reader.loupe-magnify; clicked => { ReaderBridge.shape-option(root.id, 35, 0); root.focus-pages(); } }
        }
        // Link: links of the text's web addresses; new links' look (Acrobat's Link Properties ▸
        // Appearance: invisible by default, else a border in the colour, width and style chosen).
        // Prepare form: the kind of field a drag or a click adds; Detect fields (Acrobat's automatic
        // field detection on a flat form).
        if root.tab.reader.tool == 14: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 2px;
            for k[i] in [@tr("Text"), @tr("Check box"), @tr("Radio"), @tr("Dropdown"), @tr("List"), @tr("Date"), @tr("Button"), @tr("Signature"), @tr("Image"), @tr("Barcode")]: SmallButton {
                cross-axis-self-alignment: CrossAxisAlignment.center;
                text: k;
                on: root.tab.reader.field-kind == i;
                clicked => { ReaderBridge.field-kind(root.id, i); root.focus-pages(); }
            }
            // Acrobat's barcode field: a QR Code of the form's data; its error correction, Low to High.
            if root.tab.reader.field-kind == 9: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Error correction: {}", root.tab.reader.barcode-ecc); clicked => { ReaderBridge.shape-option(root.id, 61, 0); root.focus-pages(); } }
            Rectangle { width: 8px; }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Detect fields"); clicked => { ReaderBridge.detect-fields(root.id); root.focus-pages(); } }
            // Acrobat's View ▸ Grid with Snap to Grid: lines every 9 pt; fields placed or moved land on them.
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Grid"); on: root.tab.reader.form-grid; clicked => { ReaderBridge.form-grid(root.id); root.focus-pages(); } }
            // Acrobat's Tab Order: the order Tab goes through the fields of each page.
            tab-menu := PopupWindow {
                y: 34px;
                width: 160px;
                height: 3 * 28px + 8px;
                PopoverFrame {
                    VerticalLayout {
                        padding: 4px;
                        for o[k] in [@tr("By rows"), @tr("By columns"), @tr("By structure")]: Rectangle {
                            height: 28px;
                            background: ta.has-hover ? Theme.popup-hover : transparent;
                            Text { x: 10px; text: o; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                            ta := TouchArea { clicked => { ReaderBridge.tab-order(root.id, k); root.focus-pages(); } }
                        }
                    }
                }
            }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Tab order"); clicked => { tab-menu.show(); } }
        }
        if root.tab.reader.tool == 13: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 4px;
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Link web addresses"); clicked => { ReaderBridge.link-urls(root.id); root.focus-pages(); } }
            Rectangle { width: 6px; }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Border"); on: root.tab.reader.link-visible; clicked => { ReaderBridge.shape-option(root.id, 4, 0); root.focus-pages(); } }
            if root.tab.reader.link-visible: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Dashed"); on: root.tab.reader.link-dashed; clicked => { ReaderBridge.shape-option(root.id, 5, 0); root.focus-pages(); } }
        }
        if root.tab.reader.tool == 5 || root.tab.reader.tool == 10 || root.tab.reader.tool == 11 || (root.tab.reader.tool == 13 && root.tab.reader.link-visible) || root.tab.reader.selected-stroke: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 2px;
            padding-left: 6px;
            for w[k] in [2px, 4px, 7px, 10px]: StrokeWidth {
                cross-axis-self-alignment: CrossAxisAlignment.center;
                thickness: w;
                selected: root.tab.reader.pen-width == k;
                clicked => { ReaderBridge.set-pen-width(root.id, k); root.focus-pages(); }
            }
            // Acrobat's line style: solid or dashed (pen and shapes, or the one selected).
            if root.tab.reader.tool == 5 || root.tab.reader.tool == 10 || root.tab.reader.selected-stroke: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: "- -"; on: root.tab.reader.dashed; clicked => { ReaderBridge.shape-option(root.id, 17, 0); root.focus-pages(); } }
        }
        // Opacity: any value on a slider, four quick ones (Acrobat's Properties bar, PDF Expert's slider).
        if root.tab.reader.tool == 5 || root.tab.reader.tool == 10 || root.tab.reader.selected-stroke: Rectangle {
            width: op-btn.width;
            op-btn := SmallButton {
                y: 2px;
                text: root.tab.reader.opacity + " %";
                clicked => { op-menu.show(); }
            }
            op-menu := PopupWindow {
                x: 0;
                y: 34px;
                width: 220px;
                height: 72px;
                PopoverFrame {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Slider {
                            minimum: 10;
                            maximum: 100;
                            value: root.tab.reader.opacity;
                            released(v) => { ReaderBridge.shape-option(root.id, 2, round(v / 5) * 5); }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            for p in [100, 75, 50, 25]: SmallButton {
                                text: p + " %";
                                on: root.tab.reader.opacity == p;
                                clicked => { ReaderBridge.shape-option(root.id, 2, p); op-menu.close(); root.focus-pages(); }
                            }
                        }
                    }
                }
            }
        }
        // Shapes filled: their own fill colour (Acrobat's Fill Color), a tint of the stroke by default.
        if (root.tab.reader.tool == 10 && root.tab.reader.shape-fill && (root.tab.reader.shape-kind < 2 || root.tab.reader.shape-kind == 4 || root.tab.reader.shape-kind == 5)) || root.tab.reader.selected-fillable: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 2px;
            padding-left: 4px;
            Text { text: @tr("Fill"); font-size: Theme.fs-caption; color: Theme.text-secondary; vertical-alignment: center; }
            // Acrobat's No Fill Color.
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("None"); clicked => { ReaderBridge.shape-option(root.id, 19, 0); root.focus-pages(); } }
            ColourDot {
                cross-axis-self-alignment: CrossAxisAlignment.center;
                colour: transparent;
                selected: root.tab.reader.fill-colour == -1;
                clicked => { ReaderBridge.shape-option(root.id, 6, -1); root.focus-pages(); }
            }
            for c[k] in root.light-colours: ColourDot {
                cross-axis-self-alignment: CrossAxisAlignment.center;
                colour: c;
                selected: root.tab.reader.fill-colour == k;
                clicked => { ReaderBridge.shape-option(root.id, 6, k); root.focus-pages(); }
            }
        }
        // A page image selected with the Edit tool: turn, flip, replace or delete it (its
        // corners on the page resize it).
        if root.tab.reader.selected-image: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 4px;
            ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/rotate-ccw.svg"); tip: @tr("Rotate left"); clicked => { ReaderBridge.image-action(root.id, 0); root.focus-pages(); } }
            ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/rotate-cw.svg"); tip: @tr("Rotate right"); clicked => { ReaderBridge.image-action(root.id, 1); root.focus-pages(); } }
            ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/flip-horizontal-2.svg"); tip: @tr("Flip"); clicked => { ReaderBridge.image-action(root.id, 2); root.focus-pages(); } }
            ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/replace.svg"); tip: @tr("Replace…"); clicked => { ReaderBridge.image-action(root.id, 3); root.focus-pages(); } }
            ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/download.svg"); tip: @tr("Save image as…"); clicked => { ReaderBridge.image-action(root.id, 5); root.focus-pages(); } }
            ToolButton { cross-axis-self-alignment: CrossAxisAlignment.center; icon: @image-url("../icons/trash-2.svg"); tip: @tr("Delete"); clicked => { ReaderBridge.image-action(root.id, 4); root.focus-pages(); } }
        }
        // The text format: of text boxes (also the selected one) and of text added on
        // the page (Edit text).
        if !root.tab.reader.selected-image && (root.tab.reader.tool == 6 || root.tab.reader.tool == 7 || root.tab.reader.selected-text-box): FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 4px;
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Sans"); on: root.tab.reader.text-family == 0 && root.tab.reader.text-font == ""; clicked => { ReaderBridge.text-format(root.id, 1, 0); } }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Serif"); on: root.tab.reader.text-family == 1 && root.tab.reader.text-font == ""; clicked => { ReaderBridge.text-format(root.id, 1, 1); } }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Mono"); on: root.tab.reader.text-family == 2 && root.tab.reader.text-font == ""; clicked => { ReaderBridge.text-format(root.id, 1, 2); } }
            GroupGap { cross-axis-self-alignment: CrossAxisAlignment.center; }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("B"); on: root.tab.reader.text-bold; clicked => { ReaderBridge.text-format(root.id, 2, 0); } }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("I"); on: root.tab.reader.text-italic; clicked => { ReaderBridge.text-format(root.id, 3, 0); } }
            // Text added on the page, or the paragraph open: underlined, a bulleted list (Acrobat's Edit
            // PDF format panel).
            if root.tab.reader.tool == 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("U"); on: root.tab.reader.text-underline; clicked => { ReaderBridge.text-format(root.id, 6, 0); } }
            if root.tab.reader.tool == 7: GroupGap { cross-axis-self-alignment: CrossAxisAlignment.center; }
            if root.tab.reader.tool == 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: "•"; on: root.tab.reader.text-bullets; clicked => { ReaderBridge.text-format(root.id, 7, 0); } }
            if root.tab.reader.tool == 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: "1."; on: root.tab.reader.text-numbers; clicked => { ReaderBridge.text-format(root.id, 10, 0); } }
            GroupGap { cross-axis-self-alignment: CrossAxisAlignment.center; }
            for icon[k] in [@image-url("../icons/align-left.svg"), @image-url("../icons/align-center.svg"), @image-url("../icons/align-right.svg")]: ToolButton {
                icon: icon;
                tip: [@tr("Align left"), @tr("Centre"), @tr("Align right")][k];
                active: root.tab.reader.text-align == k;
                clicked => { ReaderBridge.text-format(root.id, 4, k); }
            }
            GroupGap { cross-axis-self-alignment: CrossAxisAlignment.center; }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: "−"; clicked => { ReaderBridge.text-format(root.id, 0, -1); } }
            // The size: − and + step through the presets; any size can be typed (↩).
            Rectangle {
                property <int> shown: root.tab.reader.text-size;
                changed shown => { if !size-field.has-focus { size-field.text = self.shown + " pt"; } }
                init => { size-field.text = self.shown + " pt"; }
                width: 48px;
                height: 26px;
                cross-axis-self-alignment: CrossAxisAlignment.center;
                border-radius: Theme.radius-small;
                border-width: size-field.has-focus || size-hover.has-hover ? 1px : 0px;
                border-color: Theme.input-border;
                background: size-field.has-focus ? Theme.input-bg : transparent;
                size-hover := TouchArea { }
                size-field := TextInput {
                    // Tools page tools' keys wait while a field has the keyboard.
                    changed has-focus => { PlatformBridge.typing = self.has-focus; }
                    font-size: Theme.fs-label;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => {
                        ReaderBridge.text-size-typed(root.id, self.text);
                        self.text = root.tab.reader.text-size + " pt";
                        root.focus-pages();
                    }
                }
            }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: "+"; clicked => { ReaderBridge.text-format(root.id, 0, 1); } }
            GroupGap { cross-axis-self-alignment: CrossAxisAlignment.center; }
            // Last in the row, so the buttons before it keep their places.
            // One of the computer's fonts, for the paragraph open, new text or a text box
            // (Acrobat's font list).
            Rectangle {
                // Its own width (the preferred width read short and the next control overlapped it).
                width: font-button.width;
                font-button := SmallButton {
                    y: 2px;
                    text: root.tab.reader.text-font == "" ? @tr("More fonts…") : root.tab.reader.text-font;
                    on: root.tab.reader.text-font != "";
                    clicked => { ReaderBridge.text-format(root.id, 9, 0); font-menu.show(); }
                }
                font-menu := PopupWindow {
                    y: 34px;
                    width: 260px;
                    height: 320px;
                    PopoverFrame {
                        if ReaderBridge.system-fonts.length == 0: Text {
                            text: @tr("Finding the computer's fonts…");
                            font-size: Theme.fs-label;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ListView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            for name[k] in ReaderBridge.system-fonts: Rectangle {
                                height: 28px;
                                background: font-ta.has-hover ? Theme.popup-hover : transparent;
                                // Each name in its own face when the system has it, as Acrobat's list.
                                // One that can't be embedded is dimmed; picked, the reason is said.
                                property <bool> locked: ReaderBridge.system-fonts-why[k] != "";
                                Text { x: 10px; width: parent.width - 20px; text: parent.locked ? @tr("{} — not embeddable", name) : name; font-family: name; font-size: Theme.fs-label; color: parent.locked ? Theme.text-muted : Theme.text; vertical-alignment: center; overflow: elide; }
                                font-ta := TouchArea { clicked => { ReaderBridge.text-format(root.id, 8, k); font-menu.close(); } }
                            }
                        }
                    }
                }
            }
            // Acrobat's Callout: the text box points at where the click was, by a line with an arrow.
            if root.tab.reader.tool == 6 && !root.tab.reader.selected-text-box: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Callout"); on: root.tab.reader.callout; clicked => { ReaderBridge.shape-option(root.id, 11, 0); root.focus-pages(); } }
        }
        if root.tab.reader.has-signature: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 6px;
            // Kept signatures (PDF Expert's list): the first is placed; a click picks another,
            // × forgets one.
            for sig[k] in root.tab.reader.signatures: Rectangle {
                width: 72px;
                height: 28px;
                cross-axis-self-alignment: CrossAxisAlignment.center;
                border-radius: Theme.radius-small;
                border-width: k == 0 ? 2px : 1px;
                border-color: k == 0 ? Theme.accent : Theme.input-border;
                background: Theme.input-bg;
                Image { width: parent.width - 8px; height: parent.height - 6px; source: sig; image-fit: contain; }
                sgt := TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.signature-pick(root.id, k, false); root.focus-pages(); } }
                Rectangle {
                    opacity: sgt.has-hover || sgx.has-hover ? 1 : 0;
                    x: parent.width - 14px;
                    y: -4px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.toast-bg;
                    Text { text: "×"; font-size: 11px; color: Theme.on-toast; }
                    sgx := TouchArea { mouse-cursor: pointer; clicked => { ReaderBridge.signature-pick(root.id, k, true); root.focus-pages(); } }
                }
            }
            SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("New signature"); clicked => { ReaderBridge.signature-reset(root.id); } }
        }
        // Acrobat's Fill & Sign ▸ Add Initials: kept apart from the signatures, placed smaller.
        if root.tab.reader.tool == 9: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Initials"); on: root.tab.reader.initials; clicked => { ReaderBridge.shape-option(root.id, 13, 0); root.focus-pages(); } }
        if root.tab.reader.tool == 9 && root.tab.reader.initials: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("New initials"); clicked => { ReaderBridge.shape-option(root.id, 14, 0); root.focus-pages(); } }
        // A stamp, picture or signature selected (Acrobat's Rotate on a stamp): a quarter turn clockwise.
        if root.tab.reader.selected-turnable: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Turn ↻"); clicked => { ReaderBridge.shape-option(root.id, 16, 0); root.focus-pages(); } }
        // The same place on every page, one click (initials down a contract's pages).
        if root.tab.reader.tool == 9: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Every page"); on: root.tab.reader.sign-every-page; clicked => { ReaderBridge.shape-option(root.id, 15, 0); root.focus-pages(); } }
        // Which pages (Acrobat's Place on multiple pages: a range, odd, even): empty, all of them.
        if root.tab.reader.tool == 9 && root.tab.reader.sign-every-page: PanelField {
            cross-axis-self-alignment: CrossAxisAlignment.center;
            width: 110px;
            placeholder: @tr("All pages");
            edited(t) => { ReaderBridge.sign-pages(root.id, t); }
        }
        if !root.tab.reader.selected-image && ((root.tab.reader.tool != 0 && root.tab.reader.tool != 8 && root.tab.reader.tool != 9 && root.tab.reader.tool != 11 && (root.tab.reader.tool != 12 || root.tab.reader.stamp < 4) && root.tab.reader.tool != 14 && (root.tab.reader.tool != 13 || root.tab.reader.link-visible)) || root.tab.reader.selected-annot): FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 2px;
            padding-left: 6px;
            for c[k] in (root.light-tool ? root.light-colours : root.ink-colours): ColourDot {
                cross-axis-self-alignment: CrossAxisAlignment.center;
                colour: c;
                selected: root.tab.reader.selected-annot ? root.tab.reader.annot-colour == k : root.tab.reader.colour == k;
                clicked => { ReaderBridge.set-colour(root.id, k); root.focus-pages(); }
            }
            // The sixth: any colour, from a palette or typed (Acrobat's Other color, PDF Expert's
            // colour picker); it stays in the row once picked.
            custom-cell := Rectangle {
                width: 22px;
                property <color> custom: root.light-tool ? root.tab.reader.custom-light : root.tab.reader.custom-ink;
                ColourDot {
                    y: 4px;
                    colour: custom-cell.custom;
                    selected: root.tab.reader.selected-annot ? root.tab.reader.annot-colour == 5 : root.tab.reader.colour == 5;
                    clicked => { palette.show(); }
                }
                // None picked yet: an empty ring with a plus, the size of the other dots (the
                // stray "+" beside the dot read as a typo).
                if custom-cell.custom.alpha == 0: Rectangle {
                    y: 4px;
                    width: 22px;
                    height: 22px;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        border-width: 1.5px;
                        border-color: Theme.text-muted;
                        background: Theme.card;
                    }
                    Image {
                        width: 10px;
                        height: 10px;
                        source: @image-url("../icons/plus.svg");
                        colorize: Theme.text-muted;
                    }
                }
                palette := PopupWindow {
                    x: -80px;
                    y: 30px;
                    width: 196px;
                    height: 128px;
                    close-policy: close-on-click-outside;
                    PopoverFrame {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            for row in [
                                ["F2C12E", "F28C28", "E5322D", "D6336C", "AE3EC9", "7048E8"],
                                ["4263EB", "1C7ED6", "1098AD", "0CA678", "37B24D", "74B816"],
                                ["000000", "495057", "868E96", "CED4DA", "8B5A2B", "FFFFFF"],
                            ]: HorizontalLayout {
                                spacing: 6px;
                                for hex in row: Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: Parse.colour(hex, 0);
                                    border-width: sw.has-hover ? 2px : 1px;
                                    border-color: sw.has-hover ? Theme.text : #00000022;
                                    sw := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { ReaderBridge.set-custom-colour(root.id, hex); palette.close(); root.focus-pages(); }
                                    }
                                }
                            }
                            Rectangle {
                                height: 22px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: hex-in.has-focus ? Theme.text-secondary : Theme.input-border;
                                if hex-in.text == "": Text {
                                    x: 6px;
                                    text: "# RRGGBB, then Enter";
                                    font-size: Theme.fs-caption;
                                    color: Theme.text-disabled;
                                    vertical-alignment: center;
                                }
                                hex-in := TextInput {
                                    // Tools page tools' keys wait while a field has the keyboard.
                                    changed has-focus => { PlatformBridge.typing = self.has-focus; }
                                    x: 6px;
                                    width: parent.width - 12px;
                                    font-size: Theme.fs-caption;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accepted => {
                                        if Parse.colour-error(self.text) == "" && self.text != "" {
                                            ReaderBridge.set-custom-colour(root.id, self.text);
                                            palette.close();
                                            root.focus-pages();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Added after the colours and pens, so those keep their places.
        // A picture of one's own as the stamp (Acrobat's custom stamp).
        if root.tab.reader.tool == 12: SmallButton {
            cross-axis-self-alignment: CrossAxisAlignment.center;
            text: root.tab.reader.stamp-image == "" ? @tr("Image…") : root.tab.reader.stamp-image;
            on: root.tab.reader.stamp-image != "";
            clicked => { ReaderBridge.stamp-image(root.id); root.focus-pages(); }
        }
        Rectangle { horizontal-stretch: 1; }
        // Filling's form actions; Prepare form has its own row (the two did not fit the window).
        if root.tab.reader.has-form && root.tab.reader.tool != 14: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 4px;
            padding-right: 6px;
            // Clear form asks first, as Acrobat's Reset Form ("Are you sure…"): every value is lost.
            if !root.confirm-clear: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Clear form"); clicked => { root.confirm-clear = true; } }
            if root.confirm-clear: Text {
                text: @tr("Clear every field?");
                font-size: Theme.fs-caption;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.confirm-clear: SmallButton {
                cross-axis-self-alignment: CrossAxisAlignment.center;
                text: @tr("Clear");
                primary: true;
                clicked => {
                    root.confirm-clear = false;
                    ReaderBridge.form-op(root.id, 0);
                }
            }
            if root.confirm-clear: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Cancel"); clicked => { root.confirm-clear = false; } }
            if !root.confirm-clear: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Flatten"); clicked => { ReaderBridge.form-op(root.id, 1); } }
            // Acrobat's Export Data and Import Data (XFDF, FDF, XML, CSV, text).
            if !root.confirm-clear: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Export data…"); clicked => { ReaderBridge.form-op(root.id, 3); } }
            if !root.confirm-clear: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Import data…"); clicked => { ReaderBridge.form-op(root.id, 4); } }
        }
    }
    // The Shapes tool's second row (Loupe, Mask and Article in the first pushed the measuring tools
    // out of a 1280 px window, 27/10): shapes clicked out vertex by vertex, and the measuring tools.
    shapes2 := FlexboxLayout {
        x: 0px;
        y: 33px;
        width: root.width;
        height: 36px;
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        padding-left: 6px;
        padding-right: 12px;
        padding-top: 3px;
        padding-bottom: 3px;
        if root.tab.reader.tool == 10: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 4px;
            padding-left: 6px;
            // Clicked out vertex by vertex, a double-click to end (Acrobat's Polygon, Cloud, Polygonal Line);
            // hidden while measuring, so the scale and Calibrate fit (a shape icon brings them back).
            if root.tab.reader.shape-kind < 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Polygon"); on: root.tab.reader.shape-kind == 4; clicked => { ReaderBridge.shape-option(root.id, 0, 4); root.focus-pages(); } }
            if root.tab.reader.shape-kind < 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Cloud"); on: root.tab.reader.shape-kind == 5; clicked => { ReaderBridge.shape-option(root.id, 0, 5); root.focus-pages(); } }
            if root.tab.reader.shape-kind < 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Polyline"); on: root.tab.reader.shape-kind == 6; clicked => { ReaderBridge.shape-option(root.id, 0, 6); root.focus-pages(); } }
            // Acrobat's Measuring tools, in true size or at a scale.
            Rectangle { width: 6px; }
            for m[k] in [@tr("Distance"), @tr("Perimeter"), @tr("Area")]: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: m; on: root.tab.reader.shape-kind == 7 + k; clicked => { ReaderBridge.shape-option(root.id, 0, 7 + k); root.focus-pages(); } }
            // The scale they measure at (Acrobat's Scale Ratio): a click goes to the next.
            if root.tab.reader.shape-kind >= 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: root.tab.reader.measure-scale; clicked => { ReaderBridge.shape-option(root.id, 10, 0); root.focus-pages(); } }
            // Acrobat's Precision: the decimals the measures are written with.
            if root.tab.reader.shape-kind >= 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: root.tab.reader.measure-decimals == 0 ? "1" : root.tab.reader.measure-decimals == 1 ? "0.1" : root.tab.reader.measure-decimals == 2 ? "0.01" : "0.001"; clicked => { ReaderBridge.shape-option(root.id, 18, 0); root.focus-pages(); } }
            // Acrobat's and Bluebeam's Calibrate: measure a length you know, type it.
            if root.tab.reader.shape-kind == 7: SmallButton { cross-axis-self-alignment: CrossAxisAlignment.center; text: @tr("Calibrate"); on: root.tab.reader.calibrating; clicked => { ReaderBridge.shape-option(root.id, 12, 0); root.focus-pages(); } }
        }
    }
}
