// The reader's toolbar: side panel, annotation tools, page field, zoom, page theme, search, the
// More menu, undo/redo/save.
import { Theme } from "../theme.slint";
import { ToolButton, Divider } from "reader-parts.slint";
import { ToolTab, ViewerBridge, ReaderBridge } from "../flow-types.slint";

export component ReaderToolbar inherits Rectangle {
    in property <ToolTab> tab;
    in property <int> id;
    in property <bool> is-full-screen;
    // A small window: the three page themes become one button, the zoom buttons go (⌘+ / ⌘− stay).
    in property <bool> narrow;
    // Too narrow for every tool: the edit group folds into one button (900 px, the window's least,
    // up to where it all fits).
    property <bool> fold-edit: root.width < 1180px;
    in-out property <bool> bare;
    // What the search field holds (the side panel lists its results).
    out property <string> search-text: search-in.text;
    // The keyboard back to the pages; Presentation; full screen on or off (More menu).
    callback focus-pages();
    callback present();
    callback toggle-full-screen();

    property <string> page-text: root.tab.reader.page-text;
    changed page-text => { if !page-in.has-focus { page-in.text = root.page-text; } }

    // ⌥⌘G: the page field, its text selected.
    public function focus-page-field() { page-in.focus(); page-in.select-all(); }
    // ⌘F: the search field, its text selected.
    public function focus-search() { search-in.focus(); search-in.select-all(); }
    // The given words in the search field, searched.
    public function search-for(text: string) {
        search-in.text = text;
        ReaderBridge.search(root.id, search-in.text);
    }

    height: root.bare ? 0px : 46px;
    visible: !root.bare;
    background: Theme.panel-bg;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 4px;
        alignment: stretch;
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            padding-top: 8px;
            padding-bottom: 8px;
            ToolButton { icon: @image-url("../icons/panel-left.svg"); tip: "Side panel"; active: root.tab.reader.panel-open; clicked => { ReaderBridge.toggle-panel(root.id); } }
            Rectangle { width: 6px; }
            Divider { y: 5px; }
            Rectangle { width: 6px; }
            ToolButton { icon: @image-url("../icons/mouse-pointer-2.svg"); tip: "Select text (V)"; active: root.tab.reader.tool == 0; clicked => { ReaderBridge.set-tool(root.id, 0); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/highlighter.svg"); tip: "Highlight (H)"; active: root.tab.reader.tool == 1; clicked => { ReaderBridge.set-tool(root.id, 1); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/underline.svg"); tip: "Underline (U)"; active: root.tab.reader.tool == 2; clicked => { ReaderBridge.set-tool(root.id, 2); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/strikethrough.svg"); tip: "Strikethrough (K)"; active: root.tab.reader.tool == 3; clicked => { ReaderBridge.set-tool(root.id, 3); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/sticky-note.svg"); tip: "Note (N)"; active: root.tab.reader.tool == 4; clicked => { ReaderBridge.set-tool(root.id, 4); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/pencil.svg"); tip: "Pen (P)"; active: root.tab.reader.tool == 5; clicked => { ReaderBridge.set-tool(root.id, 5); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/shapes.svg"); tip: "Shapes (R)"; active: root.tab.reader.tool == 10; clicked => { ReaderBridge.set-tool(root.id, 10); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/eraser.svg"); tip: "Eraser (X)"; active: root.tab.reader.tool == 11; clicked => { ReaderBridge.set-tool(root.id, 11); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/stamp.svg"); tip: "Stamp (M)"; active: root.tab.reader.tool == 12; clicked => { ReaderBridge.set-tool(root.id, 12); root.focus-pages(); } }
            ToolButton { icon: @image-url("../icons/type.svg"); tip: "Text box (T)"; active: root.tab.reader.tool == 6; clicked => { ReaderBridge.set-tool(root.id, 6); root.focus-pages(); } }
            Rectangle { width: 6px; }
            Divider { y: 5px; }
            Rectangle { width: 6px; }
            if !root.fold-edit: ToolButton { icon: @image-url("../icons/text-cursor-input.svg"); tip: "Edit text (E)"; active: root.tab.reader.tool == 7; clicked => { ReaderBridge.set-tool(root.id, 7); root.focus-pages(); } }
            if !root.fold-edit: ToolButton { icon: @image-url("../icons/image.svg"); tip: "Add image (I)"; active: root.tab.reader.tool == 8; clicked => { ReaderBridge.set-tool(root.id, 8); root.focus-pages(); } }
            if !root.fold-edit: ToolButton { icon: @image-url("../icons/link.svg"); tip: "Link (L)"; active: root.tab.reader.tool == 13; clicked => { ReaderBridge.set-tool(root.id, 13); root.focus-pages(); } }
            if !root.fold-edit: ToolButton { icon: @image-url("../icons/eye-off.svg"); tip: "Redact…"; clicked => { ReaderBridge.redact(root.id); } }
            if !root.fold-edit: ToolButton { icon: @image-url("../icons/signature.svg"); tip: "Sign (S)"; active: root.tab.reader.tool == 9; clicked => { ReaderBridge.set-tool(root.id, 9); root.focus-pages(); } }
            // A narrow window folds the edit group into one button with its menu (Acrobat's toolbar
            // overflow), so no tool falls off the bar.
            if root.fold-edit: Rectangle {
                width: 30px;
                ToolButton {
                    icon: @image-url("../icons/text-cursor-input.svg");
                    tip: "Edit, link, redact, sign";
                    active: root.tab.reader.tool == 7 || root.tab.reader.tool == 8 || root.tab.reader.tool == 13 || root.tab.reader.tool == 9;
                    clicked => { edit-menu.show(); }
                }
                edit-menu := PopupWindow {
                    x: 0;
                    y: 34px;
                    width: 220px;
                    height: 5 * 30px + 8px;
                    Rectangle {
                        background: Theme.input-bg;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: Theme.input-border;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000033;
                        VerticalLayout {
                            padding: 4px;
                            for item[k] in [
                                { icon: @image-url("../icons/text-cursor-input.svg"), text: "Edit text", keys: "E", tool: 7 },
                                { icon: @image-url("../icons/image.svg"), text: "Add image", keys: "I", tool: 8 },
                                { icon: @image-url("../icons/link.svg"), text: "Link", keys: "L", tool: 13 },
                                { icon: @image-url("../icons/eye-off.svg"), text: "Redact…", keys: "", tool: -1 },
                                { icon: @image-url("../icons/signature.svg"), text: "Sign", keys: "S", tool: 9 },
                            ]: Rectangle {
                                height: 30px;
                                border-radius: Theme.radius-small;
                                background: et.has-hover ? Theme.popup-hover : transparent;
                                Image { x: 8px; width: 16px; height: 16px; source: item.icon; colorize: Theme.text-secondary; }
                                Text { x: 32px; text: item.text; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                                Text { x: parent.width - self.width - 10px; text: item.keys; font-size: Theme.fs-caption; color: Theme.text-muted; vertical-alignment: center; }
                                et := TouchArea {
                                    clicked => {
                                        if item.tool < 0 { ReaderBridge.redact(root.id); } else { ReaderBridge.set-tool(root.id, item.tool); }
                                        root.focus-pages();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        // Page field and zoom
        HorizontalLayout {
            spacing: 4px;
            alignment: center;
            padding-top: 9px;
            padding-bottom: 9px;
            Rectangle {
                width: 46px;
                border-radius: Theme.radius-small;
                border-width: 1px;
                border-color: page-in.has-focus ? Theme.text-secondary : Theme.input-border;
                background: Theme.input-bg;
                page-in := TextInput {
                    // Back to the page shown once the field is left or a jump is done.
                    changed has-focus => { if !self.has-focus { self.text = root.tab.reader.page-text; } }
                    x: 6px;
                    width: parent.width - 12px;
                    text: root.tab.reader.page-text;
                    font-size: Theme.fs-label;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => {
                        ReaderBridge.go-to-page(root.id, self.text);
                        root.focus-pages();
                        self.text = root.tab.reader.page-text;
                    }
                }
            }
            Text {
                text: root.tab.reader.page-counter;
                font-size: Theme.fs-label;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            Rectangle { width: 8px; }
            if !root.narrow: ToolButton { y: -2px; icon: @image-url("../icons/zoom-out.svg"); tip: "Zoom out (⌘−)"; clicked => { ViewerBridge.zoom-step(root.id, -1); } }
            // The zoom: type a percentage (↩), or pick one from the list (PDF Expert's zoom menu).
            Rectangle {
                property <int> shown: root.tab.viewer-zoom;
                changed shown => { if !zoom-field.has-focus { zoom-field.text = self.shown + "%"; } }
                init => { zoom-field.text = self.shown + "%"; }
                width: 62px;
                height: 26px;
                border-radius: Theme.radius-small;
                border-width: zoom-field.has-focus || zoom-hover.has-hover ? 1px : 0px;
                border-color: Theme.input-border;
                background: zoom-field.has-focus ? Theme.input-bg : transparent;
                zoom-hover := TouchArea { }
                zoom-field := TextInput {
                    x: 4px;
                    width: 40px;
                    font-size: Theme.fs-label;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => { ReaderBridge.zoom-typed(root.id, self.text); root.focus-pages(); }
                }
                Image {
                    x: parent.width - 16px;
                    width: 11px;
                    height: 11px;
                    source: @image-url("../icons/chevron-down.svg");
                    colorize: Theme.text-secondary;
                }
                TouchArea {
                    x: parent.width - 18px;
                    width: 18px;
                    mouse-cursor: pointer;
                    clicked => { zoom-menu.show(); }
                }
                zoom-menu := PopupWindow {
                    x: 0;
                    y: parent.height + 4px;
                    width: 120px;
                    Rectangle {
                        background: Theme.card;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: Theme.input-border;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000033;
                        VerticalLayout {
                            padding: 4px;
                            for z in ["50%", "75%", "100%", "125%", "150%", "200%", "300%", "400%"]: Rectangle {
                                height: 26px;
                                background: zt.has-hover ? Theme.popup-hover : transparent;
                                border-radius: Theme.radius-small;
                                Text { x: 10px; text: z; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                                zt := TouchArea { clicked => { ReaderBridge.zoom-typed(root.id, z); root.focus-pages(); } }
                            }
                            Rectangle { height: 1px; background: Theme.sidebar-border; }
                            for f[k] in ["Fit width", "Fit page"]: Rectangle {
                                height: 26px;
                                background: ft.has-hover ? Theme.popup-hover : transparent;
                                border-radius: Theme.radius-small;
                                Text { x: 10px; text: f; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                                ft := TouchArea { clicked => { ReaderBridge.zoom-fit(root.id, k); root.focus-pages(); } }
                            }
                        }
                    }
                }
            }
            if !root.narrow: ToolButton { y: -2px; icon: @image-url("../icons/zoom-in.svg"); tip: "Zoom in (⌘+)"; clicked => { ViewerBridge.zoom-step(root.id, 1); } }
            // Narrow: in the More menu only (its "Two pages" entry).
            if !root.fold-edit: ToolButton {
                y: -2px;
                icon: @image-url("../icons/columns-2.svg");
                active: root.tab.reader.spread > 0;
                tip: (root.tab.reader.spread == 0 ? "Two pages" : root.tab.reader.spread == 1 ? "Two pages, cover alone" : "One page wide") + " (⌥⌘2)";
                clicked => { ReaderBridge.cycle-spread(root.id); root.focus-pages(); }
            }
            // Narrow: Fit width / Fit page stay in the zoom list (and ⌘9 / ⌘8).
            if !root.fold-edit: ToolButton { y: -2px; icon: @image-url("../icons/maximize.svg"); tip: root.tab.reader.zoom-mode == 1 ? "Fit width (⌘9)" : "Fit page (⌘8)"; clicked => { ReaderBridge.zoom-fit(root.id, root.tab.reader.zoom-mode == 1 ? 0 : 1); } }
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 2px;
            alignment: end;
            padding-top: 8px;
            padding-bottom: 8px;
            if !root.narrow: ToolButton { icon: @image-url("../icons/sun.svg"); tip: "Day"; active: root.tab.reader.theme == 0; clicked => { ReaderBridge.set-theme(root.id, 0); } }
            if !root.narrow: ToolButton { icon: @image-url("../icons/book-open.svg"); tip: "Sepia"; active: root.tab.reader.theme == 2; clicked => { ReaderBridge.set-theme(root.id, 2); } }
            if !root.narrow: ToolButton { icon: @image-url("../icons/moon.svg"); tip: "Night"; active: root.tab.reader.theme == 1; clicked => { ReaderBridge.set-theme(root.id, 1); } }
            // Day → Sepia → Night → Day.
            if root.narrow: ToolButton {
                icon: root.tab.reader.theme == 0 ? @image-url("../icons/sun.svg") : root.tab.reader.theme == 2 ? @image-url("../icons/book-open.svg") : @image-url("../icons/moon.svg");
                tip: "Page theme";
                clicked => { ReaderBridge.set-theme(root.id, root.tab.reader.theme == 0 ? 2 : root.tab.reader.theme == 2 ? 1 : 0); }
            }
            Rectangle { width: 6px; }
            // Search
            Rectangle {
                // Narrower in a small window, so the toolbar always fits (the window's
                // minimum is 900 px).
                width: root.fold-edit ? 88px : root.narrow ? 110px : clamp(root.width - 1154px, 110px, 210px);
                border-radius: Theme.radius-button;
                border-width: 1px;
                border-color: search-in.has-focus ? Theme.text-secondary : Theme.input-border;
                background: Theme.input-bg;
                Image {
                    x: 8px;
                    width: 14px;
                    height: 14px;
                    source: @image-url("../icons/search.svg");
                    colorize: Theme.text-muted;
                }
                Text {
                    x: 28px;
                    visible: search-in.text == "";
                    text: "Search";
                    font-size: Theme.fs-label;
                    color: Theme.text-disabled;
                    vertical-alignment: center;
                }
                search-in := TextInput {
                    x: 28px;
                    width: parent.width - 28px - count.width - 8px;
                    font-size: Theme.fs-label;
                    color: Theme.text;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => {
                        // Results already listed (even while the search goes on): Enter goes to the next one.
                        if root.tab.reader.search-count != "" && root.tab.reader.search-count != "None" {
                            ReaderBridge.search-step(root.id, 1);
                        } else {
                            ReaderBridge.search(root.id, self.text);
                        }
                    }
                    // Any change drops the results of the old text: Enter then searches the new one.
                    edited => { ReaderBridge.search-clear(root.id); }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            self.text = "";
                            ReaderBridge.search-clear(root.id);
                            root.focus-pages();
                            return accept;
                        }
                        if e.text == Key.Return && e.modifiers.shift {
                            ReaderBridge.search-step(root.id, -1);
                            return accept;
                        }
                        // ⌘F again in the field: its words selected, ready to type a new search.
                        if e.modifiers.control && (e.text == "f" || e.text == "F") {
                            self.select-all();
                            return accept;
                        }
                        if e.modifiers.control && (e.text == "g" || e.text == "G") {
                            ReaderBridge.search-step(root.id, e.modifiers.shift ? -1 : 1);
                            return accept;
                        }
                        reject
                    }
                }
                count := Text {
                    x: parent.width - self.width - 8px;
                    text: root.tab.reader.search-count;
                    font-size: Theme.fs-caption;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
            Rectangle { width: 6px; }
            // More: how the window shows the document (PDF Expert's View menu), print, properties.
            ToolButton {
                icon: @image-url("../icons/ellipsis.svg");
                tip: "More";
                clicked => { view-menu.show(); }
                // More ▸ More tools…: what did not fit in the first menu.
                more-tools := PopupWindow {
                    x: parent.width - 240px;
                    y: parent.height + 6px;
                    width: 240px;
                    Rectangle {
                        background: Theme.card;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: Theme.input-border;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000033;
                        VerticalLayout {
                            padding: 4px;
                            for item[k] in [
                                // PDF Expert's and Acrobat's overlay: another PDF's pages drawn over these.
                                { text: "Overlay a PDF…", on: false },
                                // Acrobat's Read Out Loud, Preview's Speech: from the page shown; again, it stops.
                                { text: "Read aloud", on: false },
                                { text: "Reading speed", on: false },
                                // Acrobat's Loupe tool: the area under the pointer magnified.
                                { text: "Loupe", on: root.tab.reader.loupe },
                                // Acrobat's View ▸ Show/Hide ▸ Grid (also Prepare form's, where fields snap to it).
                                { text: "Grid", on: root.tab.reader.form-grid },
                                // PDF Expert's Export ▸ Flattened Copy: comments and fields drawn in, the document unchanged.
                                { text: "Save a flattened copy…", on: false },
                                { text: "Email a flattened copy", on: false },
                                // Acrobat's Auto-Rotate Pages: the pages whose text runs sideways turned upright.
                                { text: "Turn pages upright", on: false },
                                // Acrobat's Remove all images (Smallpdf's): the text kept, every picture out.
                                { text: "Remove all images", on: false },
                                // Acrobat's Reflow: the page's text on the window's width, any size.
                                { text: "Reflow", on: root.tab.reader.reflow },
                                // Acrobat's Accessibility ▸ Full Check, its fixes and its report.
                                { text: "Accessibility check", on: false },
                                // Acrobat's Underlay: another PDF's pages behind these, page by page.
                                { text: "Underlay a PDF…", on: false },
                                // Acrobat's Read This Page Only, a selection read, Pause, and the voice.
                                { text: "Read this page", on: false },
                                { text: "Read the selection", on: false },
                                { text: "Pause or resume reading", on: false },
                                { text: "Voice…", on: false },
                                // Acrobat's Rulers; a click on one makes a guide.
                                { text: "Rulers", on: root.tab.reader.rulers-on },
                                // Acrobat's and PDF Expert's keyboard shortcuts list (? or ⌘/).
                                { text: "Keyboard shortcuts", on: false },
                                // PDF Expert's Share ▸ Copy, macOS's AirDrop.
                                { text: "Copy the file", on: false },
                                { text: "Share with AirDrop", on: false },
                                { text: "Correct recognized text…", on: false },
                            ]: Rectangle {
                                height: 28px;
                                border-radius: Theme.radius-small;
                                background: mt.has-hover ? Theme.popup-hover : transparent;
                                Text { x: 10px; text: (item.on ? "✓ " : "") + item.text; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                                mt := TouchArea {
                                    clicked => {
                                        if k == 0 { ReaderBridge.overlay-pdf(root.id, false); }
                                        if k == 1 { ReaderBridge.read-aloud(root.id, 0); }
                                        if k == 2 { ReaderBridge.read-aloud(root.id, 1); }
                                        if k == 3 { ReaderBridge.loupe(root.id); }
                                        if k == 4 { ReaderBridge.form-grid(root.id); }
                                        if k == 5 { ReaderBridge.flat-copy(root.id, false); }
                                        if k == 6 { ReaderBridge.flat-copy(root.id, true); }
                                        if k == 7 { ReaderBridge.turn-upright(root.id); }
                                        if k == 8 { ReaderBridge.remove-images(root.id); }
                                        if k == 9 { ReaderBridge.reflow(root.id, 0); }
                                        if k == 10 { ReaderBridge.accessibility-check(root.id); }
                                        if k == 11 { ReaderBridge.overlay-pdf(root.id, true); }
                                        if k == 12 { ReaderBridge.read-aloud(root.id, 2); }
                                        if k == 13 { ReaderBridge.read-aloud(root.id, 3); }
                                        if k == 14 { ReaderBridge.read-aloud(root.id, 4); }
                                        if k == 15 { ReaderBridge.read-aloud(root.id, 5); }
                                        if k == 16 { ReaderBridge.rulers(root.id); }
                                        if k == 17 { ReaderBridge.show-help(root.id, true); }
                                        if k == 18 { ReaderBridge.share-file(root.id, false); }
                                        if k == 19 { ReaderBridge.share-file(root.id, true); }
                                        if k == 20 { ReaderBridge.review-ocr(root.id); }
                                        root.focus-pages();
                                    }
                                }
                            }
                        }
                    }
                }
                view-menu := PopupWindow {
                    x: parent.width - 240px;
                    y: parent.height + 6px;
                    width: 240px;
                    Rectangle {
                        background: Theme.card;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: Theme.input-border;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000033;
                        VerticalLayout {
                            padding: 4px;
                            for item[k] in [
                                { text: "Presentation", keys: "⇧⌘P", on: false },
                                { text: "Full screen", keys: "⌃⌘F", on: root.is-full-screen },
                                { text: "Hide toolbar", keys: "⇧T", on: root.bare },
                                { text: "Highlight links", keys: "⇧⌘L", on: root.tab.reader.show-links },
                                { text: "Highlight form fields", keys: "", on: root.tab.reader.show-fields },
                                { text: root.tab.reader.spread == 0 ? "Two pages" : root.tab.reader.spread == 1 ? "Two pages, cover alone" : "One page wide", keys: "⌥⌘2", on: false },
                                { text: "Page grid", keys: "", on: root.tab.reader.spread == 3 },
                                { text: "Right to left", keys: "", on: root.tab.reader.rtl },
                                { text: "Print…", keys: "⌘P", on: false },
                                { text: "Document properties…", keys: "⌘D", on: false },
                                // Acrobat's Prepare a Form, among its tools: add, move and set up fields.
                                { text: "Prepare form", keys: "F", on: root.tab.reader.tool == 14 },
                                // Acrobat's Protect ▸ Sanitize Document: hidden information removed, ⌘Z undoes it.
                                { text: "Sanitize document", keys: "", on: false },
                                // Acrobat's Edit a PDF ▸ Background.
                                { text: "Page background…", keys: "", on: false },
                                // Acrobat's File ▸ Revert, and the versions an incremental save keeps.
                                { text: "Versions…", keys: "", on: false },
                                // Acrobat's Marquee Zoom.
                                { text: "Zoom to area", keys: "Z", on: false },
                                // Acrobat's Snapshot tool.
                                { text: "Copy an area as a picture", keys: "", on: false },
                                // Acrobat's Automatically Scroll.
                                { text: "Scroll automatically", keys: "", on: root.tab.reader.auto-scroll },
                                // Acrobat's Single Page view (not continuous).
                                { text: "One page at a time", keys: "", on: root.tab.reader.page-at-a-time },
                                // Acrobat's Share ▸ Email, Preview's Share ▸ Mail.
                                { text: "Email…", keys: "", on: false },
                                // Acrobat's View ▸ Rotate View ▸ Clockwise: the view, not the file.
                                { text: "Rotate view", keys: "⇧⌘+", on: root.tab.reader.view-turn != 0 },
                                // The rest, in a second menu (this one fills the window's height).
                                { text: "More tools…", keys: "›", on: false },
                            ]: Rectangle {
                                height: 28px;
                                border-radius: Theme.radius-small;
                                background: vt.has-hover ? Theme.popup-hover : transparent;
                                Text { x: 10px; text: (item.on ? "✓ " : "") + item.text; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                                Text { x: parent.width - self.width - 10px; text: item.keys; font-size: Theme.fs-caption; color: Theme.text-muted; vertical-alignment: center; }
                                vt := TouchArea {
                                    clicked => {
                                        if k == 0 { root.present(); }
                                        if k == 1 { root.toggle-full-screen(); }
                                        if k == 2 { root.bare = !root.bare; }
                                        if k == 3 { ReaderBridge.toggle-links(root.id); }
                                        if k == 4 { ReaderBridge.toggle-fields(root.id); }
                                        if k == 5 { ReaderBridge.cycle-spread(root.id); }
                                        if k == 6 { ReaderBridge.toggle-grid(root.id); }
                                        if k == 7 { ReaderBridge.toggle-rtl(root.id); }
                                        if k == 8 { ReaderBridge.print-open(root.id); }
                                        if k == 9 { ReaderBridge.props-open(root.id); }
                                        if k == 10 { ReaderBridge.set-tool(root.id, root.tab.reader.tool == 14 ? 0 : 14); }
                                        if k == 11 { ReaderBridge.sanitize(root.id); }
                                        if k == 12 { ReaderBridge.background-open(root.id); }
                                        if k == 13 { ReaderBridge.versions-open(root.id); }
                                        if k == 14 { ReaderBridge.zoom-area(root.id); }
                                        if k == 15 { ReaderBridge.snap-area(root.id); }
                                        if k == 16 { ReaderBridge.auto-scroll(root.id); }
                                        if k == 17 { ReaderBridge.page-at-a-time(root.id); }
                                        if k == 18 { ReaderBridge.email(root.id); }
                                        if k == 19 { ReaderBridge.rotate-view(root.id, 1); }
                                        if k == 20 { more-tools.show(); return; }
                                        root.focus-pages();
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Named as Acrobat's Edit menu names them: "Undo Add highlight".
            ToolButton { icon: @image-url("../icons/undo-2.svg"); tip: root.tab.reader.can-undo && root.tab.reader.undo-label != "" ? "Undo " + root.tab.reader.undo-label + " (⌘Z)" : "Undo (⌘Z)"; enabled: root.tab.reader.can-undo; clicked => { ReaderBridge.undo(root.id); } }
            ToolButton { icon: @image-url("../icons/redo-2.svg"); tip: root.tab.reader.can-redo && root.tab.reader.redo-label != "" ? "Redo " + root.tab.reader.redo-label + " (⇧⌘Z)" : "Redo (⇧⌘Z)"; enabled: root.tab.reader.can-redo; clicked => { ReaderBridge.redo(root.id); } }
            ToolButton { icon: @image-url("../icons/wrench.svg"); tip: "Use a tool on this PDF"; clicked => { ReaderBridge.to-tools(root.id); } }
            ToolButton { icon: @image-url("../icons/save.svg"); tip: root.tab.reader.dirty ? "Save (⌘S)" : "Saved"; enabled: root.tab.reader.dirty; active: root.tab.reader.dirty; clicked => { ReaderBridge.save(root.id); } }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.sidebar-border;
    }
}
