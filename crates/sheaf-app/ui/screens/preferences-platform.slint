// Settings ▸ Shortcuts' list (the PlatformBridge global, src/platform_ui.rs): Stirling's Hotkeys,
// search the commands, change or reset a shortcut.
import { Theme } from "../theme.slint";
import { SecondaryButton } from "dialogs.slint";
import { TextField } from "../widgets/text-field.slint";
import { PlatformBridge } from "../platform.slint";

component Card inherits Rectangle {
    in property <string> title;
    // The Settings window's card (settings-form.slint): small-capital title, hairline edge.
    border-radius: Theme.r-md;
    background: Theme.window;
    border-width: 1px;
    border-color: Theme.hairline;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 16px;
        padding-top: 8px;
        spacing: 12px;
        Text {
            height: 16px;
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.title.to-uppercase();
            font-size: Theme.fs-subhead;
            font-weight: Theme.weight-demibold;
            color: Theme.text-2;
            vertical-alignment: bottom;
        }
        @children
    }
}

// Stirling's Hotkeys: every menu command with its shortcut; a click records new keys.
export component KeyboardSection inherits Card {
    title: @tr("Keyboard shortcuts");
    // The command whose keys are being recorded (its index; -1 none).
    property <int> recording: -1;
    // Every command listed, or only those found by the search (the list is long).
    property <bool> all;
    property <string> query;
    function start(i: int) {
        root.recording = i;
        // The menu bar lets the keys through while they are recorded.
        PlatformBridge.recording(true);
        PlatformBridge.recording-keys = true;
    }
    function stop() {
        root.recording = -1;
        PlatformBridge.recording(false);
        PlatformBridge.recording-keys = false;
    }
    TextField {
        placeholder: @tr("Search commands or keys");
        changed text => {
            root.query = self.text;
            PlatformBridge.shortcut-query(self.text);
        }
    }
    if PlatformBridge.shortcut-error != "": Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: PlatformBridge.shortcut-error;
        font-size: Theme.fs-caption;
        color: Theme.danger;
        wrap: word-wrap;
    }
    if !root.all && root.query == "": FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        SecondaryButton { text: @tr("Show all {} shortcuts", PlatformBridge.shortcut-rows.length); clicked => { root.all = true; } }
    }
    if root.query != "" && PlatformBridge.shortcut-rows.length == 0: Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("No command or keys match.");
        font-size: Theme.fs-caption;
        color: Theme.text-muted;
    }
    if root.all || root.query != "": VerticalLayout {
        spacing: 12px;
        for row in PlatformBridge.shortcut-rows: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            height: 30px;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: row.name;
                font-size: Theme.fs-body;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Rectangle {
                width: 170px;
                border-radius: Theme.radius-button;
                border-width: root.recording == row.index ? 2px : 0;
                border-color: Theme.accent;
                background: keys-touch.has-hover ? Theme.popup-hover : Theme.pill-bg;
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.recording == row.index ? @tr("Press the keys…") : row.keys == "" ? @tr("None") : row.keys;
                    font-size: Theme.fs-label;
                    font-weight: row.custom ? Theme.weight-demibold : 400;
                    color: row.keys == "" && root.recording != row.index ? Theme.text-muted : Theme.text;
                }
                keys-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.start(row.index); row-keys.focus(); }
                }
                // Takes the keys pressed while this row records, and keeps the keyboard after (other keys
                // go on to the window's). It lives in the box clicked, so taking the keyboard never
                // scrolls the page (one at the section's end scrolled it under the pointer, and the
                // next click missed).
                row-keys := FocusScope {
                    width: 0;
                    height: 0;
                    key-pressed(e) => {
                        if root.recording != row.index { return reject; }
                        if PlatformBridge.record-shortcut(root.recording, e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta) {
                            root.stop();
                        }
                        accept
                    }
                    changed has-focus => {
                        if !self.has-focus && root.recording == row.index { root.stop(); }
                    }
                }
            }
            if row.custom: SecondaryButton { text: @tr("Reset"); clicked => { root.stop(); PlatformBridge.reset-shortcut(row.index); } }
        }
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 12px;
        SecondaryButton { text: @tr("Reset all"); clicked => { root.stop(); PlatformBridge.reset-shortcuts(); } }
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("Click a shortcut, then press the new keys. Esc cancels, Backspace removes it.");
            font-size: Theme.fs-caption;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

