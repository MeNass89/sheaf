// Preferences' platform sections (the PlatformBridge global, src/platform_ui.rs): Spelling,
// Keyboard shortcuts (Stirling's Hotkeys: search the commands, change or reset a shortcut), the
// tools shown and the interface's direction.
import { Theme } from "../theme.slint";
import { Segment } from "../widgets/radio-card.slint";
import { SecondaryButton } from "dialogs.slint";
import { Check } from "../widgets/check.slint";
import { TextField } from "../widgets/text-field.slint";
import { PlatformBridge } from "../platform.slint";

// A white card with a title, as the page's other sections.
component Card inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius-card;
    background: Theme.card;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.title;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
        }
        @children
    }
}

// Acrobat's Preferences ▸ Spelling: check while typing, the dictionary used, the words learned.
export component SpellingSection inherits Card {
    title: @tr("Spelling");
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 214px; text: @tr("Check spelling while typing"); selected: PlatformBridge.spell-on; clicked => { PlatformBridge.set-spell-on(true); } }
        Segment { width: 214px; text: @tr("Don't check spelling"); selected: !PlatformBridge.spell-on; clicked => { PlatformBridge.set-spell-on(false); } }
    }
    // Preview's Check Grammar With Spelling: repeated words, a capital after a full stop, double
    // spaces, "a" or "an".
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 214px; text: @tr("Check grammar too"); selected: PlatformBridge.grammar-on; clicked => { PlatformBridge.set-grammar-on(true); } }
        Segment { width: 214px; text: @tr("Spelling only"); selected: !PlatformBridge.grammar-on; clicked => { PlatformBridge.set-grammar-on(false); } }
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("Grammar, every language: a word written twice, two spaces, a space before a comma or full stop, none after a comma. English also: agreement (“she go”), word choice (“their is”), a capital after a full stop, “a” or “an”, a space before ; : ! ?, “i” for “I”, “could of”. Not checked: style.");
        font-size: Theme.fs-caption;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: PlatformBridge.spell-dictionary == "" ? @tr("Looking for a dictionary…") : PlatformBridge.spell-dictionary;
        font-size: Theme.fs-caption;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    // Acrobat's dictionary list: those ticked are used, in their order (a word any of them knows is
    // right); none ticked, the system's language.
    if PlatformBridge.dictionaries.length > 1: Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("Dictionaries (ticked ones are used, in this order; none: your system's language)");
        font-size: Theme.fs-body;
        color: Theme.text;
        wrap: word-wrap;
    }
    if PlatformBridge.dictionaries.length > 1: VerticalLayout {
        spacing: 4px;
        for d in PlatformBridge.dictionaries: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            height: 30px;
            Check {
                horizontal-stretch: 1;
                text: d.name;
                checked: d.chosen;
                toggled => { PlatformBridge.dictionary-change(d.lang, 0); }
            }
            if d.chosen: SecondaryButton { text: @tr("Up"); clicked => { PlatformBridge.dictionary-change(d.lang, -1); } }
            if d.chosen: SecondaryButton { text: @tr("Down"); clicked => { PlatformBridge.dictionary-change(d.lang, 1); } }
        }
    }
    if PlatformBridge.learned.length > 0: FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        spacing: 8px;
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: PlatformBridge.learned.length == 1 ? @tr("1 word learned (Learn in the spelling card)") : @tr("{} words learned (Learn in the spelling card)", PlatformBridge.learned.length);
            font-size: Theme.fs-body;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        SecondaryButton { text: @tr("Forget them"); clicked => { PlatformBridge.forget-learned(); } }
    }
}

// Stirling's Hotkeys: every menu command with its shortcut; a click records new keys.
export component KeyboardSection inherits Card {
    title: @tr("Keyboard shortcuts");
    // The command whose keys are being recorded (its index; -1 none).
    property <int> recording: -1;
    // Every command listed, or only those found by the search (the list is long).
    property <bool> all;
    property <string> query;
    function start(i: int) {
        root.recording = i;
        // The menu bar lets the keys through while they are recorded.
        PlatformBridge.recording(true);
        PlatformBridge.recording-keys = true;
    }
    function stop() {
        root.recording = -1;
        PlatformBridge.recording(false);
        PlatformBridge.recording-keys = false;
    }
    TextField {
        placeholder: @tr("Search commands or keys");
        changed text => {
            root.query = self.text;
            PlatformBridge.shortcut-query(self.text);
        }
    }
    if PlatformBridge.shortcut-error != "": Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: PlatformBridge.shortcut-error;
        font-size: Theme.fs-caption;
        color: Theme.danger;
        wrap: word-wrap;
    }
    if !root.all && root.query == "": FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        SecondaryButton { text: @tr("Show all {} shortcuts", PlatformBridge.shortcut-rows.length); clicked => { root.all = true; } }
    }
    if root.query != "" && PlatformBridge.shortcut-rows.length == 0: Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: @tr("No command or keys match.");
        font-size: Theme.fs-caption;
        color: Theme.text-muted;
    }
    if root.all || root.query != "": VerticalLayout {
        spacing: 12px;
        for row in PlatformBridge.shortcut-rows: FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: LayoutAlignment.stretch;
            spacing: 8px;
            height: 30px;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: row.name;
                font-size: Theme.fs-body;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Rectangle {
                width: 170px;
                border-radius: Theme.radius-button;
                border-width: root.recording == row.index ? 2px : 0;
                border-color: Theme.accent;
                background: keys-touch.has-hover ? Theme.popup-hover : Theme.pill-bg;
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.recording == row.index ? @tr("Press the keys…") : row.keys == "" ? @tr("None") : row.keys;
                    font-size: Theme.fs-label;
                    font-weight: row.custom ? Theme.weight-demibold : 400;
                    color: row.keys == "" && root.recording != row.index ? Theme.text-muted : Theme.text;
                }
                keys-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.start(row.index); row-keys.focus(); }
                }
                // Takes the keys pressed while this row records, and keeps the keyboard after (other keys
                // go on to the window's). It lives in the box clicked, so taking the keyboard never
                // scrolls the page (one at the section's end scrolled it under the pointer, and the
                // next click missed).
                row-keys := FocusScope {
                    width: 0;
                    height: 0;
                    key-pressed(e) => {
                        if root.recording != row.index { return reject; }
                        if PlatformBridge.record-shortcut(root.recording, e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta) {
                            root.stop();
                        }
                        accept
                    }
                    changed has-focus => {
                        if !self.has-focus && root.recording == row.index { root.stop(); }
                    }
                }
            }
            if row.custom: SecondaryButton { text: @tr("Reset"); clicked => { root.stop(); PlatformBridge.reset-shortcut(row.index); } }
        }
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 12px;
        SecondaryButton { text: @tr("Reset all"); clicked => { root.stop(); PlatformBridge.reset-shortcuts(); } }
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("Click a shortcut, then press the new keys. Esc cancels, Backspace removes it.");
            font-size: Theme.fs-caption;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

// The Tools page without the tools that cannot run here (Stirling's), and iLovePDF's
// right-to-left interface.
export component InterfaceSection inherits Card {
    title: @tr("Interface");
    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Tools page"); font-size: Theme.fs-body; color: Theme.text; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        Segment { width: 214px; text: @tr("Show every tool"); selected: !PlatformBridge.hide-unavailable; clicked => { PlatformBridge.set-hide-unavailable(false); } }
        Segment { width: 254px; text: @tr("Hide tools that can't run here"); selected: PlatformBridge.hide-unavailable; clicked => { PlatformBridge.set-hide-unavailable(true); } }
    }
    Text {
        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: PlatformBridge.unavailable-tools == "" ? @tr("Every tool can run on this computer.") : @tr("Can't run here: {}.", PlatformBridge.unavailable-tools);
        font-size: Theme.fs-caption;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Direction"); font-size: Theme.fs-body; color: Theme.text; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        for label[i] in [@tr("As the system's language"), @tr("Left to right"), @tr("Right to left")]: Segment {
            width: 190px;
            text: label;
            selected: PlatformBridge.direction == i;
            clicked => { PlatformBridge.set-direction(i); }
        }
    }
    // iLovePDF's Language and Acrobat's "Same as the operating system": the interface in French or
    // English, at once.
    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: @tr("Language"); font-size: Theme.fs-body; color: Theme.text; }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.wrap;
        alignment: LayoutAlignment.start;
        spacing: 8px;
        // Each language named in itself, as iLovePDF lists them (src/i18n.rs LANGUAGES' order).
        Segment { width: 190px; text: @tr("As the system's language"); selected: PlatformBridge.language == 0; clicked => { PlatformBridge.set-language(0); } }
        for name[i] in ["English", "Français", "Deutsch", "Español", "Italiano", "Português"]: Segment {
            width: 112px;
            text: name;
            selected: PlatformBridge.language == i + 1;
            clicked => { PlatformBridge.set-language(i + 1); }
        }
    }
}
