// Prepare form: the fields drawn over their pages, the selected field's properties card (Acrobat's
// Field Properties, in short: name, tooltip, required, read-only, several lines, items) and the
// card of several fields selected together (Acrobat's Align, Center, Distribute, Match Size).
import { PlatformBridge } from "../platform.slint";
import { Theme } from "../theme.slint";
import { SmallButton, PanelField } from "reader-parts.slint";
import { Check } from "../widgets/check.slint";
import { TextEdit } from "std-widgets.slint";
import { ReaderFormField, ReaderFieldProps, ReaderBridge } from "../flow-types.slint";

// One field over its page, its name in its top-left corner.
export component FormFieldBox inherits Rectangle {
    in property <ReaderFormField> field;
    x: field.x;
    y: field.y;
    width: field.w;
    height: field.h;
    background: field.selected ? #3B82F633 : #3B82F61A;
    border-width: field.selected ? 2px : 1px;
    border-color: field.selected ? Theme.accent : #3B82F6;
    Text {
        x: 3px;
        y: 1px;
        width: parent.width - 6px;
        text: root.field.name;
        font-size: 10px;
        color: #1D4ED8;
        overflow: elide;
    }
}

// The selected field's card. Done (or ↩ in a line) applies what changed, as one undo step.
export component FieldPropsCard inherits Rectangle {
    in property <ReaderFieldProps> props;
    in property <int> id;
    // The keyboard back to the pages.
    callback focus-pages();
    property <bool> required;
    property <bool> read-only;
    property <bool> multiline;
    property <int> align;
    property <int> font;
    property <int> action;
    property <int> format;

    width: 360px;
    height: col.preferred-height;
    border-radius: Theme.radius-item;
    background: Theme.card;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;
    // Each newly selected field (or a change applied: a new name, a new place) starts from its own
    // values; the model's refreshes in between keep what is being typed.
    property <string> key: props.name + "@" + round(props.x / 1px) + "," + round(props.y / 1px) + "#" + props.seq;
    changed key => {
        name-field.text = props.name;
        tip-field.text = props.tooltip;
        items.text = props.options;
        root.required = props.required;
        root.read-only = props.read-only;
        root.multiline = props.multiline;
        root.align = props.align;
        root.font = props.font;
        root.action = props.action;
        size-text.text = props.font-size;
        url-text.text = props.url;
        root.format = props.format;
        min-text.text = props.min;
        max-text.text = props.max;
        calc-text.text = props.calc;
    }
    init => {
        name-field.text = props.name;
        tip-field.text = props.tooltip;
        items.text = props.options;
        root.required = props.required;
        root.read-only = props.read-only;
        root.multiline = props.multiline;
        root.align = props.align;
        root.font = props.font;
        root.action = props.action;
        size-text.text = props.font-size;
        url-text.text = props.url;
        root.format = props.format;
        min-text.text = props.min;
        max-text.text = props.max;
        calc-text.text = props.calc;
    }
    function apply() {
        ReaderBridge.field-scripts(root.id, root.format, min-text.text, max-text.text, calc-text.text);
        ReaderBridge.field-props(root.id, name-field.text, tip-field.text, root.required, root.read-only, root.multiline, items.text, size-text.text, root.align, root.font, root.action, url-text.text);
        root.focus-pages();
    }
    // A click on the card stays on it.
    TouchArea { }
    col := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: [@tr("Text field"), @tr("Check box"), @tr("Radio button"), @tr("Dropdown"), @tr("List box"), @tr("Button"), @tr("Signature field")][root.props.exact];
            font-size: Theme.fs-label;
            font-weight: Theme.weight-demibold;
            color: Theme.text-heading;
        }
        name-field := PanelField { placeholder: @tr("Name"); }
        tip-field := PanelField { placeholder: @tr("Tooltip (what to fill in)"); }
        if root.props.exact == 3 || root.props.exact == 4: VerticalLayout {
            spacing: 4px;
            Text { text: @tr("Items, one per line"); font-size: Theme.fs-caption; color: Theme.text-muted; }
            items-edit := TextEdit {
                // Tools page tools' keys wait while a field has the keyboard.
                changed has-focus => { PlatformBridge.typing = self.has-focus; }
                height: 84px;
                font-size: Theme.fs-label;
                text <=> items.text;
            }
        }
        // Text, dropdown and list: the text's size and alignment (Acrobat's Appearance ▸ Font size, Options ▸ Alignment).
        if root.props.exact == 0 || root.props.exact == 3 || root.props.exact == 4: HorizontalLayout {
            spacing: 6px;
            Text { text: @tr("Size"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            PanelField { width: 64px; placeholder: @tr("Auto"); text <=> size-text.text; }
            Rectangle { width: 8px; }
            for a[i] in [@tr("Left"), @tr("Centre"), @tr("Right")]: SmallButton { text: a; on: root.align == i; clicked => { root.align = i; } }
        }
        // Its text's font (Acrobat's Appearance ▸ Font).
        if root.props.exact == 0 || (root.props.exact >= 3 && root.props.exact <= 5): HorizontalLayout {
            spacing: 4px;
            for f[i] in ["Helvetica", "Times", "Courier"]: SmallButton { text: f; on: root.font == i; clicked => { root.font = i; } }
        }
        // A button: what a click does (Acrobat's Actions ▸ Mouse Up).
        if root.props.exact == 5: VerticalLayout {
            spacing: 6px;
            Text { text: @tr("When clicked"); font-size: Theme.fs-caption; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 4px;
                for a[i] in [@tr("Nothing"), @tr("Clear"), @tr("Print"), @tr("Open address"), @tr("Submit")]: SmallButton { text: a; on: root.action == i; clicked => { root.action = i; } }
            }
            if root.action >= 3: PanelField { placeholder: root.action == 4 ? @tr("The address the form is sent to") : "https://…"; text <=> url-text.text; }
        }
        // A text field: Acrobat's Format, Validate (a range) and Calculate (simplified field notation).
        if root.props.exact == 0: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text { text: @tr("Format"); font-size: Theme.fs-caption; color: Theme.text-muted; vertical-alignment: center; }
                for f[i] in [@tr("None"), @tr("Number"), "%", @tr("Date"), @tr("Phone"), @tr("Zip")]: SmallButton { text: f; on: root.format == i; clicked => { root.format = i; } }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text { text: @tr("Between"); font-size: Theme.fs-caption; color: Theme.text-muted; vertical-alignment: center; }
                PanelField { width: 70px; placeholder: "min"; text <=> min-text.text; }
                Text { text: "and"; font-size: Theme.fs-caption; color: Theme.text-muted; vertical-alignment: center; }
                PanelField { width: 70px; placeholder: "max"; text <=> max-text.text; }
            }
            PanelField { placeholder: @tr("Calculated: Price * Quantity"); text <=> calc-text.text; }
        }
        HorizontalLayout {
            spacing: 14px;
            Check { text: @tr("Required"); checked <=> root.required; }
            Check { text: @tr("Read-only"); checked <=> root.read-only; }
            if root.props.exact == 0: Check { text: @tr("Several lines"); checked <=> root.multiline; }
        }
        // Copies in a grid, the field the top-left one (Acrobat's Create Multiple Copies: down, across).
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text { text: @tr("Copies"); vertical-alignment: center; font-size: Theme.fs-caption; color: Theme.text-muted; }
            down := PanelField { width: 44px; placeholder: "1"; }
            Text { text: @tr("down ×"); vertical-alignment: center; font-size: Theme.fs-caption; color: Theme.text-muted; }
            across := PanelField { width: 44px; placeholder: "1"; }
            Text { text: "across"; vertical-alignment: center; font-size: Theme.fs-caption; color: Theme.text-muted; }
            SmallButton {
                text: @tr("Make");
                clicked => {
                    ReaderBridge.field-copies(root.id, down.text == "" ? 1 : down.text.to-float(), across.text == "" ? 1 : across.text.to-float());
                    root.focus-pages();
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            SmallButton { text: @tr("Delete"); clicked => { ReaderBridge.field-delete(root.id); root.focus-pages(); } }
            if root.props.other-pages: SmallButton { text: @tr("On every page"); clicked => { ReaderBridge.field-everywhere(root.id); root.focus-pages(); } }
            Rectangle { horizontal-stretch: 1; }
            SmallButton { text: @tr("Done"); primary: true; clicked => { root.apply(); } }
        }
    }
    // The texts of the rows shown for some fields only, kept here when the row is hidden.
    items := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
    size-text := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
    min-text := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
    max-text := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
    calc-text := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
    url-text := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
}

// Several fields selected (⇧-click): they follow the first one picked. Each button is one undo step.
export component FieldsArrangeCard inherits Rectangle {
    in property <int> count;
    in property <int> id;
    callback focus-pages();
    width: 360px;
    height: col.preferred-height;
    border-radius: Theme.radius-item;
    background: Theme.card;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;
    TouchArea { }
    col := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: @tr("{} fields selected", root.count);
            font-size: Theme.fs-label;
            font-weight: Theme.weight-demibold;
            color: Theme.text-heading;
        }
        Text { text: @tr("Arranged after the first one picked; the arrow keys move them."); font-size: Theme.fs-caption; color: Theme.text-muted; wrap: word-wrap; }
        // Codes as reader::arrange.
        for row in [
            { label: @tr("Align"), items: [{ t: @tr("Left"), k: 0 }, { t: @tr("Centre"), k: 1 }, { t: @tr("Right"), k: 2 }] },
            { label: "", items: [{ t: @tr("Top"), k: 3 }, { t: @tr("Middle"), k: 4 }, { t: @tr("Bottom"), k: 5 }] },
            { label: @tr("Size"), items: [{ t: @tr("Same width"), k: 6 }, { t: @tr("Same height"), k: 7 }, { t: @tr("Both"), k: 8 }] },
            { label: @tr("Space"), items: [{ t: @tr("Evenly across"), k: 9 }, { t: @tr("Evenly down"), k: 10 }] },
        ]: HorizontalLayout {
            spacing: 4px;
            Text { width: 44px; text: row.label; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            for b in row.items: SmallButton { text: b.t; clicked => { ReaderBridge.fields-arrange(root.id, b.k); root.focus-pages(); } }
        }
        HorizontalLayout {
            spacing: 6px;
            SmallButton { text: @tr("Delete"); clicked => { ReaderBridge.field-delete(root.id); root.focus-pages(); } }
            Rectangle { horizontal-stretch: 1; }
            SmallButton { text: @tr("Done"); primary: true; clicked => { ReaderBridge.escape(root.id); root.focus-pages(); } }
        }
    }
}

// Edit tool, objects picked (Acrobat's Align Objects and Arrange): several lined up on the
// selection's outer edge or middle, or spaced evenly; one or more brought to the front, forward,
// backward or sent to the back; each button is one undo step.
export component ObjectsArrangeCard inherits Rectangle {
    in property <int> count;
    in property <int> id;
    // Comments selected together instead of objects.
    in property <bool> comments;
    callback focus-pages();
    // Wide enough for the four Order buttons in one row (340 px cut "To back" off; seen in smoke 210).
    width: 420px;
    height: col.preferred-height;
    border-radius: Theme.radius-item;
    background: Theme.card;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;
    TouchArea { }
    col := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: root.count + (root.comments ? @tr(" comments selected") : root.count == 1 ? @tr(" object selected") : @tr(" objects selected"));
            font-size: Theme.fs-label;
            font-weight: Theme.weight-demibold;
            color: Theme.text-heading;
        }
        // Codes as reader::arrange (several only).
        if root.count > 1: VerticalLayout {
            spacing: 8px;
            for row in [
                { label: @tr("Align"), items: [{ t: @tr("Left"), k: 0 }, { t: @tr("Centre"), k: 1 }, { t: @tr("Right"), k: 2 }] },
                { label: "", items: [{ t: @tr("Top"), k: 3 }, { t: @tr("Middle"), k: 4 }, { t: @tr("Bottom"), k: 5 }] },
                { label: @tr("Space"), items: [{ t: @tr("Evenly across"), k: 9 }, { t: @tr("Evenly down"), k: 10 }] },
            ]: HorizontalLayout {
                spacing: 4px;
                Text { width: 44px; text: row.label; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                for b in row.items: SmallButton {
                    text: b.t;
                    clicked => {
                        if root.comments { ReaderBridge.annots-arrange(root.id, b.k); } else { ReaderBridge.objects-arrange(root.id, b.k); }
                        root.focus-pages();
                    }
                }
            }
        }
        // Stacking order (Acrobat's Arrange), codes 20–23 as reader_ui::objects_arrange.
        if !root.comments: HorizontalLayout {
            spacing: 4px;
            Text { width: 44px; text: @tr("Order"); font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            for b in [{ t: @tr("To front"), k: 20 }, { t: @tr("Forward"), k: 21 }, { t: @tr("Backward"), k: 22 }, { t: @tr("To back"), k: 23 }]: SmallButton {
                text: b.t;
                clicked => {
                    ReaderBridge.objects-arrange(root.id, b.k);
                    root.focus-pages();
                }
            }
        }
    }
}
