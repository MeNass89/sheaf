// Prepare form: the fields drawn over their pages, the selected field's properties card (Acrobat's
// Field Properties, in short: name, tooltip, required, read-only, several lines, items) and the
// card of several fields selected together (Acrobat's Align, Center, Distribute, Match Size).
import { Theme } from "../theme.slint";
import { SmallButton, PanelField } from "reader-parts.slint";
import { Check } from "../widgets/check.slint";
import { TextEdit } from "std-widgets.slint";
import { ReaderFormField, ReaderFieldProps, ReaderBridge } from "../flow-types.slint";

// One field over its page, its name in its top-left corner.
export component FormFieldBox inherits Rectangle {
    in property <ReaderFormField> field;
    x: field.x;
    y: field.y;
    width: field.w;
    height: field.h;
    background: field.selected ? #3B82F633 : #3B82F61A;
    border-width: field.selected ? 2px : 1px;
    border-color: field.selected ? Theme.accent : #3B82F6;
    Text {
        x: 3px;
        y: 1px;
        width: parent.width - 6px;
        text: root.field.name;
        font-size: 10px;
        color: #1D4ED8;
        overflow: elide;
    }
}

// The selected field's card. Done (or ↩ in a line) applies what changed, as one undo step.
export component FieldPropsCard inherits Rectangle {
    in property <ReaderFieldProps> props;
    in property <int> id;
    // The keyboard back to the pages.
    callback focus-pages();
    property <bool> required;
    property <bool> read-only;
    property <bool> multiline;
    property <int> align;
    property <int> font;
    property <int> action;

    width: 360px;
    height: col.preferred-height;
    border-radius: Theme.radius-item;
    background: Theme.card;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;
    // Each newly selected field (or a change applied: a new name, a new place) starts from its own
    // values; the model's refreshes in between keep what is being typed.
    property <string> key: props.name + "@" + round(props.x / 1px) + "," + round(props.y / 1px) + "#" + props.seq;
    changed key => {
        name-field.text = props.name;
        tip-field.text = props.tooltip;
        items.text = props.options;
        root.required = props.required;
        root.read-only = props.read-only;
        root.multiline = props.multiline;
        root.align = props.align;
        root.font = props.font;
        root.action = props.action;
        size-text.text = props.font-size;
        url-text.text = props.url;
    }
    init => {
        name-field.text = props.name;
        tip-field.text = props.tooltip;
        items.text = props.options;
        root.required = props.required;
        root.read-only = props.read-only;
        root.multiline = props.multiline;
        root.align = props.align;
        root.font = props.font;
        root.action = props.action;
        size-text.text = props.font-size;
        url-text.text = props.url;
    }
    function apply() {
        ReaderBridge.field-props(root.id, name-field.text, tip-field.text, root.required, root.read-only, root.multiline, items.text, size-text.text, root.align, root.font, root.action, url-text.text);
        root.focus-pages();
    }
    // A click on the card stays on it.
    TouchArea { }
    col := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: ["Text field", "Check box", "Radio button", "Dropdown", "List box", "Button", "Signature field"][root.props.exact];
            font-size: Theme.fs-label;
            font-weight: Theme.weight-demibold;
            color: Theme.text-heading;
        }
        name-field := PanelField { placeholder: "Name"; }
        tip-field := PanelField { placeholder: "Tooltip (what to fill in)"; }
        if root.props.exact == 3 || root.props.exact == 4: VerticalLayout {
            spacing: 4px;
            Text { text: "Items, one per line"; font-size: Theme.fs-caption; color: Theme.text-muted; }
            items-edit := TextEdit {
                height: 84px;
                font-size: Theme.fs-label;
                text <=> items.text;
            }
        }
        // Text, dropdown and list: the text's size and alignment (Acrobat's Appearance ▸ Font size, Options ▸ Alignment).
        if root.props.exact == 0 || root.props.exact == 3 || root.props.exact == 4: HorizontalLayout {
            spacing: 6px;
            Text { text: "Size"; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            PanelField { width: 64px; placeholder: "Auto"; text <=> size-text.text; }
            Rectangle { width: 8px; }
            for a[i] in ["Left", "Centre", "Right"]: SmallButton { text: a; primary: root.align == i; clicked => { root.align = i; } }
        }
        // Its text's font (Acrobat's Appearance ▸ Font).
        if root.props.exact == 0 || (root.props.exact >= 3 && root.props.exact <= 5): HorizontalLayout {
            spacing: 4px;
            for f[i] in ["Helvetica", "Times", "Courier"]: SmallButton { text: f; primary: root.font == i; clicked => { root.font = i; } }
        }
        // A button: what a click does (Acrobat's Actions ▸ Mouse Up).
        if root.props.exact == 5: VerticalLayout {
            spacing: 6px;
            Text { text: "When clicked"; font-size: Theme.fs-caption; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 4px;
                for a[i] in ["Nothing", "Clear", "Print", "Open address", "Submit"]: SmallButton { text: a; primary: root.action == i; clicked => { root.action = i; } }
            }
            if root.action >= 3: PanelField { placeholder: root.action == 4 ? "The address the form is sent to" : "https://…"; text <=> url-text.text; }
        }
        HorizontalLayout {
            spacing: 14px;
            Check { text: "Required"; checked <=> root.required; }
            Check { text: "Read-only"; checked <=> root.read-only; }
            if root.props.exact == 0: Check { text: "Several lines"; checked <=> root.multiline; }
        }
        HorizontalLayout {
            spacing: 6px;
            SmallButton { text: "Delete"; clicked => { ReaderBridge.field-delete(root.id); root.focus-pages(); } }
            if root.props.other-pages: SmallButton { text: "On every page"; clicked => { ReaderBridge.field-everywhere(root.id); root.focus-pages(); } }
            Rectangle { horizontal-stretch: 1; }
            SmallButton { text: "Done"; primary: true; clicked => { root.apply(); } }
        }
    }
    // The texts of the rows shown for some fields only, kept here when the row is hidden.
    items := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
    size-text := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
    url-text := Rectangle {
        in-out property <string> text;
        visible: false;
        width: 0;
        height: 0;
    }
}

// Several fields selected (⇧-click): they follow the first one picked. Each button is one undo step.
export component FieldsArrangeCard inherits Rectangle {
    in property <int> count;
    in property <int> id;
    callback focus-pages();
    width: 360px;
    height: col.preferred-height;
    border-radius: Theme.radius-item;
    background: Theme.card;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 2px;
    TouchArea { }
    col := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: root.count + " fields selected";
            font-size: Theme.fs-label;
            font-weight: Theme.weight-demibold;
            color: Theme.text-heading;
        }
        Text { text: "Arranged after the first one picked; the arrow keys move them."; font-size: Theme.fs-caption; color: Theme.text-muted; wrap: word-wrap; }
        // Codes as reader::arrange.
        for row in [
            { label: "Align", items: [{ t: "Left", k: 0 }, { t: "Centre", k: 1 }, { t: "Right", k: 2 }, { t: "Top", k: 3 }, { t: "Middle", k: 4 }, { t: "Bottom", k: 5 }] },
            { label: "Size", items: [{ t: "Same width", k: 6 }, { t: "Same height", k: 7 }, { t: "Both", k: 8 }] },
            { label: "Space", items: [{ t: "Evenly across", k: 9 }, { t: "Evenly down", k: 10 }] },
        ]: HorizontalLayout {
            spacing: 4px;
            Text { width: 44px; text: row.label; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
            for b in row.items: SmallButton { text: b.t; clicked => { ReaderBridge.fields-arrange(root.id, b.k); root.focus-pages(); } }
        }
        HorizontalLayout {
            spacing: 6px;
            SmallButton { text: "Delete"; clicked => { ReaderBridge.field-delete(root.id); root.focus-pages(); } }
            Rectangle { horizontal-stretch: 1; }
            SmallButton { text: "Done"; primary: true; clicked => { ReaderBridge.escape(root.id); root.focus-pages(); } }
        }
    }
}
