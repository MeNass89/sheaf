// Home ▸ Tasks (DESIGN §5.1): every finished run, newest first, on Home's margins and title row.
import { PlatformBridge } from "../platform.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme, Motion, Space } from "../theme.slint";
import { Button, ButtonKind, IconButton } from "../widgets/button.slint";
import { Sheet, SheetButtons } from "../widgets/surfaces.slint";
import { HistoryRow } from "../history-types.slint";
import { HomeMetrics, PageTitle, EmptyState, LinkButton } from "home-kit.slint";

// One run: the tool's glyph on a `fill-1` tile, its name and files, when, Run Again, Show in folder.
// 52 tall, a hairline under it; hover `fill-1`.
component HistoryRowView inherits Rectangle {
    in property <HistoryRow> item;
    callback reveal();
    callback rerun();
    height: 52px;
    border-radius: Theme.r-row;
    background: ta.has-hover ? Theme.fill-1 : transparent;
    animate background { duration: Motion.hover; }
    ta := TouchArea { }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        x: Space.sm;
        width: parent.width - 2 * Space.sm;
        background: Theme.hairline;
    }
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: LayoutAlignment.stretch;
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.md;
        Rectangle {
            cross-axis-self-alignment: CrossAxisAlignment.center;
            width: 32px;
            height: 32px;
            border-radius: Theme.r-pill;
            background: Theme.fill-1;
            Image {
                width: Theme.icon-md;
                height: Theme.icon-md;
                source: root.item.icon;
                colorize: Theme.text;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.item.tool-name;
                font-size: Theme.fs-headline;
                font-weight: Theme.weight-demibold;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.item.files;
                font-size: Theme.fs-subhead;
                color: Theme.text-2;
                overflow: elide;
            }
        }
        Text {
            text: root.item.when;
            font-size: Theme.fs-callout;
            color: Theme.text-2;
            vertical-alignment: center;
        }
        if root.item.can-rerun: LinkButton {
            text: @tr("Run again");
            clicked => { root.rerun(); }
        }
        IconButton {
            cross-axis-self-alignment: CrossAxisAlignment.center;
            icon: @image-url("../icons/folder-open.svg");
            enabled: root.item.can-reveal;
            tip: PlatformBridge.mac ? @tr("Show in Finder") : @tr("Show in Folder");
            clicked => { root.reveal(); }
        }
    }
}

// "Clear the whole history?" Shown by AppWindow so its scrim covers the whole window.
export component ClearHistoryDialog inherits Rectangle {
    callback clear();
    callback cancel();
    background: Theme.scrim;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { root.cancel(); return accept; }
            if e.text == Key.Return { root.clear(); return accept; }
            reject
        }
    }
    Sheet {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 360px;
        height: self.preferred-height;
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("Clear the whole history?");
            font-size: Theme.fs-headline;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
        }
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("Your files are not deleted.");
            font-size: Theme.fs-body;
            color: Theme.text-2;
        }
        SheetButtons {
            Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
            Button { text: @tr("Clear"); kind: ButtonKind.primary; clicked => { root.clear(); } }
        }
    }
}

// Home ▸ Tasks: every finished job, newest first.
export component HistoryScreen inherits Rectangle {
    in property <[HistoryRow]> rows;
    callback reveal(int);
    callback rerun(int);
    // "Clear History…" pressed: AppWindow asks for confirmation.
    callback ask-clear();
    background: Theme.window;

    VerticalLayout {
        padding-top: HomeMetrics.top;
        spacing: Space.lg;
        PageTitle {
            padding-left: HomeMetrics.margin;
            padding-right: HomeMetrics.margin;
            text: @tr("Tasks");
            if root.rows.length > 0: Button {
                text: @tr("Clear History…");
                clicked => { root.ask-clear(); }
            }
        }
        if root.rows.length == 0: EmptyState {
            icon: @image-url("../icons/list.svg");
            text: @tr("Runs of your tools will appear here with their results");
        }
        if root.rows.length > 0: scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: scroll.visible-width;
                padding-left: HomeMetrics.margin - Space.sm;
                padding-right: HomeMetrics.margin - Space.sm;
                padding-bottom: HomeMetrics.margin;
                alignment: start;
                for r[i] in root.rows: HistoryRowView {
                    item: r;
                    reveal => { root.reveal(i); }
                    rerun => { root.rerun(i); }
                }
            }
        }
        if root.rows.length == 0: Rectangle { vertical-stretch: 1; }
    }
}
