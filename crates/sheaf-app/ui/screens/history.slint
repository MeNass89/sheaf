import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "../widgets/button.slint";
import { HistoryRow } from "../history-types.slint";
import { Modal, SecondaryButton } from "dialogs.slint";
import { PrimaryButton } from "../widgets/button.slint";

component HistoryRowView inherits Rectangle {
    in property <HistoryRow> item;
    callback reveal();
    callback rerun();
    height: 56px;
    border-radius: Theme.radius-item;
    background: Theme.card;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 32px;
            height: 32px;
            border-radius: 7px;
            background: root.item.tile;
            Image {
                width: 18px;
                height: 18px;
                source: root.item.icon;
                colorize: white;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.tool-name;
                font-size: Theme.fs-body;
                font-weight: Theme.weight-demibold;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: root.item.files;
                font-size: Theme.fs-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        Text {
            text: root.item.when;
            font-size: Theme.fs-label;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        if root.item.can-rerun: Text {
            text: "Run again";
            font-size: Theme.fs-label;
            font-weight: Theme.weight-demibold;
            color: rerun-touch.has-hover ? Theme.accent-hover : Theme.accent;
            vertical-alignment: center;
            rerun-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.rerun(); }
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("../icons/folder-open.svg");
            enabled: root.item.can-reveal;
            clicked => { root.reveal(); }
        }
    }
}

// "Clear the whole history?" Shown by AppWindow so its scrim covers the whole window.
export component ClearHistoryDialog inherits Modal {
    callback clear();
    callback cancel();
    Text {
        text: "Clear the whole history?";
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
    }
    Text {
        text: "Your files are not deleted.";
        font-size: Theme.fs-label;
        color: Theme.text-secondary;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 10px;
        SecondaryButton {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
        PrimaryButton {
            text: "Clear";
            clicked => { root.clear(); }
        }
    }
}

// Tasks History page: every finished job, newest first.
export component HistoryScreen inherits Rectangle {
    in property <[HistoryRow]> rows;
    callback reveal(int);
    callback rerun(int);
    // "Clear all" pressed: AppWindow asks for confirmation.
    callback ask-clear();
    background: Theme.content-bg;

    VerticalLayout {
        padding-top: Theme.content-padding;
        spacing: 12px;
        HorizontalLayout {
            padding-left: Theme.content-padding;
            padding-right: Theme.content-padding;
            height: 36px;
            Text {
                text: "Tasks History";
                font-size: Theme.fs-page-title;
                font-weight: Theme.weight-bold;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.rows.length > 0: Text {
                text: "Clear all";
                font-size: Theme.fs-button;
                font-weight: Theme.weight-demibold;
                color: clear-touch.has-hover ? Theme.accent-hover : Theme.accent;
                vertical-alignment: center;
                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.ask-clear(); }
                }
            }
        }
        if root.rows.length == 0: Text {
            x: Theme.content-padding;
            text: "Finished tasks will appear here";
            font-size: Theme.fs-button;
            color: Theme.text-muted;
        }
        scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: scroll.visible-width;
                padding-left: Theme.content-padding;
                padding-right: Theme.content-padding;
                padding-bottom: Theme.content-padding;
                spacing: 8px;
                alignment: start;
                for r[i] in root.rows: HistoryRowView {
                    item: r;
                    reveal => { root.reveal(i); }
                    rerun => { root.rerun(i); }
                }
            }
        }
    }
}
