// Reader: one document open to read and annotate, PDF Expert's reading window as the model.
// Toolbar on top (panel, annotation tools and colours, page field, zoom, page theme, search,
// undo/redo/save), a side panel (reader-panel.slint: thumbnails, outline, notes, results), the pages in a continuous
// scroll. Pages, thumbnails and zoom are the tab's viewer (ViewerBridge); everything else is
// ReaderBridge. Coordinates given to Rust are content coordinates of the page scroll.
import { ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Pad } from "sign-panel.slint";
import { ToolButton, SmallButton, Divider, ColourDot } from "reader-parts.slint";
import { ReaderPanel } from "reader-panel.slint";
import { SortCombo } from "../widgets/sort-combo.slint";
import { TextField } from "../widgets/text-field.slint";
import { ToolTab, ViewerBridge, ReaderBridge } from "../flow-types.slint";

export component ReaderScreen inherits Rectangle {
    in property <ToolTab> tab;
    in property <bool> is-full-screen;
    // The tab shown: it takes the keyboard when it becomes so (a tab switched to by ⇧⌘[ ⇧⌘] or a click).
    in property <bool> active;
    changed active => { if self.active { keys.focus(); } }
    // Full screen on or off; −1 / +1 the previous / next tab.
    callback full-screen(bool);
    callback switch-tab(int);
    // The reading view alone, toolbar and panel hidden (View ▸ Hide Toolbar).
    in-out property <bool> bare;
    property <bool> over-link;
    // A small window: the three page themes become one button, the zoom buttons go (⌘+ / ⌘− stay).
    property <bool> narrow: root.width < 1150px;
    // Pages panel drag: where the press was, and the drop line (−1: no drag).
    property <length> thumb-down-y;
    property <length> drop-line: -1px;
    property <int> thumb-down-page: -1;
    property <int> id: root.tab.id;
    property <length> panel-width: 248px;
    property <length> page-top: -sv.content-y;
    property <length> strip-top: panel.strip-top;
    property <length> page-w: sv.visible-width;
    property <length> page-h: sv.visible-height;
    property <length> strip-h: panel.strip-h;
    property <bool> pressing;
    // Colours offered per tool: highlights are light, strokes dark (same order as reader.rs).
    property <[color]> light-colours: [#FFDB40, #6BD96B, #61B8FF, #FF7399, #BF80FF];
    property <[color]> ink-colours: [#D93326, #1A1A1F, #1A66E6, #1A994D, #9940D9];
    property <bool> markup-tool: root.tab.reader.tool >= 1 && root.tab.reader.tool <= 3;
    property <bool> light-tool: root.tab.reader.tool == 0 || root.tab.reader.tool == 1 || root.tab.reader.tool == 4;
    property <bool> ink-tool: root.tab.reader.tool >= 4;

    changed page-top => { ViewerBridge.viewport(root.id, root.page-w, root.page-top, root.page-h); }
    changed page-w => { ViewerBridge.viewport(root.id, root.page-w, root.page-top, root.page-h); }
    changed page-h => { ViewerBridge.viewport(root.id, root.page-w, root.page-top, root.page-h); }
    changed strip-h => { ViewerBridge.strip-viewport(root.id, root.strip-top, root.strip-h); }
    changed strip-top => { ViewerBridge.strip-viewport(root.id, root.strip-top, root.strip-h); }
    property <int> scroll-seq: root.tab.viewer-scroll-seq;
    changed scroll-seq => { sv.content-y = -root.tab.viewer-scroll; }

    property <string> page-text: root.tab.reader.page-text;
    changed page-text => { if !page-in.has-focus { page-in.text = root.page-text; } }
    init => {
        ViewerBridge.viewport(root.id, sv.visible-width, root.page-top, sv.visible-height);
        keys.focus();
    }

    public function focus-pages() { keys.focus(); }

    background: Theme.filearea-bg;

    VerticalLayout {
        // ---- toolbar ----------------------------------------------------------------------
        Rectangle {
            height: root.bare ? 0px : 46px;
            visible: !root.bare;
            background: Theme.panel-bg;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 4px;
                alignment: stretch;
                HorizontalLayout {
                    spacing: 2px;
                    alignment: start;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    ToolButton { icon: @image-url("../icons/panel-left.svg"); tip: "Side panel"; active: root.tab.reader.panel-open; clicked => { ReaderBridge.toggle-panel(root.id); } }
                    Rectangle { width: 6px; }
                    Divider { y: 5px; }
                    Rectangle { width: 6px; }
                    ToolButton { icon: @image-url("../icons/mouse-pointer-2.svg"); tip: "Select text (V)"; active: root.tab.reader.tool == 0; clicked => { ReaderBridge.set-tool(root.id, 0); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/highlighter.svg"); tip: "Highlight (H)"; active: root.tab.reader.tool == 1; clicked => { ReaderBridge.set-tool(root.id, 1); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/underline.svg"); tip: "Underline (U)"; active: root.tab.reader.tool == 2; clicked => { ReaderBridge.set-tool(root.id, 2); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/strikethrough.svg"); tip: "Strikethrough (K)"; active: root.tab.reader.tool == 3; clicked => { ReaderBridge.set-tool(root.id, 3); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/sticky-note.svg"); tip: "Note (N)"; active: root.tab.reader.tool == 4; clicked => { ReaderBridge.set-tool(root.id, 4); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/pencil.svg"); tip: "Pen (P)"; active: root.tab.reader.tool == 5; clicked => { ReaderBridge.set-tool(root.id, 5); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/shapes.svg"); tip: "Shapes (R)"; active: root.tab.reader.tool == 10; clicked => { ReaderBridge.set-tool(root.id, 10); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/type.svg"); tip: "Text box (T)"; active: root.tab.reader.tool == 6; clicked => { ReaderBridge.set-tool(root.id, 6); keys.focus(); } }
                    Rectangle { width: 6px; }
                    Divider { y: 5px; }
                    Rectangle { width: 6px; }
                    ToolButton { icon: @image-url("../icons/text-cursor-input.svg"); tip: "Edit text (E)"; active: root.tab.reader.tool == 7; clicked => { ReaderBridge.set-tool(root.id, 7); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/image.svg"); tip: "Add image (I)"; active: root.tab.reader.tool == 8; clicked => { ReaderBridge.set-tool(root.id, 8); keys.focus(); } }
                    ToolButton { icon: @image-url("../icons/signature.svg"); tip: "Sign (S)"; active: root.tab.reader.tool == 9; clicked => { ReaderBridge.set-tool(root.id, 9); keys.focus(); } }
                }
                Rectangle { horizontal-stretch: 1; }
                // Page field and zoom
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    padding-top: 9px;
                    padding-bottom: 9px;
                    Rectangle {
                        width: 46px;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: page-in.has-focus ? Theme.text-secondary : Theme.input-border;
                        background: Theme.input-bg;
                        page-in := TextInput {
                            // Back to the page shown once the field is left or a jump is done.
                            changed has-focus => { if !self.has-focus { self.text = root.tab.reader.page-text; } }
                            x: 6px;
                            width: parent.width - 12px;
                            text: root.tab.reader.page-text;
                            font-size: Theme.fs-label;
                            color: Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                ReaderBridge.go-to-page(root.id, self.text);
                                keys.focus();
                                self.text = root.tab.reader.page-text;
                            }
                        }
                    }
                    Text {
                        text: "/ " + root.tab.reader.page-count;
                        font-size: Theme.fs-label;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 8px; }
                    if !root.narrow: ToolButton { y: -2px; icon: @image-url("../icons/zoom-out.svg"); tip: "Zoom out (⌘−)"; clicked => { ViewerBridge.zoom-step(root.id, -1); } }
                    Text {
                        width: 44px;
                        text: root.tab.viewer-zoom + "%";
                        font-size: Theme.fs-label;
                        color: Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !root.narrow: ToolButton { y: -2px; icon: @image-url("../icons/zoom-in.svg"); tip: "Zoom in (⌘+)"; clicked => { ViewerBridge.zoom-step(root.id, 1); } }
                    ToolButton { y: -2px; icon: @image-url("../icons/maximize.svg"); tip: root.tab.reader.zoom-mode == 1 ? "Fit width (⌘9)" : "Fit page (⌘8)"; clicked => { ReaderBridge.zoom-fit(root.id, root.tab.reader.zoom-mode == 1 ? 0 : 1); } }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 2px;
                    alignment: end;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    if !root.narrow: ToolButton { icon: @image-url("../icons/sun.svg"); tip: "Day"; active: root.tab.reader.theme == 0; clicked => { ReaderBridge.set-theme(root.id, 0); } }
                    if !root.narrow: ToolButton { icon: @image-url("../icons/book-open.svg"); tip: "Sepia"; active: root.tab.reader.theme == 2; clicked => { ReaderBridge.set-theme(root.id, 2); } }
                    if !root.narrow: ToolButton { icon: @image-url("../icons/moon.svg"); tip: "Night"; active: root.tab.reader.theme == 1; clicked => { ReaderBridge.set-theme(root.id, 1); } }
                    // Day → Sepia → Night → Day.
                    if root.narrow: ToolButton {
                        icon: root.tab.reader.theme == 0 ? @image-url("../icons/sun.svg") : root.tab.reader.theme == 2 ? @image-url("../icons/book-open.svg") : @image-url("../icons/moon.svg");
                        tip: "Page theme";
                        clicked => { ReaderBridge.set-theme(root.id, root.tab.reader.theme == 0 ? 2 : root.tab.reader.theme == 2 ? 1 : 0); }
                    }
                    Rectangle { width: 6px; }
                    // Search
                    Rectangle {
                        // Narrower in a small window, so the toolbar always fits (the window's
                        // minimum is 900 px).
                        width: root.narrow ? 110px : clamp(root.width - 1090px, 110px, 210px);
                        border-radius: Theme.radius-button;
                        border-width: 1px;
                        border-color: search-in.has-focus ? Theme.text-secondary : Theme.input-border;
                        background: Theme.input-bg;
                        Image {
                            x: 8px;
                            width: 14px;
                            height: 14px;
                            source: @image-url("../icons/search.svg");
                            colorize: Theme.text-muted;
                        }
                        Text {
                            x: 28px;
                            visible: search-in.text == "";
                            text: "Search";
                            font-size: Theme.fs-label;
                            color: Theme.text-disabled;
                            vertical-alignment: center;
                        }
                        search-in := TextInput {
                            x: 28px;
                            width: parent.width - 28px - count.width - 8px;
                            font-size: Theme.fs-label;
                            color: Theme.text;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                if root.tab.reader.search-count != "" && !root.tab.reader.search-busy {
                                    ReaderBridge.search-step(root.id, 1);
                                } else {
                                    ReaderBridge.search(root.id, self.text);
                                }
                            }
                            // Any change drops the results of the old text: Enter then searches the new one.
                            edited => { ReaderBridge.search-clear(root.id); }
                            key-pressed(e) => {
                                if e.text == Key.Escape {
                                    self.text = "";
                                    ReaderBridge.search-clear(root.id);
                                    keys.focus();
                                    return accept;
                                }
                                if e.text == Key.Return && e.modifiers.shift {
                                    ReaderBridge.search-step(root.id, -1);
                                    return accept;
                                }
                                if e.modifiers.control && (e.text == "g" || e.text == "G") {
                                    ReaderBridge.search-step(root.id, e.modifiers.shift ? -1 : 1);
                                    return accept;
                                }
                                reject
                            }
                        }
                        count := Text {
                            x: parent.width - self.width - 8px;
                            text: root.tab.reader.search-count;
                            font-size: Theme.fs-caption;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { width: 6px; }
                    ToolButton { icon: @image-url("../icons/undo-2.svg"); tip: "Undo (⌘Z)"; enabled: root.tab.reader.can-undo; clicked => { ReaderBridge.undo(root.id); } }
                    ToolButton { icon: @image-url("../icons/redo-2.svg"); tip: "Redo (⇧⌘Z)"; enabled: root.tab.reader.can-redo; clicked => { ReaderBridge.redo(root.id); } }
                    ToolButton { icon: @image-url("../icons/wrench.svg"); tip: "Use a tool on this PDF"; clicked => { ReaderBridge.to-tools(root.id); } }
                    ToolButton { icon: @image-url("../icons/printer.svg"); tip: "Print (⌘P)"; clicked => { ReaderBridge.print-open(root.id); } }
                    ToolButton { icon: @image-url("../icons/save.svg"); tip: root.tab.reader.dirty ? "Save (⌘S)" : "Saved"; enabled: root.tab.reader.dirty; active: root.tab.reader.dirty; clicked => { ReaderBridge.save(root.id); } }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.sidebar-border;
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            // ---- side panel -------------------------------------------------------------------
            panel := ReaderPanel {
                tab: root.tab;
                id: root.id;
                bare: root.bare;
                panel-width: root.panel-width;
                search-text: search-in.text;
                thumb-down-y <=> root.thumb-down-y;
                drop-line <=> root.drop-line;
                thumb-down-page <=> root.thumb-down-page;
                focus-pages => { keys.focus(); }
            }

            // ---- pages ------------------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 1;
                background: root.tab.reader.backdrop;
                clip: true;
                sv := ScrollView {
                    content-width: max(root.tab.viewer-width, self.visible-width);
                    content-height: root.tab.viewer-height;
                    for p in root.tab.viewer-pages: Rectangle {
                        x: p.x;
                        y: p.y;
                        width: p.w;
                        height: p.h;
                        background: root.tab.reader.theme == 1 ? #1E1E20 : root.tab.reader.theme == 2 ? #F4ECD8 : white;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: Theme.thumb-shadow;
                        drop-shadow-offset-y: 1px;
                        if p.ready: Image {
                            width: parent.width;
                            height: parent.height;
                            source: p.image;
                            image-fit: fill;
                        }
                    }
                    for m in root.tab.reader.provisional: Rectangle {
                        x: m.x;
                        y: m.y;
                        width: m.w;
                        height: m.h;
                        background: m.colour;
                    }
                    for m in root.tab.reader.marks: Rectangle {
                        x: m.x;
                        y: m.y;
                        width: m.w;
                        height: m.h;
                        border-radius: m.kind == 6 || m.kind == 7 ? 2px : 1px;
                        background: m.kind == 3 ? #3B82F655 : m.kind == 4 ? #FFD60A66 : m.kind == 5 ? #FF9F0A99 : m.kind == 10 ? #5AA0FF26 : m.kind == 11 ? Theme.info : transparent;
                        border-width: m.kind == 6 ? 1.5px : m.kind == 5 || m.kind == 7 ? 1px : 0px;
                        border-color: m.kind == 6 ? Theme.info : m.kind == 7 ? #3B82F699 : #FF9F0A;
                    }
                    if root.tab.reader.ink != "": Path {
                        x: 0;
                        y: 0;
                        width: max(root.tab.viewer-width, sv.visible-width);
                        height: root.tab.viewer-height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: root.tab.reader.ink;
                        stroke: root.tab.reader.ink-colour;
                        stroke-width: 2px;
                    }
                    pages-ta := TouchArea {
                        width: max(root.tab.viewer-width, sv.visible-width);
                        height: root.tab.viewer-height;
                        mouse-cursor: root.over-link && root.tab.reader.tool == 0 ? pointer : root.tab.reader.tool == 0 || root.markup-tool || root.tab.reader.tool == 7 ? text : crosshair;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.move && !root.pressing {
                                root.over-link = ReaderBridge.over-link(root.id, self.mouse-x, self.mouse-y);
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                keys.focus();
                                root.pressing = true;
                                ReaderBridge.pressed(root.id, self.mouse-x, self.mouse-y, 1);
                            } else if e.kind == PointerEventKind.up && root.pressing {
                                root.pressing = false;
                                ReaderBridge.released(root.id, self.mouse-x, self.mouse-y);
                            }
                        }
                        double-clicked => { ReaderBridge.pressed(root.id, self.mouse-x, self.mouse-y, 2); }
                        moved => {
                            if root.pressing { ReaderBridge.moved(root.id, self.mouse-x, self.mouse-y); }
                        }
                        scroll-event(e) => {
                            // ⌘ + wheel zooms, as in every reader.
                            if e.modifiers.control && e.delta-y != 0 {
                                ViewerBridge.zoom-step(root.id, e.delta-y > 0 ? 1 : -1);
                                return accept;
                            }
                            reject
                        }
                    }
                    // Floating bar over a text selection: Copy, Highlight, Underline, Strikethrough.
                    if root.tab.reader.has-selection && root.tab.reader.tool == 0 && !root.pressing && root.tab.reader.marks.length > 0: Rectangle {
                        x: max(4px, root.tab.reader.marks[0].x);
                        y: max(4px, root.tab.reader.marks[0].y - self.height - 8px);
                        width: bar.preferred-width;
                        height: 34px;
                        border-radius: Theme.radius-item;
                        background: Theme.card;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000040;
                        drop-shadow-offset-y: 2px;
                        bar := HorizontalLayout {
                            padding: 2px;
                            spacing: 0px;
                            ToolButton { icon: @image-url("../icons/copy.svg"); tip: "Copy (⌘C)"; clicked => { clip.text = root.tab.reader.selected-text; clip.select-all(); clip.copy(); keys.focus(); } }
                            ToolButton { icon: @image-url("../icons/highlighter.svg"); tip: "Highlight"; clicked => { ReaderBridge.markup(root.id, 1); } }
                            ToolButton { icon: @image-url("../icons/underline.svg"); tip: "Underline"; clicked => { ReaderBridge.markup(root.id, 2); } }
                            ToolButton { icon: @image-url("../icons/strikethrough.svg"); tip: "Strikethrough"; clicked => { ReaderBridge.markup(root.id, 3); } }
                            Divider { y: 7px; }
                            // Highlight in one of the five colours straight from the selection.
                            for c[k] in root.light-colours: ColourDot {
                                y: 6px;
                                colour: c;
                                selected: false;
                                clicked => {
                                    ReaderBridge.set-colour(root.id, k);
                                    ReaderBridge.markup(root.id, 1);
                                }
                            }
                        }
                    }
                    // A note or text box being typed.
                    if root.tab.reader.note.show: Rectangle {
                        init => {
                            note-edit.text = root.tab.reader.note.text;
                            note-edit.focus();
                        }
                        // Created inside a pointer event, the editor can lose the text set in init:
                        // set it again on the next turn of the event loop.
                        Timer {
                            interval: 1ms;
                            running: true;
                            triggered => {
                                note-edit.text = root.tab.reader.note.text;
                                note-edit.focus();
                                // The caret at the end, ready to add to the text.
                                note-edit.set-selection-offsets(note-edit.text.character-count * 4, note-edit.text.character-count * 4);
                                self.running = false;
                            }
                        }
                        // Tab to the next form field reuses this editor: new text, focus kept.
                        property <int> seq: root.tab.reader.note.seq;
                        changed seq => {
                            note-edit.text = root.tab.reader.note.text;
                            note-edit.focus();
                        }
                        // Kept inside the visible part of the pages.
                        x: min(root.tab.reader.note.x, -sv.content-x + sv.visible-width - self.width - 8px);
                        y: root.tab.reader.note.y;
                        width: root.tab.reader.note.w;
                        height: root.tab.reader.note.h;
                        border-radius: Theme.radius-item;
                        background: Theme.card;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000044;
                        drop-shadow-offset-y: 2px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text {
                                text: root.tab.reader.note.kind == 0 ? "Note" : root.tab.reader.note.kind == 1 ? "Text box" : root.tab.reader.note.kind == 2 ? "Edit text — ⌘↩ to apply" : root.tab.reader.note.kind == 4 ? "↩ done · Tab next field" : root.tab.reader.note.kind == 5 ? "Choose" : root.tab.reader.note.kind == 6 ? "Comment" : "Add text";
                                font-size: Theme.fs-caption;
                                font-weight: Theme.weight-demibold;
                                color: Theme.text-secondary;
                            }
                            if root.tab.reader.note.kind == 5: VerticalLayout {
                                spacing: 2px;
                                for c[k] in root.tab.reader.choices: Rectangle {
                                    height: 26px;
                                    border-radius: Theme.radius-small;
                                    background: ct.has-hover ? Theme.popup-hover : transparent;
                                    Text {
                                        x: 8px;
                                        text: c;
                                        font-size: Theme.fs-label;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                    ct := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { ReaderBridge.choice-picked(root.id, k); keys.focus(); }
                                    }
                                }
                            }
                            note-edit := TextEdit {
                                // Hidden for a choice list; otherwise it takes the room left.
                                visible: root.tab.reader.note.kind != 5;
                                min-height: root.tab.reader.note.kind == 5 ? 0px : 28px;
                                max-height: root.tab.reader.note.kind == 5 ? 0px : 2000px;
                                vertical-stretch: 1;
                                font-size: Theme.fs-label;
                                wrap: word-wrap;
                                key-pressed(e) => {
                                    if e.text == Key.Escape {
                                        ReaderBridge.note-cancel(root.id);
                                        keys.focus();
                                        return accept;
                                    }
                                    if e.text == Key.Return && e.modifiers.control {
                                        ReaderBridge.note-commit(root.id, self.text);
                                        keys.focus();
                                        return accept;
                                    }
                                    // A form field: Return fills it, Tab / ⇧Tab moves to the next / previous one.
                                    if root.tab.reader.note.kind == 4 && e.text == Key.Return && !e.modifiers.shift {
                                        ReaderBridge.note-commit(root.id, self.text);
                                        keys.focus();
                                        return accept;
                                    }
                                    if root.tab.reader.note.kind == 4 && (e.text == Key.Tab || e.text == Key.Backtab) {
                                        ReaderBridge.field-tab(root.id, self.text, e.text == Key.Backtab || e.modifiers.shift);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            if root.tab.reader.note.kind < 4 || root.tab.reader.note.kind == 6: HorizontalLayout {
                                spacing: 6px;
                                alignment: end;
                                SmallButton { text: "Cancel"; clicked => { ReaderBridge.note-cancel(root.id); keys.focus(); } }
                                SmallButton { text: "Done"; primary: true; clicked => { ReaderBridge.note-commit(root.id, note-edit.text); keys.focus(); } }
                            }
                        }
                    }
                }
                        // Options of the tool in use and the form's actions: a bar floating over the top of
                        // the pages (PDF Expert's tool options), so the toolbar fits a small window and the
                        // pages never move when a tool is picked.
                if !root.bare && (root.tab.reader.tool == 5 || (root.tab.reader.tool != 0 && root.tab.reader.tool != 8 && root.tab.reader.tool != 9) || root.tab.reader.selected-annot || root.tab.reader.has-form || root.tab.reader.has-signature): Rectangle {
                    x: 12px;
                    y: 8px;
                    width: min(parent.width - 24px, optbar.preferred-width);
                    height: 36px;
                    border-radius: Theme.radius-item;
                    background: Theme.card;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #00000030;
                    drop-shadow-offset-y: 2px;
                    optbar := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        spacing: 4px;
                            // Shapes: which one, filled or not.
                            if root.tab.reader.tool == 10: HorizontalLayout {
                                spacing: 0px;
                                ToolButton { icon: @image-url("../icons/square.svg"); tip: "Rectangle"; active: root.tab.reader.shape-kind == 0; clicked => { ReaderBridge.shape-option(root.id, 0, 0); keys.focus(); } }
                                ToolButton { icon: @image-url("../icons/circle.svg"); tip: "Oval"; active: root.tab.reader.shape-kind == 1; clicked => { ReaderBridge.shape-option(root.id, 0, 1); keys.focus(); } }
                                ToolButton { icon: @image-url("../icons/slash.svg"); tip: "Line"; active: root.tab.reader.shape-kind == 2; clicked => { ReaderBridge.shape-option(root.id, 0, 2); keys.focus(); } }
                                ToolButton { icon: @image-url("../icons/move-up-right.svg"); tip: "Arrow"; active: root.tab.reader.shape-kind == 3; clicked => { ReaderBridge.shape-option(root.id, 0, 3); keys.focus(); } }
                                if root.tab.reader.shape-kind < 2: SmallButton { y: 2px; text: "Fill"; primary: root.tab.reader.shape-fill; clicked => { ReaderBridge.shape-option(root.id, 1, 0); keys.focus(); } }
                            }
                            if root.tab.reader.tool == 5 || root.tab.reader.tool == 10: HorizontalLayout {
                                spacing: 2px;
                                padding-left: 6px;
                                for w[k] in [2px, 4px, 7px]: Rectangle {
                                    y: 4px;
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    border-width: root.tab.reader.pen-width == k ? 2px : 0px;
                                    border-color: Theme.text;
                                    Rectangle {
                                        width: w;
                                        height: w;
                                        border-radius: w / 2;
                                        background: Theme.text-secondary;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { ReaderBridge.set-pen-width(root.id, k); keys.focus(); }
                                    }
                                }
                            }
                            if root.tab.reader.tool == 5 || root.tab.reader.tool == 10: SmallButton {
                                y: 2px;
                                text: root.tab.reader.opacity + " %";
                                clicked => { ReaderBridge.shape-option(root.id, 2, 0); keys.focus(); }
                            }
                            // Text box: its text size.
                            if root.tab.reader.tool == 6: HorizontalLayout {
                                spacing: 4px;
                                SmallButton { y: 2px; text: "−"; clicked => { ReaderBridge.text-format(root.id, 0, -1); } }
                                Text { text: root.tab.reader.text-size + " pt"; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                                SmallButton { y: 2px; text: "+"; clicked => { ReaderBridge.text-format(root.id, 0, 1); } }
                            }
                            // Edit text: the format of text added on the page.
                            if root.tab.reader.tool == 7: HorizontalLayout {
                                spacing: 4px;
                                SmallButton { y: 2px; text: "Sans"; primary: root.tab.reader.text-family == 0; clicked => { ReaderBridge.text-format(root.id, 1, 0); } }
                                SmallButton { y: 2px; text: "Serif"; primary: root.tab.reader.text-family == 1; clicked => { ReaderBridge.text-format(root.id, 1, 1); } }
                                SmallButton { y: 2px; text: "Mono"; primary: root.tab.reader.text-family == 2; clicked => { ReaderBridge.text-format(root.id, 1, 2); } }
                                SmallButton { y: 2px; text: "B"; primary: root.tab.reader.text-bold; clicked => { ReaderBridge.text-format(root.id, 2, 0); } }
                                SmallButton { y: 2px; text: "−"; clicked => { ReaderBridge.text-format(root.id, 0, -1); } }
                                Text { text: root.tab.reader.text-size + " pt"; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                                SmallButton { y: 2px; text: "+"; clicked => { ReaderBridge.text-format(root.id, 0, 1); } }
                            }
                            if root.tab.reader.has-signature: HorizontalLayout {
                                spacing: 6px;
                                Text { text: "Click where the signature goes."; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                                SmallButton { y: 2px; text: "New signature"; clicked => { ReaderBridge.signature-reset(root.id); } }
                            }
                            if (root.tab.reader.tool != 0 && root.tab.reader.tool != 8 && root.tab.reader.tool != 9) || root.tab.reader.selected-annot: HorizontalLayout {
                                spacing: 2px;
                                padding-left: 6px;
                                for c[k] in (root.light-tool ? root.light-colours : root.ink-colours): ColourDot {
                                    y: 4px;
                                    colour: c;
                                    selected: root.tab.reader.selected-annot ? root.tab.reader.annot-colour == k : root.tab.reader.colour == k;
                                    clicked => { ReaderBridge.set-colour(root.id, k); keys.focus(); }
                                }
                            }
                        Rectangle { horizontal-stretch: 1; }
                            if root.tab.reader.has-form: HorizontalLayout {
                                spacing: 4px;
                                padding-right: 6px;
                                SmallButton { y: 2px; text: "Clear form"; clicked => { ReaderBridge.form-op(root.id, 0); } }
                                SmallButton { y: 2px; text: "Flatten"; clicked => { ReaderBridge.form-op(root.id, 1); } }
                            }
                    }
                }
                if root.tab.viewer-status != "": Text {
                    y: 40px;
                    width: parent.width;
                    text: root.tab.viewer-status;
                    font-size: Theme.fs-body;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
                if root.tab.reader.read-only != "": Rectangle {
                    y: 10px;
                    x: (parent.width - self.width) / 2;
                    width: ro.preferred-width + 24px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.info-bg;
                    ro := Text {
                        text: root.tab.reader.read-only;
                        font-size: Theme.fs-caption;
                        color: Theme.info;
                    }
                }
            }
        }
    }

    // The signature pad (PDF Expert's "Create signature"): draw it, or type a name.
    if root.tab.reader.sign-open: Rectangle {
        background: #00000044;
        TouchArea { }
        Rectangle {
            width: 440px;
            height: sl.preferred-height;
            border-radius: Theme.radius-card;
            background: Theme.card;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            sl := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { text: "Create your signature"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
                pad := Pad { }
                Text { text: "or type your name"; font-size: Theme.fs-caption; color: Theme.text-muted; }
                typed := TextField { placeholder: "Your name"; }
                HorizontalLayout {
                    spacing: 8px;
                    SmallButton { text: "Clear"; clicked => { pad.commands = ""; typed.text = ""; } }
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { text: "Cancel"; clicked => { ReaderBridge.signature-made(root.id, "", 1px, 1px, ""); keys.focus(); } }
                    SmallButton { text: "Use"; primary: true; clicked => { ReaderBridge.signature-made(root.id, pad.commands, pad.width, pad.height, typed.text); keys.focus(); } }
                }
            }
        }
    }

    // The print sheet (PDF Expert's print panel, reduced to what matters): printer, copies, pages,
    // scale, two-sided. Choices stay local until Print.
    if root.tab.reader.print-open: Rectangle {
        property <int> copies: 1;
        property <int> pages: 0;
        property <bool> fit: true;
        property <bool> two-sided: false;
        property <bool> ready: root.tab.reader.printers.length > 0;
        property <int> printer: root.tab.reader.printer;
        background: #00000044;
        TouchArea { }
        // Return prints, Escape cancels (the sheet takes the keyboard when it opens).
        sheet-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Return { ok.clicked(); return accept; }
                if e.text == Key.Escape { ReaderBridge.print-cancel(root.id); keys.focus(); return accept; }
                reject
            }
        }
        Rectangle {
            width: 420px;
            height: pl.preferred-height;
            border-radius: Theme.radius-card;
            background: Theme.card;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            pl := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { text: "Print"; font-size: Theme.fs-body-large; font-weight: Theme.weight-demibold; color: Theme.text; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Printer"; width: 70px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                    if ready: SortCombo {
                        width: 250px;
                        options: root.tab.reader.printers;
                        current-index: root.tab.reader.printer;
                        chevron: @image-url("../icons/chevron-down.svg");
                        selected(i) => { printer = i; }
                    }
                    if !ready: Text { text: "No printer is set up"; font-size: Theme.fs-label; color: Theme.text-muted; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Copies"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                    SmallButton { text: "−"; clicked => { copies = max(1, copies - 1); } }
                    Text { text: copies; width: 30px; horizontal-alignment: center; font-size: Theme.fs-label; color: Theme.text; vertical-alignment: center; }
                    SmallButton { text: "+"; clicked => { copies = min(999, copies + 1); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Pages"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                    SmallButton { text: "All"; primary: pages == 0; clicked => { pages = 0; } }
                    SmallButton { text: "Current"; primary: pages == 1; clicked => { pages = 1; } }
                    SmallButton { text: "Range"; primary: pages == 2; clicked => { pages = 2; } }
                    Rectangle {
                        width: 110px;
                        height: 26px;
                        border-radius: Theme.radius-small;
                        border-width: 1px;
                        border-color: range.has-focus ? Theme.text-secondary : Theme.input-border;
                        background: Theme.input-bg;
                        if range.text == "": Text { x: 8px; text: "1-3, 5"; font-size: Theme.fs-label; color: Theme.text-muted; }
                        range := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            font-size: Theme.fs-label;
                            color: Theme.text;
                            vertical-alignment: center;
                            single-line: true;
                            changed text => { if self.text != "" { pages = 2; } }
                            accepted => { ok.clicked(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Scale"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                    SmallButton { text: "Fit to paper"; primary: fit; clicked => { fit = true; } }
                    SmallButton { text: "Actual size"; primary: !fit; clicked => { fit = false; } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Two-sided"; width: 74px; font-size: Theme.fs-label; color: Theme.text-secondary; vertical-alignment: center; }
                    SmallButton { text: "Off"; primary: !two-sided; clicked => { two-sided = false; } }
                    SmallButton { text: "On"; primary: two-sided; clicked => { two-sided = true; } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { text: "Cancel"; clicked => { ReaderBridge.print-cancel(root.id); keys.focus(); } }
                    ok := SmallButton {
                        text: "Print";
                        primary: ready;
                        clicked => {
                            if ready {
                                ReaderBridge.print(root.id, printer, copies, pages, range.text, fit, two-sided);
                                keys.focus();
                            }
                        }
                    }
                }
            }
        }
    }

    // Copy goes through a hidden text field: Slint's clipboard is a text input's.
    clip := TextInput {
        x: -1000px;
        width: 10px;
        height: 10px;
        visible: false;
        read-only: true;
    }

    // Keyboard of the reading view (Slint reports ⌘ as `control` on macOS).
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        key-pressed(e) => {
            if e.modifiers.control {
                if e.text == "+" || e.text == "=" { ViewerBridge.zoom-step(root.id, 1); return accept; }
                if e.text == "-" { ViewerBridge.zoom-step(root.id, -1); return accept; }
                // PDF Expert's shortcuts: ⌘0 100 %, ⌘9 fit width, ⌘8 fit page, ⌃⌘F full screen,
                // ⇧⌘[ ⇧⌘] previous / next tab, ⌥⌘G go to page, ⌥⌘0 left panel.
                if e.text == "0" && e.modifiers.alt { ReaderBridge.toggle-panel(root.id); return accept; }
                if e.text == "0" { ReaderBridge.zoom-fit(root.id, 2); return accept; }
                if e.text == "9" { ReaderBridge.zoom-fit(root.id, 0); return accept; }
                if e.text == "8" { ReaderBridge.zoom-fit(root.id, 1); return accept; }
                if (e.text == "f" || e.text == "F") && e.modifiers.meta { root.full-screen(!root.is-full-screen); return accept; }
                if (e.text == "g" || e.text == "©") && e.modifiers.alt { page-in.focus(); page-in.select-all(); return accept; }
                if (e.text == "[" || e.text == "{") && e.modifiers.shift { root.switch-tab(-1); return accept; }
                if (e.text == "]" || e.text == "}") && e.modifiers.shift { root.switch-tab(1); return accept; }
                if e.text == "f" { search-in.focus(); search-in.select-all(); return accept; }
                if e.text == "g" || e.text == "G" { ReaderBridge.search-step(root.id, e.modifiers.shift ? -1 : 1); return accept; }
                if e.text == "c" && root.tab.reader.has-selection {
                    clip.text = root.tab.reader.selected-text;
                    clip.select-all();
                    clip.copy();
                    // Copying went through the hidden field: the keyboard comes back here.
                    keys.focus();
                    return accept;
                }
                if e.text == "a" { ReaderBridge.select-all(root.id); return accept; }
                if e.text == "[" { ReaderBridge.history(root.id, -1); return accept; }
                if e.text == "]" { ReaderBridge.history(root.id, 1); return accept; }
                // With ⇧ the letter comes upper case.
                if (e.text == "z" || e.text == "Z") && e.modifiers.shift { ReaderBridge.redo(root.id); return accept; }
                if e.text == "z" { ReaderBridge.undo(root.id); return accept; }
                if e.text == "y" { ReaderBridge.redo(root.id); return accept; }
                if (e.text == "s" || e.text == "S") && e.modifiers.shift { ReaderBridge.save-as(root.id); return accept; }
                if e.text == "w" { ReaderBridge.close(root.id); return accept; }
                if e.text == "s" { ReaderBridge.save(root.id); return accept; }
                if e.text == "p" { ReaderBridge.print-open(root.id); return accept; }
                if e.text == Key.UpArrow || e.text == Key.Home { ReaderBridge.page-step(root.id, -10); return accept; }
                if e.text == Key.DownArrow || e.text == Key.End { ReaderBridge.page-step(root.id, 10); return accept; }
                return reject;
            }
            if e.text == Key.Escape && root.is-full-screen { root.full-screen(false); return accept; }
            if e.text == Key.Escape && root.bare { root.bare = false; return accept; }
            if e.text == Key.Escape { ReaderBridge.escape(root.id); return accept; }
            // ⌃⌘T in PDF Expert hides the toolbar; here T alone with ⇧ (no ⌘ shortcuts left free).
            if e.text == "T" || (e.text == "t" && e.modifiers.shift) { root.bare = !root.bare; return accept; }
            if e.text == Key.Delete || e.text == Key.Backspace { ReaderBridge.delete-selected(root.id); return accept; }
            if e.text == Key.RightArrow { ReaderBridge.page-step(root.id, 1); return accept; }
            if e.text == Key.LeftArrow { ReaderBridge.page-step(root.id, -1); return accept; }
            if e.text == Key.PageDown || (e.text == " " && !e.modifiers.shift) { ReaderBridge.page-step(root.id, 2); return accept; }
            if e.text == Key.PageUp || (e.text == " " && e.modifiers.shift) { ReaderBridge.page-step(root.id, -2); return accept; }
            if e.text == Key.Home { ReaderBridge.page-step(root.id, -10); return accept; }
            if e.text == Key.End { ReaderBridge.page-step(root.id, 10); return accept; }
            if e.text == Key.DownArrow { ReaderBridge.scroll-by(root.id, 48px); return accept; }
            if e.text == Key.UpArrow { ReaderBridge.scroll-by(root.id, -48px); return accept; }
            if e.text == "v" { ReaderBridge.set-tool(root.id, 0); return accept; }
            if e.text == "h" { ReaderBridge.set-tool(root.id, 1); return accept; }
            if e.text == "u" { ReaderBridge.set-tool(root.id, 2); return accept; }
            if e.text == "k" { ReaderBridge.set-tool(root.id, 3); return accept; }
            if e.text == "n" { ReaderBridge.set-tool(root.id, 4); return accept; }
            if e.text == "p" { ReaderBridge.set-tool(root.id, 5); return accept; }
            if e.text == "r" { ReaderBridge.set-tool(root.id, 10); return accept; }
            if e.text == "t" { ReaderBridge.set-tool(root.id, 6); return accept; }
            if e.text == "e" { ReaderBridge.set-tool(root.id, 7); return accept; }
            if e.text == "i" { ReaderBridge.set-tool(root.id, 8); return accept; }
            if e.text == "s" { ReaderBridge.set-tool(root.id, 9); return accept; }
            reject
        }
    }
}
