// Reader: one document open to read and annotate, PDF Expert's reading window as the model.
// Toolbar on top (reader-toolbar.slint), a side panel (reader-panel.slint: thumbnails, outline,
// notes, results), the pages in a continuous scroll with the tool's options bar over them
// (reader-options.slint), sheets over everything (reader-sheets.slint). Pages, thumbnails and
// zoom are the tab's viewer (ViewerBridge); everything else is ReaderBridge. Coordinates given to
// Rust are content coordinates of the page scroll.
import { ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolButton, SmallButton, Divider, ColourDot } from "reader-parts.slint";
import { ReaderPanel } from "reader-panel.slint";
import { ReaderToolbar } from "reader-toolbar.slint";
import { ReaderOptionsBar } from "reader-options.slint";
import { SignatureSheet, PrintSheet, PropertiesSheet } from "reader-sheets.slint";
import { ToolTab, ViewerBridge, ReaderBridge } from "../flow-types.slint";

export component ReaderScreen inherits Rectangle {
    in property <ToolTab> tab;
    in property <bool> is-full-screen;
    // The tab shown: it takes the keyboard when it becomes so (a tab switched to by ⇧⌘[ ⇧⌘] or a click).
    in property <bool> active;
    changed active => { if self.active { keys.focus(); } }
    // Full screen on or off; −1 / +1 the previous / next tab.
    callback full-screen(bool);
    callback switch-tab(int);
    // ⌘, : Home ▸ Preferences.
    callback open-preferences();
    // The reading view alone, toolbar and panel hidden (View ▸ Hide Toolbar).
    in-out property <bool> bare;
    property <string> link-tip;
    property <bool> over-link: root.link-tip != "";
    // A small window: the three page themes become one button, the zoom buttons go (⌘+ / ⌘− stay).
    property <bool> narrow: root.width < 1150px;
    // Pages panel drag: where the press was, and the drop line (−1: no drag).
    property <length> thumb-down-y;
    property <length> drop-line: -1px;
    property <int> thumb-down-page: -1;
    property <int> id: root.tab.id;
    property <length> panel-width: 248px;
    property <length> page-top: -sv.content-y;
    property <length> strip-top: panel.strip-top;
    property <length> page-w: sv.visible-width;
    property <length> page-h: sv.visible-height;
    property <length> strip-h: panel.strip-h;
    property <bool> pressing;
    // Colours offered per tool: highlights are light, strokes dark (same order as reader.rs).
    property <[color]> light-colours: [#FFDB40, #6BD96B, #61B8FF, #FF7399, #BF80FF];
    property <[color]> ink-colours: [#D93326, #1A1A1F, #1A66E6, #1A994D, #9940D9];
    property <bool> markup-tool: root.tab.reader.tool >= 1 && root.tab.reader.tool <= 3;
    // The palette shown: a selected comment's own (light for highlights and notes), else the tool's.
    property <bool> light-tool: root.tab.reader.selected-annot ? root.tab.reader.annot-light
        : root.tab.reader.tool == 0 || root.tab.reader.tool == 1 || root.tab.reader.tool == 4;
    property <bool> ink-tool: root.tab.reader.tool >= 4;
    // Panning: Space held, or the middle button, drags the pages (PDF Expert's and Acrobat's hand);
    // the pointer and scroll position where the drag began, in view coordinates.
    property <bool> space-held;
    property <bool> panning;
    property <bool> panned;
    property <length> pan-vx0;
    property <length> pan-vy0;
    property <length> pan-cx0;
    property <length> pan-cy0;
    property <PointerEventButton> pan-button;
    // Pinch: the zoom when the gesture began.
    property <float> pinch-zoom0;
    // ⌘ + wheel: where the pointer is in the window, taken from the first wheel event and kept until
    // the pointer really moves. In the window, not on the pages: the pages move under the still
    // pointer as they zoom, and Slint then sends moves of its own, some before the new scroll is in.
    property <length> pointer-wx;
    property <length> pointer-wy;
    property <bool> wheel-anchored;

    // Zooms to `pct` percent actual size, the view point (ax, ay) staying on the same point of
    // its page under the pointer or the pinch (Rust works it out; the vertical scroll comes with
    // the tab, the horizontal one is returned).
    function zoom-around(pct: float, ax: length, ay: length) {
        ViewerBridge.zoom-at(root.id, pct, ax / 1px, ay / 1px, root.scroll-x-now / 1px);
    }

    // Scrolling moves the pages under a still pointer: a link's tooltip no longer applies.
    changed page-top => { root.link-tip = ""; ViewerBridge.viewport(root.id, root.page-w, root.page-top, root.page-h); }
    property <length> page-left: -sv.content-x;
    // The scroll a zoom wanted is taken: no need to set it again.
    changed page-left => {
        root.link-tip = "";
        if root.want-x >= 0px && abs(root.page-left - root.want-x) < 1px { root.want-x = -1px; }
    }
    changed page-w => { ViewerBridge.viewport(root.id, root.page-w, root.page-top, root.page-h); }
    changed page-h => { ViewerBridge.viewport(root.id, root.page-w, root.page-top, root.page-h); }
    changed strip-h => { ViewerBridge.strip-viewport(root.id, root.strip-top, root.strip-h); }
    changed strip-top => { ViewerBridge.strip-viewport(root.id, root.strip-top, root.strip-h); }
    property <int> scroll-seq: root.tab.viewer-scroll-seq;
    // Rust's scroll after a zoom, both ways, once the new page sizes are in (setting it earlier
    // would be cut to the old width).
    changed scroll-seq => {
        sv.content-y = -root.tab.viewer-scroll;
        // Each scroll asked for replaces what an earlier zoom wanted across: a jump with no
        // horizontal part (Home, a page) left the last zoom's, which a later width change then
        // put back (the view drifted sideways after ⌘9 then a ⌘ + wheel zoom).
        root.want-x = root.tab.viewer-scroll-x >= 0px ? root.tab.viewer-scroll-x : -1px;
        if root.tab.viewer-scroll-x >= 0px {
            sv.content-x = -root.tab.viewer-scroll-x;
            want-x-timer.running = true;
        }
    }
    // The view can take that scroll before its content has the new width, and cut it to the old
    // width: it is set again when the width comes, until the view shows it (a busy machine brought
    // the width after the 300 ms this used to wait, and a zoom drifted sideways), 2 s at most.
    property <length> want-x: -1px;
    // The horizontal scroll a zoom step anchors on: the one asked for and not shown yet, else the
    // view's. A wheel notch landing before the last one's scroll is shown (a busy machine) would
    // otherwise anchor on the old one and drift.
    property <length> scroll-x-now: root.want-x >= 0px ? root.want-x : -sv.content-x;
    property <length> content-w: root.tab.viewer-width;
    changed content-w => { if root.want-x >= 0px { sv.content-x = -root.want-x; } }
    want-x-timer := Timer {
        interval: 2000ms;
        running: false;
        triggered => { root.want-x = -1px; self.running = false; }
    }

    init => {
        ViewerBridge.viewport(root.id, sv.visible-width, root.page-top, sv.visible-height);
        keys.focus();
    }

    public function focus-pages() { keys.focus(); }

    // Presentation (⇧⌘P): full screen, no toolbar or panel, a whole page in view; arrows and Space
    // turn pages, Escape ends it.
    // Presenting (not only full screen): Space and the arrows show whole pages; Escape ends it.
    property <bool> presenting;
    // Bumped by the window (⌘, Preferences) to end a presentation as Escape does.
    in property <int> end-presenting;
    // Bumped by the window when this tab should take the keyboard (after a dialog closed).
    in property <int> take-keys;
    changed take-keys => { if root.active { keys.focus(); } }
    changed end-presenting => { root.stop-presenting(); }
    function stop-presenting() {
        if root.presenting {
            root.bare = false;
            root.presenting = false;
            ReaderBridge.set-spread(root.id, root.spread-before);
        }
    }
    // The two-page mode a presentation put aside (it shows one page at a time).
    property <int> spread-before;
    function present() {
        // Already presenting: the mode to restore is kept.
        if root.presenting { return; }
        root.presenting = true;
        root.spread-before = root.tab.reader.spread;
        ReaderBridge.set-spread(root.id, 0);
        root.full-screen(true);
        root.bare = true;
        ReaderBridge.zoom-fit(root.id, 1);
        keys.focus();
    }

    background: Theme.filearea-bg;

    VerticalLayout {
        toolbar := ReaderToolbar {
            tab: root.tab;
            id: root.id;
            is-full-screen: root.is-full-screen;
            narrow: root.narrow;
            bare <=> root.bare;
            focus-pages => { keys.focus(); }
            present => { root.present(); }
            toggle-full-screen => { root.full-screen(!root.is-full-screen); root.presenting = false; }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            // ---- side panel -------------------------------------------------------------------
            panel := ReaderPanel {
                tab: root.tab;
                id: root.id;
                bare: root.bare;
                panel-width: root.panel-width;
                search-text: toolbar.search-text;
                thumb-down-y <=> root.thumb-down-y;
                drop-line <=> root.drop-line;
                thumb-down-page <=> root.thumb-down-page;
                focus-pages => { keys.focus(); }
            }

            // ---- pages ------------------------------------------------------------------------
            Rectangle {
                horizontal-stretch: 1;
                background: root.tab.reader.backdrop;
                clip: true;
                // Trackpad pinch (macOS) and touch screens zoom around the fingers. Under the pages:
                // everything else passes through to them.
                ScaleRotateGestureHandler {
                    started => { root.pinch-zoom0 = root.tab.viewer-zoom; }
                    updated => { root.zoom-around(root.pinch-zoom0 * self.scale, self.center.x, self.center.y); }
                }
                sv := ScrollView {
                    content-width: max(root.tab.viewer-width, self.visible-width);
                    content-height: root.tab.viewer-height;
                    for p in root.tab.viewer-pages: Rectangle {
                        x: p.x;
                        y: p.y;
                        width: p.w;
                        height: p.h;
                        background: root.tab.reader.theme == 1 ? #1E1E20 : root.tab.reader.theme == 2 ? #F4ECD8 : white;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: Theme.thumb-shadow;
                        drop-shadow-offset-y: 1px;
                        if p.ready: Image {
                            width: parent.width;
                            height: parent.height;
                            source: p.image;
                            image-fit: fill;
                        }
                    }
                    for m in root.tab.reader.provisional: Rectangle {
                        x: m.x;
                        y: m.y;
                        width: m.w;
                        height: m.h;
                        background: m.colour;
                    }
                    for m in root.tab.reader.marks: Rectangle {
                        x: m.x;
                        y: m.y;
                        width: m.w;
                        height: m.h;
                        border-radius: m.kind == 6 || m.kind == 7 ? 2px : 1px;
                        background: m.kind == 3 ? #3B82F655 : m.kind == 4 ? #FFD60A66 : m.kind == 5 ? #FF9F0A99 : m.kind == 10 ? #5AA0FF26 : m.kind == 11 ? Theme.info : transparent;
                        border-width: m.kind == 6 ? 1.5px : m.kind == 5 || m.kind == 7 ? 1px : 0px;
                        border-color: m.kind == 6 ? Theme.info : m.kind == 7 ? #3B82F699 : #FF9F0A;
                    }
                    if root.tab.reader.ink != "": Path {
                        x: 0;
                        y: 0;
                        width: max(root.tab.viewer-width, sv.visible-width);
                        height: root.tab.viewer-height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: root.tab.reader.ink;
                        stroke: root.tab.reader.ink-colour;
                        stroke-width: 2px;
                    }
                    pages-ta := TouchArea {
                        // A link's tooltip goes when the pointer leaves the pages.
                        changed has-hover => { if !self.has-hover { root.link-tip = ""; } }
                        width: max(root.tab.viewer-width, sv.visible-width);
                        height: root.tab.viewer-height;
                        mouse-cursor: root.panning ? grabbing : root.space-held ? grab : root.over-link && root.tab.reader.tool == 0 ? pointer : root.tab.reader.tool == 0 || root.markup-tool || root.tab.reader.tool == 7 ? text : crosshair;
                        // Where a link goes, beside the pointer.
                        if root.over-link && root.tab.reader.tool == 0: Rectangle {
                            // Beside the pointer, flipped above or to the left near the edges of the view.
                            x: min(pages-ta.mouse-x + 14px, -sv.content-x + sv.visible-width - self.width - 4px);
                            y: pages-ta.mouse-y + 48px > -sv.content-y + sv.visible-height ? pages-ta.mouse-y - 30px : pages-ta.mouse-y + 18px;
                            width: min(lt.preferred-width + 14px, 420px);
                            height: 22px;
                            border-radius: Theme.radius-small;
                            background: Theme.toast-bg;
                            lt := Text { x: 7px; width: parent.width - 14px; text: root.link-tip; font-size: Theme.fs-caption; color: Theme.on-toast; overflow: elide; vertical-alignment: center; }
                        }
                        pointer-event(e) => {
                            // A drag with the middle button, or with Space held, moves the pages.
                            if e.kind == PointerEventKind.down && !root.pressing && !root.panning && (e.button == PointerEventButton.middle || (root.space-held && e.button == PointerEventButton.left)) {
                                root.panning = true;
                                root.pan-button = e.button;
                                root.pan-vx0 = self.mouse-x + sv.content-x;
                                root.pan-vy0 = self.mouse-y + sv.content-y;
                                root.pan-cx0 = sv.content-x;
                                root.pan-cy0 = sv.content-y;
                                return;
                            }
                            if root.panning {
                                if e.kind == PointerEventKind.move {
                                    sv.content-x = clamp(root.pan-cx0 + (self.mouse-x + sv.content-x - root.pan-vx0), min(0px, sv.visible-width - sv.content-width), 0px);
                                    sv.content-y = clamp(root.pan-cy0 + (self.mouse-y + sv.content-y - root.pan-vy0), min(0px, sv.visible-height - sv.content-height), 0px);
                                    if root.space-held { root.panned = true; }
                                } else if e.kind == PointerEventKind.up && e.button == root.pan-button {
                                    root.panning = false;
                                }
                                return;
                            }
                            if e.kind == PointerEventKind.move
                                && (abs(self.absolute-position.x + self.mouse-x - root.pointer-wx) > 1px
                                    || abs(self.absolute-position.y + self.mouse-y - root.pointer-wy) > 1px) {
                                root.wheel-anchored = false;
                            }
                            if e.kind == PointerEventKind.move && !root.pressing {
                                root.link-tip = ReaderBridge.over-link(root.id, self.mouse-x, self.mouse-y);
                                if root.tab.reader.tool == 7 { ReaderBridge.hover(root.id, self.mouse-x, self.mouse-y); }
                            }
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                keys.focus();
                                root.pressing = true;
                                // ⇧ held: 16 more (the Edit tool picks objects together).
                                ReaderBridge.pressed(root.id, self.mouse-x, self.mouse-y, e.modifiers.shift ? 17 : 1);
                            } else if e.kind == PointerEventKind.up && root.pressing {
                                root.pressing = false;
                                ReaderBridge.released(root.id, self.mouse-x, self.mouse-y);
                            }
                        }
                        double-clicked => { ReaderBridge.pressed(root.id, self.mouse-x, self.mouse-y, 2); }
                        moved => {
                            if root.pressing { ReaderBridge.moved(root.id, self.mouse-x, self.mouse-y); }
                        }
                        scroll-event(e) => {
                            // ⌘ + wheel zooms around the pointer, as in every reader.
                            if e.modifiers.control && e.delta-y != 0 {
                                // In proportion to the scroll: a wheel notch is about ×1.25, a trackpad's
                                // many small steps add up smoothly.
                                if !root.wheel-anchored {
                                    root.pointer-wx = self.absolute-position.x + self.mouse-x;
                                    root.pointer-wy = self.absolute-position.y + self.mouse-y;
                                    root.wheel-anchored = true;
                                }
                                // The point of the view under the pointer: the window point less the
                                // view's own place in the window (not moved by the zoom).
                                ViewerBridge.zoom-by(root.id, clamp(pow(1.002, e.delta-y / 1px), 0.8, 1.25), (root.pointer-wx - sv.absolute-position.x) / 1px, (root.pointer-wy - sv.absolute-position.y) / 1px, root.scroll-x-now / 1px);
                                return accept;
                            }
                            reject
                        }
                    }
                    // Floating bar over a text selection: Copy, Highlight, Underline, Strikethrough.
                    if root.tab.reader.has-selection && root.tab.reader.tool == 0 && !root.pressing && root.tab.reader.marks.length > 0: Rectangle {
                        // Kept inside the visible part of the pages, whatever the zoom and the scroll.
                        x: max(-sv.content-x + 4px, min(root.tab.reader.marks[0].x, -sv.content-x + sv.visible-width - self.width - 4px));
                        y: max(-sv.content-y + 4px, root.tab.reader.marks[0].y - self.height - 8px);
                        width: bar.preferred-width;
                        height: 34px;
                        border-radius: Theme.radius-item;
                        background: Theme.card;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000040;
                        drop-shadow-offset-y: 2px;
                        bar := HorizontalLayout {
                            padding: 2px;
                            spacing: 0px;
                            ToolButton { icon: @image-url("../icons/copy.svg"); tip: "Copy (⌘C)"; clicked => { clip.text = root.tab.reader.selected-text; clip.select-all(); clip.copy(); keys.focus(); } }
                            // PDF Expert's "Search": the selected words in the search field, results listed.
                            ToolButton {
                                icon: @image-url("../icons/search.svg");
                                tip: "Search for this (⇧⌘E)";
                                clicked => { root.bare = false; toolbar.search-for(root.tab.reader.selected-text); keys.focus(); }
                            }
                            ToolButton { icon: @image-url("../icons/highlighter.svg"); tip: "Highlight"; clicked => { ReaderBridge.markup(root.id, 1); } }
                            ToolButton { icon: @image-url("../icons/underline.svg"); tip: "Underline"; clicked => { ReaderBridge.markup(root.id, 2); } }
                            ToolButton { icon: @image-url("../icons/strikethrough.svg"); tip: "Strikethrough"; clicked => { ReaderBridge.markup(root.id, 3); } }
                            // Acrobat's and PDF Expert's link from selected text.
                            ToolButton { icon: @image-url("../icons/link.svg"); tip: "Link… (⌘K)"; clicked => { ReaderBridge.link-selection(root.id); } }
                            Divider { y: 7px; }
                            // Highlight in one of the five colours straight from the selection.
                            for c[k] in root.light-colours: ColourDot {
                                y: 6px;
                                colour: c;
                                selected: false;
                                clicked => {
                                    ReaderBridge.set-colour(root.id, k);
                                    ReaderBridge.markup(root.id, 1);
                                }
                            }
                        }
                    }
                    // A note or text box being typed.
                    if root.tab.reader.note.show: Rectangle {
                        init => {
                            note-edit.text = root.tab.reader.note.text;
                            note-edit.focus();
                        }
                        // Created inside a pointer event, the editor can lose the text set in init:
                        // set it again on the next turn of the event loop.
                        Timer {
                            interval: 1ms;
                            running: true;
                            triggered => {
                                note-edit.text = root.tab.reader.note.text;
                                note-edit.focus();
                                // The caret at the end, ready to add to the text.
                                note-edit.set-selection-offsets(note-edit.text.character-count * 4, note-edit.text.character-count * 4);
                                self.running = false;
                            }
                        }
                        // Tab to the next form field reuses this editor: new text, focus kept.
                        property <int> seq: root.tab.reader.note.seq;
                        changed seq => {
                            note-edit.text = root.tab.reader.note.text;
                            note-edit.focus();
                        }
                        // Kept inside the visible part of the pages.
                        x: min(root.tab.reader.note.x, -sv.content-x + sv.visible-width - self.width - 8px);
                        y: root.tab.reader.note.y;
                        width: root.tab.reader.note.w;
                        height: root.tab.reader.note.h;
                        border-radius: Theme.radius-item;
                        background: Theme.card;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000044;
                        drop-shadow-offset-y: 2px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text {
                                text: root.tab.reader.note.kind == 0 ? "Note" : root.tab.reader.note.kind == 1 ? "Text box" : root.tab.reader.note.kind == 2 ? "Edit text — ⌘↩ to apply" : root.tab.reader.note.kind == 4 ? "↩ done · Tab next field" : root.tab.reader.note.kind == 5 ? "Choose" : root.tab.reader.note.kind == 6 ? "Comment" : root.tab.reader.note.kind == 7 ? "Reply — ↩ to send" : root.tab.reader.note.kind == 8 ? "Link to — a page number or a web address" : root.tab.reader.note.kind == 9 ? "Link — change where it goes, or remove it" : "Add text";
                                font-size: Theme.fs-caption;
                                font-weight: Theme.weight-demibold;
                                color: Theme.text-secondary;
                            }
                            if root.tab.reader.note.kind == 5: VerticalLayout {
                                spacing: 2px;
                                for c[k] in root.tab.reader.choices: Rectangle {
                                    height: 26px;
                                    border-radius: Theme.radius-small;
                                    background: ct.has-hover ? Theme.popup-hover : transparent;
                                    Text {
                                        x: 8px;
                                        text: c;
                                        font-size: Theme.fs-label;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                    ct := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { ReaderBridge.choice-picked(root.id, k); keys.focus(); }
                                    }
                                }
                            }
                            note-edit := TextEdit {
                                // Hidden for a choice list; otherwise it takes the room left.
                                visible: root.tab.reader.note.kind != 5;
                                min-height: root.tab.reader.note.kind == 5 ? 0px : 28px;
                                max-height: root.tab.reader.note.kind == 5 ? 0px : 2000px;
                                vertical-stretch: 1;
                                font-size: Theme.fs-label;
                                wrap: word-wrap;
                                edited(text) => { ReaderBridge.note-edited(root.id, text); }
                                key-pressed(e) => {
                                    if e.text == Key.Escape {
                                        ReaderBridge.note-cancel(root.id);
                                        keys.focus();
                                        return accept;
                                    }
                                    if e.text == Key.Return && e.modifiers.control {
                                        ReaderBridge.note-commit(root.id, self.text);
                                        keys.focus();
                                        return accept;
                                    }
                                    // A form field: Return fills it, Tab / ⇧Tab moves to the next / previous one.
                                    // A reply: Return sends it, ⇧Return starts a new line (as in a chat).
                                    // A link: Return sets it.
                                    if (root.tab.reader.note.kind == 4 || root.tab.reader.note.kind == 7 || root.tab.reader.note.kind >= 8) && e.text == Key.Return && !e.modifiers.shift {
                                        ReaderBridge.note-commit(root.id, self.text);
                                        keys.focus();
                                        return accept;
                                    }
                                    if root.tab.reader.note.kind == 4 && (e.text == Key.Tab || e.text == Key.Backtab) {
                                        ReaderBridge.field-tab(root.id, self.text, e.text == Key.Backtab || e.modifiers.shift);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            if root.tab.reader.note.kind >= 8 && root.tab.reader.link-error != "": Text {
                                text: root.tab.reader.link-error;
                                font-size: Theme.fs-caption;
                                color: Theme.danger;
                                wrap: word-wrap;
                            }
                            if root.tab.reader.note.kind < 4 || root.tab.reader.note.kind == 6 || root.tab.reader.note.kind >= 8: HorizontalLayout {
                                spacing: 6px;
                                alignment: end;
                                // An existing link: remove it (as Acrobat's Delete on a selected link).
                                if root.tab.reader.note.kind == 9: SmallButton { text: "Remove link"; clicked => { ReaderBridge.note-commit(root.id, ""); keys.focus(); } }
                                SmallButton { text: "Cancel"; clicked => { ReaderBridge.note-cancel(root.id); keys.focus(); } }
                                SmallButton { text: "Done"; primary: true; clicked => { ReaderBridge.note-commit(root.id, note-edit.text); keys.focus(); } }
                            }
                        }
                    }
                }
                // Options of the tool in use and the form's actions: a bar floating over the top of
                // the pages (PDF Expert's tool options), so the toolbar fits a small window and the
                // pages never move when a tool is picked.
                if !root.bare && (root.tab.reader.tool == 5 || (root.tab.reader.tool != 0 && root.tab.reader.tool != 8 && root.tab.reader.tool != 9 && !(root.tab.reader.tool == 7 && root.tab.reader.has-picked && !root.tab.reader.selected-image)) || root.tab.reader.selected-annot || root.tab.reader.has-form || root.tab.reader.has-signature): ReaderOptionsBar {
                    x: 12px;
                    y: 8px;
                    width: min(parent.width - 24px, self.bar-width);
                    tab: root.tab;
                    id: root.id;
                    light-colours: root.light-colours;
                    ink-colours: root.ink-colours;
                    light-tool: root.light-tool;
                    focus-pages => { keys.focus(); }
                }
                if root.tab.viewer-status != "": Text {
                    y: 40px;
                    width: parent.width;
                    text: root.tab.viewer-status;
                    font-size: Theme.fs-body;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
                if root.tab.reader.read-only != "": Rectangle {
                    y: 10px;
                    x: (parent.width - self.width) / 2;
                    width: ro.preferred-width + 24px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.info-bg;
                    ro := Text {
                        text: root.tab.reader.read-only;
                        font-size: Theme.fs-caption;
                        color: Theme.info;
                    }
                }
            }
        }
    }

    // The signature pad.
    if root.tab.reader.sign-open: SignatureSheet {
        tab: root.tab;
        id: root.id;
        focus-pages => { keys.focus(); }
    }

    // The print sheet.
    if root.tab.reader.print-open: PrintSheet {
        tab: root.tab;
        id: root.id;
        focus-pages => { keys.focus(); }
    }

    // Document Properties (⌘D).
    if root.tab.reader.props-open: PropertiesSheet {
        tab: root.tab;
        id: root.id;
        focus-pages => { keys.focus(); }
    }

    // Copy goes through a hidden text field: Slint's clipboard is a text input's.
    clip := TextInput {
        x: -1000px;
        width: 10px;
        height: 10px;
        visible: false;
        read-only: true;
    }

    // Keyboard of the reading view (Slint reports ⌘ as `control` on macOS).
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        // A Space let go while the keyboard was elsewhere never arrives: no hand left stuck.
        changed has-focus => {
            if !self.has-focus { root.space-held = false; root.panned = false; root.panning = false; }
        }
        // Space: held, a drag pans; let go without a drag, it turns the page (see key-pressed).
        key-released(e) => {
            if e.text == " " && root.space-held {
                root.space-held = false;
                if !root.panned { ReaderBridge.page-step(root.id, e.modifiers.shift ? -2 : 2); }
                root.panned = false;
                return accept;
            }
            reject
        }
        key-pressed(e) => {
            if e.modifiers.control {
                // ⌘K: link the selected text (as in Word, Pages and PDF Expert).
                if e.text == "k" && root.tab.reader.has-selection { ReaderBridge.link-selection(root.id); return accept; }
                if e.text == "+" || e.text == "=" { ViewerBridge.zoom-step(root.id, 1); return accept; }
                if e.text == "-" { ViewerBridge.zoom-step(root.id, -1); return accept; }
                // PDF Expert's shortcuts: ⌘0 100 %, ⌘9 fit width, ⌘8 fit page, ⌃⌘F full screen,
                // ⇧⌘[ ⇧⌘] previous / next tab, ⌥⌘G go to page, ⌥⌘0 left panel.
                if e.text == "0" && e.modifiers.alt { ReaderBridge.toggle-panel(root.id); return accept; }
                // ⌥⌘2: one column → two pages → cover alone (⌥2 types ™ on a Mac keyboard).
                if (e.text == "2" || e.text == "™") && e.modifiers.alt { ReaderBridge.cycle-spread(root.id); return accept; }
                if e.text == "0" { ReaderBridge.zoom-fit(root.id, 2); return accept; }
                if e.text == "9" { ReaderBridge.zoom-fit(root.id, 0); return accept; }
                if e.text == "8" { ReaderBridge.zoom-fit(root.id, 1); return accept; }
                if (e.text == "f" || e.text == "F") && e.modifiers.meta { root.full-screen(!root.is-full-screen); return accept; }
                if (e.text == "g" || e.text == "©") && e.modifiers.alt { toolbar.focus-page-field(); return accept; }
                if (e.text == "[" || e.text == "{") && e.modifiers.shift { root.switch-tab(-1); return accept; }
                if (e.text == "]" || e.text == "}") && e.modifiers.shift { root.switch-tab(1); return accept; }
                if e.text == "f" { toolbar.focus-search(); return accept; }
                if e.text == "g" || e.text == "G" { ReaderBridge.search-step(root.id, e.modifiers.shift ? -1 : 1); return accept; }
                if e.text == "c" && root.tab.reader.has-selection {
                    clip.text = root.tab.reader.selected-text;
                    clip.select-all();
                    clip.copy();
                    // Copying went through the hidden field: the keyboard comes back here.
                    keys.focus();
                    return accept;
                }
                if e.text == "a" { ReaderBridge.select-all(root.id); return accept; }
                if e.text == "v" { ReaderBridge.paste(root.id); return accept; }
                if e.text == "[" { ReaderBridge.history(root.id, -1); return accept; }
                if e.text == "]" { ReaderBridge.history(root.id, 1); return accept; }
                // With ⇧ the letter comes upper case.
                if (e.text == "z" || e.text == "Z") && e.modifiers.shift { ReaderBridge.redo(root.id); return accept; }
                if e.text == "z" { ReaderBridge.undo(root.id); return accept; }
                if e.text == "y" { ReaderBridge.redo(root.id); return accept; }
                if (e.text == "s" || e.text == "S") && e.modifiers.shift { ReaderBridge.save-as(root.id); return accept; }
                if e.text == "w" { ReaderBridge.close(root.id); return accept; }
                if e.text == "s" { ReaderBridge.save(root.id); return accept; }
                if e.text == "P" || (e.text == "p" && e.modifiers.shift) { root.present(); return accept; }
                if e.text == "L" || (e.text == "l" && e.modifiers.shift) { ReaderBridge.toggle-links(root.id); return accept; }
                if e.text == "p" { ReaderBridge.print-open(root.id); return accept; }
                if (e.text == "e" || e.text == "E") && e.modifiers.shift && root.tab.reader.has-selection {
                    // The field and the results show again if the toolbar was hidden (⇧T).
                    root.bare = false;
                    toolbar.search-for(root.tab.reader.selected-text);
                    return accept;
                }
                if e.text == "d" { ReaderBridge.props-open(root.id); return accept; }
                if e.text == "," { root.open-preferences(); return accept; }
                if e.text == Key.UpArrow || e.text == Key.Home { ReaderBridge.page-step(root.id, -10); return accept; }
                if e.text == Key.DownArrow || e.text == Key.End { ReaderBridge.page-step(root.id, 10); return accept; }
                return reject;
            }
            // Presentation ends with its toolbar back; plain full screen keeps a hidden toolbar hidden.
            if e.text == Key.Escape && root.is-full-screen {
                root.full-screen(false);
                root.stop-presenting();
                return accept;
            }
            if root.presenting && (e.text == " " || e.text == Key.RightArrow || e.text == Key.DownArrow || e.text == Key.PageDown) { ReaderBridge.page-step(root.id, e.modifiers.shift ? -1 : 1); return accept; }
            if root.presenting && (e.text == Key.LeftArrow || e.text == Key.UpArrow || e.text == Key.PageUp) { ReaderBridge.page-step(root.id, -1); return accept; }
            if e.text == Key.Escape && root.bare { root.bare = false; return accept; }
            if e.text == Key.Escape { ReaderBridge.escape(root.id); return accept; }
            // ⌃⌘T in PDF Expert hides the toolbar; here T alone with ⇧ (no ⌘ shortcuts left free).
            if e.text == "T" || (e.text == "t" && e.modifiers.shift) { root.bare = !root.bare; return accept; }
            if e.text == Key.Delete || e.text == Key.Backspace { ReaderBridge.delete-selected(root.id); return accept; }
            // Edit tool, objects picked: the arrows nudge them (1 point, 10 with ⇧), as iLovePDF's.
            if root.tab.reader.tool == 7 && root.tab.reader.has-picked {
                if e.text == Key.LeftArrow { ReaderBridge.nudge(root.id, e.modifiers.shift ? -10 : -1, 0); return accept; }
                if e.text == Key.RightArrow { ReaderBridge.nudge(root.id, e.modifiers.shift ? 10 : 1, 0); return accept; }
                if e.text == Key.UpArrow { ReaderBridge.nudge(root.id, 0, e.modifiers.shift ? 10 : 1); return accept; }
                if e.text == Key.DownArrow { ReaderBridge.nudge(root.id, 0, e.modifiers.shift ? -10 : -1); return accept; }
            }
            if e.text == Key.RightArrow { ReaderBridge.page-step(root.id, 1); return accept; }
            if e.text == Key.LeftArrow { ReaderBridge.page-step(root.id, -1); return accept; }
            if e.text == " " {
                if !root.space-held { root.panned = false; }
                root.space-held = true;
                return accept;
            }
            if e.text == Key.PageDown { ReaderBridge.page-step(root.id, 2); return accept; }
            if e.text == Key.PageUp { ReaderBridge.page-step(root.id, -2); return accept; }
            if e.text == Key.Home { ReaderBridge.page-step(root.id, -10); return accept; }
            if e.text == Key.End { ReaderBridge.page-step(root.id, 10); return accept; }
            if e.text == Key.DownArrow { ReaderBridge.scroll-by(root.id, 48px); return accept; }
            if e.text == Key.UpArrow { ReaderBridge.scroll-by(root.id, -48px); return accept; }
            if e.text == "v" { ReaderBridge.set-tool(root.id, 0); return accept; }
            if e.text == "h" { ReaderBridge.set-tool(root.id, 1); return accept; }
            if e.text == "u" { ReaderBridge.set-tool(root.id, 2); return accept; }
            if e.text == "k" { ReaderBridge.set-tool(root.id, 3); return accept; }
            if e.text == "n" { ReaderBridge.set-tool(root.id, 4); return accept; }
            if e.text == "p" { ReaderBridge.set-tool(root.id, 5); return accept; }
            if e.text == "r" { ReaderBridge.set-tool(root.id, 10); return accept; }
            if e.text == "x" { ReaderBridge.set-tool(root.id, 11); return accept; }
            if e.text == "m" { ReaderBridge.set-tool(root.id, 12); return accept; }
            if e.text == "t" { ReaderBridge.set-tool(root.id, 6); return accept; }
            if e.text == "e" { ReaderBridge.set-tool(root.id, 7); return accept; }
            if e.text == "i" { ReaderBridge.set-tool(root.id, 8); return accept; }
            if e.text == "s" { ReaderBridge.set-tool(root.id, 9); return accept; }
            if e.text == "l" { ReaderBridge.set-tool(root.id, 13); return accept; }
            reject
        }
    }
}
