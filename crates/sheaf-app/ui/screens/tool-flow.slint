import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolTab, ToolOptions, FileItem } from "../flow-types.slint";
import { DashedBox } from "../widgets/dashed-box.slint";
import { DropZone, AddFab, SortFab } from "../widgets/drop-zone.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { FileCardView, PageCardView } from "../widgets/file-card.slint";
import { OptionsPanel } from "options.slint";
import { ProcessingOverlay } from "processing.slint";
import { PageViewer } from "../widgets/page-viewer.slint";
import { RedactPanel } from "redact-panel.slint";
import { SignPanel } from "sign-panel.slint";
import { EditPanel } from "edit-panel.slint";
import { ViewerBridge } from "../flow-types.slint";

// Full-width accent button at the bottom of the options panel.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled;
    callback clicked();
    height: Theme.action-height;
    border-radius: Theme.radius-item;
    background: touch.pressed && root.enabled ? Theme.accent-pressed
        : touch.has-hover && root.enabled ? Theme.accent-hover : Theme.accent;
    opacity: root.enabled ? 1 : 0.4;
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Text {
            text: root.text;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-bold;
            color: Theme.on-accent;
            vertical-alignment: center;
        }
        Image {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            source: @image-url("../icons/circle-arrow-right.svg");
            colorize: Theme.on-accent;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Compare: one of the two file slots ("Original" / "Changed").
component CompareSlot inherits VerticalLayout {
    in property <string> label;
    in property <bool> filled;
    in property <FileItem> file;
    in property <color> tile;
    in property <bool> interactive;
    callback open();
    callback remove();
    spacing: 10px;
    alignment: center;
    Text {
        text: root.label;
        font-size: Theme.fs-body-large;
        font-weight: Theme.weight-demibold;
        color: Theme.text;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        alignment: center;
        if root.filled: FileCardView {
            file: root.file;
            tile: root.tile;
            interactive: root.interactive;
            remove => { root.remove(); }
        }
        if !root.filled: DashedBox {
            width: Theme.file-card-width;
            height: Theme.file-card-height;
            background: Theme.card;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    PrimaryButton {
                        text: "Open file";
                        width: 96px;
                        height: 32px;
                        clicked => { root.open(); }
                    }
                }
                Text {
                    text: "or drop it here";
                    font-size: Theme.fs-caption;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }
    }
    // Always laid out, so a filled slot and an empty one keep their cards on one line.
    HorizontalLayout {
        alignment: center;
        Text {
            text: "Replace…";
            font-size: Theme.fs-caption;
            color: Theme.text-secondary;
            opacity: root.filled && root.interactive ? 1 : 0;
            TouchArea {
                enabled: root.filled && root.interactive;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => { root.open(); }
            }
        }
    }
}

// A tool tab before its result: file area on the left, options panel on the right.
export component ToolFlowScreen inherits Rectangle {
    in property <ToolTab> tab;
    callback open-files();
    callback remove-file(int);
    callback move-file(int, int);
    // A file card dropped before slot (0 … files) of the list.
    callback place-file(int, int);
    // A file card being dragged: which, its name, where the pointer is in the grid; the slot it
    // would drop before (the grid's columns from its width, every card one size).
    property <int> drag-uid: -1;
    property <string> drag-name;
    property <length> drag-x;
    property <length> drag-y;
    property <length> step-x: Theme.file-card-width + 16px;
    property <length> step-y: Theme.file-card-height + 16px;
    property <length> grid-w;
    property <int> drop-cols: max(1, floor((root.grid-w - 40px - Theme.fab-size - 36px + 16px) / root.step-x));
    property <int> drop-col: clamp(floor((root.drag-x - 20px + root.step-x / 2) / root.step-x), 0, root.drop-cols);
    property <int> drop-row: max(0, floor((root.drag-y - 20px) / root.step-y));
    property <int> drop-slot: min(root.tab.files.length, root.drop-row * root.drop-cols + root.drop-col);
    // The files by name: A to Z, or Z to A when they already are.
    callback sort-files();
    callback remove-page(int);
    callback move-page(int, int);
    callback insert-blank();
    callback run(ToolOptions);
    callback cancel();
    callback get-libreoffice();
    // Compare: "Open file" on a slot (0 Original, 1 Changed), and swapping the two.
    callback open-slot(int);
    callback swap-slots();

    property <bool> running: root.tab.phase == 1;
    property <bool> organize: root.tab.tool == "organize";
    property <bool> compare: root.tab.tool == "compare";
    // Redact shows its one file in the page viewer instead of the file grid.
    property <bool> redact: root.tab.tool == "redact";
    // Sign places its signature on the same page viewer.
    property <bool> sign: root.tab.tool == "sign";
    // Edit places text and images on it too.
    property <bool> edit: root.tab.tool == "edit";
    property <bool> viewer: root.redact || root.sign || root.edit;
    property <int> need: root.tab.tool == "merge" || root.compare ? 2 : 1;
    property <bool> has-original: root.tab.files.length > 0 && root.tab.files[0].slot == 0;
    property <bool> has-changed: root.tab.files.length > 0 && root.tab.files[root.tab.files.length - 1].slot == 1;

    background: Theme.bg;

    // File area
    area := Rectangle {
        x: Theme.filearea-margin;
        y: Theme.filearea-margin;
        width: parent.width - Theme.panel-width - 2 * Theme.filearea-margin;
        height: parent.height - 2 * Theme.filearea-margin;
        DashedBox {
            background: Theme.filearea-bg;
            if root.compare: HorizontalLayout {
                alignment: center;
                spacing: 28px;
                CompareSlot {
                    label: "Original";
                    filled: root.has-original;
                    file: root.tab.files[0];
                    tile: root.tab.tile;
                    interactive: !root.running;
                    open => { root.open-slot(0); }
                    remove => { root.remove-file(root.tab.files[0].uid); }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: sw.has-hover && sw.enabled ? Theme.popup-hover : Theme.card;
                        opacity: sw.enabled ? 1 : 0.4;
                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../icons/git-compare.svg");
                            colorize: Theme.text;
                        }
                        sw := TouchArea {
                            enabled: root.tab.files.length == 2 && !root.running;
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => { root.swap-slots(); }
                        }
                    }
                    Text {
                        text: "Swap";
                        font-size: Theme.fs-caption;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }
                CompareSlot {
                    label: "Changed";
                    filled: root.has-changed;
                    file: root.tab.files[root.tab.files.length - 1];
                    tile: root.tab.tile;
                    interactive: !root.running;
                    open => { root.open-slot(1); }
                    remove => { root.remove-file(root.tab.files[root.tab.files.length - 1].uid); }
                }
            }
            if root.viewer && root.tab.files.length > 0: PageViewer {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                pages: root.tab.viewer-pages;
                thumbs: root.tab.viewer-thumbs;
                overlays: root.tab.viewer-overlays;
                content-width: root.tab.viewer-width;
                content-height: root.tab.viewer-height;
                thumbs-height: root.tab.viewer-thumbs-height;
                current: root.tab.viewer-current;
                zoom: root.tab.viewer-zoom;
                status: root.tab.viewer-status;
                scroll: root.tab.viewer-scroll;
                scroll-seq: root.tab.viewer-scroll-seq;
                interactive: !root.running;
                drag-box: root.redact;
                selecting: root.tab.viewer-selecting;
                sign: root.tab.sign-overlay;
                sign-image: root.tab.sign-preview;
                edits: root.tab.edit-overlays;
                viewport(w, top, h) => { ViewerBridge.viewport(root.tab.id, w, top, h); }
                strip-viewport(top, h) => { ViewerBridge.strip-viewport(root.tab.id, top, h); }
                pressed(x, y) => { ViewerBridge.pressed(root.tab.id, x, y); }
                released(x, y) => { ViewerBridge.released(root.tab.id, x, y); }
                dragged(x, y) => { if root.redact { ViewerBridge.dragged(root.tab.id, x, y); } }
                double-clicked(x, y) => { if root.redact { ViewerBridge.double-clicked(root.tab.id, x, y); } }
                thumb-clicked(p) => { ViewerBridge.thumb-clicked(root.tab.id, p); }
                zoom-step(d) => { ViewerBridge.zoom-step(root.tab.id, d); }
            }
            if !root.compare && root.tab.files.length == 0: DropZone {
                open-file => { root.open-files(); }
            }
            if !root.compare && !root.viewer && root.tab.files.length > 0: ScrollView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-width: self.visible-width;
                content-height: grid.preferred-height;
                grid := FlexboxLayout {
                    width: parent.visible-width;
                    padding: 20px;
                    padding-right: Theme.fab-size + 36px;
                    spacing: 16px;
                    flex-wrap: wrap;
                    for f[i] in (root.organize ? [] : root.tab.files): FileCardView {
                        drag-to(x, y) => {
                            root.drag-uid = f.uid;
                            root.drag-name = f.name;
                            root.grid-w = grid.width;
                            root.drag-x = x - grid.absolute-position.x;
                            root.drag-y = y - grid.absolute-position.y;
                        }
                        drag-end => {
                            root.place-file(f.uid, root.drop-slot);
                            root.drag-uid = -1;
                        }
                        file: f;
                        tile: root.tab.tile;
                        reorder: root.tab.multi && root.tab.files.length > 1;
                        first: i == 0;
                        last: i == root.tab.files.length - 1;
                        interactive: !root.running;
                        remove => { root.remove-file(f.uid); }
                        move(d) => { root.move-file(f.uid, d); }
                    }
                    for p[i] in (root.organize ? root.tab.pages : []): PageCardView {
                        item: p;
                        first: i == 0;
                        last: i == root.tab.pages.length - 1;
                        interactive: !root.running;
                        remove => { root.remove-page(i); }
                        move(d) => { root.move-page(i, d); }
                    }
                }
                // Where the dragged card would go: a bar before that slot; its name under the pointer.
                if root.drag-uid >= 0: Rectangle {
                    x: 20px + mod(root.drop-slot, root.drop-cols) * root.step-x - 10px;
                    y: 20px + floor(root.drop-slot / root.drop-cols) * root.step-y;
                    width: 3px;
                    height: Theme.file-card-height;
                    border-radius: 2px;
                    background: Theme.accent;
                }
                if root.drag-uid >= 0: Rectangle {
                    x: root.drag-x + 8px;
                    y: root.drag-y + 8px;
                    width: min(200px, ghost-text.preferred-width + 20px);
                    height: 28px;
                    border-radius: Theme.radius-small;
                    background: Theme.card;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000040;
                    ghost-text := Text {
                        text: root.drag-name;
                        font-size: Theme.fs-label;
                        color: Theme.text;
                        overflow: elide;
                    }
                }
            }
            if root.organize && root.tab.preview-failed: Text {
                x: 20px;
                y: parent.height - self.height - 14px;
                text: "⚠ Page previews unavailable";
                font-size: Theme.fs-caption;
                color: Theme.warning;
            }
            if !root.compare && !root.viewer && root.tab.files.length > 0 && !root.running: AddFab {
                x: parent.width - self.width - 20px;
                y: 20px;
                count: root.tab.files.length;
                clicked => { root.open-files(); }
            }
            if !root.compare && !root.viewer && root.tab.multi && root.tab.files.length > 1 && !root.running: SortFab {
                x: parent.width - self.width - 20px;
                y: 20px + Theme.fab-size + 12px;
                clicked => { root.sort-files(); }
            }
            if root.running: ProcessingOverlay {
                progress: root.tab.progress;
                label: root.tab.progress-text;
                cancelling: root.tab.cancelling;
                cancel => { root.cancel(); }
            }
        }
    }

    // Options panel
    Rectangle {
        x: parent.width - Theme.panel-width;
        width: Theme.panel-width;
        background: Theme.panel-bg;
        Rectangle {
            x: 0;
            width: 1px;
            background: Theme.sidebar-border;
        }
        VerticalLayout {
            padding: Theme.panel-padding;
            padding-top: 20px;
            spacing: 14px;
            Text {
                text: root.tab.name;
                font-size: Theme.fs-panel-title;
                font-weight: Theme.weight-demibold;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 1px;
                background: Theme.separator;
            }
            // Add watermark: the first page it marks, as it will look, kept in view while the
            // options below scroll (redrawn as they change, see wm_preview.rs).
            if root.tab.tool == "watermark": VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: 230px;
                    background: Theme.filearea-bg;
                    border-radius: Theme.radius-small;
                    if !root.tab.has-preview: Text {
                        text: root.tab.preview-note != "" ? root.tab.preview-note : root.tab.files.length > 0 ? "Preview…" : "Add a file to see the watermark";
                        width: parent.width - 24px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        font-size: Theme.fs-caption;
                        color: Theme.text-muted;
                    }
                    if root.tab.has-preview: Image {
                        width: parent.width - 12px;
                        height: parent.height - 12px;
                        source: root.tab.preview;
                        image-fit: contain;
                    }
                }
                if root.tab.has-preview && root.tab.preview-note != "": Text {
                    text: root.tab.preview-note;
                    wrap: word-wrap;
                    font-size: Theme.fs-caption;
                    color: Theme.danger;
                }
            }
            // Long panels (page numbers, watermark, crop) scroll above the action button. The
            // style's scrollbar draws over the content, so it gets a 12 px gutter, always (measuring
            // the overflow instead would make the width depend on the height: a binding loop).
            sv := ScrollView {
                property <length> inner: self.visible-width - 12px;
                vertical-stretch: 1;
                // The gutter's width only: content as wide as the viewport would be centred in it.
                content-width: self.inner;
                content-height: root.redact ? rp.preferred-height
                    : root.sign ? sp.preferred-height + 14px + opts.preferred-height
                    : root.edit ? ep.preferred-height : opts.preferred-height;
                rp := RedactPanel {
                    width: sv.inner;
                    visible: root.redact;
                    height: root.redact ? self.preferred-height : 0;
                    tab: root.tab;
                    enabled: !root.running && root.tab.files.length > 0;
                }
                sp := SignPanel {
                    width: sv.inner;
                    visible: root.sign;
                    height: root.sign ? self.preferred-height : 0;
                    tab: root.tab;
                    enabled: !root.running && root.tab.files.length > 0;
                }
                ep := EditPanel {
                    width: sv.inner;
                    visible: root.edit;
                    height: root.edit ? self.preferred-height : 0;
                    tab: root.tab;
                    enabled: !root.running && root.tab.files.length > 0;
                }
                opts := OptionsPanel {
                    y: root.sign ? sp.preferred-height + 14px : 0;
                    visible: !root.redact && !root.edit;
                    width: sv.inner;
                    tool: root.tab.tool;
                    file-count: root.tab.files.length;
                    any-scanned: root.tab.any-scanned;
                    default-out: root.tab.default-out;
                    office-missing: root.tab.office-missing;
                    preview: root.tab.preview;
                    has-preview: root.tab.has-preview;
                    preview-w: root.tab.preview-w;
                    preview-h: root.tab.preview-h;
                    insert-blank => { root.insert-blank(); }
                    get-libreoffice => { root.get-libreoffice(); }
                    tab-id: root.tab.id;
                }
            }
            ActionButton {
                text: root.tab.name;
                enabled: !root.running && opts.valid && root.tab.files-ready && root.tab.files.length >= root.need
                    && (!root.compare || (root.has-original && root.has-changed))
                    && (!root.organize || root.tab.pages.length > 0)
                    && (!root.redact || root.tab.redact-marks.length > 0)
                    && (!root.sign || (root.tab.sign-has-graphic && root.tab.sign-placed))
                    && (!root.edit || root.tab.edit-ready);
                clicked => { root.run(opts.options); }
            }
        }
    }
}
