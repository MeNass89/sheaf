import { PlatformBridge } from "../platform.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ToolTab, ToolOptions, FileItem } from "../flow-types.slint";
import { DashedBox } from "../widgets/dashed-box.slint";
import { DropZone, AddFab, SortFab } from "../widgets/drop-zone.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { FileCardView, PageCardView, SplitPageView } from "../widgets/file-card.slint";
import { OptionsPanel } from "options.slint";
import { ProcessingOverlay } from "processing.slint";
import { PageViewer } from "../widgets/page-viewer.slint";
import { RedactPanel } from "redact-panel.slint";
import { SignPanel } from "sign-panel.slint";
import { EditPanel } from "edit-panel.slint";
import { ViewerBridge, Parse } from "../flow-types.slint";

// Full-width accent button at the bottom of the options panel.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled;
    callback clicked();
    height: Theme.action-height;
    border-radius: Theme.radius-item;
    background: touch.pressed && root.enabled ? Theme.accent-pressed
        : touch.has-hover && root.enabled ? Theme.accent-hover : Theme.accent;
    opacity: root.enabled ? 1 : 0.4;
    FlexboxLayout {
        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
        flex-wrap: FlexboxLayoutWrap.no-wrap;
        alignment: center;
        spacing: 10px;
        Text {
            horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.text;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-bold;
            color: Theme.on-accent;
            vertical-alignment: center;
        }
        Image {
            cross-axis-self-alignment: CrossAxisAlignment.center;
            width: 20px;
            height: 20px;
            source: @image-url("../icons/circle-arrow-right.svg");
            colorize: Theme.on-accent;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Compare: one of the two file slots ("Original" / "Changed").
component CompareSlot inherits Rectangle {
    in property <string> label;
    in property <bool> filled;
    in property <FileItem> file;
    in property <color> tile;
    in property <bool> interactive;
    callback open();
    // Documents open in tabs: Open file first offers them (any one per slot), then the computer.
    in property <[string]> docs;
    callback pick-doc(int);
    callback computer();
    callback remove();
    VerticalLayout {
        spacing: 10px;
        alignment: center;
        Text {
            text: root.label;
            font-size: Theme.fs-body-large;
            font-weight: Theme.weight-demibold;
            color: Theme.text;
            horizontal-alignment: center;
        }
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: center;
            if root.filled: FileCardView {
                file: root.file;
                tile: root.tile;
                interactive: root.interactive;
                remove => { root.remove(); }
            }
            if !root.filled: DashedBox {
                width: Theme.file-card-width;
                height: Theme.file-card-height;
                background: Theme.card;
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    FlexboxLayout {
                        flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: center;
                        PrimaryButton {
                            text: @tr("Open file");
                            width: 96px;
                            height: 32px;
                            clicked => { root.open(); }
                        }
                    }
                    Text {
                        text: @tr("or drop it here");
                        font-size: Theme.fs-caption;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        // Always laid out, so a filled slot and an empty one keep their cards on one line.
        FlexboxLayout {
            flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            alignment: center;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Replace…");
                font-size: Theme.fs-caption;
                color: Theme.text-secondary;
                opacity: root.filled && root.interactive ? 1 : 0;
                TouchArea {
                    enabled: root.filled && root.interactive;
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => { root.open(); }
                }
            }
        }
    }
    // A popup's own size: without it, it takes this slot's and centres the list in it.
    doc-menu := PopupWindow {
        x: (root.width - 240px) / 2;
        y: root.height / 2 + 10px;
        width: 240px;
        height: doc-list.preferred-height;
        Rectangle {
            width: 240px;
            height: doc-list.preferred-height;
            background: Theme.input-bg;
            border-radius: Theme.radius-small;
            border-width: 1px;
            border-color: Theme.input-border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000022;
            doc-list := VerticalLayout {
                padding: 4px;
                Rectangle {
                    height: 32px;
                    border-radius: 3px;
                    background: pc.has-hover ? Theme.popup-hover : transparent;
                    Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; x: 8px; text: @tr("From your computer…"); font-size: Theme.fs-button; color: Theme.text; vertical-alignment: center; }
                    pc := TouchArea { mouse-cursor: pointer; clicked => { root.computer(); } }
                }
                for name[i] in root.docs: Rectangle {
                    height: 32px;
                    border-radius: 3px;
                    background: dt.has-hover ? Theme.popup-hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        Image { y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: @image-url("../icons/file-text.svg"); colorize: Theme.text-secondary; }
                        Text { horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; text: name; font-size: Theme.fs-button; color: Theme.text; vertical-alignment: center; overflow: elide; }
                    }
                    dt := TouchArea { mouse-cursor: pointer; clicked => { root.pick-doc(i); } }
                }
            }
        }
    }
    public function choose() { doc-menu.show(); }
}

// The + menu when PDFs are open in reader tabs: add from the computer, or those documents.
component AddMenu inherits Rectangle {
    in property <int> docs;
    callback computer();
    callback documents();
    width: 240px;
    height: 72px;
    background: Theme.input-bg;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.input-border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000022;
    VerticalLayout {
        padding: 4px;
        for label[i] in ["From your computer…", root.docs == 1 ? "Open document (1)" : "Open documents (\{root.docs})"]: Rectangle {
            height: 32px;
            border-radius: 3px;
            background: ta.has-hover ? Theme.popup-hover : transparent;
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                padding-left: 8px;
                spacing: 8px;
                Image {
                    width: 16px;
                    cross-axis-self-alignment: CrossAxisAlignment.center;
                    height: 16px;
                    source: i == 0 ? @image-url("../icons/folder-open.svg") : @image-url("../icons/file-text.svg");
                    colorize: Theme.text-secondary;
                }
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: label;
                    font-size: Theme.fs-button;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { if i == 0 { root.computer(); } else { root.documents(); } }
            }
        }
    }
}

// A tool tab before its result: file area on the left, options panel on the right.
export component ToolFlowScreen inherits Rectangle {
    in property <ToolTab> tab;
    callback open-files();
    callback remove-file(int);
    callback move-file(int, int);
    // A file card dropped before slot (0 … files) of the list.
    callback place-file(int, int);
    // Merge: the pages taken from a file ("" = all).
    callback set-pages(int, string);
    // A file card being dragged: which, its name, where the pointer is in the grid; the slot it
    // would drop before (the grid's columns from its width, every card one size).
    property <int> drag-uid: -1;
    property <string> drag-name;
    property <length> drag-x;
    property <length> drag-y;
    property <length> step-x: Theme.file-card-width + 16px;
    property <length> step-y: Theme.file-card-height + 16px;
    property <length> grid-w;
    property <int> drop-cols: max(1, floor((root.grid-w - 40px - Theme.fab-size - 36px + 16px) / root.step-x));
    property <int> drop-col: clamp(floor((root.drag-x - 20px + root.step-x / 2) / root.step-x), 0, root.drop-cols);
    property <int> drop-row: max(0, floor((root.drag-y - 20px) / root.step-y));
    property <int> drop-slot: min(root.tab.files.length, root.drop-row * root.drop-cols + root.drop-col);
    // Let go outside the file area, or Escape pressed: the drag is cancelled (as iLovePDF's).
    property <bool> drag-out;
    property <bool> drag-cancelled;
    // The pointer's height in the visible file area and that area's height: near an edge it
    // scrolls, so a card goes past what is in view.
    property <length> drag-vy;
    property <length> view-h;
    property <length> edge-step: root.drag-vy < 40px ? 12px : root.drag-vy > root.view-h - 40px ? -12px : 0px;
    // PDFs open in reader tabs that this tool can take (asked when the + is pressed).
    pure callback open-doc-count() -> int;
    callback add-open-docs();
    // Compare: the open documents by name, and one put in a slot (0 Original, 1 Changed).
    pure callback open-doc-names() -> [string];
    callback add-open-doc-to-slot(int, int);
    property <[string]> slot-docs;
    property <int> doc-count;
    property <length> menu-x;
    property <length> menu-y;
    // The files by name: A to Z, or Z to A when they already are.
    callback sort-files();
    callback remove-page(int);
    callback move-page(int, int);
    callback insert-blank();
    callback show-merge-pages(bool);
    callback crop-preview-step(int);
    callback run(ToolOptions);
    callback cancel();
    callback get-libreoffice();
    // Compare: "Open file" on a slot (0 Original, 1 Changed), and swapping the two.
    callback open-slot(int);
    callback swap-slots();

    property <bool> running: root.tab.phase == 1;
    property <bool> organize: root.tab.tool == "organize";
    // Page cards: Organize's, and Merge's when its files are opened out into their pages.
    property <bool> page-cards: root.organize || (root.tab.tool == "merge" && root.tab.merge-pages);
    // Split: its pages shown in their files, cut between by a click; the ranges are the options panel's.
    property <bool> split: root.tab.tool == "split" && root.tab.pages.length > 0;
    property <string> split-ranges;
    property <bool> compare: root.tab.tool == "compare";
    // Redact shows its one file in the page viewer instead of the file grid.
    property <bool> redact: root.tab.tool == "redact";
    // Sign places its signature on the same page viewer.
    property <bool> sign: root.tab.tool == "sign";
    // Edit places text and images on it too.
    property <bool> edit: root.tab.tool == "edit";
    property <bool> viewer: root.redact || root.sign || root.edit;
    property <int> need: root.tab.tool == "merge" || root.compare ? 2 : 1;
    property <bool> has-original: root.tab.files.length > 0 && root.tab.files[0].slot == 0;
    property <bool> has-changed: root.tab.files.length > 0 && root.tab.files[root.tab.files.length - 1].slot == 1;

    background: Theme.bg;

    // File area
    area := Rectangle {
        x: PlatformBridge.rtl ? parent.width - (Theme.filearea-margin) - self.width : Theme.filearea-margin;
        y: Theme.filearea-margin;
        width: parent.width - Theme.panel-width - 2 * Theme.filearea-margin;
        height: parent.height - 2 * Theme.filearea-margin;
        DashedBox {
            background: Theme.filearea-bg;
            if root.compare: FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: center;
                spacing: 28px;
                orig-slot := CompareSlot {
                    label: @tr("Original");
                    filled: root.has-original;
                    file: root.tab.files[0];
                    tile: root.tab.tile;
                    interactive: !root.running;
                    docs: root.slot-docs;
                    open => { root.slot-docs = root.open-doc-names(); if root.slot-docs.length > 0 { orig-slot.choose(); } else { root.open-slot(0); } }
                    computer => { root.open-slot(0); }
                    pick-doc(i) => { root.add-open-doc-to-slot(0, i); }
                    remove => { root.remove-file(root.tab.files[0].uid); }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: sw.has-hover && sw.enabled ? Theme.popup-hover : Theme.card;
                        opacity: sw.enabled ? 1 : 0.4;
                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../icons/git-compare.svg");
                            colorize: Theme.text;
                        }
                        sw := TouchArea {
                            enabled: root.tab.files.length == 2 && !root.running;
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => { root.swap-slots(); }
                        }
                    }
                    Text {
                        text: @tr("Swap");
                        font-size: Theme.fs-caption;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }
                changed-slot := CompareSlot {
                    label: @tr("Changed");
                    filled: root.has-changed;
                    file: root.tab.files[root.tab.files.length - 1];
                    tile: root.tab.tile;
                    interactive: !root.running;
                    docs: root.slot-docs;
                    open => { root.slot-docs = root.open-doc-names(); if root.slot-docs.length > 0 { changed-slot.choose(); } else { root.open-slot(1); } }
                    computer => { root.open-slot(1); }
                    pick-doc(i) => { root.add-open-doc-to-slot(1, i); }
                    remove => { root.remove-file(root.tab.files[root.tab.files.length - 1].uid); }
                }
            }
            if root.viewer && root.tab.files.length > 0: PageViewer {
                x: PlatformBridge.rtl ? parent.width - (1px) - self.width : 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                pages: root.tab.viewer-pages;
                thumbs: root.tab.viewer-thumbs;
                overlays: root.tab.viewer-overlays;
                content-width: root.tab.viewer-width;
                content-height: root.tab.viewer-height;
                thumbs-height: root.tab.viewer-thumbs-height;
                current: root.tab.viewer-current;
                zoom: root.tab.viewer-zoom;
                status: root.tab.viewer-status;
                scroll: root.tab.viewer-scroll;
                scroll-seq: root.tab.viewer-scroll-seq;
                interactive: !root.running;
                drag-box: root.redact;
                selecting: root.tab.viewer-selecting;
                sign: root.tab.sign-overlay;
                sign-image: root.tab.sign-preview;
                edits: root.tab.edit-overlays;
                viewport(w, top, h) => { ViewerBridge.viewport(root.tab.id, w, top, h); }
                strip-viewport(top, h) => { ViewerBridge.strip-viewport(root.tab.id, top, h); }
                pressed(x, y) => { ViewerBridge.pressed(root.tab.id, x, y); }
                released(x, y) => { ViewerBridge.released(root.tab.id, x, y); }
                dragged(x, y) => { if root.redact { ViewerBridge.dragged(root.tab.id, x, y); } }
                double-clicked(x, y) => { if root.redact { ViewerBridge.double-clicked(root.tab.id, x, y); } }
                thumb-clicked(p) => { ViewerBridge.thumb-clicked(root.tab.id, p); }
                zoom-step(d) => { ViewerBridge.zoom-step(root.tab.id, d); }
            }
            if !root.compare && root.tab.files.length == 0: DropZone {
                open-file => {
                    root.doc-count = root.open-doc-count();
                    if root.doc-count > 0 { root.menu-x = self.absolute-position.x + (self.width - 240px) / 2 - root.absolute-position.x; root.menu-y = self.absolute-position.y + self.height / 2 + 56px - root.absolute-position.y; add-menu.show(); } else { root.open-files(); }
                }
            }
            if !root.compare && !root.viewer && root.tab.files.length > 0: files-view := ScrollView {
                x: PlatformBridge.rtl ? parent.width - (1px) - self.width : 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-width: self.visible-width;
                content-height: grid.preferred-height;
                grid := FlexboxLayout {
                    width: parent.visible-width;
                    padding: 20px;
                    padding-right: Theme.fab-size + 36px;
                    spacing: root.split ? 2px : 16px;
                    flex-wrap: wrap;
                    for f[i] in (root.page-cards || root.split ? [] : root.tab.files): FileCardView {
                        turn: root.tab.tool == "rotate" && opts.degrees > 0 ? opts.degrees : 0;
                        drag-to(x, y) => {
                            if !root.drag-cancelled {
                                root.drag-uid = f.uid;
                                root.drag-name = f.name;
                                root.grid-w = grid.width;
                                root.drag-x = x - grid.absolute-position.x;
                                root.drag-y = y - grid.absolute-position.y;
                                root.drag-vy = y - files-view.absolute-position.y;
                                root.view-h = files-view.visible-height;
                                root.drag-out = x < files-view.absolute-position.x || x > files-view.absolute-position.x + files-view.width
                                    || y < files-view.absolute-position.y || y > files-view.absolute-position.y + files-view.height;
                                drag-keys.focus();
                            }
                        }
                        drag-end => {
                            if root.drag-uid >= 0 && !root.drag-out && !root.drag-cancelled {
                                root.place-file(f.uid, root.drop-slot);
                            }
                            root.drag-uid = -1;
                            root.drag-cancelled = false;
                        }
                        dimmed: root.drag-uid == f.uid;
                        ranges: root.tab.tool == "merge";
                        set-pages(text) => { root.set-pages(f.uid, text); }
                        file: f;
                        tile: root.tab.tile;
                        reorder: root.tab.multi && root.tab.files.length > 1;
                        first: i == 0;
                        last: i == root.tab.files.length - 1;
                        interactive: !root.running;
                        remove => { root.remove-file(f.uid); }
                        move(d) => { root.move-file(f.uid, d); }
                    }
                    for p[i] in (root.split ? root.tab.pages : []): SplitPageView {
                        item: p;
                        range: root.split-ranges == "" ? 0 : Parse.split-range-of(root.split-ranges, p.page, root.tab.pages.length);
                        cut: root.split-ranges != "" && i < root.tab.pages.length - 1
                            && Parse.split-range-of(root.split-ranges, p.page, root.tab.pages.length) >= 0
                            && Parse.split-range-of(root.split-ranges, p.page + 1, root.tab.pages.length) >= 0
                            && Parse.split-range-of(root.split-ranges, p.page, root.tab.pages.length) != Parse.split-range-of(root.split-ranges, p.page + 1, root.tab.pages.length);
                        last: i == root.tab.pages.length - 1;
                        interactive: !root.running;
                        toggle-cut => { root.split-ranges = Parse.split-cut(root.split-ranges, p.page, root.tab.pages.length); }
                    }
                    for p[i] in (root.page-cards ? root.tab.pages : []): PageCardView {
                        item: p;
                        first: i == 0;
                        last: i == root.tab.pages.length - 1;
                        interactive: !root.running;
                        remove => { root.remove-page(i); }
                        move(d) => { root.move-page(i, d); }
                    }
                }
                // Where the dragged card would go: a bar before that slot; its name under the pointer.
                if root.drag-uid >= 0 && !root.drag-out: Rectangle {
                    x: 20px + mod(root.drop-slot, root.drop-cols) * root.step-x - 10px;
                    y: 20px + floor(root.drop-slot / root.drop-cols) * root.step-y;
                    width: 3px;
                    height: Theme.file-card-height;
                    border-radius: 2px;
                    background: Theme.accent;
                }
                if root.drag-uid >= 0: Rectangle {
                    x: root.drag-x + 8px;
                    y: root.drag-y + 8px;
                    width: min(200px, ghost-text.preferred-width + 20px);
                    height: 28px;
                    border-radius: Theme.radius-small;
                    background: Theme.card;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000040;
                    ghost-text := Text {
                        horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.drag-name;
                        font-size: Theme.fs-label;
                        color: Theme.text;
                        overflow: elide;
                    }
                }
                // The pointer held near the top or bottom edge scrolls the files, the drop slot with them.
                Timer {
                    interval: 30ms;
                    running: root.drag-uid >= 0 && !root.drag-out && root.edge-step != 0px;
                    triggered => {
                        let to = clamp(files-view.content-y + root.edge-step, min(0px, files-view.visible-height - files-view.content-height), 0px);
                        root.drag-y -= to - files-view.content-y;
                        files-view.content-y = to;
                    }
                }
            }
            if root.organize && root.tab.preview-failed: Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                x: PlatformBridge.rtl ? parent.width - (20px) - self.width : 20px;
                y: parent.height - self.height - 14px;
                text: @tr("⚠ Page previews unavailable");
                font-size: Theme.fs-caption;
                color: Theme.warning;
            }
            if !root.compare && !root.viewer && root.tab.files.length > 0 && !root.running: AddFab {
                x: PlatformBridge.rtl ? parent.width - (parent.width - self.width - 20px) - self.width : parent.width - self.width - 20px;
                y: 20px;
                count: root.tab.files.length;
                clicked => {
                    root.doc-count = root.open-doc-count();
                    if root.doc-count > 0 { root.menu-x = self.absolute-position.x + self.width - 240px - root.absolute-position.x; root.menu-y = self.absolute-position.y + self.height + 6px - root.absolute-position.y; add-menu.show(); } else { root.open-files(); }
                }
            }
            if !root.compare && !root.viewer && root.tab.multi && root.tab.files.length > 1 && !root.running: SortFab {
                x: PlatformBridge.rtl ? parent.width - (parent.width - self.width - 20px) - self.width : parent.width - self.width - 20px;
                y: 20px + Theme.fab-size + 12px;
                clicked => { root.sort-files(); }
            }
            if root.running: ProcessingOverlay {
                progress: root.tab.progress;
                label: root.tab.progress-text;
                cancelling: root.tab.cancelling;
                cancel => { root.cancel(); }
            }
        }
    }

    // Options panel
    Rectangle {
        x: PlatformBridge.rtl ? parent.width - (parent.width - Theme.panel-width) - self.width : parent.width - Theme.panel-width;
        width: Theme.panel-width;
        background: Theme.panel-bg;
        Rectangle {
            x: PlatformBridge.rtl ? parent.width - (0) - self.width : 0;
            width: 1px;
            background: Theme.sidebar-border;
        }
        VerticalLayout {
            padding: Theme.panel-padding;
            padding-top: 20px;
            spacing: 14px;
            Text {
                text: root.tab.name;
                font-size: Theme.fs-panel-title;
                font-weight: Theme.weight-demibold;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 1px;
                background: Theme.separator;
            }
            // Add watermark: the first page it marks, as it will look, kept in view while the
            // options below scroll (redrawn as they change, see wm_preview.rs).
            if root.tab.tool == "watermark": VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: 230px;
                    background: Theme.filearea-bg;
                    border-radius: Theme.radius-small;
                    if !root.tab.has-preview: Text {
                        text: root.tab.preview-note != "" ? root.tab.preview-note : root.tab.files.length > 0 ? @tr("Preview…") : @tr("Add a file to see the watermark");
                        width: parent.width - 24px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        font-size: Theme.fs-caption;
                        color: Theme.text-muted;
                    }
                    if root.tab.has-preview: Image {
                        width: parent.width - 12px;
                        height: parent.height - 12px;
                        source: root.tab.preview;
                        image-fit: contain;
                    }
                }
                if root.tab.has-preview && root.tab.preview-note != "": Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.tab.preview-note;
                    wrap: word-wrap;
                    font-size: Theme.fs-caption;
                    color: Theme.danger;
                }
            }
            // Long panels (page numbers, watermark, crop) scroll above the action button. The
            // style's scrollbar draws over the content, so it gets a 12 px gutter, always (measuring
            // the overflow instead would make the width depend on the height: a binding loop).
            sv := ScrollView {
                property <length> inner: self.visible-width - 12px;
                vertical-stretch: 1;
                // The gutter's width only: content as wide as the viewport would be centred in it.
                content-width: self.inner;
                content-height: root.redact ? rp.preferred-height + 14px + opts.preferred-height
                    : root.sign ? sp.preferred-height + 14px + opts.preferred-height
                    : root.edit ? ep.preferred-height : opts.preferred-height;
                rp := RedactPanel {
                    // At the top: a child of a ScrollView without `y` is centred in its content.
                    y: 0;
                    width: sv.inner;
                    visible: root.redact;
                    height: root.redact ? self.preferred-height : 0;
                    tab: root.tab;
                    enabled: !root.running && root.tab.files.length > 0;
                }
                sp := SignPanel {
                    y: 0;
                    width: sv.inner;
                    visible: root.sign;
                    height: root.sign ? self.preferred-height : 0;
                    tab: root.tab;
                    enabled: !root.running && root.tab.files.length > 0;
                }
                ep := EditPanel {
                    y: 0;
                    width: sv.inner;
                    visible: root.edit;
                    height: root.edit ? self.preferred-height : 0;
                    tab: root.tab;
                    enabled: !root.running && root.tab.files.length > 0;
                }
                opts := OptionsPanel {
                    y: root.sign ? sp.preferred-height + 14px : root.redact ? rp.preferred-height + 14px : 0;
                    visible: !root.edit;
                    width: sv.inner;
                    tool: root.tab.tool;
                    file-count: root.tab.files.length;
                    ranges <=> root.split-ranges;
                    page-count: root.tab.tool == "split" ? root.tab.pages.length : 0;
                    any-scanned: root.tab.any-scanned;
                    any-locked: root.tab.any-locked;
                    default-out: root.tab.default-out;
                    office-missing: root.tab.office-missing;
                    restore: root.tab.options;
                    has-restore: root.tab.has-options;
                    preview: root.tab.preview;
                    has-preview: root.tab.has-preview;
                    preview-w: root.tab.preview-w;
                    preview-h: root.tab.preview-h;
                    insert-blank => { root.insert-blank(); }
                    merge-pages: root.tab.merge-pages;
                    show-pages(on) => { root.show-merge-pages(on); }
                    preview-page: root.tab.preview-page;
                    preview-pages: root.tab.preview-pages;
                    preview-step(d) => { root.crop-preview-step(d); }
                    get-libreoffice => { root.get-libreoffice(); }
                    tab-id: root.tab.id;
                }
            }
            ActionButton {
                text: root.tab.name;
                enabled: !root.running && opts.valid && root.tab.files-ready && root.tab.files.length >= root.need
                    && (!root.compare || (root.has-original && root.has-changed))
                    && (!root.organize || root.tab.pages.length > 0)
                    && (!root.redact || root.tab.redact-marks.length > 0)
                    // Certifying with a digital ID needs no signature placed (Sol, 26/10: the button stayed off).
                    && (!root.sign || (root.tab.sign-has-graphic && root.tab.sign-placed) || (opts.options.sign-cert && opts.options.sign-certify > 0) || opts.options.sign-timestamp)
                    && (!root.edit || root.tab.edit-ready);
                clicked => { root.run(opts.options); }
            }
        }
    }
    // Escape while a file card is dragged cancels the drag (focused when the drag starts).
    drag-keys := FocusScope {
        width: 0;
        height: 0;
        key-pressed(e) => {
            if e.text == Key.Escape && root.drag-uid >= 0 {
                root.drag-cancelled = true;
                root.drag-uid = -1;
                return accept;
            }
            reject
        }
    }
    add-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 240px;
        height: 72px;
        AddMenu {
            docs: root.doc-count;
            computer => { root.open-files(); }
            documents => { root.add-open-docs(); }
        }
    }
}
