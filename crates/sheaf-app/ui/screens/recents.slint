import { PlatformBridge } from "../platform.slint";
import { Theme } from "../theme.slint";
import { ToolCard, ToolCardView } from "../widgets/tool-card.slint";
import { PrimaryButton } from "../widgets/button.slint";
import { ScrollView } from "std-widgets.slint";
import { DashedBox } from "../widgets/dashed-box.slint";
import { SecondaryButton } from "dialogs.slint";
import { RecentCard } from "../widgets/recent-card.slint";
import { RecentFile } from "../history-types.slint";
import { TextField } from "../widgets/text-field.slint";
import { SortCombo } from "../widgets/sort-combo.slint";

// One tilted page outline of the empty-state illustration.
component PageSketch inherits Rectangle {
    in property <angle> tilt;
    width: 92px;
    height: 120px;
    Rectangle {
        transform-rotation: root.tilt;
        border-radius: 6px;
        border-width: 1.5px;
        border-color: Theme.art-stroke;
        background: Theme.art-page;
        for i in 5: Rectangle {
            x: PlatformBridge.rtl ? parent.width - (14px) - self.width : 14px;
            y: 22px + i * 16px;
            width: i == 4 ? 36px : 64px;
            height: 1.5px;
            border-radius: 1px;
            background: Theme.art-stroke;
        }
    }
}

// Recents page: drop zone, then the recent output files or the empty-state illustration.
export component RecentsScreen inherits Rectangle {
    in property <[RecentFile]> recents;
    // The tools of the latest runs (iLovePDF's Recent Tools): one click opens one.
    in property <[ToolCard]> recent-tools;
    callback open-tool(string);
    callback star(string);
    callback open-file();
    // A new one-page blank PDF (PDF Expert's New ▸ Blank Document).
    callback new-blank();
    callback new-from-clipboard();
    callback new-from-screenshot();
    callback new-from-scanner();
    callback new-from-iphone();
    callback open-recent(int);
    callback reveal-recent(int);
    callback remove-recent(int);
    callback clear-recents();
    callback pin-recent(int);
    // Search and order (0 newest, 1 name, 2 size): Home's list filtered in Rust.
    callback filter-recents(string, int);
    property <int> order: 0;
    property <string> query;
    changed query => { root.filter-recents(root.query, root.order); }
    background: Theme.content-bg;

    scroll := ScrollView {
      content-width: self.visible-width;
      content-height: body.preferred-height;
      body := VerticalLayout {
        width: scroll.visible-width;
        padding: Theme.content-padding;
        spacing: 0;
        alignment: start;

        DashedBox {
            height: Theme.dropzone-height;
            background: Theme.card;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                FlexboxLayout {
                    flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                    flex-wrap: FlexboxLayoutWrap.no-wrap;
                    alignment: center;
                    spacing: 8px;
                    PrimaryButton {
                        text: @tr("Open file");
                        width: 92px;
                        clicked => { root.open-file(); }
                    }
                    SecondaryButton {
                        text: @tr("New blank PDF");
                        clicked => { root.new-blank(); }
                    }
                    // Acrobat's Create PDF from Clipboard, Preview's New from Clipboard.
                    SecondaryButton {
                        text: @tr("From clipboard");
                        clicked => { root.new-from-clipboard(); }
                    }
                    // Acrobat's Create PDF ▸ Screen capture.
                    SecondaryButton {
                        text: @tr("From screenshot");
                        clicked => { root.new-from-screenshot(); }
                    }
                    // Acrobat's Create PDF ▸ Scanner.
                    SecondaryButton {
                        text: @tr("From scanner");
                        clicked => { root.new-from-scanner(); }
                    }
                    // Preview's Import from iPhone or iPad (Continuity Camera): Mac only.
                    if PlatformBridge.mac: SecondaryButton {
                        text: @tr("From iPhone or iPad");
                        clicked => { root.new-from-iphone(); }
                    }
                }
                Text {
                    text: @tr("PDFs, images or documents, or drag & drop anywhere");
                    font-size: Theme.fs-button;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        if root.recent-tools.length > 0: VerticalLayout {
            padding-top: 24px;
            spacing: 14px;
            Text {
                horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                height: Theme.button-height;
                text: @tr("Recent tools");
                font-size: Theme.fs-subtitle;
                font-weight: Theme.weight-demibold;
                color: Theme.text-heading;
                vertical-alignment: center;
            }
            // Wraps at narrow widths (six cards are wider than the window's minimum).
            FlexboxLayout {
                // Right to left, the cards flow from the right.
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: wrap;
                spacing: Theme.grid-spacing;
                for t in root.recent-tools: ToolCardView {
                    tool: t;
                    clicked(id) => { root.open-tool(id); }
                    star(id) => { root.star(id); }
                }
            }
        }

        if root.recents.length > 0 || root.query != "": VerticalLayout {
            padding-top: 24px;
            spacing: 14px;
            FlexboxLayout {
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: LayoutAlignment.stretch;
                height: Theme.button-height;
                spacing: 10px;
                Text {
                    horizontal-alignment: PlatformBridge.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Recent files");
                    font-size: Theme.fs-subtitle;
                    font-weight: Theme.weight-demibold;
                    color: Theme.text-heading;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // Finder's search and sort, as PDF Expert's file browser has them.
                TextField {
                    width: 200px;
                    placeholder: @tr("Search recent files");
                    text <=> root.query;
                }
                SortCombo {
                    options: [@tr("Newest"), @tr("Name"), @tr("Size")];
                    current-index <=> root.order;
                    chevron: @image-url("../icons/chevron-down.svg");
                    selected(i) => { root.filter-recents(root.query, i); }
                }
                SecondaryButton {
                    text: @tr("Clear recents");
                    accessible-role: button;
                    accessible-label: @tr("Clear recents");
                    accessible-action-default => { root.clear-recents(); }
                    border-color: clear-focus.has-focus ? Theme.text-secondary : Theme.input-border;
                    clicked => { root.clear-recents(); }
                    clear-focus := FocusScope {
                        key-pressed(e) => {
                            if e.text == Key.Return || e.text == " " {
                                root.clear-recents();
                                return accept;
                            }
                            reject
                        }
                    }
                }
            }
            FlexboxLayout {
                // Right to left, the cards flow from the right.
                flex-direction: PlatformBridge.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
                flex-wrap: wrap;
                spacing: 14px;
                for f[i] in root.recents: RecentCard {
                    file: f;
                    open => { root.open-recent(i); }
                    reveal => { root.reveal-recent(i); }
                    remove => { root.remove-recent(i); }
                    pin => { root.pin-recent(i); }
                }
            }
        }

        if root.recents.length == 0 && root.query == "": Rectangle { height: 80px; }

        // Illustration
        if root.recents.length == 0 && root.query == "": Rectangle {
            height: 232px;
            clip: true;
            Rectangle {
                width: 320px;
                height: 320px;
                y: 0;
                border-radius: self.width / 2;
                background: @linear-gradient(180deg, Theme.art-circle 0%, Theme.art-circle 40%, Theme.content-bg 72%);
            }
            PageSketch { x: (parent.width - self.width) / 2 - 58px; y: 92px; tilt: -14deg; }
            PageSketch { x: (parent.width - self.width) / 2 + 58px; y: 92px; tilt: 12deg; }
            PageSketch { x: (parent.width - self.width) / 2; y: 72px; tilt: 0deg; }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 222px;
                width: 260px;
                height: 1.5px;
                background: Theme.art-stroke;
            }
        }

        if root.recents.length == 0: Rectangle { height: 16px; }
        if root.recents.length == 0: Text {
            text: @tr("Your recent files will appear here");
            font-size: Theme.fs-button;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
      }
    }
}
